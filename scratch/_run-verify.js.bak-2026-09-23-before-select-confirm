// 临时汇总器：一次性跑完资金域 + 任务域自检脚本，只打印尾部汇总与失败明细
const { execFileSync } = require('child_process');
const path = require('path');

const NODE = process.execPath;
const ROOT = path.resolve(__dirname, '..');
const scripts = process.argv.slice(2);
if (!scripts.length) {
  scripts.push('wb-bankcard-verify', 'wb-withdraw-verify', 'wb-recharge-verify',
    'wb-task-draft-verify', 'wb-task-select-verify');
}

let totalFail = 0;
for (const s of scripts) {
  const file = path.join(ROOT, 'temp', s + '.js');
  let out = '';
  try {
    out = execFileSync(NODE, [file], { cwd: ROOT, encoding: 'utf8' });
  } catch (e) {
    out = (e.stdout || '') + (e.stderr || '');
  }
  const lines = out.split(/\r?\n/);
  const fails = lines.filter(l => /❌|FAIL|✗/.test(l));
  const summary = lines.filter(l => /通过|失败|PASS|结果|总计|共 /.test(l));
  console.log('=== ' + s + ' ===');
  console.log(summary.slice(-4).join('\n') || '(无汇总行)');
  if (fails.length) {
    console.log('--- 失败明细 (' + fails.length + ') ---');
    console.log(fails.slice(0, 40).join('\n'));
    totalFail += fails.length;
  }
  console.log('');
}
console.log('>>> 全部脚本失败断言合计: ' + totalFail);
