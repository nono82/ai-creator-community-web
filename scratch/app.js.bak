// =========================================================================
// AI创作者社区 - 核心交互与应用驱动引擎 (App Core)
// 实现 7 大页面 100% 交互、全 Tab 动态联动与状态管理
// =========================================================================

const App = {
  currentView: 'discover',
  activeWorkCategory: '全部',
  activeTaskCategory: '全部',
  activePlanCategory: '全部',
  activeToolCategory: '全部',
  activeFeedCategory: '全部',
  activeFeedSort: 'hot',
  activeTasksPlazaCategory: '全部任务',
  activeTasksPlazaSort: 'high-reward',
  activeTasksMode: 'hall',
  activeGalleryCategory: '全部',
  activeGallerySort: 'featured',
  activeMyTasksStatus: '全部',
  currentGalleryWorkId: null,
  lastStudioDraft: null,
  activeRankPeriod: 'day',
  activeAnalyticsDimension: '概览',
  activeAnalyticsTime: '30d',
  visibleChartSeries: ['views', 'likes', 'comments', 'shares'],
  trendGranularity: 'day',
  activeAssetCategory: '全部',
  selectedCalendarDay: '28',
  currentApplyingTaskId: null,
  activeTopicFilter: null,
  txShowAll: false,

  // 初始化应用
  init: function() {
    this.bindGlobalEvents();
    this.renderStaticIcons();
    this.syncLevelBadges();
    this.renderAllViews();
    
    // 支持从 URL Hash 读取页面
    const hash = window.location.hash.replace('#', '');
    if (hash && document.getElementById('view-' + hash)) {
      this.navigateTo(hash);
    } else {
      this.navigateTo('discover');
    }
  },

  // 静态区域：快捷入口 / 社区挂件 / 页脚 / 打卡火焰（统一 SVG，非截图）
  renderStaticIcons: function() {
    const discoverQuick = [
      { icon: 'ai_tools', label: 'AI 创作工具', action: "App.openAIWorkbench('AI 创作工具')" },
      { icon: 'smart_edit', label: '智能剪辑', action: "App.openAIWorkbench('智能剪辑')" },
      { icon: 'digital_human', label: '数字人', action: "App.openAIWorkbench('数字人')" },
      { icon: 'txt2img', label: '文生图', action: "App.openAIWorkbench('文生图')" },
      { icon: 'txt2video', label: '文生视频', action: "App.openAIWorkbench('文生视频')" },
      { icon: 'voice', label: '配音合成', action: "App.openAIWorkbench('配音合成')" },
      { icon: 'templates', label: '模板中心', action: "App.navigateTo('tools')" },
      { icon: 'all_tools', label: '全部工具', action: "App.navigateTo('tools')" }
    ];
    const fillQuick = (id, items) => {
      const el = document.getElementById(id);
      if (!el || typeof Icons === 'undefined' || !items) return;
      el.innerHTML = items.map(it => `
        <div class="quick-entry-item" onclick="${it.action}">
          ${Icons.soft(it.icon, 40)}
          <span class="quick-entry-label">${it.label}</span>
        </div>
      `).join('');
    };
    fillQuick('discover-quick-entry', discoverQuick);

    document.querySelectorAll('.widget-title-icon[data-icon]').forEach(el => {
      const name = el.getAttribute('data-icon');
      el.innerHTML = Icons.img(name, 18);
      el.classList.add('widget-title-icon-svg');
    });

    const flame = document.getElementById('streak-flame-icon');
    if (flame) {
      flame.innerHTML = Icons.img('flame', 16);
    }

    const footerMap = {
      creators: 'creators',
      works: 'works',
      brands: 'brands',
      tasks_done: 'tasks_done',
      paid: 'money'
    };
    document.querySelectorAll('[data-footer-icon]').forEach(el => {
      const key = footerMap[el.getAttribute('data-footer-icon')] || 'spark';
      el.innerHTML = Icons.img(key, 18, 'stat-icon-img');
    });
  },

  // 绑定全局事件
  bindGlobalEvents: function() {
    // 全局搜索实时联动
    const searchInput = document.getElementById('global-search-input');
    const searchDropdown = document.getElementById('search-dropdown');
    const searchBtn = document.getElementById('btn-global-search');

    if (searchInput && searchDropdown) {
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val.length > 0) {
          searchDropdown.classList.add('active');
        } else {
          searchDropdown.classList.remove('active');
        }
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.global-search-container')) {
          searchDropdown.classList.remove('active');
        }
        if (!e.target.closest('#btn-notify') && !e.target.closest('#notify-dropdown')) {
          const nd = document.getElementById('notify-dropdown');
          if (nd) nd.hidden = true;
        }
        if (!e.target.closest('.matrix-card-corner-action')) {
          const pop = document.getElementById('native-caps-popover');
          if (pop) pop.classList.remove('active');
        }
      });

      searchBtn.addEventListener('click', () => {
        const val = searchInput.value.trim();
        if (val) {
          this.runGlobalSearch(val);
          searchDropdown.classList.remove('active');
        }
      });

      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          searchBtn.click();
        }
      });
    }

    // 模态弹窗点击背景关闭
    document.querySelectorAll('.modal-backdrop').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.remove('active');
        }
      });
    });

    // 监听任务广场排序下拉
    const taskDropdown = document.getElementById('tasks-dropdown-filter');
    if (taskDropdown) {
      taskDropdown.addEventListener('change', (e) => {
        this.activeTasksPlazaSort = e.target.value;
        this.renderTasksPlaza();
      });
    }

    const galleryDropdown = document.getElementById('gallery-dropdown-filter');
    if (galleryDropdown) {
      galleryDropdown.addEventListener('change', (e) => {
        this.activeGallerySort = e.target.value;
        this.renderGalleryPlaza();
      });
    }

    // 监听数据中心粒度切换
    const trendSeg = document.querySelector('.trend-granularity-seg');
    if (trendSeg) {
      trendSeg.addEventListener('click', (e) => {
        const btn = e.target.closest('.trend-granularity-btn');
        if (!btn || btn.classList.contains('is-active')) return;
        trendSeg.querySelectorAll('.trend-granularity-btn').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        this.trendGranularity = btn.dataset.granularity || 'day';
        this.showToast(`趋势数据已按【${btn.textContent.trim()}】重新统计呈现`);
        this.renderAnalyticsTrendChart();
      });
    }

    // 监听资产明细时间下拉
    const assetTimeSelect = document.getElementById('asset-time-select');
    if (assetTimeSelect) {
      assetTimeSelect.addEventListener('change', (e) => {
        this.showToast(`流水已筛选：${assetTimeSelect.options[assetTimeSelect.selectedIndex].text}`);
      });
    }
  },

  switchView: function(viewId, opts) {
    return this.navigateTo(viewId, opts);
  },

  // 全局页面路由跳转
  navigateTo: function(viewId, opts) {
    opts = opts || {};
    this.currentView = viewId;
    window.location.hash = viewId;

    // 切换左侧导航高亮
    document.querySelectorAll('.nav-item').forEach(item => {
      if (item.getAttribute('data-view') === viewId) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });

    // 切换页面主视图
    document.querySelectorAll('.view-container').forEach(view => {
      if (view.id === 'view-' + viewId) {
        view.classList.add('active');
      } else {
        view.classList.remove('active');
      }
    });

    // 滚动回顶部
    const viewport = document.getElementById('content-viewport');
    if (viewport) viewport.scrollTop = 0;

    if (viewId === 'analytics' && opts.dimension) {
      this.activeAnalyticsDimension = opts.dimension;
    }

    // 图表自适应渲染
    setTimeout(() => {
      if (viewId === 'analytics') {
        this.syncAnalyticsDimensionTabs();
        this.applyAnalyticsDimension();
        this.renderAnalyticsCharts();
      } else if (viewId === 'assets') {
        this.renderAssetsCharts();
      }
    }, 50);
  },

  openMatrixAnalytics: function(platformKey) {
    this.navigateTo('analytics', { dimension: '矩阵分发' });
    if (platformKey && platformKey !== 'more') {
      setTimeout(() => {
        const nameMap = {
          native: '社区大本营',
          douyin: '抖音',
          kuaishou: '快手',
          bilibili: '哔哩哔哩',
          xiaohongshu: '小红书',
          shipinhao: '视频号',
          tiktok: 'TikTok',
          youtube: 'YouTube',
          facebook: 'Facebook',
          instagram: 'Instagram',
          twitter: '推特 (X)'
        };
        this.showToast(`已定位矩阵分发 · ${nameMap[platformKey] || platformKey}`);
        const card = document.querySelector(`.matrix-platform-card[data-platform="${platformKey}"]`);
        if (card) {
          card.classList.add('is-highlight');
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => card.classList.remove('is-highlight'), 1800);
        }
      }, 80);
    }
  },

  getUserLevel: function() {
    return Number(MockData.currentUser.level) || 1;
  },

  // Lv.3 可接基础任务；Lv.4 可接高赏金商单并享展厅加权
  canTakeBasicTasks: function() {
    return this.getUserLevel() >= 3;
  },

  canTakeCommercialTasks: function() {
    return this.getUserLevel() >= 4;
  },

  isHighRewardTask: function(task) {
    if (!task) return false;
    const money = parseInt(String(task.rewardMoney || task.reward || '0').replace(/[^\d]/g, ''), 10) || 0;
    return money >= 3000 || (task.tags || []).includes('品牌合作') || task.category === '品牌合作';
  },

  syncLevelBadges: function() {
    const lv = this.getUserLevel();
    const paths = MockData.academy.paths || [];
    const path = paths[lv - 1];
    const name = path ? path.name : '创作者';
    const label = `Lv.${lv}`;

    document.querySelectorAll('.badge-level').forEach(el => {
      el.textContent = label;
    });
    document.querySelectorAll('[data-user-level-text]').forEach(el => {
      const tmpl = el.getAttribute('data-user-level-text');
      if (tmpl) {
        el.innerHTML = tmpl
          .replace(/\{lv\}/g, label)
          .replace(/\{name\}/g, name);
      }
    });
    document.querySelectorAll('.profile-exp-bar-wrap strong').forEach(el => {
      if (/Lv\.\d/.test(el.textContent)) el.textContent = label;
    });
    document.querySelectorAll('.profile-sub').forEach(el => {
      const school = MockData.currentUser.school || '';
      if (el.textContent.includes('｜') || el.textContent.includes('|')) {
        el.textContent = `${school} ｜ ${name}`;
      }
    });

    if (MockData.analytics && MockData.analytics.creationPerformance && MockData.analytics.creationPerformance.habits) {
      const habit = MockData.analytics.creationPerformance.habits.find(h => h.label === '成长路径');
      if (habit) habit.val = `${label} ${name}`;
    }
    if (MockData.assets && MockData.assets.benefits) {
      const priv = MockData.assets.benefits.find(p => /创作达人/.test(p.title || ''));
      if (priv) priv.title = `创作达人 ${label}`;
    }
  },

  runGlobalSearch: function(keyword) {
    const q = String(keyword || '').trim().toLowerCase();
    if (!q) return;

    const work = (MockData.discover.works || []).find(w =>
      (w.title || '').toLowerCase().includes(q) || (w.author || '').toLowerCase().includes(q)
    );
    if (work) {
      this.navigateTo('discover');
      this.activeWorkCategory = '全部';
      this.renderDiscoverWorks();
      this.showToast(`已定位作品：${work.title}`);
      return;
    }

    const course = (MockData.academy.plans || []).find(p => (p.title || '').toLowerCase().includes(q))
      || (MockData.discover.courses || []).find(c => (c.title || '').toLowerCase().includes(q));
    if (course) {
      this.navigateTo('academy');
      this.showToast(`已定位课程：${course.title}`);
      return;
    }

    const task = (MockData.tasks.list || []).find(t => (t.title || '').toLowerCase().includes(q));
    if (task) {
      this.navigateTo('tasks');
      this.setTasksMode('hall', true);
      setTimeout(() => this.openTaskApplyModal(task.id), 40);
      this.showToast(`已定位任务：${task.title}`);
      return;
    }

    const toolPools = [
      ...((MockData.tools && MockData.tools.myToolbox) || []),
      ...((MockData.tools && MockData.tools.allTools) || []),
      ...((MockData.tools && MockData.tools.leaderboard) || [])
    ];
    const tool = toolPools.find(t => (t.name || '').toLowerCase().includes(q));
    if (tool) {
      this.navigateTo('tools');
      this.openAIWorkbench(tool.name);
      return;
    }

    const creator = ((MockData.tasks.gallery && MockData.tasks.gallery.works) || [])
      .find(w => w.creator && (w.creator.name || '').toLowerCase().includes(q));
    if (creator) {
      this.navigateTo('tasks');
      this.setTasksMode('gallery', true);
      setTimeout(() => this.openCreatorProfile(creator.creator.name), 60);
      return;
    }

    this.navigateTo('discover');
    this.showToast(`未找到「${keyword}」，已回到发现页`);
  },

  // 渲染所有页面内容
  renderAllViews: function() {
    this.renderDiscover();
    this.renderAcademy();
    this.renderTools();
    this.renderCommunity();
    this.renderTasks();
    this.renderAnalytics();
    this.renderAssets();
  },

  // =========================================================================
  // 1. 发现页 (Discover) 渲染与交互
  // =========================================================================
  renderDiscover: function() {
    // 绑定作品 Tab 点击
    const workTabs = document.querySelectorAll('#discover-work-tabs .pill-tab');
    workTabs.forEach(tab => {
      tab.onclick = () => {
        workTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeWorkCategory = tab.getAttribute('data-cat');
        this.renderDiscoverWorks();
      };
    });

    // 绑定任务 Tab 点击
    const taskTabs = document.querySelectorAll('#discover-task-tabs .pill-tab');
    taskTabs.forEach(tab => {
      tab.onclick = () => {
        taskTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeTaskCategory = tab.getAttribute('data-taskcat');
        this.renderDiscoverTasks();
      };
    });

    this.renderDiscoverWorks();
    this.renderDiscoverTasks();
    this.renderDiscoverCourses();
    this.renderDiscoverMatrix();
    this.renderDiscoverRight();
  },

  renderDiscoverMatrix: function() {
    const container = document.getElementById('discover-matrix-platforms');
    if (!container || !MockData.discover || !MockData.discover.matrixStats) return;
    const platforms = MockData.discover.matrixStats.platforms;
    const keyByName = {
      '社区大本营': 'native',
      '本站社区': 'native',
      '抖音': 'douyin',
      '小红书': 'xiaohongshu',
      '视频号': 'shipinhao',
      'TikTok': 'tiktok',
      'YouTube': 'youtube',
      '推特 (X)': 'twitter',
      '推特': 'twitter',
      '更多': 'more'
    };
    container.innerHTML = platforms.map(p => {
      const platKey = p.key || keyByName[p.name] || '';
      const isNative = p.isNative || platKey === 'native';
      const isMore = p.isMore || platKey === 'more';
      const nativeTag = isNative ? `<span class="platform-native-badge">大本营</span>` : '';
      const clickAction = isMore ? `App.openMorePlatformsModal()` : `App.openMatrixAnalytics('${platKey}')`;
      const titleTip = isMore ? '查看更多矩阵通道与全量回流' : `查看 ${p.name} 回流数据`;
      return `
      <div class="platform-icon-wrap ${isNative ? 'is-native-wrap' : ''} ${isMore ? 'is-more-wrap' : ''}" onclick="${clickAction}" title="${titleTip}">
        ${nativeTag}
        <img src="${p.icon}" alt="${p.name}" class="platform-img ${isNative ? 'is-native-img' : ''} ${isMore ? 'is-more-img' : ''}">
        <span class="platform-name">${p.name}</span>
        <span class="platform-count">${p.views}</span>
      </div>
    `}).join('');
  },

  openMorePlatformsModal: function() {
    this.navigateTo('analytics', { dimension: '矩阵分发' });
    setTimeout(() => {
      this.showToast('已展开全网矩阵：涵盖快手、Facebook、B站、Instagram等全量渠道');
      const expandedCards = document.querySelectorAll(
        '.matrix-platform-card[data-platform="kuaishou"], ' +
        '.matrix-platform-card[data-platform="bilibili"], ' +
        '.matrix-platform-card[data-platform="facebook"], ' +
        '.matrix-platform-card[data-platform="instagram"]'
      );
      expandedCards.forEach(c => c.classList.add('is-highlight'));
      const firstTarget = document.querySelector('.matrix-platform-card[data-platform="kuaishou"]');
      if (firstTarget) firstTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => expandedCards.forEach(c => c.classList.remove('is-highlight')), 2000);
    }, 120);
  },

  toggleNativeCapsDropdown: function(evt, btn) {
    if (evt) evt.stopPropagation();
    const pop = document.getElementById('native-caps-popover');
    if (!pop) return;
    const isShow = pop.classList.contains('active');
    document.querySelectorAll('.native-caps-popover.active').forEach(p => p.classList.remove('active'));
    if (!isShow) {
      pop.classList.add('active');
    }
  },

  closeNativeCapsDropdown: function(evt) {
    if (evt) evt.stopPropagation();
    const pop = document.getElementById('native-caps-popover');
    if (pop) pop.classList.remove('active');
  },

  formatLikesDisplay: function(n) {
    if (n >= 10000) {
      const v = (n / 10000).toFixed(1);
      return (v.endsWith('.0') ? v.slice(0, -2) : v) + '万';
    }
    return String(n);
  },

  renderDiscoverWorks: function() {
    const container = document.getElementById('discover-works-container');
    if (!container) return;

    let list = MockData.discover.works;
    if (this.activeWorkCategory !== '全部') {
      list = list.filter(w => w.category === this.activeWorkCategory || (this.activeWorkCategory === '热门榜单' && w.tag === '精选'));
      if (list.length === 0) list = MockData.discover.works; // 若空则保留推荐以防空白
    }

    const eyeIcon = `<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
    const heartIcon = `<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;

    container.innerHTML = list.slice(0, 5).map(item => {
      const likesText = item.liked
        ? this.formatLikesDisplay(item.likes)
        : (item.likesDisplay || this.formatLikesDisplay(item.likes));
      const authorLine = item.authorLine || `@${item.author}`;
      const badgeText = item.tag === '精选' ? '精选' : (item.capabilityTag || '');
      const featuredBadge = badgeText
        ? `<span class="work-cover-badge ${item.capabilityTag && item.tag !== '精选' ? 'is-cap-badge' : ''}">${badgeText}</span>`
        : '';
      const duration = item.duration
        ? `<span class="work-cover-duration">${item.duration}</span>`
        : '';
      const matrixTag = item.matrixSync
        ? `<span class="work-matrix-tag">${item.matrixSync}</span>`
        : '';
      return `
      <div class="work-card" onclick="App.openWorkPlayer('${item.title}')">
        <div class="work-cover-wrap">
          <img src="${item.cover}" alt="${item.title}" class="work-cover-img">
          ${featuredBadge}
          ${duration}
        </div>
        <div class="work-card-info">
          <div class="work-title" title="${item.title}">${item.title}</div>
          <div class="work-author-row">
            <span class="work-author">${authorLine}</span>
            ${matrixTag}
          </div>
          <div class="work-meta">
            <span class="meta-item">${eyeIcon} ${item.views}</span>
            <span class="meta-item ${item.liked ? 'liked' : ''}" onclick="event.stopPropagation(); App.toggleLikeWork(${item.id})">
              ${heartIcon} ${likesText}
            </span>
          </div>
        </div>
      </div>`;
    }).join('');
  },

  renderDiscoverTasks: function() {
    const container = document.getElementById('discover-tasks-container');
    if (!container) return;

    let list = MockData.discover.tasks;
    if (this.activeTaskCategory !== '全部') {
      list = list.filter(t => t.category === this.activeTaskCategory);
      if (list.length === 0) list = MockData.discover.tasks;
    }

    container.innerHTML = list.map(t => `
      <div class="task-mini-card" onclick="App.openTaskModal('${t.id}')">
        <div class="task-mini-body">
          <span class="task-mini-tag ${t.badgeClass}">${t.typeTag}</span>
          <div class="task-mini-title" title="${t.title}">${t.title}</div>
          <div class="task-mini-desc" title="${t.desc}">${t.desc}</div>
          <span class="task-theme-tag">${t.themeTag}</span>
        </div>
        <div class="task-mini-footer">
          <div class="task-mini-footer-main">
            <div class="task-mini-reward-row">
              <span class="task-reward-money">${t.reward}</span>
              <span class="task-meta-info">${t.applied}</span>
              <span class="task-deadline-info">${t.deadline || ''}</span>
            </div>
            <div class="task-applicants-slot">
              ${t.applicantAvatars && t.applicantAvatars.length
                ? Icons.avatarStack(t.applicantAvatars, 20)
                : ''}
            </div>
          </div>
        </div>
      </div>
    `).join('');
  },

  renderDiscoverCourses: function() {
    const container = document.getElementById('discover-courses-container');
    if (!container) return;

    container.innerHTML = MockData.discover.courses.map(c => `
      <div class="course-card" onclick="App.openCoursePlayer('${c.title}')">
        <div class="course-cover-wrap">
          <img src="${c.cover}" alt="${c.title}" class="course-cover-img">
        </div>
        <div class="course-title" title="${c.title}">${c.title}</div>
        <div class="course-meta">
          <div class="course-level">${c.level}</div>
          <div class="course-students">${c.students}</div>
        </div>
      </div>
    `).join('');
  },

  renderDiscoverRight: function() {
    const container = document.getElementById('discover-rec-tasks-list');
    if (!container) return;

    container.innerHTML = MockData.discover.recommendedTasksRight.map(t => `
      <div class="rec-task-item" onclick="App.openTaskModal('${t.id}')">
        <img src="${t.cover}" alt="${t.title}" class="rec-task-thumb">
        <div class="rec-task-content">
          <div class="rec-task-title">${t.title}</div>
          <span class="rec-task-sub">${t.tag}</span>
        </div>
        <div class="rec-task-price">${t.reward}</div>
        <div class="rec-task-right">
          <div class="rec-task-time">${t.deadline}</div>
          <div class="rec-task-applied">${t.applied}</div>
        </div>
      </div>
    `).join('');
  },

  toggleLikeWork: function(workId) {
    const work = MockData.discover.works.find(w => w.id === workId);
    if (work) {
      work.liked = !work.liked;
      work.likes += work.liked ? 1 : -1;
      this.renderDiscoverWorks();
      this.showToast(work.liked ? '已点赞作品 👍' : '已取消点赞');
    }
  },

  // =========================================================================
  // 2. 成长学院 (Academy) 渲染与交互
  // =========================================================================
  renderAcademy: function() {
    // 渲染成长路径节点
    const stepsContainer = document.getElementById('growth-steps-container');
    if (stepsContainer) {
      stepsContainer.innerHTML = MockData.academy.paths.map((p, idx) => {
        const locked = !p.done && !p.active;
        const statusText = p.done ? '已完成' : (p.active ? '进行中' : '未解锁');
        const arrowDone = p.done ? 'is-passed' : '';
        const perkTip = p.perk ? ` · ${p.perk}` : '';
        return `
        <div class="growth-step-card ${p.active ? 'active' : ''} ${locked ? 'is-locked' : ''} ${p.done ? 'is-done' : ''}" onclick="App.onGrowthPathClick(${idx})" title="${p.level} ${p.name}${perkTip}">
          <div class="growth-step-icon-wrap">
            <img src="assets/icons/academy/${p.icon}.png" alt="" class="growth-step-icon-img" draggable="false">
            ${p.done ? '<span class="growth-step-check" aria-hidden="true"></span>' : ''}
          </div>
          <div class="growth-step-level">${p.level}</div>
          <div class="growth-step-name">${p.name}</div>
          <div class="growth-step-status">${statusText}</div>
        </div>
        ${idx < MockData.academy.paths.length - 1 ? `<div class="growth-step-arrow ${arrowDone}" aria-hidden="true"><span></span></div>` : ''}
      `;
      }).join('');
    }

    // 绑定计划分类 Tab
    const planTabs = document.querySelectorAll('#academy-plan-tabs .pill-tab');
    planTabs.forEach(tab => {
      tab.onclick = () => {
        planTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activePlanCategory = tab.getAttribute('data-plancat');
        this.renderAcademyPlans();
      };
    });

    // 绑定周历点击
    const calCols = document.querySelectorAll('#academy-calendar-row .calendar-day-col');
    calCols.forEach(col => {
      col.onclick = () => {
        calCols.forEach(c => c.classList.remove('active'));
        col.classList.add('active');
        this.selectedCalendarDay = col.getAttribute('data-day');
        this.renderCalendarPlans();
      };
    });

    this.renderAcademyPlans();
    this.renderCalendarPlans();
    this.renderAcademyResources();
    this.renderAcademyAchievements();
  },

  renderAcademyPlans: function() {
    const container = document.getElementById('academy-plans-container');
    if (!container) return;

    let list = MockData.academy.plans;
    if (this.activePlanCategory !== '全部') {
      list = list.filter(p => p.category === this.activePlanCategory);
      if (list.length === 0) list = MockData.academy.plans;
    }

    const badgeClassMap = {
      '新手入门': 'badge-newbie',
      '技能提升': 'badge-skill',
      '实战进阶': 'badge-advance',
      '出海运营': 'badge-global',
      '商业变现': 'badge-biz'
    };

    container.innerHTML = list.map(p => {
      const badgeText = p.badge || p.category;
      const badgeClass = badgeClassMap[badgeText] || '';
      return `
      <div class="plan-card" onclick="App.openCoursePlayer('${p.title}')">
        <div class="plan-cover-wrap">
          <img src="${p.cover}" alt="${p.title}" class="plan-cover-img">
          <span class="plan-cover-badge ${badgeClass}">${badgeText}</span>
        </div>
        <div class="plan-info-wrap">
          <div class="plan-sub">${p.lessons}</div>
          <div class="plan-students">${p.students}</div>
          <div class="plan-progress-row">
            <div class="progress-bar-bg plan-progress-bar">
              <div class="progress-bar-fill" style="width: ${p.progress}%;"></div>
            </div>
            <span class="plan-progress-pct">已学 ${p.progress}%</span>
          </div>
        </div>
      </div>
    `;
    }).join('');
  },

  renderCalendarPlans: function() {
    const container = document.getElementById('academy-today-plans-list');
    if (!container) return;

    const list = MockData.academy.calendarTasks[this.selectedCalendarDay] || MockData.academy.calendarTasks['28'];
    container.innerHTML = list.map(task => {
      const statusText = task.status || (task.state === '已完成' ? '已完成' : '未开始');
      const done = statusText === '已完成' || task.state === '已完成';
      const btnText = done ? '已完成' : '去学习';
      const statusClass = done ? 'is-done' : 'is-todo';
      const safeTitle = String(task.title).replace(/'/g, "\\'");
      return `
      <div class="today-plan-item">
        <div class="today-plan-thumb-wrap">
          <img src="${task.cover}" alt="${task.title}" class="today-plan-thumb">
          <span class="today-plan-play" aria-hidden="true"></span>
        </div>
        <div class="today-plan-content">
          <div class="today-plan-title">${task.title}</div>
          <div class="today-plan-sub">${task.lesson}</div>
          <div class="today-plan-status ${statusClass}">${statusText}</div>
        </div>
        <button class="btn-study-action ${done ? 'is-done' : ''}" ${done ? 'disabled' : ''} onclick="event.stopPropagation(); App.completeLesson('${safeTitle}')">${btnText}</button>
      </div>
    `;
    }).join('');
  },

  renderAcademyResources: function() {
    const container = document.getElementById('academy-resources-container');
    if (!container) return;

    container.innerHTML = MockData.academy.resources.map(r => `
      <div class="resource-card" onclick="App.showToast('已进入：${r.name} · ${r.desc}')">
        <div class="resource-icon-wrap" style="background:${r.iconColor}18;">
          ${typeof Icons !== 'undefined' ? Icons.img(r.icon, 28, 'resource-icon-img') : ''}
        </div>
        <div class="resource-name">${r.name}</div>
        <div class="resource-desc">${r.desc}</div>
      </div>
    `).join('');
  },

  renderAcademyAchievements: function() {
    const container = document.getElementById('academy-achievements-grid');
    if (!container) return;

    container.innerHTML = MockData.academy.achievements.map(a => `
      <div class="achievement-card" onclick="App.showToast('成就已获得：${a.title} (${a.desc})')">
        <img src="${a.icon}" alt="${a.title}" class="achievement-medal-img">
        <div class="achievement-title">${a.title}</div>
        <div class="achievement-sub">${a.desc}</div>
        <div class="achievement-date">${a.date}</div>
      </div>
    `).join('');
  },

  // =========================================================================
  // 3. 创作工具 (Tools) 渲染与交互
  // =========================================================================
  toolIconSvg: function(iconKey) {
    const key = iconKey || 'grid';
    if (typeof Icons !== 'undefined' && Icons.src(key)) {
      return `<img src="${Icons.src(key)}" alt="" class="tool-icon-img">`;
    }
    return `<img src="assets/icons/tools/${key}.png" alt="" class="tool-icon-img">`;
  },

  renderStarRating: function(score) {
    const full = Math.floor(score);
    const hasHalf = score - full >= 0.5;
    let stars = '';
    for (let i = 1; i <= 5; i++) {
      if (i <= full) stars += '<span class="star filled">★</span>';
      else if (i === full + 1 && hasHalf) stars += '<span class="star half">★</span>';
      else stars += '<span class="star empty">★</span>';
    }
    return `<div class="star-rating">${stars}<span class="star-score">${score.toFixed(1)}</span></div>`;
  },

  renderTools: function() {
    // 渲染我的工具箱
    const toolbox = document.getElementById('my-toolbox-grid');
    if (toolbox) {
      toolbox.innerHTML = MockData.tools.myToolbox.map(t => `
        <div class="toolbox-card toolbox-card-h" onclick="App.openAIWorkbench('${t.name}')">
          <div class="toolbox-icon-wrap toolbox-icon-soft">
            ${this.toolIconSvg(t.icon)}
          </div>
          <div class="toolbox-text">
            <div class="toolbox-title">${t.name}</div>
            <div class="toolbox-desc">${t.desc}</div>
            <span class="toolbox-tag">最近使用</span>
          </div>
        </div>
      `).join('') + `
        <div class="toolbox-card toolbox-card-h" onclick="App.scrollToToolsCatalog()">
          <div class="toolbox-icon-wrap toolbox-icon-soft">
            ${this.toolIconSvg('grid')}
          </div>
          <div class="toolbox-text">
            <div class="toolbox-title">更多工具</div>
            <div class="toolbox-desc">探索全部工具</div>
            <span class="toolbox-tag">查看全部</span>
          </div>
        </div>
      `;
    }

    // 绑定热门工具 Tab
    const toolTabs = document.querySelectorAll('#tools-category-tabs .pill-tab');
    toolTabs.forEach(tab => {
      tab.onclick = () => {
        toolTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeToolCategory = tab.getAttribute('data-toolcat');
        this.renderHotTools();
      };
    });

    this.renderHotTools();
    this.renderCommercialWorkflows();
    this.renderToolsRecentProjects();
    this.renderToolsGenQueue();

    // 渲染 6 大分类
    const catGrid = document.getElementById('tool-categories-grid');
    if (catGrid) {
      catGrid.innerHTML = MockData.tools.categories.map(c => `
        <div class="toolbox-card toolbox-card-h" onclick="App.filterToolCategory('${c.name}')">
          <div class="toolbox-icon-wrap toolbox-icon-soft">
            ${this.toolIconSvg(c.icon)}
          </div>
          <div class="toolbox-text">
            <div class="toolbox-title">${c.name}</div>
            <div class="toolbox-desc">${c.count}</div>
          </div>
        </div>
      `).join('');
    }

    // 渲染工具排行榜
    const lb = document.getElementById('tools-leaderboard-list');
    if (lb) {
      lb.innerHTML = MockData.tools.leaderboard.map(item => `
        <div class="leaderboard-item" onclick="App.openAIWorkbench('${item.name}')">
          <span class="rank-num-badge ${item.rank <= 3 ? 'top-' + item.rank : ''}">${item.rank}</span>
          <div class="leaderboard-icon toolbox-icon-soft">${this.toolIconSvg(item.icon)}</div>
          <div class="leaderboard-content">
            <div class="leaderboard-name">${item.name}</div>
            <div class="leaderboard-users">${item.users}</div>
          </div>
          ${this.renderStarRating(item.score)}
        </div>
      `).join('');
    }
  },

  renderToolsRecentProjects: function() {
    const container = document.getElementById('tools-recent-projects');
    if (!container) return;
    const list = MockData.tools.recentProjects || [];
    container.innerHTML = list.map(p => `
      <div class="recent-project-item">
        <img src="${p.cover}" alt="${p.title}" class="recent-project-thumb">
        <div class="recent-project-body">
          <div class="recent-project-title" title="${p.title}">${p.title}</div>
          <div class="recent-project-meta">${p.type} · ${p.updatedAt}</div>
        </div>
        <button class="btn-continue-edit" onclick="event.stopPropagation(); App.openAIWorkbench('${p.tool}'); App.showToast('已打开「${p.title}」，继续上次编辑')">继续编辑</button>
      </div>
    `).join('');
  },

  renderToolsGenQueue: function() {
    const container = document.getElementById('tools-gen-queue');
    if (!container) return;
    const list = MockData.tools.generationQueue || [];
    const statusMap = {
      rendering: { label: '生成中', cls: 'is-rendering' },
      queued: { label: '排队中', cls: 'is-queued' },
      done: { label: '已完成', cls: 'is-done' }
    };
    container.innerHTML = list.map(t => {
      const st = statusMap[t.status] || statusMap.queued;
      const action = t.status === 'done'
        ? `<div class="gen-queue-actions">
             <button class="btn-gen-action" onclick="event.stopPropagation(); App.openPreviewLightbox('${t.cover || 'assets/covers/work_1.png'}', '${t.title}')">预览</button>
             <button class="btn-gen-action is-primary" onclick="event.stopPropagation(); App.showToast('已开始下载：${t.title}')">下载</button>
           </div>`
        : `<div class="gen-queue-eta">${t.eta}</div>`;
      return `
      <div class="gen-queue-item ${st.cls}">
        <img src="${t.cover}" alt="${t.title}" class="gen-queue-thumb">
        <div class="gen-queue-body">
          <div class="gen-queue-top">
            <div class="gen-queue-title" title="${t.title}">${t.title}</div>
            <span class="gen-queue-status ${st.cls}">${st.label}</span>
          </div>
          <div class="gen-queue-type">${t.type}</div>
          <div class="gen-queue-progress-row">
            <div class="progress-bar-bg gen-queue-bar">
              <div class="progress-bar-fill ${t.status === 'done' ? 'is-done-fill' : ''}" style="width:${t.progress}%;"></div>
            </div>
            <span class="gen-queue-pct">${t.progress}%</span>
          </div>
          ${action}
        </div>
      </div>`;
    }).join('');
  },

  renderHotTools: function() {
    const container = document.getElementById('hot-tools-grid');
    if (!container) return;

    let list = MockData.tools.allTools;
    if (this.activeToolCategory !== '全部') {
      list = list.filter(t => t.category === this.activeToolCategory);
      if (list.length === 0) list = MockData.tools.allTools;
    }

    container.innerHTML = list.map(t => `
      <div class="hot-tool-card">
        <div>
          <div class="tool-card-header">
            <div class="tool-card-icon toolbox-icon-soft">
              ${this.toolIconSvg(t.icon)}
            </div>
            <div class="tool-title-row">
              <div class="tool-card-title">${t.name}</div>
              <span class="tool-tag">${t.category}</span>
            </div>
          </div>
          <div class="tool-card-desc">${t.desc}</div>
        </div>
        <div class="tool-card-footer">
          <span class="tool-user-count">${t.users}</span>
          <button class="btn-open-tool" onclick="App.openAIWorkbench('${t.name}')">打开</button>
        </div>
      </div>
    `).join('');
  },

  filterToolCategory: function(catName) {
    const toolTabs = document.querySelectorAll('#tools-category-tabs .pill-tab');
    toolTabs.forEach(tab => {
      if (tab.getAttribute('data-toolcat') === catName) {
        tab.click();
      }
    });
  },

  // 工具使用统计卡片已移除（底部已有汇总指标）
  renderToolsCharts: function() {},

  // =========================================================================
  // 4. 社区中心 (Community) 渲染与交互
  // =========================================================================
  renderCommunity: function() {
    // 热门话题
    const topics = document.getElementById('community-topics-list');
    if (topics) {
      topics.innerHTML = MockData.community.hotTopics.map((t, i) => {
        const rank = i + 1;
        return `
        <div class="topic-item-row" onclick="App.filterFeedByTopic('${t.name}')">
          <span class="topic-rank rank-${rank}">${rank}</span>
          <div class="topic-main">
            <span class="topic-hash">#</span>
            <span class="topic-name">${t.name}</span>
            ${t.hot ? '<span class="topic-hot-tag">热</span>' : ''}
          </div>
          <span class="topic-count">${t.discusses.replace('讨论', '')}</span>
        </div>`;
      }).join('');
    }

    // 创作圈子小挂件（头像 + 名称）
    const circlesMini = document.getElementById('community-circles-list-mini');
    if (circlesMini) {
      circlesMini.innerHTML = MockData.community.circles.slice(0, 3).map(c => `
        <div class="circle-mini-row" onclick="App.focusHotCircle('${c.name}')">
          <div class="circle-mini-left">
            ${typeof Icons !== 'undefined' ? Icons.soft(c.icon, 28) : ''}
            <span class="topic-name">${c.name}</span>
          </div>
          <span class="topic-count">${c.count.replace('人加入','')}</span>
        </div>
      `).join('');
    }

    // 绑定 Feed Tab（underline）
    const feedTabs = document.querySelectorAll('#community-feed-tabs .underline-tab');
    feedTabs.forEach(tab => {
      tab.onclick = () => {
        feedTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeFeedCategory = tab.getAttribute('data-feedcat');
        this.activeTopicFilter = null;
        this.renderCommunityFeed();
      };
    });

    this.renderCommunityFeed();
    this.renderCommunityActiveRanks();
    this.renderCommunityHotCircles();
    this.renderCommunityAnnouncements();
  },

  renderCommunityFeed: function() {
    const container = document.getElementById('community-feed-container');
    if (!container) return;

    let posts = MockData.community.posts;
    if (this.activeTopicFilter) {
      const key = this.activeTopicFilter;
      const filtered = posts.filter(p =>
        (p.topicTag || '').includes(key.slice(0, 4)) ||
        (p.content || '').includes(key.slice(0, 4)) ||
        key.includes((p.topicTag || '').slice(0, 4))
      );
      if (filtered.length) posts = filtered;
    }
    if (this.activeFeedCategory !== '全部') {
      posts = posts.filter(p => p.category === this.activeFeedCategory || (this.activeFeedCategory === '关注' && p.isFollowing));
      if (posts.length === 0) posts = MockData.community.posts;
    }

    const likeIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;
    const commentIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`;
    const shareIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`;
    const eyeIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;

    container.innerHTML = posts.map(p => `
      <div class="feed-card">
        <div class="feed-author-row">
          <div class="feed-author-left">
            <img src="${p.avatar || 'assets/avatars/avatar_post2.png'}" alt="${p.author}" class="feed-author-avatar">
            <div class="feed-author-meta">
              <div class="feed-author-name-wrap">
                <span class="feed-author-name">${p.author}</span>
                <span class="badge-level-soft">${p.level}</span>
                ${p.roleTag ? `<span class="feed-role-tag">${p.roleTag}</span>` : ''}
              </div>
              <div class="feed-post-time">${p.time} · ${p.school}</div>
            </div>
          </div>
          <button class="btn-follow ${p.isFollowing ? 'followed' : ''}" onclick="App.toggleFollowAuthor('${p.id}')">
            ${p.isFollowing ? '已关注' : '关注'}
          </button>
        </div>

        <div class="feed-content-text">${p.content}</div>

        <div class="feed-images-grid">
          ${p.images.map((img, idx) => `
            <div class="feed-img-item" onclick="App.openPreviewLightbox('${img}', '${p.author} · 动态配图')">
              <img src="${img}" alt="配图">
              ${idx === 3 && p.extraCount ? `<span class="feed-img-more-badge">${p.extraCount}</span>` : ''}
            </div>
          `).join('')}
        </div>

        <div class="feed-actions-bar">
          <div class="feed-action-btn ${p.liked ? 'liked' : ''}" onclick="App.toggleLikeFeed('${p.id}')">
            ${likeIcon}
            <span>${p.likes}</span>
          </div>
          <div class="feed-action-btn" onclick="App.toggleFeedComments('${p.id}')">
            ${commentIcon}
            <span>${p.comments}</span>
          </div>
          <div class="feed-action-btn" onclick="App.shareFeedPost('${p.id}')">
            ${shareIcon}
            <span>${p.shares}</span>
          </div>
          <div class="feed-views-count">
            ${eyeIcon}
            <span>${p.views}</span>
          </div>
        </div>
        <div class="feed-comment-panel" id="feed-comments-${p.id}" hidden>
          <div class="feed-comment-list">
            ${(p.commentList || [
              { user: '漫剧小画家', text: '这个提示词结构很清晰，学习了！' },
              { user: '数字人小美', text: '完播钩子可以再提前 1 秒。' }
            ]).slice(0, 3).map(c => `
              <div class="feed-comment-item"><strong>${c.user}</strong><span>${c.text}</span></div>
            `).join('')}
          </div>
          <div class="feed-comment-compose">
            <input type="text" class="form-input" id="feed-comment-input-${p.id}" placeholder="说点什么…">
            <button type="button" class="hero-btn-primary" style="padding:6px 12px;font-size:12px;" onclick="App.submitFeedComment('${p.id}')">发送</button>
          </div>
        </div>
      </div>
    `).join('');
  },

  toggleFeedComments: function(postId) {
    const panel = document.getElementById('feed-comments-' + postId);
    if (!panel) return;
    panel.hidden = !panel.hidden;
  },

  submitFeedComment: function(postId) {
    const post = MockData.community.posts.find(p => p.id === postId);
    const input = document.getElementById('feed-comment-input-' + postId);
    const text = (input && input.value || '').trim();
    if (!post) return;
    if (!text) {
      this.showToast('请输入评论内容');
      return;
    }
    if (!post.commentList) post.commentList = [];
    post.commentList.unshift({ user: MockData.currentUser.name, text });
    post.comments = (post.comments || 0) + 1;
    if (input) input.value = '';
    this.renderCommunityFeed();
    const panel = document.getElementById('feed-comments-' + postId);
    if (panel) panel.hidden = false;
    this.showToast('评论已发布');
  },

  shareFeedPost: function(postId) {
    const post = MockData.community.posts.find(p => p.id === postId);
    if (!post) return;
    post.shares = (post.shares || 0) + 1;
    this.renderCommunityFeed();
    this.showToast('分享链接已复制，可粘贴到微信/社群');
  },

  toggleLikeFeed: function(postId) {
    const post = MockData.community.posts.find(p => p.id === postId);
    if (post) {
      post.liked = !post.liked;
      post.likes += post.liked ? 1 : -1;
      this.renderCommunityFeed();
      this.showToast(post.liked ? '点赞成功 👍' : '已取消点赞');
    }
  },

  toggleFollowAuthor: function(postId) {
    const post = MockData.community.posts.find(p => p.id === postId);
    if (post) {
      post.isFollowing = !post.isFollowing;
      this.renderCommunityFeed();
      this.showToast(post.isFollowing ? `已关注创作者：${post.author}` : `已取消关注：${post.author}`);
    }
  },

  setCommunitySort: function(sortType) {
    this.activeFeedSort = sortType;
    const hotBtn = document.getElementById('sort-hot');
    const latestBtn = document.getElementById('sort-latest');
    if (hotBtn && latestBtn) {
      hotBtn.classList.toggle('active', sortType === 'hot');
      latestBtn.classList.toggle('active', sortType === 'latest');
    }
    this.showToast(`已按【${sortType === 'hot' ? '热门讨论' : '最新发布'}】排序动态`);
    this.renderCommunityFeed();
  },

  switchRankPeriod: function(period) {
    this.activeRankPeriod = period;
    document.querySelectorAll('.rank-tab-btn').forEach(btn => {
      if (btn.getAttribute('data-rankperiod') === period) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
    this.renderCommunityActiveRanks();
  },

  renderCommunityActiveRanks: function() {
    const container = document.getElementById('community-active-ranks-list');
    if (!container) return;

    const list = MockData.community.activeRanks[this.activeRankPeriod] || MockData.community.activeRanks.day;
    container.innerHTML = list.map(u => `
      <div class="leaderboard-item">
        <span class="rank-num-badge ${u.rank <= 3 ? 'top-' + u.rank : ''}">${u.rank}</span>
        <img src="${u.avatar}" alt="${u.name}" style="width:28px; height:28px; border-radius:50%; object-fit:cover;">
        <div class="leaderboard-content">
          <div class="leaderboard-name">${u.name} <span class="badge-level-soft">${u.level}</span></div>
        </div>
        <div class="rank-hot-val ${u.rank === 1 ? 'is-top' : ''}">${u.rank === 1 && typeof Icons !== 'undefined' ? `<span class="rank-flame">${Icons.line('flame', 12)}</span>` : ''}${u.hot}</div>
      </div>
    `).join('');
  },

  renderCommunityHotCircles: function() {
    const container = document.getElementById('community-hot-circles-list');
    if (!container) return;

    container.innerHTML = MockData.community.circles.map(c => `
      <div class="circle-item-row" data-circle-name="${c.name}">
        <span class="circle-avatar-wrap" style="--circle-accent:${c.color || '#7C3AED'};">
          ${typeof Icons !== 'undefined' ? Icons.soft(c.icon, 32) : ''}
        </span>
        <div class="circle-meta">
          <div class="circle-name" title="${c.name}">${c.name}</div>
          <div class="circle-count">${c.count}</div>
        </div>
        <button class="btn-join-circle ${c.joined ? 'joined' : ''}" onclick="App.toggleJoinCircle('${c.name}')">
          ${c.joined ? '已加入' : '加入'}
        </button>
      </div>
    `).join('');
  },

  toggleJoinCircle: function(circleName) {
    const circle = MockData.community.circles.find(c => c.name === circleName);
    if (circle) {
      circle.joined = !circle.joined;
      this.renderCommunityHotCircles();
      this.showToast(circle.joined ? `成功加入圈子：${circle.name}` : `已退出圈子：${circle.name}`);
    }
  },

  renderCommunityAnnouncements: function() {
    const container = document.getElementById('community-announcements-list');
    if (!container) return;

    const hornIcon = `<svg class="announcement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M17.5 6a8 8 0 0 1 0 12"/></svg>`;

    container.innerHTML = MockData.community.announcements.map((a, idx) => `
      <div class="announcement-row" onclick="App.openAnnouncementDetail(${idx})">
        ${hornIcon}
        <span class="announcement-title">${a.title}</span>
        <span class="announcement-date">${a.date}</span>
      </div>
    `).join('');
  },

  submitPublishWork: function(opts) {
    opts = opts || {};
    const titleInput = document.getElementById('publish-title');
    const catInput = document.getElementById('publish-category');
    const contentInput = document.getElementById('publish-content');

    const title = (opts.title || (titleInput && titleInput.value) || '').trim();
    const cat = opts.category || (catInput && catInput.value) || 'AI短视频';
    const content = (opts.content || (contentInput && contentInput.value) || '').trim();
    const cover = opts.cover || 'assets/covers/work_1.png';

    if (!title) {
      this.showToast('请输入作品标题');
      return false;
    }

    const platforms = opts.platforms || this.getSelectedMatrixPlatforms();

    const newPost = {
      id: 'P' + Date.now(),
      author: '小宇同学',
      school: '南京大学',
      level: 'Lv.' + (MockData.currentUser.level || 4),
      roleTag: MockData.currentUser.role || '商业创作者',
      time: '刚刚',
      content: content || `刚发布了最新 AI 作品《${title}》，使用 ${cat} 模型全流程精细化生成！`,
      topicTag: cat + '创作',
      images: [cover, 'assets/covers/work_2.png'],
      extraCount: '',
      likes: 1,
      liked: true,
      comments: 0,
      shares: 0,
      views: '1',
      isFollowing: false,
      category: '最新'
    };

    MockData.community.posts.unshift(newPost);

    const newWork = {
      id: Date.now(),
      title: title,
      author: '小宇同学',
      school: '南京大学',
      authorLine: '南京大学 | @小宇同学',
      tag: '刚刚发布',
      category: cat,
      duration: '00:45',
      views: '128',
      likes: 1,
      likesDisplay: '1',
      cover: cover
    };
    MockData.discover.works.unshift(newWork);
    MockData.currentUser.worksCount += 1;

    if (platforms.length) {
      this.applyMatrixDistribution({ title, cover, platforms });
      this.bumpOverviewStats({ views: 1800 * platforms.length, likes: 220 * platforms.length, shares: 40 * platforms.length });
    } else {
      this.bumpOverviewStats({ views: 128, likes: 1 });
    }

    if (typeof this.renderCommunityFeed === 'function') this.renderCommunityFeed();
    if (typeof this.renderDiscoverWorks === 'function') this.renderDiscoverWorks();
    if (typeof this.renderDiscoverMatrix === 'function') this.renderDiscoverMatrix();
    if (this.currentView === 'analytics') {
      this.applyAnalyticsDimension();
      this.renderAnalyticsRight && this.renderAnalyticsRight();
    }

    if (!opts.keepModalOpen) {
      this.closeModal('modal-publish');
      if (titleInput) titleInput.value = '';
      if (contentInput) contentInput.value = '';
    }

    const platTip = platforms.length ? `，已分发至 ${platforms.length} 个平台` : '';
    this.showToast(opts.toast || `🎉 作品发布成功！已同步社区与发现页${platTip}`);
    return true;
  },

  getSelectedMatrixPlatforms: function() {
    return Array.from(document.querySelectorAll('input[name="matrix-plat"]:checked')).map(el => el.value);
  },

  parseMetricNumber: function(val) {
    const s = String(val == null ? '' : val).replace(/[¥+\s,]/g, '').trim();
    if (!s) return 0;
    if (s.includes('万')) return Math.round(parseFloat(s) * 10000) || 0;
    if (s.includes('千')) return Math.round(parseFloat(s) * 1000) || 0;
    return parseInt(s, 10) || 0;
  },

  formatMetricNumber: function(n, asMoney) {
    n = Math.max(0, Math.round(Number(n) || 0));
    if (asMoney) return '¥ ' + n.toLocaleString('zh-CN');
    if (n >= 10000) {
      const v = (n / 10000).toFixed(1).replace(/\.0$/, '');
      return v + '万';
    }
    return n.toLocaleString('zh-CN');
  },

  applyMatrixDistribution: function({ title, cover, platforms }) {
    const mx = MockData.analytics.matrixDistribution;
    if (!mx) return;
    const keyMap = {
      native: 'native',
      douyin: 'douyin',
      kuaishou: 'kuaishou',
      bilibili: 'bilibili',
      xiaohongshu: 'xiaohongshu',
      shipinhao: 'shipinhao',
      tiktok: 'tiktok',
      youtube: 'youtube',
      facebook: 'facebook',
      instagram: 'instagram',
      twitter: 'twitter'
    };
    const row = {
      title,
      cover: cover || 'assets/covers/work_1.png',
      native: { views: '—', likes: '—', note: '社区首发' },
      douyin: { views: '—', likes: '—' },
      kuaishou: { views: '—', likes: '—' },
      bilibili: { views: '—', likes: '—' },
      xiaohongshu: { views: '—', likes: '—' },
      shipinhao: { views: '—', likes: '—' },
      tiktok: { views: '—', likes: '—' },
      youtube: { views: '—', likes: '—' },
      facebook: { views: '—', likes: '—' },
      instagram: { views: '—', likes: '—' },
      twitter: { views: '—', likes: '—' }
    };

    platforms.forEach((key) => {
      const plat = mx.platforms.find(p => p.key === key);
      if (!plat) return;
      const addViews = 1200 + Math.floor(Math.random() * 1800);
      const addLikes = 80 + Math.floor(Math.random() * 220);
      const addComments = 12 + Math.floor(Math.random() * 40);
      const addShares = 8 + Math.floor(Math.random() * 30);
      const addIncome = 30 + Math.floor(Math.random() * 90);
      const addFans = 20 + Math.floor(Math.random() * 80);

      plat.views = this.formatMetricNumber(this.parseMetricNumber(plat.views) + addViews);
      plat.likes = this.formatMetricNumber(this.parseMetricNumber(plat.likes) + addLikes);
      plat.comments = this.formatMetricNumber(this.parseMetricNumber(plat.comments) + addComments);
      plat.shares = this.formatMetricNumber(this.parseMetricNumber(plat.shares) + addShares);
      plat.income = this.formatMetricNumber(this.parseMetricNumber(plat.income) + addIncome, true);
      const fansNum = this.parseMetricNumber(String(plat.fans).replace('+', ''));
      plat.fans = '+' + this.formatMetricNumber(fansNum + addFans);

      if (keyMap[key]) {
        row[key] = {
          views: this.formatMetricNumber(addViews),
          likes: this.formatMetricNumber(addLikes)
        };
      }

      const disc = (MockData.discover.matrixStats.platforms || []).find(p => p.name === plat.name);
      if (disc) {
        disc.views = plat.views;
        disc.count = plat.views;
        disc.likes = plat.likes;
        disc.income = plat.income;
      }
    });

    mx.summary.totalViews = this.formatMetricNumber(
      mx.platforms.reduce((s, p) => s + this.parseMetricNumber(p.views), 0)
    );
    mx.summary.totalLikes = this.formatMetricNumber(
      mx.platforms.reduce((s, p) => s + this.parseMetricNumber(p.likes), 0)
    );
    mx.summary.totalComments = this.formatMetricNumber(
      mx.platforms.reduce((s, p) => s + this.parseMetricNumber(p.comments), 0)
    );
    mx.summary.totalIncome = this.formatMetricNumber(
      mx.platforms.reduce((s, p) => s + this.parseMetricNumber(p.income), 0),
      true
    );

    const discStats = MockData.discover.matrixStats;
    if (discStats) {
      discStats.totalViews = mx.summary.totalViews;
      discStats.predictedIncome = mx.summary.totalIncome;
    }

    mx.workMatrix.unshift(row);
    if (mx.workMatrix.length > 8) mx.workMatrix.length = 8;
  },

  bumpOverviewStats: function({ views = 0, likes = 0, comments = 0, shares = 0, fans = 0, income = 0 } = {}) {
    const stats = MockData.analytics.overviewStats;
    if (!stats) return;
    Object.keys(stats).forEach((k) => {
      const s = stats[k];
      if (!s) return;
      if (views) s.views = this.formatMetricNumber(this.parseMetricNumber(s.views) + views);
      if (likes) s.likes = this.formatMetricNumber(this.parseMetricNumber(s.likes) + likes);
      if (comments) s.comments = this.formatMetricNumber(this.parseMetricNumber(s.comments) + comments);
      if (shares) s.shares = this.formatMetricNumber(this.parseMetricNumber(s.shares) + shares);
      if (fans) s.fans = this.formatMetricNumber(this.parseMetricNumber(s.fans) + fans);
      if (income) s.income = this.formatMetricNumber(this.parseMetricNumber(s.income) + income, true);
    });
    if (this.currentView === 'analytics' && this.activeAnalyticsDimension === '概览') {
      this.renderAnalyticsMetricCards && this.renderAnalyticsMetricCards();
    }
  },

  // =========================================================================
  // 5. 任务广场 (Tasks) 渲染与交互
  // =========================================================================
  renderTasks: function() {
    const modeTabs = document.querySelectorAll('#tasks-mode-tabs .underline-tab');
    modeTabs.forEach(tab => {
      tab.onclick = () => {
        this.setTasksMode(tab.getAttribute('data-mode'));
      };
    });

    const tTabs = document.querySelectorAll('#tasks-filter-tabs .pill-tab');
    tTabs.forEach(tab => {
      tab.onclick = () => {
        tTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeTasksPlazaCategory = tab.getAttribute('data-tcat');
        this.renderTasksPlaza();
      };
    });

    const gTabs = document.querySelectorAll('#gallery-filter-tabs .pill-tab');
    gTabs.forEach(tab => {
      tab.onclick = () => {
        gTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeGalleryCategory = tab.getAttribute('data-gcat');
        this.renderGalleryPlaza();
      };
    });

    const myTabs = document.querySelectorAll('#my-tasks-status-tabs .pill-tab');
    myTabs.forEach(tab => {
      tab.onclick = () => {
        myTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeMyTasksStatus = tab.getAttribute('data-mystatus');
        this.renderMyTasks();
      };
    });

    this.syncTaskStats();
    this.applyTasksMode();
    this.renderTasksRight();
  },

  setTasksMode: function(mode, silent) {
    if (!mode || !['hall', 'productized', 'consortium', 'gallery', 'mine'].includes(mode)) return;
    this.activeTasksMode = mode;
    this.applyTasksMode();
    this.renderTasksRight();
    if (!silent) {
      const tip = mode === 'gallery' ? '已进入作品展厅 · 精选馆'
        : mode === 'mine' ? '已打开「我的任务」台账'
        : mode === 'productized' ? '已进入校园 OPC 标品服务货架 · 48H极速交付'
        : mode === 'consortium' ? '已进入学长联合舰队 · 跨校大单组网'
        : '已切换回任务大厅';
      this.showToast(tip);
    }
  },

  applyTasksMode: function() {
    const mode = this.activeTasksMode;
    const isGallery = mode === 'gallery';
    const isMine = mode === 'mine';
    const isHall = mode === 'hall';
    const isProductized = mode === 'productized';
    const isConsortium = mode === 'consortium';

    document.querySelectorAll('#tasks-mode-tabs .underline-tab').forEach(tab => {
      tab.classList.toggle('active', tab.getAttribute('data-mode') === mode);
    });

    const hall = document.getElementById('tasks-hall-block');
    const gallery = document.getElementById('tasks-gallery-block');
    const mine = document.getElementById('tasks-mine-block');
    const productized = document.getElementById('tasks-productized-block');
    const consortium = document.getElementById('tasks-consortium-block');
    if (hall) hall.hidden = !isHall;
    if (gallery) gallery.hidden = !isGallery;
    if (mine) mine.hidden = !isMine;
    if (productized) productized.hidden = !isProductized;
    if (consortium) consortium.hidden = !isConsortium;

    const desc = document.getElementById('tasks-hero-desc');
    const actions = document.getElementById('tasks-hero-actions');
    if (desc) {
      desc.textContent = isProductized
        ? '校园 OPC 标品服务货架：48H标准化交付，平台资金全额托管，拒绝改稿扯皮'
        : isConsortium
          ? '学长联合舰队：成熟学长带队组网，协同承接 5~10 万元品牌营销大单'
          : isGallery
            ? '浏览学生优秀作品，联系制作方同学发起定向定制'
            : isMine
              ? '跟踪接单与定向定制进度，验收通过后收益进入我的资产'
              : '参与任务挑战，赢取奖励与成长；或逛标品货架、联合舰队承接商单';
    }
    if (actions) {
      if (isProductized) {
        actions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.setTasksMode('consortium')">去逛联合舰队</button>
           <button type="button" class="hero-btn-secondary" onclick="App.setTasksMode('mine')">我的任务</button>`;
      } else if (isConsortium) {
        actions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.setTasksMode('productized')">去逛标品货架</button>
           <button type="button" class="hero-btn-secondary" onclick="App.setTasksMode('mine')">我的任务</button>`;
      } else if (isGallery) {
        actions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.setTasksMode('hall')">去接任务</button>
           <button type="button" class="hero-btn-secondary" onclick="App.setTasksMode('mine')">我的任务</button>`;
      } else if (isMine) {
        actions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.setTasksMode('hall')">去接新任务</button>
           <button type="button" class="hero-btn-secondary" onclick="App.setTasksMode('gallery')">逛作品展厅</button>`;
      } else {
        actions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.setTasksMode('productized')">校园标品货架</button>
           <button type="button" class="hero-btn-secondary" onclick="App.setTasksMode('consortium')">学长联合舰队</button>`;
      }
    }

    if (isProductized) this.renderProductizedServices();
    else if (isConsortium) this.renderConsortiumTasks();
    else if (isGallery) this.renderGalleryPlaza();
    else if (isMine) this.renderMyTasks();
    else this.renderTasksPlaza();
  },

  syncTaskStats: function() {
    const orders = MockData.tasks.myOrders || [];
    const active = orders.filter(o => o.status === '进行中' || o.status === '待验收').length;
    const finishedInLedger = orders.filter(o => o.status === '已完成').length;
    // 「累计完成」= 历史累计基数 + 当前台账已完成（初始仍为 12）
    const finished = (MockData.currentUser.finishedTasksBase || 11) + finishedInLedger;
    MockData.currentUser.activeTasks = active;
    MockData.currentUser.finishedTasks = finished;

    const activeEl = document.getElementById('my-active-tasks-count');
    const finishedEl = document.getElementById('my-finished-tasks-count');
    if (activeEl) activeEl.innerText = active;
    if (finishedEl) finishedEl.innerText = finished;
  },

  renderMyTasks: function() {
    const container = document.getElementById('tasks-mine-list-container');
    if (!container) return;
    if (!MockData.tasks.myOrders) MockData.tasks.myOrders = [];

    let list = [...MockData.tasks.myOrders];
    if (this.activeMyTasksStatus && this.activeMyTasksStatus !== '全部') {
      list = list.filter(o => o.status === this.activeMyTasksStatus);
    }

    if (list.length === 0) {
      container.innerHTML = `<div class="gallery-empty">暂无该状态的任务，去任务大厅接单或在展厅发起定制吧</div>`;
      return;
    }

    container.innerHTML = list.map(o => {
      const roleTag = o.role === 'buyer' ? '我发起的定制' : (o.type === 'custom' ? '定向商单' : '广场接单');
      const statusClass = o.status === '已完成' ? 'is-done' : (o.status === '待验收' ? 'is-review' : 'is-active');
      let actions = '';
      if (o.status === '进行中') {
        if (o.role === 'buyer') {
          actions = `<button type="button" class="btn-apply-task" onclick="App.submitMyTaskDelivery('${o.id}')">标记已交付</button>`;
        } else {
          actions = `<button type="button" class="btn-apply-task" onclick="App.submitMyTaskDelivery('${o.id}')">提交交付</button>`;
        }
      } else if (o.status === '待验收') {
        actions = `<button type="button" class="btn-apply-task" onclick="App.acceptMyTaskDelivery('${o.id}')">确认验收</button>`;
      } else {
        if (o.role === 'creator' && !o.listedToGallery) {
          actions = `<button type="button" class="btn-apply-task" onclick="App.listOrderToGallery('${o.id}')">上架展厅</button>`;
        } else {
          actions = `<button type="button" class="btn-apply-task applied" disabled>${o.listedToGallery ? '已上架' : '已完成'}</button>`;
        }
      }

      return `
        <div class="task-plaza-card tasks-mine-card">
          <div class="task-card-cover-wrap">
            <img src="${o.cover}" alt="${o.title}" class="task-card-cover-img">
            <span class="task-cover-badge ${o.status === '已完成' ? 'badge-green' : ''}">${o.status}</span>
          </div>
          <div class="task-card-main">
            <div class="task-title-wrap">
              <span class="task-card-title">${o.title}</span>
            </div>
            <div class="task-card-desc">${o.desc || ''}</div>
            <div class="task-tags-row">
              <span class="task-tag-pill">${roleTag}</span>
              ${(o.tags || []).map(tag => `<span class="task-tag-pill">${tag}</span>`).join('')}
            </div>
            <div class="task-card-meta">
              <span class="task-meta-item">合作方：${o.counterpart || '平台'}</span>
              <span class="task-meta-item">${o.deadline || ''}</span>
            </div>
          </div>
          <div class="task-card-right-action">
            <div class="task-reward-box">
              ${o.rewardMoney ? `<div class="task-reward-cash">${o.rewardMoney}<span class="task-reward-cash-label"> 托管金额</span></div>` : ''}
              <span class="tasks-mine-status ${statusClass}">${o.status}</span>
              ${actions}
            </div>
          </div>
        </div>
      `;
    }).join('');
  },

  renderTasksPlaza: function() {
    const container = document.getElementById('tasks-plaza-list-container');
    if (!container) return;

    let list = [...MockData.tasks.list];
    if (this.activeTasksPlazaCategory !== '全部任务') {
      if (this.activeTasksPlazaCategory === '热门任务') {
        list = list.filter(t => t.badge === '热门');
      } else {
        list = list.filter(t => t.category === this.activeTasksPlazaCategory || t.tags.includes(this.activeTasksPlazaCategory));
      }
      if (list.length === 0) list = MockData.tasks.list;
    }

    // 排序逻辑
    if (this.activeTasksPlazaSort === 'high-reward') {
      list.sort((a, b) => (parseInt(String(b.rewardMoney || '').replace(/[^\d]/g, ''), 10) || 0) - (parseInt(String(a.rewardMoney || '').replace(/[^\d]/g, ''), 10) || 0));
    } else if (this.activeTasksPlazaSort === 'deadline-soon') {
      const toTime = (t) => {
        const d = t.deadlineDate || '';
        const ts = Date.parse(d.replace(/-/g, '/'));
        return Number.isFinite(ts) ? ts : Number.MAX_SAFE_INTEGER;
      };
      list.sort((a, b) => toTime(a) - toTime(b));
    } else if (this.activeTasksPlazaSort === 'most-applied') {
      const toCount = (t) => {
        const s = String(t.participants || '');
        if (s.includes('万')) return (parseFloat(s) || 0) * 10000;
        return parseInt(s.replace(/[^\d]/g, ''), 10) || 0;
      };
      list.sort((a, b) => toCount(b) - toCount(a));
    }

    const usersIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
    const clockIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
    const coinIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M9.5 10.5c.5-.8 1.4-1.3 2.5-1.3 1.7 0 3 1 3 2.3s-1.3 2.3-3 2.3c-1.1 0-2-.5-2.5-1.3"/></svg>`;

    container.innerHTML = list.map(t => `
      <div class="task-plaza-card">
        <div class="task-card-cover-wrap">
          <img src="${t.cover}" alt="${t.title}" class="task-card-cover-img">
          ${t.badge ? `<span class="task-cover-badge ${t.badgeColor === 'green' ? 'badge-green' : ''}">${t.badge}</span>` : ''}
        </div>
        <div class="task-card-main">
          <div class="task-title-wrap">
            <span class="task-card-title">${t.title}</span>
          </div>
          <div class="task-card-desc">${t.desc}</div>
          <div class="task-tags-row">
            ${t.tags.map(tag => `<span class="task-tag-pill">${tag}</span>`).join('')}
          </div>
          <div class="task-card-meta">
            <span class="task-meta-item">${usersIcon} ${t.participants}</span>
            <span class="task-meta-item">${clockIcon} 截止 ${t.deadlineDate || t.deadline || '待定'}</span>
          </div>
        </div>

        <div class="task-card-right-action">
          <div class="task-reward-box">
            ${t.rewardMoney ? `<div class="task-reward-cash">${t.rewardMoney}<span class="task-reward-cash-label"> 现金奖励</span></div>` : ''}
            ${t.rewardPoints ? `<div class="task-reward-points">${coinIcon} ${t.rewardPoints} 创作积分</div>` : ''}
            <button class="btn-apply-task ${t.status === '进行中' || t.status === '已完成' ? 'applied' : ''}"
              ${t.status === '已完成' ? 'disabled' : ''}
              onclick="${t.status === '已完成' ? `App.showToast('该任务已完成验收')` : `App.openTaskApplyModal('${t.id}')`}">
              ${t.status === '进行中' ? '已参与' : (t.status === '已完成' ? '已完成' : '立即参与')}
            </button>
          </div>
        </div>
      </div>
    `).join('');
  },

  renderGalleryPlaza: function() {
    const grid = document.getElementById('gallery-works-grid');
    const intro = document.getElementById('gallery-intro-text');
    const gallery = MockData.tasks.gallery;
    if (!grid || !gallery) return;

    if (intro) intro.textContent = gallery.intro || '';

    let list = [...(gallery.works || [])];
    const cat = this.activeGalleryCategory;
    if (cat === '可接单') {
      list = list.filter(w => w.available);
    } else if (cat && cat !== '全部') {
      list = list.filter(w => w.category === cat || (w.tags || []).includes(cat));
    }

    const parseViews = (v) => {
      if (!v) return 0;
      if (String(v).includes('万')) return parseFloat(v) * 10000;
      return parseInt(String(v).replace(/[^\d]/g, ''), 10) || 0;
    };
    const parsePrice = (p) => parseInt(String(p || '').replace(/[^\d]/g, ''), 10) || 0;

    if (this.activeGallerySort === 'hot') {
      list.sort((a, b) => parseViews(b.views) - parseViews(a.views));
    } else if (this.activeGallerySort === 'price-asc') {
      list.sort((a, b) => parsePrice(a.priceRange) - parsePrice(b.priceRange));
    } else if (this.activeGallerySort === 'latest') {
      list = list.slice().reverse();
    } else {
      const creatorLv = (w) => parseInt(String((w.creator && w.creator.level) || '').replace(/[^\d]/g, ''), 10) || 0;
      const rank = (w) => {
        // Lv.4+ 商业创作者展厅优先加权
        if (w.weightBoost || creatorLv(w) >= 4) return -1;
        if (w.badge === '精选' || w.badge === '榜单入选') return 0;
        if (w.badge === '学院认证') return 1;
        if (w.available) return 2;
        return 3;
      };
      list.sort((a, b) => rank(a) - rank(b) || parseViews(b.views) - parseViews(a.views));
    }

    if (list.length === 0) {
      grid.innerHTML = `<div class="gallery-empty">该筛选下暂无展厅作品，试试切换品类或查看「可接单」</div>`;
      return;
    }

    grid.innerHTML = list.map(w => {
      const c = w.creator || {};
      const playIcon = `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg>`;
      return `
        <article class="gallery-work-card">
          <div class="gallery-work-cover-wrap" onclick="App.openPreviewLightbox('${w.cover}', '${w.title}')">
            <img src="${w.cover}" alt="${w.title}" class="gallery-work-cover">
            ${w.badge ? `<span class="gallery-work-badge">${w.badge}</span>` : ''}
            <button type="button" class="gallery-play-btn" aria-label="播放作品">${playIcon}</button>
            <div class="gallery-work-stats">
              <span>${w.views} 播放</span>
              <span>${w.likes} 赞</span>
            </div>
          </div>
          <div class="gallery-work-body">
            <div class="gallery-title-row">
              <h3 class="gallery-work-title" title="${w.title}">${w.title}</h3>
              <div class="gallery-work-tags">
                <span class="gallery-tag">${w.category}</span>
                <span class="gallery-tag is-muted">${w.scene}</span>
                <span class="gallery-tag is-source">${w.source}</span>
              </div>
            </div>
            <div class="gallery-work-footer">
              <div class="gallery-footer-top">
                <div class="gallery-creator-row">
                  <img src="${c.avatar}" alt="${c.name}" class="gallery-creator-avatar">
                  <div class="gallery-creator-meta">
                    <div class="gallery-creator-name">
                      <span class="gallery-creator-name-text">${c.name}</span>
                      <span class="gallery-creator-lv">${c.level || ''}</span>
                    </div>
                    <div class="gallery-creator-chips">
                      <span>${c.school || ''}</span>
                      <span>交付 ${w.delivered || 0} 单</span>
                      <span>${w.cycle || ''}</span>
                    </div>
                  </div>
                </div>
                <div class="gallery-price">
                  <span class="gallery-price-label">参考报价</span>
                  <strong>${w.priceRange}</strong>
                </div>
              </div>
              <div class="gallery-work-actions">
                <button type="button" class="gallery-btn-secondary" onclick="event.stopPropagation(); App.openCreatorProfile('${c.name}')">看创作者</button>
                <button type="button" class="gallery-btn-primary ${w.available ? '' : 'is-disabled'}"
                  onclick="${w.available ? `App.openGalleryCustomModal('${w.id}')` : `App.showToast('该同学暂未开放接单')`}">
                  ${w.available ? '找 TA 定制' : '暂不可约'}
                </button>
              </div>
            </div>
          </div>
        </article>
      `;
    }).join('');
  },

  renderTasksRight: function() {
    const todayRec = document.getElementById('tasks-today-rec-container');
    const recTitle = document.getElementById('tasks-side-rec-title');
    const recMore = document.getElementById('tasks-side-rec-more');
    const isGallery = this.activeTasksMode === 'gallery';

    if (recTitle) recTitle.textContent = isGallery ? '展厅热门' : '今日推荐任务';
    if (recMore) {
      recMore.onclick = () => {
        if (isGallery) {
          this.setTasksMode('gallery');
          this.showToast('已定位至作品展厅精选列表');
        } else {
          this.showToast('已刷新今日算法推荐任务');
        }
      };
    }

    if (todayRec) {
      if (isGallery) {
        const works = (MockData.tasks.gallery && MockData.tasks.gallery.works || []).slice(0, 3);
        todayRec.innerHTML = works.map(w => `
          <div class="tasks-rec-item" onclick="App.openGalleryCustomModal('${w.id}')">
            <img src="${w.cover}" alt="${w.title}" class="tasks-rec-thumb">
            <div class="tasks-rec-content">
              <div class="tasks-rec-title">${w.title}</div>
              <div class="tasks-rec-tags">
                <span class="rec-task-sub">${w.category}</span>
                <span class="rec-task-sub">${w.creator ? w.creator.name : ''}</span>
              </div>
              <div class="tasks-rec-meta">
                <span class="tasks-rec-meta-item">${w.views} 播放</span>
                <span class="tasks-rec-meta-item">${w.available ? '可接单' : '暂不可约'}</span>
              </div>
            </div>
            <div class="tasks-rec-aside">
              <div class="tasks-rec-price">${w.priceRange}</div>
              <div class="tasks-rec-deadline">${w.cycle || ''}</div>
            </div>
          </div>
        `).join('');
      } else {
        const usersIcon = typeof Icons !== 'undefined' ? Icons.line('users', 12) : '';
        const clockIcon = typeof Icons !== 'undefined' ? Icons.line('clock', 12) : '';
        todayRec.innerHTML = MockData.tasks.todayRec.map(t => `
          <div class="tasks-rec-item" onclick="App.openTaskApplyModal('${t.id}')">
            <img src="${t.cover}" alt="${t.title}" class="tasks-rec-thumb">
            <div class="tasks-rec-content">
              <div class="tasks-rec-title">${t.title}</div>
              <div class="tasks-rec-tags">
                ${(t.tags || []).map(tag => `<span class="rec-task-sub">${tag}</span>`).join('')}
              </div>
              <div class="tasks-rec-meta">
                <span class="tasks-rec-meta-item">${usersIcon} ${t.participants || ''}</span>
                <span class="tasks-rec-meta-item">${clockIcon} ${t.deadlineDate || '待定'}</span>
              </div>
            </div>
            <div class="tasks-rec-aside">
              <div class="tasks-rec-price">${t.reward}</div>
              <div class="tasks-rec-deadline">${t.deadline || ''}</div>
            </div>
          </div>
        `).join('');
      }
    }

    const lb = document.getElementById('tasks-leaderboard-list');
    if (lb) {
      lb.innerHTML = MockData.tasks.ranksWeek.map(u => `
        <div class="tasks-rank-item">
          <span class="rank-num-badge ${u.rank <= 3 ? 'top-' + u.rank : 'plain'}">${u.rank}</span>
          <img src="${u.avatar}" alt="${u.name}" class="tasks-rank-avatar">
          <div class="tasks-rank-name">${u.name}</div>
          <div class="tasks-rank-metric"><span class="lbl">完成任务</span><strong>${u.taskCount}</strong></div>
          <div class="tasks-rank-metric"><span class="lbl">积分</span><strong>${u.points}</strong></div>
        </div>
      `).join('');
    }
  },

  openTaskApplyModal: function(taskId) {
    this.currentApplyingTaskId = taskId;
    const task = MockData.tasks.list.find(t => t.id === taskId) || MockData.tasks.todayRec.find(t => t.id === taskId);
    if (!task) return;
    if (task.status === '已完成') {
      this.showToast('该任务已完成验收');
      return;
    }
    if (task.status === '进行中') {
      this.showToast('你已参与该任务，可在「我的任务」查看进度');
      this.setTasksMode('mine', true);
      return;
    }
    document.getElementById('modal-task-title').innerText = task.title;
    document.getElementById('modal-task-reward').innerText = task.rewardMoney || task.reward || '¥ 2,000';
    document.getElementById('modal-task-deadline').innerText = task.deadlineDate || task.deadline || '待定';
    this.openModal('modal-task-apply');
  },

  confirmTaskApply: function() {
    const task = MockData.tasks.list.find(t => t.id === this.currentApplyingTaskId)
      || MockData.tasks.todayRec.find(t => t.id === this.currentApplyingTaskId);
    if (!task) return;

    if (!this.canTakeBasicTasks()) {
      this.showToast('需达到 Lv.3 内容创作者后，才能承接基础任务');
      return;
    }
    if (this.isHighRewardTask(task) && !this.canTakeCommercialTasks()) {
      this.showToast('高赏金/品牌商单需 Lv.4 商业创作者解锁');
      return;
    }

    if (task.id && MockData.tasks.list.find(t => t.id === task.id)) {
      const plaza = MockData.tasks.list.find(t => t.id === task.id);
      plaza.status = '进行中';
      plaza.badge = '进行中';
      plaza.badgeColor = 'green';
    }

    if (!MockData.tasks.myOrders) MockData.tasks.myOrders = [];
    const exists = MockData.tasks.myOrders.some(o => o.sourceId === task.id && o.status !== '已完成');
    if (!exists) {
      const amount = parseInt(String(task.rewardMoney || task.reward || '2000').replace(/[^\d]/g, ''), 10) || 2000;
      MockData.tasks.myOrders.unshift({
        id: 'MO' + Date.now(),
        role: 'creator',
        type: 'plaza',
        sourceId: task.id,
        title: task.title,
        desc: task.desc || '任务广场接单，平台托管结算',
        cover: task.cover || 'assets/covers/task_main_1.png',
        rewardMoney: task.rewardMoney || task.reward || '¥ 2,000',
        rewardAmount: amount,
        rewardPoints: task.rewardPoints || '',
        status: '进行中',
        tags: task.tags || [],
        deadline: task.deadline || '协商截止',
        counterpart: '官方任务',
        createdAt: '刚刚'
      });
    }

    this.syncTaskStats();
    this.closeModal('modal-task-apply');
    this.renderTasksPlaza();
    this.setTasksMode('mine', true);
    const tip = this.isHighRewardTask(task) ? '✅ 高赏金商单接单成功！' : '✅ 接单成功！已加入「我的任务」进行中';
    this.showToast(tip);
  },

  openGalleryCustomModal: function(workId) {
    const work = (MockData.tasks.gallery && MockData.tasks.gallery.works || []).find(w => w.id === workId);
    if (!work) return;
    if (!work.available) {
      this.showToast('该同学暂未开放接单');
      return;
    }

    this.currentGalleryWorkId = workId;
    const c = work.creator || {};
    document.getElementById('modal-gallery-title').innerText = `找 ${c.name || 'TA'} 定制`;
    document.getElementById('modal-gallery-sub').innerText = `参考作品《${work.title}》· ${work.priceRange} · ${work.cycle || ''}`;

    const box = document.getElementById('modal-gallery-creator');
    if (box) {
      box.innerHTML = `
        <img src="${work.cover}" alt="" class="gallery-custom-thumb">
        <div class="gallery-custom-info">
          <div class="gallery-custom-work">${work.title}</div>
          <div class="gallery-custom-person">
            <img src="${c.avatar}" alt="">
            <span>${c.name} · ${c.school} · ${c.level || ''}</span>
          </div>
          <div class="gallery-custom-meta">近期交付 ${work.delivered || 0} 单 · 周期 ${work.cycle || '协商'} · ${work.source || ''}</div>
        </div>
      `;
    }

    const brief = document.getElementById('gallery-custom-brief');
    if (brief) brief.value = `希望参考《${work.title}》的风格与完成度，定制同类型作品。`;

    this.openModal('modal-gallery-custom');
  },

  confirmGalleryCustom: function() {
    const work = (MockData.tasks.gallery && MockData.tasks.gallery.works || []).find(w => w.id === this.currentGalleryWorkId);
    const brief = (document.getElementById('gallery-custom-brief') || {}).value || '';
    if (!brief.trim()) {
      this.showToast('请先填写需求简述');
      return;
    }
    if (!work) return;

    const budgetEl = document.getElementById('gallery-custom-budget');
    const deadlineEl = document.getElementById('gallery-custom-deadline');
    const budgetText = budgetEl ? budgetEl.options[budgetEl.selectedIndex].text : '¥1,000-3,000';
    let amount = 2000;
    if (/面议/.test(budgetText)) amount = 2000;
    else if (/5,000\+/.test(budgetText) || /5000\+/.test(budgetText)) amount = 5000;
    else {
      const nums = String(budgetText).match(/\d[\d,]*/g) || [];
      amount = parseInt(String(nums[0] || '2000').replace(/,/g, ''), 10) || 2000;
    }
    const c = work.creator || {};

    if (!this.freezeEscrow(amount, `定制托管 · ${c.name || '创作者'}`)) return;

    if (!MockData.tasks.myOrders) MockData.tasks.myOrders = [];
    MockData.tasks.myOrders.unshift({
      id: 'MO' + Date.now(),
      role: 'buyer',
      type: 'custom',
      sourceId: work.id,
      title: `定制 · ${work.title}`,
      desc: brief.trim(),
      cover: work.cover,
      rewardMoney: '¥ ' + amount.toLocaleString('zh-CN'),
      rewardAmount: amount,
      rewardPoints: '',
      status: '进行中',
      tags: ['定向定制', work.category].filter(Boolean),
      deadline: deadlineEl ? deadlineEl.options[deadlineEl.selectedIndex].text : '7 天内',
      counterpart: c.name || '创作者',
      createdAt: '刚刚',
      escrowFrozen: true,
      listedToGallery: false
    });

    this.syncTaskStats();
    this.closeModal('modal-gallery-custom');
    this.closeModal('modal-creator-profile');
    this.setTasksMode('mine', true);
    this.showToast(`✅ 已托管 ¥ ${amount.toLocaleString('zh-CN')}，定制单已进入「我的任务」`);
  },

  // 渲染校园 OPC 标品服务货架
  renderProductizedServices: function() {
    const container = document.getElementById('productized-services-container');
    if (!container) return;
    const items = (MockData.tasks && MockData.tasks.productizedServices) || [];
    container.innerHTML = items.map(p => `
      <div class="productized-card" onclick="App.orderProductizedService('${p.id}')">
        <div class="productized-top">
          <img src="${p.cover}" alt="" class="productized-cover">
          <div class="productized-info">
            <div class="productized-header-row">
              <span class="productized-title">${p.title}</span>
              <span class="productized-delivery-tag">${p.deliveryDays}</span>
            </div>
            <div class="productized-author-row">
              <img src="${p.authorAvatar}" class="productized-author-avatar" alt="">
              <span>${p.studio} · ${p.author} (${p.school})</span>
              <span style="color:#F59E0B; margin-left:auto; font-weight:700;">★ ${p.rating}</span>
            </div>
            <div class="productized-deliverables">
              ${p.deliverables.map(d => `<div class="productized-deliverable-item">✓ ${d}</div>`).join('')}
            </div>
          </div>
        </div>
        <div class="productized-bottom-row">
          <div class="productized-price-wrap">
            <span class="productized-price">${p.price}</span>
            <span class="productized-sales">/ 已交付 ${p.salesCount}</span>
          </div>
          <button class="productized-btn-order" onclick="event.stopPropagation(); App.orderProductizedService('${p.id}')">一键下单定制</button>
        </div>
      </div>
    `).join('');
  },

  orderProductizedService: function(id) {
    const p = ((MockData.tasks && MockData.tasks.productizedServices) || []).find(item => item.id === id);
    if (!p) return;
    this.showToast(`🛡️ 平台资金已预先安全托管！已为《${p.title}》发起定制，48H标准时效保障。`);
  },

  // 渲染学长联合舰队大单
  renderConsortiumTasks: function() {
    const container = document.getElementById('consortium-tasks-container');
    if (!container) return;
    const items = (MockData.tasks && MockData.tasks.consortiumTasks) || [];
    container.innerHTML = items.map(c => `
      <div class="consortium-card">
        <div class="consortium-header">
          <div>
            <div class="consortium-brand">${c.brand} · ${c.period}</div>
            <div class="consortium-title">${c.title}</div>
          </div>
          <div class="consortium-budget-wrap">
            <div class="consortium-budget-lbl">总赏金池</div>
            <div class="consortium-budget-val">${c.budget}</div>
          </div>
        </div>
        <div class="consortium-brief">${c.brief}</div>
        <div class="consortium-roles-row">
          ${c.roles.map(r => `
            <div class="consortium-role-chip">
              <strong>${r.role}</strong>
              <span>${r.count}</span>
              <span class="${r.status === '已就位' ? 'role-status-full' : 'role-status-open'}">${r.status} (${r.reward})</span>
            </div>
          `).join('')}
        </div>
        <div class="consortium-footer-row">
          <div class="consortium-leader-info">
            <img src="${c.leaderAvatar}" class="consortium-leader-avatar" alt="">
            <span>舰队领航：<strong>${c.leader}</strong></span>
            <span class="badge-mini-pink" style="margin-left:8px;">${c.progress}</span>
          </div>
          <button class="consortium-btn-join" onclick="App.joinConsortiumTask('${c.id}')">申请加入席位</button>
        </div>
      </div>
    `).join('');
  },

  joinConsortiumTask: function(id) {
    const c = ((MockData.tasks && MockData.tasks.consortiumTasks) || []).find(item => item.id === id);
    if (!c) return;
    this.showToast(`🚀 已向领航学长提交加入申请！审核通过后将统一纳入《${c.title}》虚拟作战室。`);
  },

  // 渲染 OPC 商业交付流水线
  renderCommercialWorkflows: function() {
    const container = document.getElementById('commercial-workflows-grid');
    if (!container) return;
    const workflows = (MockData.tools && MockData.tools.commercialWorkflows) || [];
    container.innerHTML = workflows.map(w => `
      <div class="workflow-card" onclick="App.openAIWorkbench('${w.title}')">
        <div class="wf-icon-box" style="background:${w.color}15; color:${w.color};">
          ${w.icon === 'shopping-bag' ? '🛍️' : w.icon === 'film' ? '🎬' : w.icon === 'globe' ? '🌐' : '👤'}
        </div>
        <div class="wf-content">
          <div class="wf-title-row">
            <span class="wf-title">${w.title}</span>
            <span class="wf-badge">${w.badge}</span>
          </div>
          <div class="wf-desc">${w.desc}</div>
          <div class="wf-meta-row">
            <span class="wf-cost">${w.gpuCost}</span>
            <span style="color:#4F46E5; font-weight:600;">⚡ ${w.timeSaved}</span>
          </div>
        </div>
      </div>
    `).join('');
  },

  freezeEscrow: function(amount, label) {
    amount = Number(amount) || 0;
    if (amount <= 0) return true;
    let bal = parseFloat(String(MockData.assets.cards.balance).replace(/,/g, '')) || 0;
    if (amount > bal) {
      this.showToast('账户余额不足，无法完成平台托管冻结');
      return false;
    }
    bal -= amount;
    MockData.assets.cards.balance = bal.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    const wd = Math.max(0, (parseFloat(String(MockData.assets.cards.withdrawable).replace(/,/g, '')) || 0) - amount);
    MockData.assets.cards.withdrawable = wd.toLocaleString('zh-CN', { minimumFractionDigits: 2 });

    const freezeItem = (MockData.assets.breakdown.items || []).find(it => it.label === '冻结金额');
    if (freezeItem) {
      freezeItem.value = (freezeItem.value || 0) + amount;
      freezeItem.amount = '¥ ' + freezeItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }
    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = Math.max(0, (availItem.value || 0) - amount);
      availItem.amount = '¥ ' + availItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '支出',
      name: label || '定制商单资金托管冻结',
      amount: `- ¥ ${amount.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}`,
      rawAmount: -amount,
      status: '托管中',
      statusType: 'done',
      time: '刚刚',
      category: '支出'
    });

    this.refreshAssetDisplays();
    return true;
  },

  releaseEscrow: function(amount, label) {
    amount = Number(amount) || 0;
    if (amount <= 0) return;
    const freezeItem = (MockData.assets.breakdown.items || []).find(it => it.label === '冻结金额');
    if (freezeItem) {
      freezeItem.value = Math.max(0, (freezeItem.value || 0) - amount);
      freezeItem.amount = '¥ ' + freezeItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }
    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '支出',
      name: label || '定制托管解冻并结算给创作者',
      amount: `托管划转 ¥ ${amount.toLocaleString('zh-CN')}`,
      rawAmount: 0,
      status: '已结算',
      statusType: 'done',
      time: '刚刚',
      category: '支出'
    });
    this.refreshAssetDisplays();
  },

  creditCreatorIncome: function(amount, label) {
    amount = Number(amount) || 0;
    if (amount <= 0) return;
    let bal = parseFloat(String(MockData.assets.cards.balance).replace(/,/g, '')) || 0;
    bal += amount;
    MockData.assets.cards.balance = bal.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    const wd = (parseFloat(String(MockData.assets.cards.withdrawable).replace(/,/g, '')) || 0) + amount;
    MockData.assets.cards.withdrawable = wd.toLocaleString('zh-CN', { minimumFractionDigits: 2 });

    const incomeItem = (MockData.assets.breakdown.items || []).find(it => it.label === '创作收益');
    if (incomeItem) {
      incomeItem.value = (incomeItem.value || 0) + amount;
      incomeItem.amount = '¥ ' + incomeItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }
    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = (availItem.value || 0) + amount;
      availItem.amount = '¥ ' + availItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '收入',
      name: label || '任务验收入账',
      amount: `+ ¥ ${amount.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}`,
      rawAmount: amount,
      status: '已到账',
      statusType: 'success',
      time: '刚刚',
      category: '收入'
    });

    this.bumpOverviewStats({ income: amount, fans: 30 });
    this.refreshAssetDisplays();
  },

  refreshAssetDisplays: function() {
    const balEl = document.getElementById('asset-display-balance');
    if (balEl) balEl.innerText = '¥ ' + MockData.assets.cards.balance;
    const wdEl = document.getElementById('asset-display-withdrawable');
    if (wdEl) wdEl.innerText = '¥ ' + MockData.assets.cards.withdrawable;
    if (typeof this.renderTransactionsTable === 'function') this.renderTransactionsTable();
    if (typeof this.renderAssetsCharts === 'function') this.renderAssetsCharts();
  },

  submitMyTaskDelivery: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order || order.status !== '进行中') return;
    order.status = '待验收';
    this.syncTaskStats();
    this.renderMyTasks();
    this.showToast(order.role === 'buyer' ? '对方已提交交付，请确认验收' : '已提交交付，等待平台/甲方验收');
  },

  acceptMyTaskDelivery: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order || order.status !== '待验收') return;
    if (order.settled) {
      this.showToast('该笔订单已入账');
      return;
    }

    const amount = Number(order.rewardAmount) || 0;
    order.status = '已完成';
    order.settled = true;

    if (order.role === 'buyer' && order.escrowFrozen) {
      this.releaseEscrow(amount, `定制结算给 ${order.counterpart || '创作者'} · ${order.title}`);
      order.escrowFrozen = false;
      this.syncTaskStats();
      this.renderMyTasks();
      this.showToast('✅ 验收通过，托管资金已结算给创作者');
      return;
    }

    if (amount > 0 && order.role === 'creator') {
      this.creditCreatorIncome(amount, `任务验收入账 · ${order.title}`);
    }

    this.syncTaskStats();
    this.renderMyTasks();
    if (order.role === 'creator' && amount > 0) {
      this.showToast(`🎉 验收通过！¥ ${amount.toLocaleString('zh-CN')} 已入账，可选择上架展厅`);
    } else {
      this.showToast('✅ 订单已完成验收');
    }
  },

  listOrderToGallery: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order || order.status !== '已完成') return;
    if (order.listedToGallery) {
      this.showToast('该作品已在展厅中');
      return;
    }
    if (!MockData.tasks.gallery) return;
    const lv = this.getUserLevel();
    const id = 'GW' + Date.now();
    MockData.tasks.gallery.works.unshift({
      id,
      title: order.title.replace(/^定制 · /, ''),
      cover: order.cover || 'assets/covers/gallery/gallery_01.jpg',
      category: (order.tags && order.tags[1]) || 'AI短视频',
      scene: '刚交付',
      badge: lv >= 4 ? '精选' : '刚交付',
      weightBoost: lv >= 4,
      views: '1,280',
      likes: '168',
      priceRange: order.rewardMoney || '¥1,000-3,000',
      cycle: '5-7 天',
      delivered: 1,
      tags: order.tags || ['交付作品'],
      source: '任务优质交付',
      available: true,
      creator: {
        name: MockData.currentUser.name,
        school: MockData.currentUser.school,
        level: 'Lv.' + lv,
        avatar: MockData.currentUser.avatarLarge || MockData.currentUser.avatar
      }
    });
    order.listedToGallery = true;
    this.renderMyTasks();
    this.showToast(lv >= 4
      ? '已上架作品展厅 · Lv.4 商业创作者加权优先展示'
      : '已上架作品展厅 · 精选馆');
    this.setTasksMode('gallery', true);
  },

  filterTasks: function(status) {
    this.activeMyTasksStatus = status === '进行中' || status === '待验收' || status === '已完成' ? status : '全部';
    document.querySelectorAll('#my-tasks-status-tabs .pill-tab').forEach(tab => {
      tab.classList.toggle('active', tab.getAttribute('data-mystatus') === this.activeMyTasksStatus);
    });
    this.setTasksMode('mine', true);
    this.showToast(`已打开「我的任务」· ${this.activeMyTasksStatus}`);
  },

  openTaskModal: function(taskId) {
    this.navigateTo('tasks');
    setTimeout(() => this.openTaskApplyModal(taskId), 30);
  },

  // =========================================================================
  // 6. 数据中心 (Analytics) 渲染与图表交互
  // =========================================================================
  renderAnalytics: function() {
    // 维度 Tab
    const dimTabs = document.querySelectorAll('#analytics-dimension-tabs .underline-tab');
    dimTabs.forEach(tab => {
      tab.onclick = () => {
        dimTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeAnalyticsDimension = tab.getAttribute('data-dimension');
        this.applyAnalyticsDimension();
        this.showToast(`已切换数据分析维度：${this.activeAnalyticsDimension}`);
      };
    });

    // 时间粒度 Tab (7天/30天/90天)
    const timeTabs = document.querySelectorAll('#analytics-timeframe-tabs .pill-tab');
    timeTabs.forEach(tab => {
      tab.onclick = () => {
        timeTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeAnalyticsTime = tab.getAttribute('data-time');
        this.applyAnalyticsDimension();
      };
    });

    this.syncAnalyticsDimensionTabs();
    this.applyAnalyticsDimension();
    this.renderAnalyticsRight();
    this.renderAnalyticsCharts();
  },

  syncAnalyticsDimensionTabs: function() {
    document.querySelectorAll('#analytics-dimension-tabs .underline-tab').forEach(tab => {
      tab.classList.toggle('active', tab.getAttribute('data-dimension') === this.activeAnalyticsDimension);
    });
  },

  applyAnalyticsDimension: function() {
    const overview = document.getElementById('analytics-overview-block');
    const matrix = document.getElementById('analytics-matrix-block');
    const dimBlock = document.getElementById('analytics-dim-block');
    const dim = this.activeAnalyticsDimension;
    const isOverview = dim === '概览';
    const isMatrix = dim === '矩阵分发';
    const isDimPanel = !isOverview && !isMatrix;

    if (overview) overview.hidden = !isOverview;
    if (matrix) matrix.hidden = !isMatrix;
    if (dimBlock) dimBlock.hidden = !isDimPanel;

    if (isMatrix) {
      this.renderMatrixDistribution();
    } else if (isDimPanel) {
      this.renderAnalyticsDimPanel(dim);
    } else {
      this.renderAnalyticsMetricCards();
      this.renderAnalyticsCharts();
    }
  },

  renderAnalyticsDimPanel: function(dim) {
    const a = MockData.analytics || {};
    const map = {
      '内容分析': a.contentAnalysis,
      '用户分析': a.userAnalysis,
      '收益分析': a.incomeAnalysis,
      '创作表现': a.creationPerformance
    };
    const data = map[dim];
    const host = document.getElementById('analytics-dim-block');
    if (!host || !data) return;

    const timeLabel = ({ '7d': '近 7 天', '30d': '近 30 天', '90d': '近 90 天', custom: '自定义区间' })[this.activeAnalyticsTime] || '近 30 天';

    const summaryHtml = (data.summary || []).map((s) => `
      <div class="analytics-dim-stat">
        <div class="analytics-dim-stat-label">${s.label}</div>
        <div class="analytics-dim-stat-value">${s.val}</div>
        <div class="analytics-dim-stat-sub">${s.sub || ''}</div>
      </div>
    `).join('');

    let middleHtml = '';
    let tableHtml = '';

    if (dim === '内容分析') {
      middleHtml = `
        <div class="card-section">
          <div class="section-header">
            <span class="section-title">内容品类表现</span>
            <span class="analytics-dim-range-hint">${timeLabel}</span>
          </div>
          <div class="analytics-dim-bars">
            ${(data.categories || []).map((c) => `
              <div class="analytics-dim-bar-row">
                <span class="analytics-dim-bar-name">${c.name}</span>
                <div class="analytics-dim-bar-track">
                  <div class="analytics-dim-bar-fill" style="width:${c.share}%;background:${c.color};"></div>
                </div>
                <span class="analytics-dim-bar-meta">${c.share}% · ${c.works} 篇 · ${c.views}</span>
              </div>
            `).join('')}
          </div>
        </div>`;
      tableHtml = `
        <div class="card-section">
          <div class="section-header"><span class="section-title">内容表现排行</span></div>
          <div class="analytics-dim-table-wrap">
            <table class="matrix-work-table analytics-dim-table">
              <thead><tr><th>作品</th><th>类型</th><th>播放</th><th>点赞</th><th>互动率</th></tr></thead>
              <tbody>
                ${(data.ranking || []).map((w) => `
                  <tr>
                    <td class="matrix-work-title">${w.title}</td>
                    <td>${w.type}</td>
                    <td>${w.views}</td>
                    <td>${w.likes}</td>
                    <td>${w.rate}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>`;
    } else if (dim === '用户分析') {
      middleHtml = `
        <div class="card-section">
          <div class="section-header">
            <span class="section-title">年龄构成</span>
            <span class="analytics-dim-range-hint">${timeLabel}</span>
          </div>
          <div class="analytics-dim-bars">
            ${(data.ages || []).map((age) => `
              <div class="analytics-dim-bar-row">
                <span class="analytics-dim-bar-name">${age.label}</span>
                <div class="analytics-dim-bar-track">
                  <div class="analytics-dim-bar-fill" style="width:${age.pct}%;background:${age.color};"></div>
                </div>
                <span class="analytics-dim-bar-meta">${age.pct}%</span>
              </div>
            `).join('')}
          </div>
        </div>
        <div class="analytics-dim-two-col">
          <div class="card-section">
            <div class="section-header"><span class="section-title">高校分布</span></div>
            <div class="analytics-dim-chip-list">
              ${(data.campuses || []).map((c) => `
                <div class="analytics-dim-chip">
                  <span>${c.name}</span>
                  <strong>${c.pct}%</strong>
                </div>
              `).join('')}
            </div>
          </div>
          <div class="card-section">
            <div class="section-header"><span class="section-title">兴趣偏好</span></div>
            <div class="analytics-dim-chip-list">
              ${(data.interests || []).map((i) => `
                <div class="analytics-dim-chip">
                  <span>${i.name}</span>
                  <strong>${i.pct}%</strong>
                </div>
              `).join('')}
            </div>
          </div>
        </div>`;
    } else if (dim === '收益分析') {
      middleHtml = `
        <div class="card-section">
          <div class="section-header">
            <span class="section-title">收益结构</span>
            <span class="analytics-dim-range-hint">${timeLabel}</span>
          </div>
          <div class="analytics-dim-bars">
            ${(data.sources || []).map((s) => `
              <div class="analytics-dim-bar-row">
                <span class="analytics-dim-bar-name">${s.name}</span>
                <div class="analytics-dim-bar-track">
                  <div class="analytics-dim-bar-fill" style="width:${s.pct}%;background:${s.color};"></div>
                </div>
                <span class="analytics-dim-bar-meta">${s.pct}% · ${s.amount}</span>
              </div>
            `).join('')}
          </div>
        </div>`;
      tableHtml = `
        <div class="card-section">
          <div class="section-header"><span class="section-title">收益明细</span></div>
          <div class="analytics-dim-table-wrap">
            <table class="matrix-work-table analytics-dim-table">
              <thead><tr><th>项目</th><th>类型</th><th>金额</th><th>状态</th></tr></thead>
              <tbody>
                ${(data.topEarners || []).map((e) => `
                  <tr>
                    <td class="matrix-work-title">${e.title}</td>
                    <td>${e.type}</td>
                    <td>${e.amount}</td>
                    <td><span class="analytics-dim-status">${e.status}</span></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>`;
    } else if (dim === '创作表现') {
      middleHtml = `
        <div class="card-section">
          <div class="section-header">
            <span class="section-title">工具使用分布</span>
            <span class="analytics-dim-range-hint">${timeLabel}</span>
          </div>
          <div class="analytics-dim-bars">
            ${(data.tools || []).map((t) => `
              <div class="analytics-dim-bar-row">
                <span class="analytics-dim-bar-name">${t.name}</span>
                <div class="analytics-dim-bar-track">
                  <div class="analytics-dim-bar-fill" style="width:${t.pct}%;background:${t.color};"></div>
                </div>
                <span class="analytics-dim-bar-meta">${t.pct}% · ${t.count} 次</span>
              </div>
            `).join('')}
          </div>
        </div>
        <div class="card-section">
          <div class="section-header"><span class="section-title">创作习惯</span></div>
          <div class="analytics-dim-habit-grid">
            ${(data.habits || []).map((h) => `
              <div class="analytics-dim-habit">
                <div class="analytics-dim-habit-label">${h.label}</div>
                <div class="analytics-dim-habit-val">${h.val}</div>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    const tipsHtml = (data.tips || []).map((t) => `
      <div class="matrix-insight-item" style="--mi-accent:#6366F1;">
        <span class="matrix-insight-tag">${t.tag}</span>
        <strong class="matrix-insight-hl">${t.highlight || ''}</strong>
        <span class="matrix-insight-text">${t.text}</span>
      </div>
    `).join('');

    host.innerHTML = `
      <div class="analytics-dim-panel">
        <div class="analytics-dim-summary">${summaryHtml}</div>
        ${middleHtml}
        ${tableHtml}
        <div class="card-section">
          <div class="section-header"><span class="section-title">行动建议</span></div>
          <div class="matrix-insight-list">${tipsHtml}</div>
        </div>
      </div>
    `;
  },

  renderMatrixDistribution: function() {
    const data = MockData.analytics.matrixDistribution;
    if (!data) return;

    const summary = document.getElementById('matrix-summary-row');
    if (summary) {
      const items = [
        { label: '总浏览量', val: data.summary.totalViews },
        { label: '总点赞', val: data.summary.totalLikes },
        { label: '总评论', val: data.summary.totalComments },
        { label: '回流收益', val: data.summary.totalIncome }
      ];
      summary.innerHTML = items.map(it => `
        <div class="matrix-summary-card">
          <div class="matrix-summary-lbl">${it.label}</div>
          <div class="matrix-summary-val">${it.val}</div>
        </div>
      `).join('');
    }

    const grid = document.getElementById('matrix-platform-grid');
    if (grid) {
      grid.innerHTML = data.platforms.map(p => {
        const isNative = p.isNative || p.key === 'native';
        const nativeBadge = isNative ? `<span class="matrix-platform-native-tag">大本营</span>` : '';
        const cornerActionHtml = (isNative && p.extraCapability) ? `
          <div class="matrix-card-corner-action" onclick="event.stopPropagation()">
            <button type="button" class="btn-native-caps-corner" onclick="App.toggleNativeCapsDropdown(event, this)" title="点击查看大本营专属能力贡献">
              <span class="corner-caps-badge">🌟 专属能力</span>
              <span class="corner-caps-dots">···</span>
            </button>
            <div class="native-caps-popover" id="native-caps-popover">
              <div class="native-caps-popover-head">
                <span class="popover-head-title">大本营专属生态能力</span>
                <button type="button" class="popover-head-close" onclick="App.closeNativeCapsDropdown(event)">✕</button>
              </div>
              <div class="native-caps-popover-list">
                <div class="popover-cap-item" onclick="App.navigateTo('tasks')">
                  <span class="popover-cap-icon">💼</span>
                  <div class="popover-cap-texts">
                    <div class="popover-cap-name">商单撮合与履约</div>
                    <div class="popover-cap-desc">累计 <strong>${p.extraCapability.bounties}</strong> · 品牌合作已结算</div>
                  </div>
                  <span class="popover-cap-arrow">&gt;</span>
                </div>
                <div class="popover-cap-item" onclick="App.navigateTo('assets')">
                  <span class="popover-cap-icon">🏆</span>
                  <div class="popover-cap-texts">
                    <div class="popover-cap-name">数字版权与存证</div>
                    <div class="popover-cap-desc">已确权 <strong>${p.extraCapability.certificates}</strong> · 原创存证证书</div>
                  </div>
                  <span class="popover-cap-arrow">&gt;</span>
                </div>
                <div class="popover-cap-item" onclick="App.openLevelPerksModal()">
                  <span class="popover-cap-icon">⭐</span>
                  <div class="popover-cap-texts">
                    <div class="popover-cap-name">社区成长经验</div>
                    <div class="popover-cap-desc">累计 <strong>${p.extraCapability.growthScore}</strong> · 创作者等级体系</div>
                  </div>
                  <span class="popover-cap-arrow">&gt;</span>
                </div>
              </div>
            </div>
          </div>
        ` : '';
        return `
        <div class="matrix-platform-card ${isNative ? 'is-native-card' : ''}" data-platform="${p.key}" onclick="App.focusMatrixPlatform('${p.key}')">
          <div class="matrix-platform-card-head">
            <img src="${p.icon}" alt="${p.name}" class="matrix-platform-logo ${isNative ? 'is-native-logo' : ''}">
            <div style="flex:1; min-width:0;">
              <div class="matrix-platform-name-wrap">
                <span class="matrix-platform-name">${p.name}</span>
                ${nativeBadge}
              </div>
              <div class="matrix-platform-change">${p.change}</div>
            </div>
            ${cornerActionHtml}
          </div>
          <div class="matrix-platform-metrics">
            <div class="matrix-metric"><span>浏览</span><strong>${p.views}</strong></div>
            <div class="matrix-metric"><span>点赞</span><strong>${p.likes}</strong></div>
            <div class="matrix-metric"><span>评论</span><strong>${p.comments}</strong></div>
            <div class="matrix-metric"><span>分享</span><strong>${p.shares}</strong></div>
            <div class="matrix-metric"><span>涨粉</span><strong>${p.fans}</strong></div>
            <div class="matrix-metric is-income"><span>收益</span><strong>${p.income}</strong></div>
          </div>
        </div>
      `}).join('');
    }

    const tbody = document.getElementById('matrix-work-tbody');
    if (tbody) {
      const cell = (plat) => {
        if (!plat) return '<div class="matrix-cell-empty">—</div>';
        return `<div class="matrix-cell-views">${plat.views}</div><div class="matrix-cell-likes">${plat.likes} 赞</div>`;
      };
      tbody.innerHTML = data.workMatrix.map(w => `
        <tr>
          <td>
            <div class="matrix-work-cell">
              <img src="${w.cover}" alt="" class="matrix-work-thumb">
              <span class="matrix-work-title" title="${w.title}">${w.title}</span>
            </div>
          </td>
          <td class="matrix-cell-native-col">${cell(w.native, true)}</td>
          <td>${cell(w.douyin)}</td>
          <td>${cell(w.kuaishou)}</td>
          <td>${cell(w.bilibili)}</td>
          <td>${cell(w.xiaohongshu)}</td>
          <td>${cell(w.shipinhao)}</td>
          <td>${cell(w.tiktok)}</td>
          <td>${cell(w.youtube)}</td>
          <td>${cell(w.facebook)}</td>
          <td>${cell(w.instagram)}</td>
          <td>${cell(w.twitter)}</td>
        </tr>
      `).join('');
    }

    const insights = document.getElementById('matrix-insight-list');
    if (insights) {
      insights.innerHTML = data.insights.map(it => `
        <div class="matrix-insight-item" style="--mi-accent:${it.color};">
          <span class="matrix-insight-tag">${it.tag}</span>
          <strong class="matrix-insight-hl">${it.highlight}</strong>
          <span class="matrix-insight-text">${it.text}</span>
        </div>
      `).join('');
    }
  },

  renderAnalyticsMetricCards: function() {
    const container = document.getElementById('analytics-metric-cards');
    if (!container) return;

    const data = MockData.analytics.overviewStats[this.activeAnalyticsTime] || MockData.analytics.overviewStats['30d'];

    const mkIcon = (name) => `<span class="metric-icon-wrap">${typeof Icons !== 'undefined' ? Icons.img(name, 16) : ''}</span>`;

    const cards = [
      { label: '播放量', val: data.views, change: data.viewsChange, icon: mkIcon('play'), canvasId: 'spk-1', color: '#6366F1', spkData: [12, 14, 18, 16, 22, 28, 34] },
      { label: '点赞数', val: data.likes, change: data.likesChange, icon: mkIcon('like'), canvasId: 'spk-2', color: '#EF4444', spkData: [8, 10, 11, 14, 16, 18, 20] },
      { label: '评论数', val: data.comments, change: data.commentsChange, icon: mkIcon('comment'), canvasId: 'spk-3', color: '#10B981', spkData: [4, 6, 5, 8, 9, 10, 11] },
      { label: '分享数', val: data.shares, change: data.sharesChange, icon: mkIcon('share'), canvasId: 'spk-4', color: '#8B5CF6', spkData: [3, 4, 6, 5, 7, 6, 8] },
      { label: '新增粉丝', val: data.fans, change: data.fansChange, icon: mkIcon('users'), canvasId: 'spk-5', color: '#3B82F6', spkData: [10, 12, 15, 18, 22, 26, 32] },
      { label: '累计收益', val: data.income, change: data.incomeChange, icon: mkIcon('coin'), canvasId: 'spk-6', color: '#F59E0B', spkData: [15, 18, 20, 24, 28, 32, 38] }
    ];

    container.innerHTML = cards.map(c => `
      <div class="analytics-metric-card">
        <div class="metric-card-top">
          ${c.icon}
          <span>${c.label}</span>
        </div>
        <div class="metric-card-value">${c.val}</div>
        <div class="metric-card-change"><span class="change-lbl">较上期</span> <span class="change-val">${c.change}</span></div>
        <div class="metric-sparkline-wrap">
          <canvas id="${c.canvasId}" class="metric-sparkline-canvas"></canvas>
        </div>
      </div>
    `).join('');

    setTimeout(() => {
      cards.forEach(c => {
        ChartEngine.drawSparkline(c.canvasId, c.spkData, c.color);
      });
    }, 40);
  },

  renderAnalyticsTrendChart: function() {
    const trend = MockData.analytics.trendChart;
    ChartEngine.drawTrendChart('analytics-trend-canvas', trend.dates, trend.series, this.visibleChartSeries);
  },

  toggleChartSeries: function(seriesKey) {
    const idx = this.visibleChartSeries.indexOf(seriesKey);
    if (idx > -1) {
      if (this.visibleChartSeries.length === 1) {
        this.showToast('至少保留一条曲线展示');
        return;
      }
      this.visibleChartSeries.splice(idx, 1);
    } else {
      this.visibleChartSeries.push(seriesKey);
    }

    document.querySelectorAll('.legend-item').forEach(item => {
      const k = item.getAttribute('data-series');
      if (this.visibleChartSeries.includes(k)) {
        item.classList.remove('disabled');
      } else {
        item.classList.add('disabled');
      }
    });

    this.renderAnalyticsTrendChart();
  },

  renderAnalyticsCharts: function() {
    this.renderAnalyticsTrendChart();

    // 年龄分布
    const demo = MockData.analytics.demographics;
    ChartEngine.drawDonutChart('age-donut-canvas', demo.ages, '年龄分布', '');
    const ageLegend = document.getElementById('age-legend-col');
    if (ageLegend) {
      ageLegend.innerHTML = demo.ages.map(a => `
        <div class="dist-legend-item">
          <div class="dist-legend-top">
            <span class="dist-legend-label"><span class="dist-dot" style="background:${a.color};"></span>${a.label}</span>
            <strong class="dist-legend-pct">${a.pct}%</strong>
          </div>
          <div class="dist-bar-track"><div class="dist-bar-fill" style="width:${a.pct}%;background:${a.color};"></div></div>
        </div>
      `).join('');
    }

    // 设备分布
    ChartEngine.drawDonutChart('device-donut-canvas', demo.devices, '', '');
    const devLegend = document.getElementById('device-legend-col');
    if (devLegend) {
      devLegend.innerHTML = demo.devices.map(d => `
        <div class="dist-legend-item">
          <div class="dist-legend-top">
            <span class="dist-legend-label"><span class="dist-dot" style="background:${d.color};"></span>${d.label}</span>
            <strong class="dist-legend-pct">${d.pct}%</strong>
          </div>
          <div class="dist-bar-track"><div class="dist-bar-fill" style="width:${d.pct}%;background:${d.color};"></div></div>
        </div>
      `).join('');
    }

    // 地域列表（按占比着色）
    const regionCol = document.getElementById('region-list-col');
    if (regionCol) {
      const maxPct = Math.max(...demo.regions.map(r => r.pct), 1);
      regionCol.innerHTML = demo.regions.map(r => {
        const intensity = 0.35 + (r.pct / maxPct) * 0.65;
        const color = `rgba(99, 102, 241, ${intensity.toFixed(2)})`;
        return `
        <div class="dist-legend-item">
          <div class="dist-legend-top">
            <span class="dist-legend-label"><span class="dist-dot" style="background:${color};"></span>${r.name}</span>
            <strong class="dist-legend-pct">${r.pct}%</strong>
          </div>
          <div class="dist-bar-track"><div class="dist-bar-fill" style="width:${(r.pct / maxPct) * 100}%;background:#6366F1;"></div></div>
        </div>`;
      }).join('');
    }

    // 24小时曲线
    ChartEngine.drawRealtimeCurve('realtime-24h-canvas', MockData.analytics.realtime24h.points);
  },

  renderAnalyticsRight: function() {
    // TOP 5 作品
    const top5 = document.getElementById('analytics-top5-list');
    if (top5) {
      const eyeIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
      const heartIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;
      top5.innerHTML = MockData.analytics.top5Works.map(w => `
        <div class="top5-item" onclick="App.openWorkPlayer('${w.title}')">
          <span class="rank-num-badge ${w.rank <= 3 ? 'top-' + w.rank : ''}">${w.rank}</span>
          <img src="${w.cover}" alt="${w.title}" class="top5-thumb">
          <div class="top5-content">
            <div class="top5-title">${w.title}</div>
            <div class="top5-date">${w.date}</div>
          </div>
          <div class="top5-stats">
            <span class="meta-item">${eyeIcon} ${w.views}</span>
            <span class="meta-item">${heartIcon} ${w.likes}</span>
          </div>
        </div>
      `).join('');
    }

    // 智能洞察
    const insights = document.getElementById('analytics-insights-list');
    if (insights) {
      insights.innerHTML = MockData.analytics.insights.map(item => {
        const tipIcon = typeof Icons !== 'undefined' ? Icons.img(item.icon || 'idea', 18) : '';
        return `
        <div class="insight-card" style="--insight-accent:${item.color};">
          <div class="insight-card-head">
            <span class="insight-card-icon">${tipIcon}</span>
            <span class="insight-card-tag">${item.tag}</span>
          </div>
          <div class="insight-card-metric">
            <span class="insight-card-highlight">${item.highlight}</span>
            <span class="insight-card-metric-lbl">${item.highlightLabel}</span>
          </div>
          <p class="insight-card-text">${item.text}</p>
        </div>`;
      }).join('');
    }
  },

  // =========================================================================
  // 7. 我的资产 (Assets) 渲染与交互
  // =========================================================================
  renderAssets: function() {
    // 绑定明细 Tab（underline）
    const txTabs = document.querySelectorAll('#asset-transaction-tabs .underline-tab');
    txTabs.forEach(tab => {
      tab.onclick = () => {
        txTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        this.activeAssetCategory = tab.getAttribute('data-txcat');
        this.renderTransactionsTable();
      };
    });

    this.renderAssetsProfileHub();
    this.renderTransactionsTable();
    this.renderNFTs();
    this.renderAssetsRight();
    this.renderAssetsCharts();
  },

  renderAssetsProfileHub: function() {
    const hub = document.getElementById('assets-profile-hub');
    if (!hub) return;
    const u = MockData.currentUser;
    const lv = this.getUserLevel();
    const paths = MockData.academy.paths || [];
    const roleName = (paths[lv - 1] && paths[lv - 1].name) || u.role || '创作者';
    hub.innerHTML = `
      <div class="assets-profile-top">
        <img src="${u.avatarLarge || u.avatar}" alt="${u.name}" class="assets-profile-avatar">
        <div class="assets-profile-meta">
          <div class="assets-profile-head-row">
            <div class="assets-profile-name-block">
              <div class="assets-profile-name-row">
                <span class="assets-profile-name">${u.name}</span>
                <span class="badge-level">Lv.${lv}</span>
              </div>
              <div class="assets-profile-sub">${u.school} ｜ ${roleName}</div>
            </div>
            <div class="assets-profile-stats">
              <div><div class="profile-stat-val">${u.worksCount || 0}</div><div class="profile-stat-lbl">作品</div></div>
              <div><div class="profile-stat-val">${u.viewsCount || '0'}</div><div class="profile-stat-lbl">浏览量</div></div>
              <div><div class="profile-stat-val">${u.fansCount || '0'}</div><div class="profile-stat-lbl">粉丝</div></div>
              <div><div class="profile-stat-val">${u.likesCount || '0'}</div><div class="profile-stat-lbl">获赞</div></div>
            </div>
            <div class="assets-profile-actions">
              <button type="button" class="hero-btn-secondary" style="padding:6px 12px;font-size:12px;" onclick="App.openMyWorksModal()">我的作品</button>
              <button type="button" class="hero-btn-primary" style="padding:6px 12px;font-size:12px;" onclick="App.openMyCertsModal()">我的证书</button>
              <button type="button" class="hero-btn-secondary" style="padding:6px 12px;font-size:12px;" onclick="App.openLevelPerksModal()">等级权益</button>
            </div>
          </div>
        </div>
      </div>
    `;
    this.syncLevelBadges();
  },

  renderTransactionsTable: function() {
    const tbody = document.getElementById('transactions-tbody');
    if (!tbody) return;

    let list = MockData.assets.transactions;
    if (this.activeAssetCategory !== '全部') {
      list = list.filter(t => t.category === this.activeAssetCategory);
    }

    tbody.innerHTML = list.map(tx => `
      <tr>
        <td>
          <span class="status-badge-tag ${tx.type === '收入' || tx.type === 'AI积分' ? 'tag-success' : 'tag-done'}">${tx.type === 'AI积分' ? 'AI 积分' : tx.type}</span>
        </td>
        <td style="font-weight:500;">${tx.name}</td>
        <td class="${tx.rawAmount > 0 ? 'amount-income' : 'amount-expense'}">${tx.amount}</td>
        <td>
          <span style="color:${tx.status === '已到账' ? 'var(--accent-green)' : (tx.status === '托管中' ? '#8B5CF6' : 'var(--text-muted)')}; font-size:12px;">● ${tx.status}</span>
        </td>
        <td style="font-size:12px; color:var(--text-muted);">${tx.time}</td>
      </tr>
    `).join('');
  },

  renderNFTs: function() {
    const container = document.getElementById('nfts-grid-container');
    if (!container) return;

    container.innerHTML = MockData.assets.nfts.map(nft => `
      <div class="nft-card" onclick="App.openPreviewLightbox('${nft.img}', '${nft.name} · 数字藏品证书')">
        <div class="nft-thumb-wrap">
          <img src="${nft.img}" alt="${nft.name}" class="nft-thumb-img">
          ${nft.moreCount ? `<div class="nft-more-mask">${nft.moreCount}</div>` : ''}
        </div>
        <div class="nft-info-row">
          <div class="nft-title">${nft.name}</div>
          <div class="nft-meta-row">
            <span class="nft-type-label">数字藏品</span>
            <span class="nft-tag-badge ${nft.tag === '珍稀' ? 'tag-epic' : (nft.tag === '稀有' ? 'tag-rare' : 'tag-common')}">${nft.tag}</span>
          </div>
        </div>
      </div>
    `).join('');
  },

  _assetSvgIcon: function(name) {
    if (typeof Icons !== 'undefined') return Icons.img(name, 20);
    return '';
  },

  renderAssetsRight: function() {
    // 安全中心
    const secGrid = document.getElementById('security-items-grid');
    if (secGrid) {
      secGrid.innerHTML = MockData.assets.security.map(s => `
        <div class="security-item" onclick="App.openSecuritySettings('${s.name}')">
          <div class="security-icon">${this._assetSvgIcon(s.icon)}</div>
          <div class="security-name">${s.name}</div>
          <div class="security-state">${s.state}</div>
        </div>
      `).join('');
    }

    // 权益特权
    const benGrid = document.getElementById('assets-benefits-grid');
    if (benGrid) {
      benGrid.innerHTML = MockData.assets.benefits.map(b => `
        <div class="achievement-card" onclick="App.openModal('modal-pro')">
          <div class="benefit-icon-wrap" style="background:${b.color}22; color:${b.color};">${this._assetSvgIcon(b.icon)}</div>
          <div class="achievement-title" style="font-size:11px;">${b.title}</div>
          <div class="achievement-sub" style="font-size:9.5px;">${b.exp}</div>
        </div>
      `).join('');
    }

    // 常用功能
    const funcGrid = document.getElementById('common-functions-grid');
    if (funcGrid) {
      funcGrid.innerHTML = MockData.assets.commonTools.map(f => `
        <div class="common-func-item" onclick="App.handleCommonFuncClick('${f.name}')">
          <div class="common-func-icon">${this._assetSvgIcon(f.icon)}</div>
          <div class="common-func-label">${f.name}</div>
        </div>
      `).join('');
    }
  },

  openSecuritySettings: function(focusItem) {
    const body = document.getElementById('security-settings-body');
    if (!body) return;
    const u = MockData.currentUser;
    const security = MockData.assets.security || [];

    body.innerHTML = `
      <div class="security-settings-profile">
        <img src="${u.avatarLarge || u.avatar}" alt="${u.name}" class="security-settings-avatar">
        <div>
          <div class="security-settings-profile-name">${u.name}</div>
          <div class="security-settings-profile-sub">${u.school} ｜ ${u.role || '创作者'} Lv.${u.level || 1}</div>
        </div>
      </div>

      <div class="security-settings-section">
        <div class="security-settings-section-title">个人信息</div>
        <div class="security-settings-card">
          <div class="security-settings-row">
            <span class="security-settings-label">真实姓名</span>
            <span class="security-settings-value">${u.realName || '未填写'}</span>
            <button type="button" class="security-settings-action" onclick="App.showToast('实名信息已认证，如需变更请联系客服')">查看</button>
          </div>
          <div class="security-settings-row">
            <span class="security-settings-label">手机号</span>
            <span class="security-settings-value">${u.phone || '未绑定'}</span>
            <button type="button" class="security-settings-action" onclick="App.showToast('更换手机号：验证码已发送至当前绑定号码')">更换</button>
          </div>
          <div class="security-settings-row">
            <span class="security-settings-label">邮箱</span>
            <span class="security-settings-value">${u.email || '未绑定'}</span>
            <button type="button" class="security-settings-action" onclick="App.showToast('邮箱换绑流程已打开')">更换</button>
          </div>
          <div class="security-settings-row">
            <span class="security-settings-label">学号</span>
            <span class="security-settings-value">${u.studentId || '未认证'}</span>
            <button type="button" class="security-settings-action" onclick="App.showToast('校园身份认证有效')">认证</button>
          </div>
          <div class="security-settings-row">
            <span class="security-settings-label">所属学校</span>
            <span class="security-settings-value">${u.school || '-'}</span>
          </div>
        </div>
      </div>

      <div class="security-settings-section">
        <div class="security-settings-section-title">安全防护</div>
        <div class="security-settings-card">
          ${security.map(s => `
            <div class="security-settings-row${focusItem === s.name ? ' is-focus' : ''}">
              <span class="security-settings-label">${s.name}</span>
              <span class="security-settings-value" style="color:#10B981;">${s.state}</span>
              <button type="button" class="security-settings-action" onclick="App.showToast('${s.name}：当前状态【${s.state}】，可在此管理')">管理</button>
            </div>
          `).join('')}
        </div>
      </div>
    `;

    this.openModal('modal-security-settings');
    if (focusItem) {
      setTimeout(() => {
        const row = body.querySelector('.security-settings-row.is-focus');
        if (row) row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 80);
    }
  },

  renderAssetsCharts: function() {
    const bd = MockData.assets.breakdown;
    const totalEl = document.getElementById('assets-overview-total');
    if (totalEl) totalEl.textContent = '¥ ' + bd.total;

    const sum = bd.items.reduce((s, it) => s + (it.value || 0), 0) || 1;
    const legend = document.getElementById('assets-donut-legend');
    if (legend) {
      legend.innerHTML = bd.items.map(item => {
        const pct = ((item.value / sum) * 100).toFixed(1);
        return `
        <div class="assets-overview-row">
          <div class="assets-overview-row-top">
            <span class="assets-overview-row-label">
              <span class="dist-dot" style="background:${item.color};"></span>${item.label}
            </span>
            <strong class="assets-overview-row-amount">${item.amount}</strong>
          </div>
          <div class="assets-overview-row-meta">
            <div class="dist-bar-track"><div class="dist-bar-fill" style="width:${pct}%;background:${item.color};"></div></div>
            <span class="assets-overview-row-pct">${pct}%</span>
          </div>
        </div>`;
      }).join('');
    }
  },

  filterAssetsTab: function(tabName) {
    const tabs = document.querySelectorAll('#asset-transaction-tabs .underline-tab');
    tabs.forEach(t => {
      if (t.getAttribute('data-txcat') === tabName) {
        t.click();
      }
    });
  },

  submitWithdraw: function() {
    const input = document.getElementById('withdraw-amount-input');
    const amount = parseFloat(input && input.value);

    if (isNaN(amount) || amount <= 0) {
      this.showToast('请输入有效的提现金额');
      return;
    }

    const parseMoney = (v) => parseFloat(String(v || '0').replace(/,/g, '')) || 0;
    let withdrawable = parseMoney(MockData.assets.cards.withdrawable);
    let balance = parseMoney(MockData.assets.cards.balance);

    if (amount > withdrawable) {
      this.showToast(`超出可提现余额（¥ ${withdrawable.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}），冻结资金不可提现`);
      return;
    }

    withdrawable = Math.max(0, withdrawable - amount);
    balance = Math.max(0, balance - amount);
    MockData.assets.cards.withdrawable = withdrawable.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    MockData.assets.cards.balance = balance.toLocaleString('zh-CN', { minimumFractionDigits: 2 });

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = withdrawable;
      availItem.amount = '¥ ' + withdrawable.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '提现',
      name: '提现到银行卡 (实时结算)',
      amount: `- ¥ ${amount.toFixed(2)}`,
      rawAmount: -amount,
      status: '处理中',
      statusType: 'done',
      time: '刚刚',
      category: '提现'
    });

    this.refreshAssetDisplays();
    this.renderTransactionsTable();
    if (typeof this.renderAssetsCharts === 'function') this.renderAssetsCharts();
    this.closeModal('modal-withdraw');
    this.showToast(`提现申请成功！¥ ${amount.toFixed(2)} 正在处理中（冻结款未动用）`);
  },

  // =========================================================================
  // 全局交互模态弹窗与工具方法
  // =========================================================================
  openModal: function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('active');
    }
    if (modalId === 'modal-withdraw') {
      const input = document.getElementById('withdraw-amount-input');
      const wd = MockData.assets.cards.withdrawable || '0';
      if (input) {
        input.placeholder = `输入提现金额，当前可提现 ¥ ${wd}`;
        const max = parseFloat(String(wd).replace(/,/g, '')) || 0;
        if (parseFloat(input.value) > max) input.value = Math.min(1000, max).toFixed(0);
      }
    }
  },

  closeModal: function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.remove('active');
    }
  },

  openAIWorkbench: function(toolTitle) {
    document.getElementById('modal-studio-title').innerText = toolTitle || 'AI 智能创作工作台';
    document.getElementById('studio-preview-status').innerText = '输入提示词并点击“开始生成”，体验实时创作';
    document.getElementById('studio-progress-bar').style.width = '0';
    const pubBtn = document.getElementById('btn-studio-publish');
    if (pubBtn) pubBtn.hidden = true;
    this.lastStudioDraft = null;
    this.openModal('modal-studio');
  },

  simulateGenerate: function() {
    const btn = document.getElementById('btn-studio-generate');
    const status = document.getElementById('studio-preview-status');
    const progress = document.getElementById('studio-progress-bar');
    const pubBtn = document.getElementById('btn-studio-publish');
    const promptEl = document.getElementById('studio-prompt-input');
    const toolTitle = (document.getElementById('modal-studio-title') || {}).innerText || 'AI 创作';

    btn.disabled = true;
    btn.innerText = 'AI 渲染中...';
    if (pubBtn) pubBtn.hidden = true;
    status.innerText = '⚡ 正在调用 GPU 集群渲染超分辨率分镜...';
    progress.style.width = '100%';

    setTimeout(() => {
      btn.disabled = false;
      btn.innerText = '再次生成';
      status.innerHTML = '🎉 <strong>生成成功！</strong> 分辨率 4K · 耗时 1.8s · 质量评分 9.8/10';
      const prompt = (promptEl && promptEl.value.trim()) || '';
      this.lastStudioDraft = {
        title: `${toolTitle.replace(/^AI\s*/, '')}作品 · ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`,
        category: 'AI短视频',
        content: prompt ? `用 ${toolTitle} 生成：${prompt}` : `刚用「${toolTitle}」完成一版新作品，欢迎来社区交流～`,
        cover: 'assets/covers/work_1.png'
      };
      if (pubBtn) pubBtn.hidden = false;
      this.showToast('生成成功！可一键发布到社区与发现页');
    }, 1800);
  },

  publishFromStudio: function() {
    if (!this.lastStudioDraft) {
      this.showToast('请先完成一次生成');
      return;
    }
    const ok = this.submitPublishWork({
      title: this.lastStudioDraft.title,
      category: this.lastStudioDraft.category,
      content: this.lastStudioDraft.content,
      cover: this.lastStudioDraft.cover,
      platforms: ['douyin', 'xiaohongshu', 'tiktok', 'youtube'],
      keepModalOpen: true,
      toast: '🎉 已发布并矩阵分发，可在数据中心查看回流'
    });
    if (ok) {
      this.closeModal('modal-studio');
      this.navigateTo('community');
    }
  },

  handleUpgradePro: function() {
    this.closeModal('modal-pro');
    this.showToast('👑 恭喜你成为 AI 创作者社区 Pro 尊享会员！');
  },

  openWorkPlayer: function(title) {
    this.showToast(`🎬 正在播放高清作品：《${title}》`);
  },

  openCoursePlayer: function(title) {
    this.completeLesson(title);
  },

  completeLesson: function(title) {
    let found = null;
    const cal = MockData.academy.calendarTasks || {};
    Object.keys(cal).forEach((day) => {
      (cal[day] || []).forEach((task) => {
        if (task.title === title) found = task;
      });
    });

    if (found && (found.state === '已完成' || found.status === '已完成')) {
      this.showToast(`《${title}》已完成学习`);
      return;
    }

    if (found) {
      found.status = '已完成';
      found.state = '已完成';
    }

    // 推进任一匹配计划进度
    const plan = (MockData.academy.plans || []).find(p => title.includes(p.title.slice(0, 4)) || p.title.includes(title.slice(0, 4)))
      || MockData.academy.plans[0];
    if (plan) {
      plan.progress = Math.min(100, (plan.progress || 0) + 18);
    }

    MockData.currentUser.coursesFinished = (MockData.currentUser.coursesFinished || 0) + 1;
    MockData.currentUser.studyHours = (MockData.currentUser.studyHours || 0) + 1;
    MockData.currentUser.learningPoints = (MockData.currentUser.learningPoints || 0) + 50;
    MockData.currentUser.streakDays = (MockData.currentUser.streakDays || 0) + 1;

    const nextLevel = this.advanceGrowthPath();
    this.syncLevelBadges();
    this.renderAcademy();
    if (nextLevel === 3) {
      this.showToast(`📚 《${title}》完成！已晋级 Lv.3 内容创作者，可接基础任务`);
      setTimeout(() => { this.navigateTo('tasks'); this.setTasksMode('hall', true); }, 600);
    } else if (nextLevel === 4) {
      this.showToast(`📚 《${title}》完成！已晋级 Lv.4 商业创作者，可接高赏金商单`);
      setTimeout(() => { this.navigateTo('tasks'); this.setTasksMode('gallery', true); }, 600);
    } else if (nextLevel === 5) {
      this.showToast(`📚 《${title}》完成！已晋级 Lv.5 OPC 创业者`);
    } else if (nextLevel) {
      this.showToast(`📚 《${title}》完成！已晋级 Lv.${nextLevel}`);
    } else {
      this.showToast(`📚 《${title}》学习完成，成长进度 +18%`);
    }
  },

  advanceGrowthPath: function() {
    const paths = MockData.academy.paths || [];
    const activeIdx = paths.findIndex(p => p.active);
    if (activeIdx < 0) return null;

    // 累计完成课节达到阈值才晋级（早期等级需连学 2 节）
    this._lessonsCompletedSession = (this._lessonsCompletedSession || 0) + 1;
    if (this._lessonsCompletedSession < 2 && activeIdx <= 1) {
      return null;
    }
    this._lessonsCompletedSession = 0;

    paths[activeIdx].done = true;
    paths[activeIdx].active = false;
    paths[activeIdx].status = '已解锁';

    let nextLevel = null;
    if (activeIdx + 1 < paths.length) {
      paths[activeIdx + 1].active = true;
      paths[activeIdx + 1].status = '进行中';
      nextLevel = activeIdx + 2;
      MockData.currentUser.level = Math.max(MockData.currentUser.level || 1, nextLevel);
    } else {
      nextLevel = activeIdx + 1;
      MockData.currentUser.level = Math.max(MockData.currentUser.level || 1, nextLevel);
    }

    this.syncLevelBadges();
    return nextLevel;
  },

  onGrowthPathClick: function(idx) {
    const p = (MockData.academy.paths || [])[idx];
    if (!p) return;
    const statusText = p.done ? '已完成' : (p.active ? '进行中' : '未解锁');
    if (!p.done && !p.active) {
      this.showToast(`${p.level} ${p.name} 尚未解锁`);
      return;
    }
    const perk = p.perk ? ` · ${p.perk}` : '';
    const lvNum = idx + 1;
    if (lvNum === 3) {
      this.showToast(`${p.level} ${p.name}${perk}`);
      this.navigateTo('tasks');
      this.setTasksMode('hall', true);
      return;
    }
    if (lvNum >= 4) {
      this.showToast(`${p.level} ${p.name}${perk}`);
      this.navigateTo('tasks');
      this.setTasksMode(lvNum >= 4 ? 'gallery' : 'hall', true);
      return;
    }
    this.showToast(`创作者体系：${p.level} ${p.name} · ${statusText}${perk}`);
  },

  focusMatrixPlatform: function(platformKey) {
    const nameMap = {
      native: '社区大本营',
      douyin: '抖音',
      kuaishou: '快手',
      bilibili: '哔哩哔哩',
      xiaohongshu: '小红书',
      shipinhao: '视频号',
      tiktok: 'TikTok',
      youtube: 'YouTube',
      facebook: 'Facebook',
      instagram: 'Instagram',
      twitter: '推特 (X)'
    };
    document.querySelectorAll('.matrix-platform-card').forEach(card => {
      card.classList.toggle('is-highlight', card.getAttribute('data-platform') === platformKey);
    });
    this.showToast(`正在查看 ${nameMap[platformKey] || platformKey} 回流明细`);
    setTimeout(() => {
      document.querySelectorAll('.matrix-platform-card.is-highlight').forEach(c => c.classList.remove('is-highlight'));
    }, 1600);
  },

  handleSearchSelect: function(title, targetView) {
    document.getElementById('search-dropdown').classList.remove('active');
    const input = document.getElementById('global-search-input');
    if (input) input.value = title;
    if (targetView === 'discover' || targetView === 'academy' || targetView === 'tools' || targetView === 'tasks') {
      this.runGlobalSearch(title);
      return;
    }
    this.navigateTo(targetView);
    this.showToast(`已定位：${title}`);
  },

  focusGrowthPath: function() {
    this.navigateTo('academy');
    setTimeout(() => {
      const el = document.getElementById('growth-steps-container');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      this.showToast('已定位至「我的成长路径」');
    }, 50);
  },

  showStudyRecord: function() {
    const doneDays = Object.values(MockData.academy.calendarTasks || {}).reduce((n, list) => {
      return n + (list || []).filter(t => t.status === '已完成' || t.state === '已完成').length;
    }, 0);
    this.showToast(`学习记录：已完成 ${doneDays} 课节 · 连续打卡 ${MockData.currentUser.streakDays || 0} 天 · 积分 ${MockData.currentUser.learningPoints || 0}`);
  },

  openLevelPerksModal: function() {
    const lv = this.getUserLevel();
    const paths = MockData.academy.paths || [];
    const sub = document.getElementById('level-perks-subtitle');
    const body = document.getElementById('level-perks-body');
    const cur = paths[lv - 1];
    if (sub) {
      sub.textContent = cur
        ? `当前：Lv.${lv} ${cur.name} · ${cur.perk || ''}`
        : `当前：Lv.${lv}`;
    }
    if (body) {
      const focus = [
        { lv: 3, name: '内容创作者', unlock: lv >= 3 ? (lv === 3 ? '当前等级' : '已解锁') : '待解锁', items: ['可承接基础任务与挑战赛', '社区发布与学院认证', '完成交付可上架展厅'] },
        { lv: 4, name: '商业创作者', unlock: lv >= 4 ? (lv === 4 ? '当前等级' : '已解锁') : '待解锁', items: ['可接高赏金 / 品牌商单', '作品展厅优先加权展示', '定制托管与商业结算'] },
        { lv: 5, name: 'OPC 创业者', unlock: lv >= 5 ? '当前等级' : '待解锁', items: ['个人品牌工作室化', '团队协作与派单', '更高分成与专属辅导'] }
      ];
      body.innerHTML = focus.map(card => {
        const active = card.lv === lv;
        const unlocked = lv >= card.lv;
        return `
          <div class="level-perk-card ${active ? 'is-current' : ''} ${unlocked ? 'is-unlocked' : 'is-locked'}">
            <div class="level-perk-head">
              <span class="level-perk-lv">Lv.${card.lv}</span>
              <span class="level-perk-name">${card.name}</span>
              <span class="level-perk-state">${card.unlock}</span>
            </div>
            <ul class="level-perk-list">
              ${card.items.map(it => `<li>${it}</li>`).join('')}
            </ul>
          </div>
        `;
      }).join('');
    }
    this.openModal('modal-level-perks');
  },

  openCreatorProfile: function(creatorName) {
    const works = ((MockData.tasks.gallery && MockData.tasks.gallery.works) || []).filter(w => w.creator && w.creator.name === creatorName);
    const sample = works[0];
    if (!sample) {
      this.showToast('暂未找到该创作者主页');
      return;
    }
    const c = sample.creator;
    const body = document.getElementById('creator-profile-body');
    if (!body) return;

    const priceHint = works.map(w => w.priceRange).filter(Boolean)[0] || '面议';
    const avail = works.some(w => w.available);

    body.innerHTML = `
      <div class="creator-profile-head">
        <img src="${c.avatar}" alt="${c.name}" class="creator-profile-avatar">
        <div class="creator-profile-meta">
          <div class="creator-profile-name">${c.name} <span class="gallery-creator-lv">${c.level || ''}</span></div>
          <div class="creator-profile-school">${c.school || ''} ｜ ${c.level || '创作者'}</div>
          <div class="creator-profile-tags">
            <span class="gallery-tag">${avail ? '可接单' : '暂不可约'}</span>
            <span class="gallery-tag is-muted">报价 ${priceHint}</span>
            <span class="gallery-tag is-source">交付 ${works.reduce((s, w) => s + (w.delivered || 0), 0)} 单</span>
          </div>
        </div>
      </div>
      <div class="section-header" style="margin:16px 0 10px;"><span class="section-title">代表作品</span></div>
      <div class="creator-profile-works">
        ${works.slice(0, 3).map(w => `
          <div class="creator-profile-work" onclick="App.openPreviewLightbox('${w.cover}', '${w.title}')">
            <img src="${w.cover}" alt="${w.title}">
            <div class="creator-profile-work-title">${w.title}</div>
          </div>
        `).join('')}
      </div>
      <div class="modal-actions-row" style="margin-top:18px;">
        <button class="hero-btn-secondary" onclick="App.closeModal('modal-creator-profile')">关闭</button>
        <button class="hero-btn-primary" ${avail ? '' : 'disabled'}
          onclick="${avail ? `App.openGalleryCustomModal('${sample.id}')` : `App.showToast('该同学暂未开放接单')`}">
          ${avail ? '发起平台定制' : '暂不可约'}
        </button>
      </div>
      <div style="font-size:11.5px;color:var(--text-muted);margin-top:10px;line-height:1.5;">
        沟通与付款均在平台内完成，不展示个人联系方式，避免私下交易风险。
      </div>
    `;
    this.openModal('modal-creator-profile');
  },

  toggleNotifyDropdown: function(e) {
    if (e) e.stopPropagation();
    const drop = document.getElementById('notify-dropdown');
    if (!drop) return;
    if (!drop.hidden) {
      drop.hidden = true;
      return;
    }
    const activeOrders = (MockData.tasks.myOrders || []).filter(o => o.status === '进行中' || o.status === '待验收');
    const items = [
      {
        title: `你有 ${activeOrders.length} 条任务待处理`,
        sub: activeOrders[0] ? activeOrders[0].title : '去任务广场看看',
        action: "App.closeNotifyDropdown(); App.navigateTo('tasks'); App.setTasksMode('mine', true);"
      },
      {
        title: '作品获得 12 个新点赞',
        sub: '《未来信号》等动态互动上升',
        action: "App.closeNotifyDropdown(); App.navigateTo('community');"
      },
      {
        title: '定制托管冻结提醒',
        sub: 'MO03 · ¥1,500 托管中',
        action: "App.closeNotifyDropdown(); App.navigateTo('assets');"
      }
    ];
    drop.innerHTML = `
      <div class="notify-dropdown-head">通知</div>
      ${items.map(it => `
        <button type="button" class="notify-dropdown-item" onclick="${it.action}">
          <strong>${it.title}</strong>
          <span>${it.sub}</span>
        </button>
      `).join('')}
    `;
    drop.hidden = false;
  },

  closeNotifyDropdown: function() {
    const drop = document.getElementById('notify-dropdown');
    if (drop) drop.hidden = true;
  },

  openMyWorksModal: function() {
    const body = document.getElementById('my-works-body');
    if (!body) return;
    const discoverMine = (MockData.discover.works || []).filter(w =>
      (w.author || '').includes('小宇') || (w.authorLine || '').includes('小宇')
    );
    const galleryMine = ((MockData.tasks.gallery && MockData.tasks.gallery.works) || []).filter(w =>
      w.creator && w.creator.name === MockData.currentUser.name
    );
    const list = [];
    discoverMine.slice(0, 3).forEach(w => list.push({ title: w.title, cover: w.cover, source: '发现' }));
    galleryMine.slice(0, 2).forEach(w => list.push({ title: w.title, cover: w.cover, source: '展厅' }));
    if (list.length === 0) {
      (MockData.discover.works || []).slice(0, 4).forEach(w => list.push({ title: w.title, cover: w.cover, source: '发现' }));
    }
    body.innerHTML = list.map(w => `
      <div class="edge-work-card" onclick="App.openPreviewLightbox('${w.cover}', '${w.title}')">
        <img src="${w.cover}" alt="${w.title}">
        <div class="edge-work-meta">
          <div class="edge-work-title">${w.title}</div>
          <div class="edge-work-source">${w.source}</div>
        </div>
      </div>
    `).join('');
    this.openModal('modal-my-works');
  },

