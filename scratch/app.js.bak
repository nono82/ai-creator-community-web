  openAnnouncementDetail: function(idx) {
    const list = MockData.community.announcements || [];
    const a = list[idx] || list[0];
    if (!a) return;
    const title = document.getElementById('announcement-title');
    const date = document.getElementById('announcement-date');
    const body = document.getElementById('announcement-body');
    if (title) title.textContent = a.title;
    if (date) date.textContent = a.date;
    if (body) body.textContent = a.body || '暂无详情';
    this.openModal('modal-announcement');
  },

  openPreviewLightbox: function(src, caption) {
    const img = document.getElementById('lightbox-image');
    const cap = document.getElementById('lightbox-caption');
    if (img) img.src = src;
    if (cap) cap.textContent = caption || '';
    this.openModal('modal-preview-lightbox');
  },

  openHelpFaqModal: function() {
    const body = document.getElementById('help-faq-body');
    if (!body) return;
    body.innerHTML = (MockData.helpFaq || []).map(item => `
      <div class="edge-faq-item">
        <div class="edge-faq-q">${item.q}</div>
        <div class="edge-faq-a">${item.a}</div>
      </div>
    `).join('');
    this.openModal('modal-help-faq');
  },

  filterFeedByTopic: function(topicName) {
    this.navigateTo('community');
    this.activeFeedCategory = '全部';
    this.activeTopicFilter = topicName;
    const feedTabs = document.querySelectorAll('#community-feed-tabs .underline-tab');
    feedTabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-feedcat') === '全部'));
    this.renderCommunityFeed();
    this.showToast(`已按话题筛选：#${topicName}`);
    setTimeout(() => {
      const el = document.getElementById('community-feed-container');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 60);
  },

  openTopicsMoreModal: function() {
    const title = document.getElementById('edge-list-title');
    const sub = document.getElementById('edge-list-sub');
    const body = document.getElementById('edge-list-body');
    if (title) title.textContent = '热门话题';
    if (sub) sub.textContent = '点击话题可过滤社区动态';
    if (body) {
      body.innerHTML = (MockData.community.hotTopics || []).map(t => `
        <button type="button" class="edge-list-row" onclick="App.closeModal('modal-edge-list'); App.filterFeedByTopic('${t.name}')">
          <strong># ${t.name}</strong>
          <span>${t.discusses}</span>
        </button>
      `).join('');
    }
    this.openModal('modal-edge-list');
  },

  focusHotCircle: function(circleName) {
    this.navigateTo('community');
    setTimeout(() => {
      const list = document.getElementById('community-hot-circles-list');
      if (list) list.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.querySelectorAll('.circle-item-row').forEach(row => {
        const match = !circleName || row.getAttribute('data-circle-name') === circleName;
        row.classList.toggle('is-highlight', !!match && !!circleName);
        if (!circleName) row.classList.add('is-highlight');
      });
      setTimeout(() => {
        document.querySelectorAll('.circle-item-row.is-highlight').forEach(r => r.classList.remove('is-highlight'));
      }, 1600);
      this.showToast(circleName ? `已定位圈子：${circleName}` : '已定位热门圈子');
    }, 80);
  },

  openActiveRanksModal: function() {
    const period = this.activeRankPeriod || 'day';
    const ranks = (MockData.community.activeRanks && MockData.community.activeRanks[period]) || [];
    const title = document.getElementById('edge-list-title');
    const sub = document.getElementById('edge-list-sub');
    const body = document.getElementById('edge-list-body');
    if (title) title.textContent = '创作者活跃榜';
    if (sub) sub.textContent = period === 'day' ? '日榜' : (period === 'week' ? '周榜' : '月榜');
    if (body) {
      body.innerHTML = ranks.map(u => `
        <div class="edge-list-row is-static">
          <strong>${u.rank}. ${u.name} <span class="badge-level-soft">${u.level}</span></strong>
          <span>${u.hot}</span>
        </div>
      `).join('');
    }
    this.openModal('modal-edge-list');
  },

  openTasksLeaderboardModal: function() {
    const ranks = MockData.tasks.ranksWeek || [];
    const title = document.getElementById('edge-list-title');
    const sub = document.getElementById('edge-list-sub');
    const body = document.getElementById('edge-list-body');
    if (title) title.textContent = '任务排行榜';
    if (sub) sub.textContent = '本周接单达人';
    if (body) {
      body.innerHTML = ranks.map(u => `
        <div class="edge-list-row is-static">
          <strong>${u.rank}. ${u.name}</strong>
          <span>完成 ${u.taskCount} · 积分 ${u.points}</span>
        </div>
      `).join('');
    }
    this.openModal('modal-edge-list');
  },

  scrollToToolsCatalog: function() {
    this.navigateTo('tools');
    this.activeToolCategory = '全部';
    setTimeout(() => {
      const tabs = document.querySelectorAll('#tools-category-tabs .pill-tab');
      tabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-toolcat') === '全部'));
      this.renderHotTools();
      const grid = document.getElementById('hot-tools-grid');
      if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      this.showToast('已定位热门创作工具');
    }, 60);
  },

  refreshTodayRec: function() {
    const list = MockData.tasks.todayRec || [];
    if (list.length > 1) {
      list.push(list.shift());
    }
    this.renderTasks();
    this.showToast('已换一批今日推荐');
  },

  showMoreTransactions: function() {
    const extra = [
      {
        id: 'TXH1', type: '收入', name: '青春校园：AI漫画创作大赛 · 结算',
        amount: '+ ¥ 3,000.00', rawAmount: 3000, status: '已到账', statusType: 'success',
        time: '2024-05-10 18:00', category: '收入'
      },
      {
        id: 'TXH2', type: '收入', name: '内容分成 · 赛博朋克街景',
        amount: '+ ¥ 420.00', rawAmount: 420, status: '已到账', statusType: 'success',
        time: '2024-05-08 12:10', category: '收入'
      },
      {
        id: 'TXH3', type: '支出', name: '工具算力包续费',
        amount: '- ¥ 68.00', rawAmount: -68, status: '已完成', statusType: 'done',
        time: '2024-05-06 09:30', category: '支出'
      }
    ];
    const ids = new Set((MockData.assets.transactions || []).map(t => t.id));
    extra.forEach(tx => {
      if (!ids.has(tx.id)) MockData.assets.transactions.push(tx);
    });
    this.renderTransactionsTable();
    this.showToast('已加载更多历史明细');
  },

  handleCommonFuncClick: function(name) {
    if (name === '提现管理') {
      this.openModal('modal-withdraw');
    } else if (name === '积分兑换') {
      this.filterAssetsTab('AI积分');
      this.showToast('已定位 AI 积分明细');
    } else if (name === '赞赏记录' || name === '合作账单' || name === '发票管理') {
      this.filterAssetsTab('收入');
      this.showToast(`已打开收入明细 · ${name}`);
    } else if (name === '礼品卡' || name === '优惠券') {
      this.openHelpFaqModal();
      this.showToast(`${name}说明见帮助中心`);
    } else if (name === '更多功能') {
      this.openLevelPerksModal();
    } else {
      this.filterAssetsTab('全部');
      this.showToast(`已打开资产明细 · ${name}`);
    }
  },

  showToast: function(msg) {
    const toast = document.getElementById('global-toast');
    const text = document.getElementById('toast-message');
    if (toast && text) {
      text.innerText = msg;
      toast.classList.add('show');
      if (this._toastTimer) clearTimeout(this._toastTimer);
      this._toastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }
  },

listOrderToGallery: function(orderId) {
    // 兼容旧调用：改为申请上架
    this.requestGalleryListing(orderId);
  },

  // ====== 1. 驳回修改 / 申请返修 ======
  openRejectTaskModal: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) return;
    const revCount = order.revisionCount || 0;
    if (revCount >= 3) {
      this.showToast('该任务已达到最大返修次数(3次)，建议申请平台仲裁');
      return;
    }
    const idInput = document.getElementById('reject-order-id');
    const roundEl = document.getElementById('reject-round-label');
    const noteInput = document.getElementById('reject-note-input');
    const dlInput = document.getElementById('reject-deadline-input');
    if (idInput) idInput.value = orderId;
    if (roundEl) roundEl.textContent = `第 ${revCount + 1} / 3 次返修`;
    if (noteInput) noteInput.value = '';
    if (dlInput) {
      const d = new Date();
      d.setDate(d.getDate() + 2);
      dlInput.value = d.toISOString().split('T')[0];
    }
    this.openModal('modal-task-reject');
  },

  submitTaskRejection: function() {
    const id = document.getElementById('reject-order-id')?.value;
    const note = document.getElementById('reject-note-input')?.value.trim();
    const deadline = document.getElementById('reject-deadline-input')?.value;
    if (!note) {
      this.showToast('请填写具体的修改要求与说明');
      return;
    }
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;

    const related = (MockData.tasks.myOrders || []).filter(o =>
      o.sourceId && order.sourceId && o.sourceId === order.sourceId
    );
    const targets = related.length ? related : [order];
    const nextRound = (order.revisionCount || 0) + 1;

    targets.forEach(o => {
      o.status = '返修中';
      o.revisionCount = nextRound;
      if (!Array.isArray(o.revisions)) o.revisions = [];
      o.revisions.unshift({
        round: nextRound,
        note: note,
        deadline: deadline || '2天内',
        requestedAt: this.getDemoToday(),
        status: 'pending'
      });
      o.coreInfo = `返修中 (第${nextRound}/3次) · ${note.slice(0, 24)}…`;
    });

    this.closeModal('modal-task-reject');
    this.refreshTaskViews();
    this.showToast(`已向创作者发出第 ${nextRound} 次返修要求`);
  },

  // ====== 2. 提交交付成果 ======
  openSubmitDeliveryModal: function(orderId) {
    const idInput = document.getElementById('delivery-order-id');
    if (idInput) idInput.value = orderId;
    this.openModal('modal-submit-delivery');
  },

  doSubmitDelivery: function() {
    const id = document.getElementById('delivery-order-id')?.value;
    const url = document.getElementById('delivery-url-input')?.value.trim();
    const pwd = document.getElementById('delivery-pwd-input')?.value.trim();
    const fname = document.getElementById('delivery-filename-input')?.value.trim();
    const note = document.getElementById('delivery-note-input')?.value.trim();
    if (!url) {
      this.showToast('请填写交付网盘或在线预览链接');
      return;
    }
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;

    const related = (MockData.tasks.myOrders || []).filter(o =>
      o.sourceId && order.sourceId && o.sourceId === order.sourceId
    );
    const targets = related.length ? related : [order];

    targets.forEach(o => {
      o.status = '待验收';
      o.autoAcceptHoursRemain = 72;
      o.deliveryFile = {
        name: fname || '交付成片及工程文件.zip',
        url: url,
        pwd: pwd,
        note: note,
        submittedAt: this.getDemoToday() + ' 12:00'
      };
      o.coreInfo = '已提交交付 · 发布方验收倒计时 72:00:00 · 超期自动结算';
    });

    this.closeModal('modal-submit-delivery');
    this.refreshTaskViews();
    this.showToast('🎉 成片与交付物提交成功！发布方已进入 72 小时验收倒计时');
  },

  // ====== 3. 催促验收与超时模拟 ======
  remindTaskAcceptance: function(orderId) {
    this.showToast('🔔 加急催促通知已发送给发布方！若 72 小时内未验收，系统将自动确认并全额结算打款');
  },

  simulateAutoAccept: function(orderId) {
    this.acceptMyTaskDelivery(orderId);
    this.showToast('⏰ 模拟触发：发布方 72 小时验收倒计时超期，系统已自动确认验收并将赏金打款至你的账户！');
  },

  // ====== 4. 双向互评体系 ======
  openTaskEvaluateModal: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) return;
    const idInput = document.getElementById('evaluate-order-id');
    const roleInput = document.getElementById('evaluate-role');
    const targetBar = document.getElementById('evaluate-target-bar');
    const starsGroup = document.getElementById('evaluate-stars-group');
    const tagsGroup = document.getElementById('evaluate-quick-tags');
    const commentInput = document.getElementById('evaluate-comment-input');

    if (idInput) idInput.value = orderId;
    if (roleInput) roleInput.value = order.role;

    const isCreator = order.role === 'creator';
    if (targetBar) {
      targetBar.innerHTML = `
        <img src="${isCreator ? 'assets/avatars/user_profile_large.png' : (order.cover || 'assets/avatars/nearby_1.jpg')}" class="evaluate-target-avatar" alt="">
        <div>
          <div style="font-weight:700; color:var(--text-primary); font-size:14px;">评价对象：${order.counterpart || (isCreator ? '发布方' : '创作者')}</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">所属任务：${order.title} · ${order.rewardMoney}</div>
        </div>
      `;
    }

    const dims = isCreator
      ? [
          { key: 'clarity', label: '需求明确清晰度' },
          { key: 'communication', label: '沟通响应速度' },
          { key: 'settlement', label: '结款验收爽快度' }
        ]
      : [
          { key: 'quality', label: 'AI交付制作质量' },
          { key: 'punctuality', label: '按时交付准时率' },
          { key: 'attitude', label: '沟通与配合态度' }
        ];

    this._currentEvaluationRatings = { dim1: 5, dim2: 5, dim3: 5 };

    if (starsGroup) {
      starsGroup.innerHTML = dims.map((d, idx) => `
        <div class="evaluate-dimension-row">
          <span style="font-size:13px; font-weight:600; color:var(--text-primary);">${d.label}</span>
          <div class="evaluate-stars" data-dim="dim${idx + 1}">
            ${[1, 2, 3, 4, 5].map(star => `
              <button type="button" class="star-btn active" data-star="${star}" onclick="App.setEvalStar('dim${idx + 1}', ${star})">★</button>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    const quickTags = isCreator
      ? ['合作非常爽快', '需求沟通明确', '结算神速', '值得长期合作']
      : ['AI画面超惊艳', '交付准时高效', '专业技能扎实', '沟通顺畅细心'];

    if (tagsGroup) {
      tagsGroup.innerHTML = quickTags.map(t => `
        <span class="quick-tag-chip" onclick="this.classList.toggle('active')">${t}</span>
      `).join('');
    }

    if (commentInput) {
      commentInput.value = order.evaluation ? (order.evaluation.comment || '') : '';
    }

    this.openModal('modal-task-evaluate');
  },

  setEvalStar: function(dimKey, star) {
    if (!this._currentEvaluationRatings) this._currentEvaluationRatings = {};
    this._currentEvaluationRatings[dimKey] = star;
    const container = document.querySelector(`.evaluate-stars[data-dim="${dimKey}"]`);
    if (container) {
      container.querySelectorAll('.star-btn').forEach((btn, idx) => {
        btn.classList.toggle('active', idx < star);
      });
    }
  },

  submitTaskEvaluation: function() {
    const id = document.getElementById('evaluate-order-id')?.value;
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;

    const comment = document.getElementById('evaluate-comment-input')?.value.trim() || '合作非常顺畅愉快，5星好评！';
    const selectedTags = Array.from(document.querySelectorAll('#evaluate-quick-tags .quick-tag-chip.active')).map(el => el.textContent);

    const evalObj = {
      evaluatedAt: this.getDemoToday(),
      ratings: this._currentEvaluationRatings || { dim1: 5, dim2: 5, dim3: 5 },
      averageScore: 5.0,
      comment: comment,
      tags: selectedTags
    };

    const related = (MockData.tasks.myOrders || []).filter(o =>
      o.sourceId && order.sourceId && o.sourceId === order.sourceId
    );
    const targets = related.length ? related : [order];
    targets.forEach(o => {
      o.evaluation = evalObj;
      o.needEvaluation = false;
      o.coreInfo = '已完成结算 · 双方已互评 · 信用沉淀完成';
    });

    this.closeModal('modal-task-evaluate');
    this.refreshTaskViews();
    this.showToast('🌟 评价提交成功！信用积分已沉淀到双方主页与创作者评级');
  },

  // ====== 5. 平台争议仲裁 ======
  openDisputeModal: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) return;
    const idInput = document.getElementById('dispute-order-id');
    if (idInput) idInput.value = orderId;
    this.openModal('modal-task-dispute');
  },

  submitTaskDispute: function() {
    const id = document.getElementById('dispute-order-id')?.value;
    const type = document.getElementById('dispute-type-select')?.value;
    const reason = document.getElementById('dispute-reason-input')?.value.trim();
    if (!reason) {
      this.showToast('请填写详细的争议事实说明');
      return;
    }
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;

    const related = (MockData.tasks.myOrders || []).filter(o =>
      o.sourceId && order.sourceId && o.sourceId === order.sourceId
    );
    const targets = related.length ? related : [order];

    targets.forEach(o => {
      o.status = '仲裁中';
      o.dispute = {
        initiator: order.role,
        type: type,
        reason: reason,
        initiatedAt: this.getDemoToday() + ' 14:20',
        agentName: '官方履约纠纷调解员01号',
        status: '审核调查中'
      };
      o.coreInfo = `平台仲裁介入中 · ${type} · 24小时内出具调解方案`;
    });

    this.closeModal('modal-task-dispute');
    this.refreshTaskViews();
    this.showToast('⚖️ 仲裁申请已正式受理！平台已冻结资金并由专员接入调解');
  },

  // ====== 6. 展位管理与档期切换 ======
  openMyGalleryManageModal: function() {
    const status = MockData.tasks.gallery.myScheduleStatus || 'available';
    document.querySelectorAll('.schedule-switch-group .schedule-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-sch') === status);
    });

    const listEl = document.getElementById('my-booth-works-list');
    if (listEl) {
      const myWorks = (MockData.tasks.gallery.works || []).filter(w => (w.creator && w.creator.name === '小宇同学') || w.id === 'GW00');
      const approvedOrPending = (MockData.tasks.myOrders || []).filter(o => o.role === 'creator' && (o.listedToGallery || o.galleryApplyPending || o.galleryStatus === 'approved' || o.galleryStatus === 'pending'));

      let itemsHtml = myWorks.map(w => `
        <div class="booth-work-item">
          <div class="booth-work-left">
            <img src="${w.cover}" class="booth-work-cover" alt="">
            <div>
              <div style="font-weight:600; font-size:13.5px; color:var(--text-primary);">${w.title}</div>
              <div style="font-size:11.5px; color:var(--text-secondary); margin-top:2px;">参考报价：${w.priceRange} · 已交付 ${w.delivered || 0} 单</div>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="booth-status-pill is-active">展厅在售</span>
            <button type="button" class="hero-btn-secondary" style="padding:3px 8px; font-size:11px;" onclick="App.setTasksMode('gallery'); App.closeModal('modal-my-gallery-manage');">前往展厅</button>
          </div>
        </div>
      `).join('');

      approvedOrPending.forEach(o => {
        if (!myWorks.some(w => w.title.includes(o.title.slice(0, 8)))) {
          const isApp = o.galleryStatus === 'approved' || o.listedToGallery;
          itemsHtml += `
            <div class="booth-work-item">
              <div class="booth-work-left">
                <img src="${o.cover}" class="booth-work-cover" alt="">
                <div>
                  <div style="font-weight:600; font-size:13.5px; color:var(--text-primary);">${o.title}</div>
                  <div style="font-size:11.5px; color:var(--text-secondary); margin-top:2px;">源自任务交付 · ${o.rewardMoney}</div>
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:8px;">
                <span class="booth-status-pill ${isApp ? 'is-active' : 'is-audit'}">${isApp ? '展厅在售' : '平台审核中'}</span>
              </div>
            </div>
          `;
        }
      });

      listEl.innerHTML = itemsHtml || '<div class="gallery-empty">暂无展厅上架作品，完成任务后可申请入驻</div>';
    }

    this.openModal('modal-my-gallery-manage');
  },

  setCreatorSchedule: function(status) {
    MockData.tasks.gallery.myScheduleStatus = status;
    document.querySelectorAll('.schedule-switch-group .schedule-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-sch') === status);
    });
    // 更新小宇同学的作品档期
    (MockData.tasks.gallery.works || []).forEach(w => {
      if ((w.creator && w.creator.name === '小宇同学') || w.id === 'GW00') {
        w.scheduleStatus = status;
        w.available = status !== 'closed';
      }
    });
    this.renderGalleryPlaza();
    const map = { available: '可接单', busy: '档期紧张', closed: '暂停接单' };
    this.showToast(`接单档期已切换为：【${map[status] || status}】`);
  },

  simulateApproveGalleryListing: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) return;
    order.galleryStatus = 'approved';
    order.listedToGallery = true;
    order.galleryApplyPending = false;
    order.coreInfo = '已结算 · 作品已审核通过并入驻展厅！';

    // 动态添加一个展品到展厅
    const newWork = {
      id: 'GW-NEW-' + Date.now().toString().slice(-4),
      title: order.title,
      cover: order.cover,
      category: order.tags && order.tags[0] ? order.tags[0] : 'AI短视频',
      scene: '优质任务成果',
      badge: '我的展品',
      views: '1.2万',
      likes: '1,520',
      priceRange: order.rewardMoney || '¥1,500-3,000',
      cycle: '3-5 天',
      delivered: 1,
      tags: order.tags || ['精选交付'],
      source: '任务优质交付',
      available: true,
      scheduleStatus: MockData.tasks.gallery.myScheduleStatus || 'available',
      sourceTask: {
        id: order.sourceId || 'TK01',
        title: order.title,
        award: '任务精选交付'
      },
      creator: {
        name: '小宇同学',
        school: '南京大学',
        level: 'Lv.4',
        avatar: 'assets/avatars/user_profile_large.png'
      }
    };
    MockData.tasks.gallery.works.unshift(newWork);
    this.renderMyTasks();
    this.renderGalleryPlaza();
    this.showToast('🎉 审核通过！作品已正式在作品展厅上架，支持买家找你定制！');
  },

  // ====== 7. 展厅定向定制接单/婉拒 ======
  openCustomConfirmModal: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) return;
    const idInput = document.getElementById('custom-confirm-order-id');
    const cardEl = document.getElementById('custom-invite-card');
    if (idInput) idInput.value = orderId;
    if (cardEl) {
      cardEl.innerHTML = `
        <div style="display:flex; gap:12px; align-items:center; padding:12px; background:var(--bg-hover,#F8FAFC); border-radius:8px;">
          <img src="${order.cover}" style="width:64px; height:48px; border-radius:4px; object-fit:cover;" alt="">
          <div>
            <div style="font-weight:700; font-size:14px; color:var(--text-primary);">${order.title}</div>
            <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">来自客户：${order.counterpart || '买家'} · 托管赏金：<strong style="color:#EF4444;">${order.rewardMoney}</strong></div>
          </div>
        </div>
        <p style="font-size:12.5px; color:var(--text-secondary); line-height:1.6; margin-top:12px;">
          ${order.desc || '客户参考你在展厅的作品发起同款风格定制需求，赏金已100%全额托管至平台。接单后将进入履约制作流程。'}
        </p>
      `;
    }
    this.openModal('modal-custom-confirm');
  },

  confirmCustomOrder: function() {
    const id = document.getElementById('custom-confirm-order-id')?.value;
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;
    order.status = '进行中';
    order.coreInfo = '履约中 · 定制商单制作中 · 待交付';
    this.closeModal('modal-custom-confirm');
    this.refreshTaskViews();
    this.showToast('🤝 已成功接单！请按期推进制作，可在履约中提交每日进度');
  },

  declineCustomOrder: function() {
    const id = document.getElementById('custom-confirm-order-id')?.value;
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;
    order.status = '未成交';
    order.coreInfo = '未成交 · 创作者档期冲突已婉拒 · 赏金已全额退还客户';
    this.closeModal('modal-custom-confirm');
    this.refreshTaskViews();
    this.showToast('已婉拒该定制邀请，客户托管赏金已全额退还');
  },

  republishTask: function(orderId) {
    this.openPublishTaskPage();
    this.showToast('已载入未成交任务需求，请调整预算或交付时间后重新上架');
  },

openWorkPlayer: function(title) {
    const work = (MockData.discover.works || []).find(w => w.title === title) || (MockData.discover.works || [])[0];
    if (work) {
      this.openWorkDetailModal(work.id);
    } else {
      this.showToast(`🎬 正在播放高清作品：《${title}》`);
    }
  },

  openWorkDetailModal: function(workId) {
    const works = MockData.discover.works || [];
    const work = works.find(w => w.id === Number(workId) || w.title === workId) || works[0];
    const body = document.getElementById('work-detail-modal-body');
    if (!work || !body) return;

    body.innerHTML = `
      <div class="work-detail-container" style="display:flex; flex-direction:column; gap:16px;">
        <!-- 作品顶部 Hero 区域 -->
        <div class="work-detail-hero" style="display:flex; gap:20px; flex-wrap:wrap; background:#0F172A; border-radius:14px; padding:18px; color:#F8FAFC;">
          <div style="flex:1; min-width:280px; position:relative; border-radius:10px; overflow:hidden; background:#000; max-height:260px; display:flex; align-items:center; justify-content:center;">
            <img src="${work.cover}" alt="${work.title}" style="width:100%; height:100%; object-fit:cover; opacity:0.9;">
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
              <button type="button" class="hero-btn-primary" style="border-radius:50px; padding:10px 22px; font-size:14px; box-shadow:0 8px 24px rgba(0,0,0,0.5);" onclick="App.showToast('正在播放《${App.escapeAttr(work.title)}》超清原画母带')">▶ 播放成片 (${work.duration || '02:30'})</button>
            </div>
            <span style="position:absolute; top:10px; left:10px; background:rgba(0,0,0,0.6); padding:3px 8px; border-radius:4px; font-size:11px; color:#38BDF8;">4K 60FPS</span>
            <span style="position:absolute; bottom:10px; right:10px; background:rgba(0,0,0,0.6); padding:3px 8px; border-radius:4px; font-size:11px;">👁️ ${work.views} · ❤️ ${work.likesDisplay || work.likes}</span>
          </div>
          <div style="flex:1; min-width:280px; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px;">
                <span class="academy-chip" style="background:rgba(99,102,241,0.2); color:#A5B4FC; border-color:rgba(99,102,241,0.4);">${work.category || 'AI精品'}</span>
                <span class="academy-chip" style="background:rgba(16,185,129,0.2); color:#6EE7B7; border-color:rgba(16,185,129,0.4);">${work.capabilityTag || '官方认证'}</span>
                <span style="font-size:12px; color:#94A3B8;">${work.matrixSync || '全网同步'}</span>
              </div>
              <h2 style="font-size:20px; font-weight:800; color:#FFF; margin:0 0 10px 0; line-height:1.4;">${work.title}</h2>
              <div style="display:flex; align-items:center; gap:10px; padding:10px 12px; background:rgba(255,255,255,0.06); border-radius:8px; margin-bottom:12px;">
                <img src="assets/avatars/user_header.png" alt="" style="width:36px; height:36px; border-radius:50%;">
                <div style="flex:1;">
                  <div style="font-size:13px; font-weight:700; color:#FFF;">${work.author} <span style="font-size:11px; color:#F59E0B; margin-left:4px;">${work.level || 'Lv.4 商业创作者'}</span></div>
                  <div style="font-size:11px; color:#94A3B8;">${work.school || '高等院校创作者'} · ${work.completedTasks || '商业商单履约中'}</div>
                </div>
                <button type="button" class="hero-btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="App.closeModal('modal-work-detail'); App.navigateTo('assets');">作者主页</button>
              </div>
            </div>
            <div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:10px 12px;">
              <div style="font-size:11px; color:#94A3B8;">商业委托参考报价</div>
              <div style="font-size:18px; font-weight:800; color:#10B981; margin:2px 0;">${work.customPrice || '¥ 1,500 ~ 3,000 / 支'}</div>
              <div style="font-size:11px; color:#CBD5E1;">通过平台担保交易，100% 资金监管专户托管，支持 72h 验收打款与版权买断</div>
            </div>
          </div>
        </div>

        <!-- 联动核心板块 1：公开提示词配方（直通创作工具） -->
        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:12px; padding:14px 16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <div style="display:flex; align-items:center; gap:6px; font-weight:700; color:var(--text-primary); font-size:14px;">
              <span>🧩 公开提示词工程配方 (Prompt Recipe)</span>
              <span style="font-size:11px; color:#6366F1; background:#EEF2FF; padding:2px 8px; border-radius:4px;">生成工具：${work.tool || '文生视频'}</span>
            </div>
            <div style="display:flex; gap:8px;">
              <button type="button" class="hero-btn-secondary" style="padding:4px 10px; font-size:12px;" onclick="App.copyPromptText('${App.escapeAttr(work.prompt || '')}')">📋 复制配方</button>
              <button type="button" class="hero-btn-primary" style="padding:4px 12px; font-size:12px;" onclick="App.applyPromptToStudio('${App.escapeAttr(work.prompt || '')}', '${App.escapeAttr(work.tool || '文生视频')}')">✨ 一键套用同款制作</button>
            </div>
          </div>
          <div style="background:#FFF; border:1px solid #E2E8F0; border-radius:8px; padding:10px 12px; font-family:monospace; font-size:12px; color:#334155; line-height:1.6; max-height:80px; overflow-y:auto;">
            ${work.prompt || '未来赛博朋克风校园，大学生操纵全息投影进行代码实验，高质感电影光影，8k分辨率 --kling v1.5'}
          </div>
        </div>

        <!-- 联动核心板块 2：商业定制通道（直通任务广场通道B） -->
        <div style="background:#FFFBEB; border:1px solid #FDE68A; border-radius:12px; padding:14px 16px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-weight:700; color:#B45309; font-size:14px; margin-bottom:4px;">💼 想要定制类似质量的商业成片？</div>
            <div style="font-size:12px; color:#78350F;">以该作品作为交付交付质量基准，直接向作者发起定向约单（任务广场通道 B）。创作者 24h 确认，享受 72h 超时验收保护与 CA 电子版权买断。</div>
          </div>
          <button type="button" class="hero-btn-primary" style="background:#D97706; border-color:#D97706; white-space:nowrap; padding:8px 18px; font-size:13px;" onclick="App.orderCustomWork('${App.escapeAttr(work.title)}', '${App.escapeAttr(work.author)}')">
            找 TA 定制同款
          </button>
        </div>
      </div>
    `;

    this.openModal('modal-work-detail');
  },

  copyPromptText: function(text) {
    if (!text) {
      this.showToast('暂无提示词');
      return;
    }
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text);
      this.showToast('✅ 提示词已复制到剪贴板！');
    } else {
      this.showToast('提示词已复制');
    }
  },

  applyPromptToStudio: function(prompt, toolTitle) {
    this.closeModal('modal-work-detail');
    this.navigateTo('tools');
    this.openAIWorkbench(toolTitle || 'AI 创作工作台');
    const input = document.getElementById('studio-prompt-input');
    if (input) {
      input.value = prompt;
      input.focus();
    }
    this.showToast(`✨ 已为您将《${toolTitle}》同款提示词配方无缝加载至工作台！`);
  },

  orderCustomWork: function(workTitle, author) {
    this.closeModal('modal-work-detail');
    this.navigateTo('tasks');
    this.setTasksMode('gallery', true);
    this.showToast(`🎯 已锁定《${workTitle}》作为交付基准件，已为您打开【任务广场 · 展厅定向约单】通道！`);
  },

  simulateGenerate: function() {
    const btn = document.getElementById('btn-studio-generate');
    const status = document.getElementById('studio-preview-status');
    const progress = document.getElementById('studio-progress-bar');
    const pubBtn = document.getElementById('btn-studio-publish');
    const deliverBtn = document.getElementById('btn-studio-deliver');
    const showcaseBtn = document.getElementById('btn-studio-showcase');
    const promptEl = document.getElementById('studio-prompt-input');
    const toolTitle = (document.getElementById('modal-studio-title') || {}).innerText || 'AI 创作';

    btn.disabled = true;
    btn.innerText = 'AI 渲染中...';
    if (pubBtn) pubBtn.hidden = true;
    if (deliverBtn) deliverBtn.hidden = true;
    if (showcaseBtn) showcaseBtn.hidden = true;
    status.innerText = '⚡ 正在调用 GPU 集群渲染超分辨率分镜... (扣减创作积分 20 分)';
    progress.style.width = '100%';

    setTimeout(() => {
      btn.disabled = false;
      btn.innerText = '再次生成';
      status.innerHTML = '🎉 <strong>生成成功！</strong> 分辨率 4K · 耗时 1.8s · 质量评分 9.8/10 · 已同步至【我的资产】';
      const prompt = (promptEl && promptEl.value.trim()) || '';
      this.lastStudioDraft = {
        title: `${toolTitle.replace(/^AI\s*/, '')}作品 · ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`,
        category: 'AI短视频',
        content: prompt ? `用 ${toolTitle} 生成：${prompt}` : `刚用「${toolTitle}」完成一版新作品，欢迎来社区交流～`,
        cover: 'assets/covers/work_1.png',
        toolTitle: toolTitle
      };
      if (pubBtn) pubBtn.hidden = false;
      if (deliverBtn) deliverBtn.hidden = false;
      if (showcaseBtn) showcaseBtn.hidden = false;
      
      // 联动：创作成果自动沉淀入我的资产
      if (MockData.assets && MockData.assets.works) {
        MockData.assets.works.unshift({
          title: this.lastStudioDraft.title,
          category: 'AI视频',
          duration: '01:15',
          views: '0',
          likes: 0,
          cover: this.lastStudioDraft.cover,
          tag: '最新生成',
          status: '已就绪'
        });
      }

      this.showToast('🎉 生成成功！已为您点亮跨模块流转通道（交付商单 / 上架展厅 / 分享社区）');
    }, 1800);
  },

  submitStudioToTask: function() {
    if (!this.lastStudioDraft) {
      this.showToast('请先完成一次生成');
      return;
    }
    this.closeModal('modal-studio');
    this.navigateTo('tasks');
    this.switchMyTasksView('taken', '进行中');
    this.showToast(`💼 成片已成功挂载为商单交付物！已为您跳转至【任务广场 · 履约台账】`);
  },

  publishStudioToShowcase: function() {
    if (!this.lastStudioDraft) {
      this.showToast('请先完成一次生成');
      return;
    }
    const newWork = {
      id: Date.now(),
      title: this.lastStudioDraft.title,
      author: (MockData.currentUser && MockData.currentUser.name) || '小宇同学',
      school: (MockData.currentUser && MockData.currentUser.school) || '南京大学',
      authorLine: `@${(MockData.currentUser && MockData.currentUser.name) || '小宇同学'}`,
      tag: '精选',
      category: '热门榜单',
      duration: '01:15',
      views: '1',
      likes: 1,
      likesDisplay: '1',
      cover: this.lastStudioDraft.cover || 'assets/covers/work_1.png',
      capabilityTag: '最新上架',
      matrixSync: '展厅首发',
      level: 'Lv.4 商业创作者',
      completedTasks: '1 单已履约',
      customPrice: '¥ 1,500 ~ 2,500 / 支',
      tool: this.lastStudioDraft.toolTitle || '文生视频',
      prompt: this.lastStudioDraft.content
    };
    MockData.discover.works.unshift(newWork);
    this.closeModal('modal-studio');
    this.navigateTo('discover');
    this.renderDiscoverWorks();
    this.showToast('✨ 成果已一键上架至【发现页】作品展厅，全网买家均可发起定向约单！');
  },

  publishFromStudio: function() {
    if (!this.lastStudioDraft) {
      this.showToast('请先完成一次生成');
      return;
    }
    const ok = this.submitPublishWork({
      title: this.lastStudioDraft.title,
      category: this.lastStudioDraft.category,
      content: this.lastStudioDraft.content,
      cover: this.lastStudioDraft.cover,
      platforms: ['douyin', 'xiaohongshu', 'tiktok', 'youtube'],
      keepModalOpen: true,
      toast: '🎉 已发布并矩阵分发，可在数据中心查看回流'
    });
    if (ok) {
      this.closeModal('modal-studio');
      this.navigateTo('community');
    }
  },

  // =========================================================================
  // 8. 系统管理与治理控制中心 (System Admin & RBAC)
  // =========================================================================
  openSystemAdminModal: function(tabKey) {
    this.currentSysAdminTab = tabKey || 'roles';
    this.renderSystemAdminTab();
    this.openModal('modal-system-admin');
  },

  switchSystemAdminTab: function(tabKey) {
    this.currentSysAdminTab = tabKey;
    const tabs = document.querySelectorAll('#sysadmin-tabs .pill-tab');
    tabs.forEach(t => {
      t.classList.toggle('active', t.getAttribute('data-systab') === tabKey);
    });
    this.renderSystemAdminTab();
  },

  renderSystemAdminTab: function() {
    const tab = this.currentSysAdminTab || 'roles';
    const body = document.getElementById('sysadmin-tab-body');
    if (!body) return;
    const adminData = MockData.systemAdmin || {};

    if (tab === 'roles') {
      const roles = adminData.roles || [];
      const currKey = adminData.currentRole || 'creator';
      body.innerHTML = `
        <div style="margin-bottom:12px; font-size:13px; color:var(--text-secondary);">
          系统采用细粒度 RBAC 权限隔离机制。您可在此<strong>一键切换当前模拟视角</strong>，体验不同角色在发现页、成长学院、任务广场等模块的专属权限与操作矩阵：
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          ${roles.map(r => {
            const isCurr = r.key === currKey;
            return `
              <div style="border:${isCurr ? '2px solid var(--primary)' : '1px solid var(--border-color)'}; background:${isCurr ? 'var(--primary-light)' : '#FFF'}; border-radius:12px; padding:14px; display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                    <strong style="font-size:14px; color:${r.badgeColor};">${r.name}</strong>
                    <span style="font-size:11px; background:${isCurr ? 'var(--primary)' : '#E2E8F0'}; color:${isCurr ? '#FFF' : '#475569'}; padding:2px 8px; border-radius:4px; font-weight:600;">
                      ${isCurr ? '当前激活' : r.tag}
                    </span>
                  </div>
                  <p style="font-size:12px; color:var(--text-secondary); margin:0 0 10px 0; line-height:1.5;">${r.desc}</p>
                </div>
                <button type="button" class="hero-btn-${isCurr ? 'primary' : 'secondary'}" style="padding:6px 12px; font-size:12px;" onclick="App.switchSystemRole('${r.key}')" ${isCurr ? 'disabled' : ''}>
                  ${isCurr ? '✓ 正在以此身份操作' : '⚡ 切换为此身份体验'}
                </button>
              </div>
            `;
          }).join('')}
        </div>
      `;
    } else if (tab === 'membership') {
      const mem = adminData.membership || {};
      body.innerHTML = `
        <div style="background:linear-gradient(135deg, #1E293B, #0F172A); border-radius:14px; padding:18px; color:#FFF; margin-bottom:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <span style="background:linear-gradient(90deg, #F59E0B, #D97706); font-size:11px; font-weight:800; padding:3px 8px; border-radius:4px; color:#FFF;">PRO MEMBER</span>
              <h3 style="font-size:20px; font-weight:800; margin:6px 0 2px 0;">${mem.tierName}</h3>
              <div style="font-size:12px; color:#94A3B8;">有效期至：${mem.expireDate} · 自动续费开启中</div>
            </div>
            <button type="button" class="hero-btn-primary" style="background:#F59E0B; border-color:#F59E0B;" onclick="App.showToast('Pro 会员特权已全站生效中！')">会员权益有效中</button>
          </div>
        </div>
        <h4 style="font-size:14px; font-weight:700; margin:0 0 10px 0;">已点亮的跨模块商业特权矩阵：</h4>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          ${(mem.privileges || []).map(p => `
            <div style="border:1px solid #E2E8F0; background:#FFF; border-radius:10px; padding:12px; display:flex; gap:10px; align-items:center;">
              <span style="font-size:24px;">${p.icon}</span>
              <div>
                <strong style="font-size:13px; color:var(--text-primary);">${p.title}</strong>
                <div style="font-size:11px; color:var(--text-muted);">${p.desc}</div>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    } else if (tab === 'risk') {
      const r = adminData.riskControl || {};
      body.innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:16px;">
          <div class="academy-stat-card"><em style="font-size:11px;">全域合规安全指数</em><strong style="color:#10B981;">${r.healthScore}<span>分</span></strong></div>
          <div class="academy-stat-card"><em style="font-size:11px;">72h 看门狗守护任务</em><strong style="color:#6366F1;">${r.watchdogActiveTasks}<span>单</span></strong></div>
          <div class="academy-stat-card"><em style="font-size:11px;">欺诈拦截与黑名单</em><strong style="color:#EF4444;">${r.fraudBlockedCount}<span>起</span></strong></div>
        </div>
        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:10px; padding:14px; font-size:12px; line-height:1.8; color:#334155;">
          <div>🛡️ <strong>多模态机审探针</strong>：已累计审核文本、提示词、成片 <strong>${r.contentAuditCount}</strong> 次，近 24 小时零违规漏网。</div>
          <div>🐕 <strong>任务广场 SLA 看门狗</strong>：实时轮询监控交付成片 72 小时免签自动放款与 3 次返修熔断判定。</div>
          <div>🔒 <strong>提现合规审查</strong>：实名 KYC 与银行专户双向校验已全量开启，保障双方资金 100% 安全合规。</div>
        </div>
      `;
    } else if (tab === 'economy') {
      const e = adminData.economy || {};
      body.innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:16px;">
          <div class="academy-stat-card"><em style="font-size:11px;">全网总发行积分</em><strong style="color:#6366F1;">${e.totalPointsIssued}</strong></div>
          <div class="academy-stat-card"><em style="font-size:11px;">生产与兑换消耗</em><strong style="color:#10B981;">${e.totalPointsBurned}</strong></div>
          <div class="academy-stat-card"><em style="font-size:11px;">通胀调控状态</em><strong style="font-size:16px; color:#059669;">${e.status}</strong></div>
        </div>
        <div style="background:#EEF2FF; border:1px solid #C7D2FE; border-radius:10px; padding:14px; font-size:12px; color:#3730A3; line-height:1.7;">
          <div>💎 <strong>积分与算力锚定机制</strong>：当前基准比率为 <strong>${e.ratio}</strong>。学员在成长学院每看一节视频获取的 +30 创作积分，可直接充当 3 次高清生成算力或在任务广场抵扣保证金。</div>
          <div>🔄 <strong>经济系统自洽闭环</strong>：看视频获积分 ➔ 创作工具实操消耗 ➔ 优质成果送展获商单 ➔ 赚取真实法币赏金，全流程无通胀淤积。</div>
        </div>
      `;
    }
  },

  switchSystemRole: function(roleKey) {
    if (!MockData.systemAdmin) return;
    MockData.systemAdmin.currentRole = roleKey;
    (MockData.systemAdmin.roles || []).forEach(r => {
      r.active = (r.key === roleKey);
    });
    const found = (MockData.systemAdmin.roles || []).find(r => r.key === roleKey);
    this.renderSystemAdminTab();
    this.showToast(`🎭 角色权限已切换为【${found ? found.name : roleKey}】，全系统权限与鉴权矩阵已实时生效！`);
  },

  handleUpgradePro: function() {
    this.closeModal('modal-pro');
    if (MockData.systemAdmin && MockData.systemAdmin.membership) {
      MockData.systemAdmin.membership.currentTier = 'pro';
    }
    this.showToast('👑 恭喜你已成功开通 AI 创作者社区 Pro 尊享会员！已为您解锁 GPU VIP 极速渲染与商单免押金特权 💎');
  },

// ====== 作品展厅点赞交互 ======
  toggleGalleryWorkLike: function(workId) {
    const gallery = (window.MockData && window.MockData.tasks && window.MockData.tasks.gallery) || (window.MockData && window.MockData.gallery);
    if (!gallery || !Array.isArray(gallery.works)) return;
    const work = gallery.works.find(w => String(w.id) === String(workId));
    if (!work) return;

    if (work._originalLikes == null) {
      work._originalLikes = typeof work.likes === 'number' ? work.likes : (parseInt(String(work.likes || 480).replace(/[^\d]/g, ''), 10) || 480);
    }

    work.isLiked = !work.isLiked;
    if (work.isLiked) {
      work.likes = work._originalLikes + 1;
      this.showToast(`已为作品《${work.title || '精选创作'}》点赞！创作鼓励已同步作者 ❤️`);
    } else {
      work.likes = work._originalLikes;
      this.showToast(`已取消对作品《${work.title || '精选创作'}》的点赞`);
    }
    if (typeof this.renderGalleryPlaza === 'function') {
      this.renderGalleryPlaza();
    }
  },

  // ====== 自定义弹窗支持 ======
  showCustomModal: function(title, contentHtml) {
    let modal = document.getElementById('modal-custom-dynamic');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'modal-custom-dynamic';
      modal.className = 'modal-overlay';
      modal.innerHTML = `
        <div class="modal-dialog" style="max-width:640px;width:90%;">
          <div class="modal-header">
            <div class="modal-title" id="custom-dynamic-title"></div>
            <button type="button" class="modal-close" onclick="App.closeCustomModal()">&times;</button>
          </div>
          <div class="modal-body" id="custom-dynamic-body" style="padding:20px;max-height:75vh;overflow-y:auto;"></div>
        </div>
      `;
      document.body.appendChild(modal);
    }
    document.getElementById('custom-dynamic-title').textContent = title || '详细信息';
    document.getElementById('custom-dynamic-body').innerHTML = contentHtml || '';
    modal.classList.add('active');
  },

  closeCustomModal: function() {
    const modal = document.getElementById('modal-custom-dynamic');
    if (modal) modal.classList.remove('active');
    const legacy = document.getElementById('academy-dynamic-modal');
    if (legacy) legacy.classList.remove('active');
  },

  // ====== 成长学院二级页面流转 ======
  closeAcademySubPage: function() {
    ['academy-courses-page', 'academy-resource-page', 'academy-lesson-page'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    const mainAcademy = document.getElementById('view-academy');
    if (mainAcademy) mainAcademy.style.display = 'block';
  },

  backFromAcademyLesson: function() {
    const lessonEl = document.getElementById('academy-lesson-page');
    if (lessonEl) lessonEl.style.display = 'none';
    const coursesEl = document.getElementById('academy-courses-page');
    if (coursesEl) {
      coursesEl.style.display = 'block';
    } else {
      this.closeAcademySubPage();
    }
  },

  openAcademyAllCourses: function() {
    this.closeAcademySubPage();
    const coursesEl = document.getElementById('academy-courses-page');
    if (coursesEl) {
      coursesEl.style.display = 'block';
      const mainEl = document.getElementById('view-academy');
      if (mainEl) mainEl.style.display = 'none';
    }
    this.showToast('已进入实战课程中心');
  },

  openAcademyResource: function() {
    this.closeAcademySubPage();
    const resEl = document.getElementById('academy-resource-page');
    if (resEl) {
      resEl.style.display = 'block';
      const mainEl = document.getElementById('view-academy');
      if (mainEl) mainEl.style.display = 'none';
    }
    this.showToast('已进入学习资源库');
  },

  openAcademyRecords: function() {
    this.openModal('modal-my-certs');
  },

  // ====== 任务发布页面交互 ======
  openPublishTaskModal: function() {
    this.openPublishTaskPage();
  },

  openPublishTaskPage: function() {
    if (this.currentView !== 'tasks') this.navigateTo('tasks');
    this.closeTaskDetailPage();
    const p = document.getElementById('tasks-publish-page');
    if (p) p.style.display = 'block';
    const l = document.getElementById('tasks-list-page');
    if (l) l.style.display = 'none';
  },

  closePublishTaskPage: function() {
    const p = document.getElementById('tasks-publish-page');
    if (p) p.style.display = 'none';
    const l = document.getElementById('tasks-list-page');
    if (l) l.style.display = 'block';
  },

  closeTaskDetailPage: function() {
    const d = document.getElementById('tasks-detail-page');
    if (d) d.style.display = 'none';
    const l = document.getElementById('tasks-list-page');
    if (l) l.style.display = 'block';
  },

  clearPublishTaskCover: function() {
    const img = document.getElementById('pt-cover-img');
    if (img) img.src = '';
    const preview = document.getElementById('pt-cover-preview');
    if (preview) preview.style.display = 'none';
    const uploadArea = document.getElementById('pt-cover-upload-area');
    if (uploadArea) uploadArea.style.display = 'block';
  },

  syncPublishAcceptModeUI: function() {
    const autoRadio = document.querySelector('input[name="pt-accept-mode"][value="auto"]');
    const isAuto = autoRadio && autoRadio.checked;
    const tip = document.getElementById('pt-accept-mode-tip');
    if (tip) {
      tip.textContent = isAuto
        ? '🤖 算法自动匹配：系统将按 6 维信誉模型（信用分≥785分）秒级直聘最优创作者，免保证金进入制作。'
        : '🤝 人工逐一挑选：发包方在投标截止后，人工审阅各创作者提案成片方案并指名签约。';
    }
  },

  submitPublishTask: function(isDraft) {
    const titleInput = document.getElementById('pt-title-input');
    const title = titleInput ? titleInput.value.trim() : 'AI商业短视频项目';
    if (!title && !isDraft) {
      this.showToast('请填写任务标题！');
      return;
    }
    this.showToast(isDraft ? '已将任务保存至草稿箱' : '🎉 任务发布成功！资金已全额托管并进入大厅招募');
    this.closePublishTaskPage();
    this.navigateTo('tasks');
  },

  // ====== 系统管理面板 ======
  openSystemAdminModal: function() {
    this.openModal('modal-system-admin');
  },

  switchSystemAdminTab: function(tabName) {
    document.querySelectorAll('#modal-system-admin .system-admin-tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === tabName);
    });
    document.querySelectorAll('#modal-system-admin .system-admin-tab-content').forEach(pane => {
      pane.style.display = pane.getAttribute('data-tab-content') === tabName ? 'block' : 'none';
    });
  },

  // ====== 证书弹窗 ======
  openMyCertsModal: function() {
    const body = document.getElementById('my-certs-body');
    if (!body) return;
    const certs = (MockData.academy && MockData.academy.certificates) || [
      { id: 'cert_1', title: 'AI 科幻短剧商业创作专项认证', level: 'Lv.3', issuer: '成长学院 · 官方认证', date: '2026-09-10' },
      { id: 'cert_2', title: 'Sora 级生成式短视频全流程通关证书', level: 'Lv.4', issuer: '南京大学创客中心 · 官方结业', date: '2026-09-15' }
    ];
    body.innerHTML = `
      <div class="edge-certs-section" style="padding:10px 0;">
        <div class="edge-certs-label" style="font-weight:bold;margin-bottom:12px;color:var(--text-primary);">官方结业证书与学分凭证（` + String(certs.length) + `）</div>
        <div class="edge-certs-cards" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          ` + certs.map(c => `
            <div class="edge-cert-card" style="padding:14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:10px;">
              <div class="edge-cert-level" style="font-size:12px;color:var(--primary);font-weight:bold;">` + c.level + `</div>
              <div class="edge-cert-title" style="font-size:14px;font-weight:bold;margin:4px 0;">` + c.title + `</div>
              <div class="edge-cert-sub" style="font-size:12px;color:var(--text-muted);">` + c.issuer + ` · ` + (c.date || '') + `</div>
            </div>
          `).join('') + `
        </div>
      </div>
    `;
    this.openModal('modal-my-certs');
  }
};

window.App = App;

// DOM 加载就绪后启动
document.addEventListener('DOMContentLoaded', () => {
  App.init();
});
