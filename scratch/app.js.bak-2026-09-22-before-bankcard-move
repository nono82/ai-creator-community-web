  // =========================================================================
  // 全局交互模态弹窗与工具方法
  // =========================================================================
  openModal: function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('active');
    }
    if (modalId === 'modal-withdraw') {
      // 提现四道闸静态口径：实名状态 / 规则校验 / 收款账户（仅同名借记卡可用）
      const rules = this.getWithdrawRules();
      const info = this.getAccountBalance();
      const cap = Math.min(info.withdrawable, rules.maxPerTx);
      const input = document.getElementById('withdraw-amount-input');
      if (input) {
        input.max = rules.maxPerTx;
        input.placeholder = `输入提现金额，当前可提现 ¥ ${this.formatMoney(info.withdrawable)}`;
        const v = parseFloat(input.value);
        if (isNaN(v) || v <= 0 || v > cap) {
          input.value = Math.max(0, Math.min(1000, cap)).toFixed(0);
        }
      }
      this.refreshWithdrawPanel();
      this.onWithdrawAmountInput();
    }
    if (modalId === 'modal-pro') {
      // Pro 订阅走独立结算通道：弹窗内只需同步「方案选择」与「会员有效期」状态
      this.selectProPlan(this._proPlan || 'year');
      this.renderProMembershipStrip();
    }
    if (modalId === 'modal-bank-card-bind') {
      // 绑卡 / 换绑弹窗：同步实名状态条与提交按钮可用态
      this.refreshBankBindPanel();
    }
    if (modalId === 'modal-account-recharge') {
      // 充值合规兜底：只能使用已绑定的本人同名借记卡（防止绕过 openAccountRechargeModal 直开）
      this.refreshRechargePanel();
    }
