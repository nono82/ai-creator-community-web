  // ====== 商单资金托管库 · 托管进度（当前商户名下全部托管项目） ======

  // 读取当前商户名下全部托管项目，按冻结时间倒序（最新在前）
  getEscrowProjects: function() {
    const list = (MockData.assets.escrowProjects || []).slice();
    return list.sort((a, b) => (b.frozenAtTs || 0) - (a.frozenAtTs || 0));
  },

  // 汇总托管台账：托管中金额 / 进行中项目数 / 累计已结算金额
  getEscrowSummary: function(list) {
    const all = list || this.getEscrowProjects();
    let frozen = 0, activeCount = 0, settled = 0;
    all.forEach((p) => {
      const amt = Number(p.amount) || 0;
      if (p.statusKey === 'active') {
        frozen += amt;
        activeCount += 1;
      } else if (p.status === '已结算') {
        settled += amt;
      }
    });
    return { frozen: frozen, activeCount: activeCount, settled: settled, total: all.length };
  },

  // 托管库卡片文案：与资产卡「冻结金额」保持同一真源
  renderEscrowLibraryCard: function() {
    const el = document.getElementById('escrow-library-desc');
    if (!el) return;
    const sum = this.getEscrowSummary();
    el.innerText = `已安全托管未结算商单款项 ¥ ${sum.frozen.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}，完工立即到账`;
  },

  // 打开商单资金托管库 · 托管进度弹窗
  openEscrowProgressModal: function() {
    this._escrowFilter = 'all';
    this.renderEscrowProgress();
    this.openModal('modal-escrow-progress');
  },

  // 切换托管项目筛选（全部 / 进行中 / 已结算）
  filterEscrowProjects: function(filter) {
    this._escrowFilter = ['all', 'active', 'settled'].indexOf(filter) >= 0 ? filter : 'all';
    const tabs = document.querySelectorAll('#escrow-filter-tabs .pill-tab');
    for (let i = 0; i < tabs.length; i++) {
      tabs[i].classList.toggle('active', tabs[i].getAttribute('data-filter') === this._escrowFilter);
    }
    this.renderEscrowProgress();
  },

  // 渲染托管进度：汇总条 + 按冻结时间倒序的项目列表
  renderEscrowProgress: function() {
    const all = this.getEscrowProjects();
    const sum = this.getEscrowSummary(all);
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };
    set('escrow-total-frozen', '¥ ' + sum.frozen.toLocaleString('zh-CN', { minimumFractionDigits: 2 }));
    set('escrow-active-count', sum.activeCount + ' 个');
    set('escrow-settled-total', '¥ ' + sum.settled.toLocaleString('zh-CN', { minimumFractionDigits: 2 }));

    const filter = this._escrowFilter || 'all';
    const rows = all.filter((p) => filter === 'all'
      || (filter === 'active' ? p.statusKey === 'active' : p.statusKey === 'settled'));

    const label = document.getElementById('escrow-list-label');
    if (label) label.innerText = `托管项目列表（按冻结时间倒序 · 共 ${rows.length} 个项目）`;

    const box = document.getElementById('escrow-project-list');
    if (!box) return;
    if (rows.length === 0) {
      box.innerHTML = '<div class="escrow-empty">暂无托管项目</div>';
      return;
    }

    box.innerHTML = rows.map((p) => {
      const isActive = p.statusKey === 'active';
      const progress = Math.max(0, Math.min(100, Number(p.progress) || 0));
      const amount = Number(p.amount).toLocaleString('zh-CN', { minimumFractionDigits: 2 });
      return `
        <div class="escrow-project-item ${isActive ? '' : 'is-settled'}">
          <div class="escrow-project-head">
            <span class="escrow-project-title">${p.title}</span>
            <span class="escrow-status-pill ${isActive ? 'is-active' : 'is-done'}">${p.status}</span>
          </div>
          <div class="escrow-project-meta">${p.orderNo} · ${p.counterpart} · 本商户角色 ${p.role}</div>
          <div class="escrow-project-bar"><span style="width:${progress}%"></span></div>
          <div class="escrow-project-stage">${p.stage}</div>
          <div class="escrow-project-foot">
            <span class="escrow-amount-label">${isActive ? '冻结金额' : '原冻结金额'}</span>
            <strong class="escrow-amount-value ${isActive ? '' : 'is-done'}">¥ ${amount}</strong>
            <span class="escrow-time">${isActive ? '冻结于 ' : ''}${p.frozenAt}</span>
          </div>
          <div class="escrow-project-rule">${p.settleRule}</div>
        </div>
      `;
    }).join('');
  },

