    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) { this.showToast('未找到对应订单'); return; }
    const task = (MockData.tasks.list || []).find(t => t.id === order.sourceId);
    const reward = task ? (parseFloat(String(task.rewardMoney || '').replace(/[^0-9.]/g, '')) || 3000) : 3000;

