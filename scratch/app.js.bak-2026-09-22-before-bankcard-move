  // 日期格式化为 YYYY-MM-DD
  formatDate: function(d) {
    const dt = (d instanceof Date) ? d : new Date(d);
    if (isNaN(dt.getTime())) return '';
    const p = (n) => String(n).padStart(2, '0');
    return `${dt.getFullYear()}-${p(dt.getMonth() + 1)}-${p(dt.getDate())}`;
  },

  // 计算本次订阅后的 Pro 到期日：已是 Pro 且未过期则在原到期日上顺延，否则从今天起算
  calcProExpireDate: function(planKey) {
    const plan = this.getProPlan(planKey);
    const days = (plan && plan.days) || 365;
    const mem = (MockData.systemAdmin && MockData.systemAdmin.membership) || {};
    let base = (this.isProMember() && mem.expireDate) ? new Date(mem.expireDate + 'T00:00:00') : new Date();
    if (isNaN(base.getTime()) || base.getTime() < Date.now()) base = new Date();
    base.setDate(base.getDate() + days);
    return this.formatDate(base);
  },

  // Pro 剩余有效期天数
  proDaysLeft: function() {
    const mem = (MockData.systemAdmin && MockData.systemAdmin.membership) || {};
    if (!this.isProMember() || !mem.expireDate) return 0;
    const end = new Date(mem.expireDate + 'T23:59:59').getTime();
    if (isNaN(end)) return 0;
    return Math.max(0, Math.ceil((end - Date.now()) / 86400000));
  },

