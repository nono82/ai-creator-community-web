  // 渲染付款二维码（确定性伪码图案，图案由订单号与渠道派生，零依赖内联 SVG）
  renderProPayQr: function() {
    const frame = document.getElementById('pro-qr-frame');
    const order = this._proOrder;
    if (!frame || !order) return;

    const isAlipay = order.channel === '支付宝';
    const seedStr = order.orderNo + '|' + order.channel;
    let seed = 0;
    for (let i = 0; i < seedStr.length; i++) seed = (seed * 31 + seedStr.charCodeAt(i)) >>> 0;
    const rnd = () => { seed = (seed * 1103515245 + 12345) >>> 0; return seed / 4294967296; };

    const N = 25, CELL = 12, PAD = 2, SIZE = (N + PAD * 2) * CELL;
    let rects = '';
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const cornerX = x >= N - 7 ? x - (N - 7) : x;
        const cornerY = y >= N - 7 ? y - (N - 7) : y;
        const inFinder = (x < 7 || x >= N - 7) && (y < 7 || y >= N - 7);
        // 三个定位角外侧各留 1 格空白分隔带（仅在定位角邻域生效，不贯穿整图）
        const isSeparator = !inFinder && (
          ((x === 7 || x === N - 8) && (y <= 7 || y >= N - 8)) ||
          ((y === 7 || y === N - 8) && (x <= 7 || x >= N - 8))
        );
        let dark;
        if (inFinder) {
          const edge = cornerX === 0 || cornerX === 6 || cornerY === 0 || cornerY === 6;
          const core = cornerX >= 2 && cornerX <= 4 && cornerY >= 2 && cornerY <= 4;
          dark = edge || core;
        } else if (isSeparator) {
          dark = false;
        } else {
          dark = rnd() > 0.52;
        }
        if (dark) {
          rects += `<rect x="${(x + PAD) * CELL}" y="${(y + PAD) * CELL}" width="${CELL}" height="${CELL}" rx="1.6"/>`;
        }
      }
    }

    frame.innerHTML = `
      <svg class="pro-qr-svg" viewBox="0 0 ${SIZE} ${SIZE}" width="196" height="196" role="img" aria-label="Pro 会员订阅支付二维码">
        <rect x="0" y="0" width="${SIZE}" height="${SIZE}" fill="#FFFFFF"></rect>
        <g fill="#0F172A">${rects}</g>
        <rect x="${SIZE / 2 - 23}" y="${SIZE / 2 - 23}" width="46" height="46" rx="11" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5"></rect>
        <text x="${SIZE / 2}" y="${SIZE / 2 + 5}" text-anchor="middle" font-size="13" font-weight="800" fill="${isAlipay ? '#1677FF' : '#07C160'}">PRO</text>
      </svg>
    `;
  },

  // 支付倒计时（15 分钟未完成则订单自动失效）
  startProQrCountdown: function() {
    this.stopProQrCountdown();
    let left = 15 * 60;
    const tick = () => {
      const el = document.getElementById('pro-qr-countdown');
      if (el) el.innerText = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
      if (left <= 0) {
        this.stopProQrCountdown();
        this.closeModal('modal-pro-pay-qr');
        this._proOrder = null;
        this.showToast('支付超时，订单已自动失效，请重新发起开通');
        return;
      }
      left -= 1;
    };
    tick();
    this._proQrTimer = setInterval(tick, 1000);
  },

  stopProQrCountdown: function() {
    if (this._proQrTimer) {
      clearInterval(this._proQrTimer);
      this._proQrTimer = null;
    }
  },

