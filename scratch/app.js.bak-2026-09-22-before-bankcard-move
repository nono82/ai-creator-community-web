  // =========================================================================
  // 提现合规四道闸：① 必须已实名 ② 必须同名提现 ③ 单笔上限 ¥10,000 ④ 仅限借记卡
  // =========================================================================

  // 提现规则总口径（唯一真源：MockData.assets.withdrawRules）
  getWithdrawRules: function() {
    const r = (MockData.assets && MockData.assets.withdrawRules) || {};
    return {
      maxPerTx: Number(r.maxPerTx) || 10000,
      requireIdVerified: r.requireIdVerified !== false,
      sameNameOnly: r.sameNameOnly !== false,
      debitOnly: r.debitOnly !== false,
      arrivalNote: r.arrivalNote || 'T+0 实时到账 · 免手续费'
    };
  },

  // 提现收款账户台账
  getWithdrawAccounts: function() {
    return (MockData.assets && MockData.assets.bankCards) || [];
  },

  // 是否已完成实名认证（提现前置条件）
  isIdVerified: function() {
    return !!(MockData.currentUser && MockData.currentUser.idVerified === true);
  },

  // 校验单张卡是否可用于提现，返回 { ok, reason, card }
  // 校验顺序：实名 → 卡类型（仅借记卡）→ 同名（持卡人 = 实名姓名）
  validateWithdrawAccount: function(cardId) {
    const rules = this.getWithdrawRules();
    const card = this.getWithdrawAccounts().find(c => c.id === cardId);
    if (!card) return { ok: false, reason: '请选择用于收款的银行借记卡', card: null };

    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, reason: '账户未完成实名认证，暂不可提现', card };
    }
    if (rules.debitOnly && card.cardType !== 'debit') {
      return { ok: false, reason: `${card.bank}（尾号 ${card.tail}）为${card.cardTypeLabel || '信用卡'}，仅支持提现至银行借记卡`, card };
    }
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    if (rules.sameNameOnly && card.holder !== realName) {
      return { ok: false, reason: `持卡人「${card.holder}」与实名认证姓名「${realName}」不一致，必须同名提现`, card };
    }
    return { ok: true, reason: '', card };
  },

  // 渲染收款账户下拉：不可用的卡保留展示但置灰并标注原因，让四条合规规则在 UI 上可见
  renderWithdrawAccounts: function() {
    const sel = document.getElementById('withdraw-account-select');
    if (!sel) return null;

    const cards = this.getWithdrawAccounts();
    let firstUsable = null;
    sel.innerHTML = cards.map(c => {
      const v = this.validateWithdrawAccount(c.id);
      if (v.ok && firstUsable === null) firstUsable = c.id;
      const label = `${c.bank}（尾号 ${c.tail}）· ${c.cardTypeLabel || '借记卡'} · ${c.holder}`;
      return `<option value="${c.id}"${v.ok ? '' : ' disabled'}>${label}${v.ok ? '' : ' —— 不可用：' + v.reason}</option>`;
    }).join('');

    // 优先落到当前选中项：选中项可用则保留，否则回落到首张可用卡（都不可用则为空）
    const keep = this.validateWithdrawAccount(sel.value).ok ? sel.value : firstUsable;
    sel.value = keep || '';
    return firstUsable;
  },

  // 刷新提现弹窗：实名状态条 + 规则说明 + 收款账户 + 提交按钮可用态
  refreshWithdrawPanel: function() {
    const rules = this.getWithdrawRules();
    const verified = this.isIdVerified();
    const u = MockData.currentUser || {};

    // ① 实名状态条
    const strip = document.getElementById('withdraw-verify-strip');
    const text = document.getElementById('withdraw-verify-text');
    const state = document.getElementById('withdraw-verify-state');
    if (strip) strip.classList.toggle('is-unverified', !verified);
    if (text) {
      text.innerText = verified
        ? `实名认证已通过 · ${u.realName || ''}（${u.phone || ''}）· 收款人必须与此姓名一致`
        : '账户尚未完成实名认证，按监管要求不能提现';
    }
    if (state) state.innerText = verified ? '已实名' : '未实名';

    // ② 四条合规规则 chips
    const ruleRow = document.getElementById('withdraw-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.sameNameOnly ? '✓' : ''} 必须同名提现`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`
      ];
      ruleRow.innerHTML = chips.map((c, i) => {
        const bad = i === 0 && !verified;
        return `<span class="withdraw-rule-chip${bad ? ' is-error' : ''}">${c}</span>`;
      }).join('');
    }

    // ③ 收款账户
    const usableId = this.renderWithdrawAccounts();
    this.onWithdrawAccountChange();

    // ④ 提交按钮可用态（未实名或无可用同名借记卡时给出置灰视觉，点击仍会给出原因提示）
    const btn = document.getElementById('withdraw-submit-btn');
    if (btn) {
      const blocked = (rules.requireIdVerified && !verified) || !usableId;
      btn.classList.toggle('is-disabled', blocked);
      btn.setAttribute('aria-disabled', blocked ? 'true' : 'false');
    }
  },

  // 打开申请提现弹窗（统一入口，替代裸 openModal）
  openWithdrawModal: function() {
    this.openModal('modal-withdraw');
  },

  // 收款账户切换：回显所选卡的同名核验结论
  onWithdrawAccountChange: function() {
    const sel = document.getElementById('withdraw-account-select');
    const note = document.getElementById('withdraw-account-note');
    if (!note) return;

    if (!this.isIdVerified()) {
      note.className = 'withdraw-account-note is-error';
      note.innerText = '未实名认证：请先完成实名认证，再选择本人同名借记卡收款';
      return;
    }
    const v = this.validateWithdrawAccount(sel && sel.value);
    if (!v.card) {
      note.className = 'withdraw-account-note is-error';
      note.innerText = '当前账户下没有可用于提现的同名借记卡，请先添加本人借记卡（不支持信用卡与异名卡）';
      return;
    }
    note.className = 'withdraw-account-note' + (v.ok ? '' : ' is-error');
    note.innerText = v.ok
      ? `${v.card.bank} · ${v.card.cardTypeLabel || '借记卡'} · 持卡人 ${v.card.holder} 与实名一致 · ${this.getWithdrawRules().arrivalNote}`
      : v.reason;
  },

  // 金额实时校验提示（单笔上限 ¥10,000 / 可提现余额）
  onWithdrawAmountInput: function() {
    const input = document.getElementById('withdraw-amount-input');
    const hint = document.getElementById('withdraw-amount-hint');
    if (!input || !hint) return;

    const rules = this.getWithdrawRules();
    const wd = this.getAccountBalance().withdrawable;
    const base = `当前可提现 ¥ ${this.formatMoney(wd)} · 单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`;
    const amount = parseFloat(input.value);

    if (isNaN(amount) || amount <= 0) {
      hint.className = 'withdraw-amount-hint';
      hint.innerText = base;
      return;
    }
    if (amount > rules.maxPerTx) {
      hint.className = 'withdraw-amount-hint is-error';
      hint.innerText = `单笔提现上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，你输入了 ¥ ${this.formatMoney(amount)}，请拆分为多笔提现`;
      return;
    }
    if (amount > wd) {
      hint.className = 'withdraw-amount-hint is-error';
      hint.innerText = `超出可提现余额 ¥ ${this.formatMoney(wd)}（冻结资金不可提现）`;
      return;
    }
    hint.className = 'withdraw-amount-hint is-ok';
    hint.innerText = `本次提现将从可提现余额扣减 ¥ ${this.formatMoney(amount)}，提现后剩余 ¥ ${this.formatMoney(wd - amount)}`;
  },

  // 提交提现申请：四道闸全通过才扣减余额并写入「提现 · 处理中」流水
  submitWithdraw: function() {
    const rules = this.getWithdrawRules();

    // 闸一：必须已完成实名认证
    if (rules.requireIdVerified && !this.isIdVerified()) {
      this.showToast('🚫 账户尚未完成实名认证，按监管要求不能提现；请先在【安全设置】完成实名认证');
      this.openSecuritySettings('实名认证');
      return;
    }

    // 闸二：必须提现到本人同名借记卡
    const sel = document.getElementById('withdraw-account-select');
    const accountCheck = this.validateWithdrawAccount(sel && sel.value);
    if (!accountCheck.ok) {
      this.showToast(`🚫 ${accountCheck.reason}`);
      this.refreshWithdrawPanel();
      return;
    }
    const card = accountCheck.card;

    // 闸三：金额有效性 + 单笔上限 ¥10,000
    const input = document.getElementById('withdraw-amount-input');
    const amount = Math.round((parseFloat(input && input.value) || 0) * 100) / 100;
    if (isNaN(amount) || amount <= 0) {
      this.showToast('请输入有效的提现金额');
      return;
    }
    if (amount > rules.maxPerTx) {
      this.showToast(`🚫 单笔提现上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，请拆分为多笔提现`);
      this.onWithdrawAmountInput();
      return;
    }

    // 闸四：可提现余额充足（冻结资金不可提现）
    let withdrawable = this.getAccountBalance().withdrawable;
    if (amount > withdrawable) {
      this.showToast(`超出可提现余额（¥ ${this.formatMoney(withdrawable)}），冻结资金不可提现`);
      this.onWithdrawAmountInput();
      return;
    }

    // 校验全通过：扣减可提现余额与账户总额（冻结额不动，「总额 = 可提现 + 冻结」恒等式保持）
    const balance = this.getAccountBalance().balance;
    withdrawable = Math.max(0, withdrawable - amount);
    const newBalance = Math.max(0, balance - amount);
    MockData.assets.cards.withdrawable = this.formatMoney(withdrawable);
    MockData.assets.cards.balance = this.formatMoney(newBalance);

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = withdrawable;
      availItem.amount = '¥ ' + this.formatMoney(withdrawable);
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '提现',
      name: `提现到${card.bank}借记卡 (尾号 ${card.tail})`,
      amount: `- ¥ ${this.formatMoney(amount)}`,
      rawAmount: -amount,
      status: '处理中',
      statusType: 'done',
      time: '刚刚',
      category: '提现'
    });

    this.refreshAssetDisplays();
    this.renderTransactionsTable();
    if (typeof this.renderAssetsCharts === 'function') this.renderAssetsCharts();
    this.closeModal('modal-withdraw');
    this.showToast(`提现申请已提交！¥ ${this.formatMoney(amount)} 将 ${rules.arrivalNote} 至${card.bank}借记卡（尾号 ${card.tail}），收款人 ${card.holder} 与实名一致`);
  },

  // =========================================================================
  // 资产安全中心 · 银行卡绑定与换绑（仅支持本人同名境内银联借记卡）
  // =========================================================================

  // 绑卡规则总口径（唯一真源：MockData.assets.bankBindRules）
  getBankBindRules: function() {
    const r = (MockData.assets && MockData.assets.bankBindRules) || {};
    return {
      requireIdVerified: r.requireIdVerified !== false,
      debitOnly: r.debitOnly !== false,
      sameNameOnly: r.sameNameOnly !== false,
      unionPayOnly: r.unionPayOnly !== false,
      codeRequired: r.codeRequired !== false,
      maxCards: Number(r.maxCards) || 5,
      note: r.note || '仅支持绑定本人同名境内银联借记卡（储蓄卡）'
    };
  },

  // 已绑定银行卡台账
  getBankCards: function() {
    return (MockData.assets && MockData.assets.bankCards) || [];
  },

  // 卡号掩码展示：6225 **** **** 1234
  maskBankCardNo: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (d.length < 8) return d;
    return `${d.slice(0, 4)} **** **** ${d.slice(-4)}`;
  },

  // Luhn 校验（离线零依赖，识别卡号是否合法）
  luhnCheck: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (!d) return false;
    let sum = 0;
    let alt = false;
    for (let i = d.length - 1; i >= 0; i--) {
      let n = Number(d[i]);
      if (alt) { n *= 2; if (n > 9) n -= 9; }
      sum += n;
      alt = !alt;
    }
    return sum % 10 === 0;
  },

  // 依据 BIN 号段离线识别发卡行与卡种（取最长前缀匹配）
  detectBankCard: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (!/^\d{16,19}$/.test(d)) {
      return { ok: false, cardNo: d, reason: '银行卡号应为 16-19 位数字，请核对后重新输入' };
    }
    if (!this.luhnCheck(d)) {
      return { ok: false, cardNo: d, reason: '卡号格式校验未通过（Luhn 校验失败），请核对卡号' };
    }
    const table = (MockData.assets && MockData.assets.bankBinTable) || [];
    const hit = table.filter(t => d.indexOf(t.prefix) === 0)
      .sort((a, b) => b.prefix.length - a.prefix.length)[0];
    if (hit) {
      return {
        ok: true, cardNo: d, tail: d.slice(-4), bank: hit.bank,
        cardType: hit.cardType, cardTypeLabel: hit.cardTypeLabel, binPrefix: hit.prefix
      };
    }
    if (/^(4|5|3[47])/.test(d)) {
      return {
        ok: false, cardNo: d, bank: '国际卡组织', cardType: 'credit', cardTypeLabel: '国际信用卡',
        reason: '识别为 Visa / MasterCard 等国际卡组织号段，仅支持绑定境内银联借记卡'
      };
    }
    return {
      ok: false, cardNo: d, bank: '未知发卡行', cardType: 'unknown',
      reason: '未能识别的银联卡号段，暂不支持绑定该银行卡'
    };
  },

  // 单张卡在「资产安全中心」的可用状态（依据规则实时推导，不落库）
  getBankCardStatus: function(card) {
    const rules = this.getBankBindRules();
    if (!card) return { ok: false, key: 'invalid', shortLabel: '异常', reason: '银行卡不存在' };
    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, key: 'invalid', shortLabel: '待实名', reason: '账户未完成实名认证，完成实名后方可绑定与使用银行卡' };
    }
    if (rules.debitOnly && card.cardType !== 'debit') {
      return {
        ok: false, key: 'invalid', shortLabel: '非借记卡',
        reason: `${card.bank}（尾号 ${card.tail}）为${card.cardTypeLabel || '信用卡'}，仅支持绑定与使用银行借记卡`
      };
    }
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    if (rules.sameNameOnly && card.holder !== realName) {
      return {
        ok: false, key: 'invalid', shortLabel: '非本人卡',
        reason: `持卡人「${card.holder}」与实名认证姓名「${realName}」不一致，仅支持绑定本人银行卡`
      };
    }
    return { ok: true, key: 'active', shortLabel: '可用', reason: '' };
  },

  // 绑定 / 换绑统一校验：实名 → 持卡人同名 → 卡号识别 → 仅限借记卡 → 不得重复 → 张数上限
  // options.excludeId：换绑时排除被替换的原卡（允许占用同名卡位）
  validateBankCardBind: function(cardNo, holder, options) {
    const opts = options || {};
    const rules = this.getBankBindRules();
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    const name = String(holder || '').trim();

    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, gate: 'id-verified', reason: '账户未完成实名认证，按监管要求完成实名后方可绑定银行卡' };
    }
    if (rules.sameNameOnly && name !== realName) {
      return {
        ok: false, gate: 'same-name',
        reason: name
          ? `持卡人「${name}」与实名认证姓名「${realName}」不一致，仅支持绑定本人银行卡`
          : '请填写持卡人姓名，且必须与实名认证姓名一致'
      };
    }
    const d = this.detectBankCard(cardNo);
    if (!d.ok) return Object.assign({ gate: 'card-no' }, d);
    if (rules.debitOnly && d.cardType !== 'debit') {
      return Object.assign({}, d, {
        ok: false, gate: 'debit-only',
        reason: `${d.bank}（尾号 ${d.tail}）为${d.cardTypeLabel}，仅支持绑定银行借记卡（储蓄卡）`
      });
    }
    const dup = this.getBankCards().find(c => c.cardNo === d.cardNo && c.id !== opts.excludeId);
    if (dup) {
      return Object.assign({}, d, {
        ok: false, gate: 'duplicate',
        reason: `${d.bank}（尾号 ${d.tail}）已绑定，请勿重复绑定`
      });
    }
    if (!opts.excludeId && this.getBankCards().length >= rules.maxCards) {
      return Object.assign({}, d, {
        ok: false, gate: 'max-cards',
        reason: `单个账户最多绑定 ${rules.maxCards} 张银行卡，请先解绑不再使用的卡`
      });
    }
    return Object.assign({ ok: true, gate: '' }, d);
  },

  // 单张银行卡行渲染（唯一陈列位：安全设置弹窗的「银行卡管理」分区）
  bankCardRowHtml: function(card) {
    const st = this.getBankCardStatus(card);
    const tags = [];
    if (card.isDefault) tags.push('<span class="bank-card-tag is-default">默认结算卡</span>');
    tags.push(`<span class="bank-card-tag">${card.cardTypeLabel || '借记卡'}</span>`);
    if (!st.ok) tags.push(`<span class="bank-card-tag is-invalid">${st.shortLabel}</span>`);

    const acts = [];
    if (!st.ok) {
      acts.push(`<button type="button" class="bank-card-act is-primary" onclick="App.openBankCardBindModal('rebind','${card.id}')">去换绑</button>`);
    } else {
      if (!card.isDefault) {
        acts.push(`<button type="button" class="bank-card-act" onclick="App.setPayoutBankCard('${card.id}')">设为默认</button>`);
      }
      acts.push(`<button type="button" class="bank-card-act" onclick="App.openBankCardBindModal('rebind','${card.id}')">换绑</button>`);
      if (card.isDefault) {
        acts.push('<span class="bank-card-act-hint">默认卡不可解绑</span>');
      } else if (this._unbindConfirmId === card.id) {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.confirmUnbindBankCard('${card.id}')">确认解绑</button>`);
        acts.push('<button type="button" class="bank-card-act" onclick="App.cancelUnbindBankCard()">取消</button>');
      } else {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.armUnbindBankCard('${card.id}')">解绑</button>`);
      }
    }

    return `
      <div class="bank-card-row${st.ok ? '' : ' is-invalid'}">
        <div class="bank-card-head">
          <span class="bank-card-logo">${String(card.bank || '').slice(0, 2)}</span>
          <div class="bank-card-info">
            <div class="bank-card-name">${card.bank}<span class="bank-card-tail">尾号 ${card.tail}</span></div>
            <div class="bank-card-no">${this.maskBankCardNo(card.cardNo)}</div>
            <div class="bank-card-tags">${tags.join('')}</div>
          </div>
        </div>
        ${st.ok ? '' : `<div class="bank-card-invalid-reason">⚠️ ${st.reason}</div>`}
        <div class="bank-card-meta">持卡人 ${card.holder} · ${card.branch || '—'} · 绑定于 ${card.boundAt || '—'}</div>
        <div class="bank-card-actions">${acts.join('')}</div>
      </div>
    `;
  },

  // 渲染安全设置弹窗「银行卡管理」分区内的银行卡列表（资产主面板不再陈列卡明细）
  renderBankCardBlocks: function() {
    const cards = this.getBankCards();
    const empty = '<div class="bank-card-empty">尚未绑定银行卡，绑定本人同名借记卡后即可提现收款</div>';

    const full = document.getElementById('security-bank-card-list');
    if (full) full.innerHTML = cards.length ? cards.map(c => this.bankCardRowHtml(c)).join('') : empty;

    const rules = this.getBankBindRules();
    const usable = cards.filter(c => this.getBankCardStatus(c).ok).length;
    const tip = document.getElementById('security-bank-card-tip');
    if (tip) {
      tip.className = 'bank-card-block-tip' + (this.isIdVerified() ? '' : ' is-error');
      tip.innerText = this.isIdVerified()
        ? `共 ${cards.length} 张，其中 ${usable} 张可用 · ${rules.note} · 最多可绑 ${rules.maxCards} 张`
        : `未完成实名认证，暂不可绑定或使用银行卡 · ${rules.note}`;
    }

    // 未实名时绑定入口给出置灰视觉（点击仍会给出具体原因）
    const addBtn = document.getElementById('security-bank-card-add');
    if (addBtn) addBtn.classList.toggle('is-disabled', !this.isIdVerified());
  },

  // 打开绑定 / 换绑银行卡弹窗（mode: 'bind' 绑定新卡 | 'rebind' 换绑）
  openBankCardBindModal: function(mode, cardId) {
    const isRebind = mode === 'rebind';
    const target = isRebind ? this.getBankCards().find(c => c.id === cardId) : null;
    if (isRebind && !target) {
      this.showToast('未找到需要换绑的银行卡');
      return;
    }

    this._bankBind = { mode: isRebind ? 'rebind' : 'bind', targetId: target ? target.id : '', codeSent: false, code: '' };
    this._unbindConfirmId = '';

    const setText = (id, txt) => {
      const el = document.getElementById(id);
      if (el) el.innerText = txt;
    };
    const setVal = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.value = val;
    };

    setText('bank-bind-title', isRebind ? '换绑银行卡' : '绑定银行卡');
    setText('bank-bind-sub', isRebind
      ? `换绑后原卡（${target.bank} 尾号 ${target.tail}）将即刻解绑，收款账户切换为新卡`
      : '仅支持绑定本人同名境内银联借记卡（储蓄卡）');
    setVal('bank-bind-holder', (MockData.currentUser && MockData.currentUser.realName) || '');
    setVal('bank-bind-cardno', '');
    setVal('bank-bind-branch', '');
    setVal('bank-bind-code', '');

    const codeBtn = document.getElementById('bank-bind-code-btn');
    if (codeBtn) {
      codeBtn.classList.remove('is-disabled');
      codeBtn.innerText = '获取验证码';
    }

    const strip = document.getElementById('bank-bind-rebind-strip');
    if (strip) {
      strip.className = 'bank-bind-rebind-strip' + (isRebind ? ' is-on' : '');
      strip.innerHTML = isRebind
        ? `<span class="bank-bind-rebind-label">待换绑原卡</span>
           <span class="bank-bind-rebind-card">${target.bank} · ${target.cardTypeLabel || '借记卡'} · 尾号 ${target.tail}</span>`
        : '';
    }

    this.onBankCardNoInput();
    this.refreshBankBindPanel();
    this.openModal('modal-bank-card-bind');
  },

  // 刷新绑卡弹窗：实名状态条 + 规则 chips + 演示卡号 + 提交按钮可用态
  refreshBankBindPanel: function() {
    const rules = this.getBankBindRules();
    const verified = this.isIdVerified();
    const u = MockData.currentUser || {};
    const bind = this._bankBind || { mode: 'bind' };

    const strip = document.getElementById('bank-bind-verify-strip');
    const text = document.getElementById('bank-bind-verify-text');
    const state = document.getElementById('bank-bind-verify-state');
    if (strip) strip.classList.toggle('is-unverified', !verified);
    if (text) {
      text.innerText = verified
        ? `实名认证已通过 · ${u.realName || ''}（${u.phone || ''}）· 仅可绑定此姓名的银行卡`
        : '账户尚未完成实名认证，按监管要求不能绑定银行卡';
    }
    if (state) state.innerText = verified ? '已实名' : '未实名';

    const ruleRow = document.getElementById('bank-bind-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.sameNameOnly ? '✓' : ''} 仅限本人卡`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `${rules.unionPayOnly ? '✓' : ''} 仅限银联卡`,
        `最多 ${rules.maxCards} 张`
      ];
      ruleRow.innerHTML = chips
        .map((c, i) => `<span class="withdraw-rule-chip${i === 0 && !verified ? ' is-error' : ''}">${c}</span>`)
        .join('');
    }

    const box = document.getElementById('bank-bind-demo');
    if (box) {
      const list = (MockData.assets && MockData.assets.bankCardDemos) || [];
      box.innerHTML = '<span class="bank-bind-demo-label">演示卡号：</span>'
        + list.map(d => `<span class="bank-bind-demo-chip" onclick="App.fillBankCardDemo('${d.key}')">${d.label}</span>`).join('');
    }

    const btn = document.getElementById('bank-bind-submit-btn');
    if (btn) {
      btn.innerText = bind.mode === 'rebind' ? '确认换绑' : '确认绑定';
      btn.classList.toggle('is-disabled', !verified);
      btn.setAttribute('aria-disabled', verified ? 'false' : 'true');
    }
  },

  // 卡号实时识别：发卡行 / 卡种 / 是否可用于绑定
  onBankCardNoInput: function() {
    const input = document.getElementById('bank-bind-cardno');
    const box = document.getElementById('bank-bind-detect');
    if (!input || !box) return;

    const raw = String(input.value || '');
    const digits = raw.replace(/\D/g, '');
    if (digits && digits !== raw) {
      const caretAtEnd = (input.selectionStart == null) || (input.selectionStart >= raw.length);
      if (caretAtEnd) input.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
    }

    if (!digits) {
      box.className = 'bank-bind-detect';
      box.innerText = '输入卡号后自动识别发卡行与卡种，识别依据为银联 BIN 号段';
      return;
    }
    const d = this.detectBankCard(digits);
    if (!d.ok) {
      box.className = 'bank-bind-detect is-error';
      box.innerText = `✕ ${d.reason}`;
      return;
    }
    if (d.cardType !== 'debit') {
      box.className = 'bank-bind-detect is-error';
      box.innerText = `✕ ${d.bank} · ${d.cardTypeLabel} —— 仅支持绑定银行借记卡，信用卡不支持绑定`;
      return;
    }
    box.className = 'bank-bind-detect is-ok';
    box.innerText = `✓ ${d.bank} · ${d.cardTypeLabel} · 尾号 ${d.tail} —— 借记卡，可用于绑定与提现`;
  },

  // 演示卡号一键填充（便于快速验证「借记卡通过 / 信用卡拦截」）
  fillBankCardDemo: function(key) {
    const list = (MockData.assets && MockData.assets.bankCardDemos) || [];
    const demo = list.find(d => d.key === key);
    if (!demo) return;
    const input = document.getElementById('bank-bind-cardno');
    if (input) input.value = demo.cardNo.replace(/(\d{4})(?=\d)/g, '$1 ');
    this.onBankCardNoInput();
    this.refreshBankBindPanel();
  },

  // 获取绑卡短信验证码（校验持卡人手机号）
  sendBankBindCode: function() {
    const bind = this._bankBind || (this._bankBind = { mode: 'bind', targetId: '', codeSent: false, code: '' });
    if (!this.isIdVerified()) {
      this.showToast('🚫 账户未完成实名认证，无法绑定银行卡；请先在【安全设置】完成实名认证');
      this.openSecuritySettings('实名认证');
      return;
    }
    bind.codeSent = true;
    bind.code = String(Math.floor(100000 + Math.random() * 900000));
    const u = MockData.currentUser || {};
    const btn = document.getElementById('bank-bind-code-btn');
    if (btn) {
      btn.classList.add('is-disabled');
      btn.innerText = '已发送';
    }
    this.showToast(`短信验证码已发送至 ${u.phone || '实名预留手机号'}，演示环境验证码：${bind.code}`);
    this.refreshBankBindPanel();
  },

  // 提交绑定 / 换绑：实名 → 同名 → 卡号 → 仅限借记卡 → 验证码 → 落库
  submitBankCardBind: function() {
    const rules = this.getBankBindRules();
    const bind = this._bankBind || { mode: 'bind', targetId: '', codeSent: false, code: '' };
    const holderEl = document.getElementById('bank-bind-holder');
    const cardEl = document.getElementById('bank-bind-cardno');
    const branchEl = document.getElementById('bank-bind-branch');
    const codeEl = document.getElementById('bank-bind-code');
    const hint = document.getElementById('bank-bind-hint');

    const fail = (msg) => {
      if (hint) {
        hint.className = 'bank-bind-hint is-error';
        hint.innerText = '🚫 ' + msg;
      }
      this.showToast('🚫 ' + msg);
    };

    // 闸一：必须已实名认证
    if (rules.requireIdVerified && !this.isIdVerified()) {
      fail('账户未完成实名认证，按监管要求不能绑定银行卡');
      this.openSecuritySettings('实名认证');
      return;
    }

    // 闸二：持卡人同名 / 卡号识别 / 仅限借记卡 / 不得重复 / 张数上限
    const check = this.validateBankCardBind(
      cardEl && cardEl.value, holderEl && holderEl.value, { excludeId: bind.targetId }
    );
    if (!check.ok) {
      fail(check.reason);
      if (['card-no', 'debit-only', 'duplicate'].indexOf(check.gate) >= 0) this.onBankCardNoInput();
      return;
    }

    // 闸三：短信验证码（校验持卡人手机号）
    if (rules.codeRequired) {
      const code = String((codeEl && codeEl.value) || '').trim();
      if (!bind.codeSent) return fail('请先点击【获取验证码】完成手机号校验');
      if (!/^\d{6}$/.test(code)) return fail('请输入 6 位短信验证码');
      if (code !== bind.code) return fail('短信验证码不正确，请核对后重新输入');
    }

    const cards = this.getBankCards();
    const holder = String((holderEl && holderEl.value) || '').trim();
    const branch = String((branchEl && branchEl.value) || '').trim() || `${check.bank}南京分行`;

    if (bind.mode === 'rebind' && bind.targetId) {
      const target = cards.find(c => c.id === bind.targetId);
      if (!target) return fail('待换绑的银行卡不存在');
      const oldLabel = `${target.bank}（尾号 ${target.tail}）`;
      target.bank = check.bank;
      target.cardNo = check.cardNo;
      target.tail = check.tail;
      target.cardType = check.cardType;
      target.cardTypeLabel = check.cardTypeLabel;
      target.holder = holder;
      target.branch = branch;
      target.boundAt = this.formatDate(new Date());
      this.closeModal('modal-bank-card-bind');
      this.refreshBankCardViews();
      this.showToast(`✅ 换绑成功！原卡 ${oldLabel} 已解绑，收款与充值账户切换为${check.bank}${check.cardTypeLabel}（尾号 ${check.tail}）`);
      return;
    }

    let seq = cards.length + 1;
    while (cards.some(c => c.id === 'BC' + seq)) seq++;
    cards.push({
      id: 'BC' + seq,
      bank: check.bank,
      cardNo: check.cardNo,
      tail: check.tail,
      cardType: check.cardType,
      cardTypeLabel: check.cardTypeLabel,
      holder,
      branch,
      boundAt: this.formatDate(new Date()),
      isDefault: cards.length === 0
    });
    this.closeModal('modal-bank-card-bind');
    this.refreshBankCardViews();
    this.showToast(`✅ 绑定成功！${check.bank}${check.cardTypeLabel}（尾号 ${check.tail}）已可用于提现收款与账户充值`);
  },

  // 设为默认结算卡（仅可用卡可设）
  setPayoutBankCard: function(cardId) {
    const cards = this.getBankCards();
    const card = cards.find(c => c.id === cardId);
    if (!card) return;
    const st = this.getBankCardStatus(card);
    if (!st.ok) {
      this.showToast('🚫 ' + st.reason);
      return;
    }
    cards.forEach(c => { c.isDefault = (c.id === cardId); });
    this.refreshBankCardViews();
    this.showToast(`✅ 已将${card.bank}（尾号 ${card.tail}）设为默认结算卡`);
  },

  // 解绑第一步：二次确认（默认结算卡不可解绑，须先换绑其他卡为默认）
  armUnbindBankCard: function(cardId) {
    const card = this.getBankCards().find(c => c.id === cardId);
    if (!card) return;
    if (card.isDefault) {
      this.showToast('🚫 默认结算卡不可解绑，请先换绑其他卡并设为默认');
      return;
    }
    this._unbindConfirmId = cardId;
    this.renderBankCardBlocks();
  },

  // 解绑：取消二次确认
  cancelUnbindBankCard: function() {
    this._unbindConfirmId = '';
    this.renderBankCardBlocks();
  },

  // 解绑第二步：确认解绑并从台账移除
  confirmUnbindBankCard: function(cardId) {
    const cards = this.getBankCards();
    const idx = cards.findIndex(c => c.id === cardId);
    if (idx < 0) return;
    const card = cards[idx];
    if (card.isDefault) {
      this._unbindConfirmId = '';
      this.renderBankCardBlocks();
      this.showToast('🚫 默认结算卡不可解绑，请先换绑其他卡并设为默认');
      return;
    }
    cards.splice(idx, 1);
    this._unbindConfirmId = '';
    this.refreshBankCardViews();
    this.showToast(`✅ 已解绑${card.bank}（尾号 ${card.tail}），提现收款将不再使用该卡`);
  },

  // 银行卡变更后统一刷新：安全设置卡列表 / 提现收款账户 / 充值银行卡（三处共用同一份台账）
  refreshBankCardViews: function() {
    this._unbindConfirmId = '';
    this.renderBankCardBlocks();
    this.refreshWithdrawPanel();
    this.refreshRechargePanel();
  },

  // =========================================================================
  // 人民币账户充值合规：只能经【安全设置】已绑定的本人同名借记卡协议代扣
  // ① 必须已实名 ② 只能选已绑定银行卡（不接受临时输卡号）③ 仅限借记卡 ④ 单笔上限
  // =========================================================================

  // 充值规则总口径（唯一真源：MockData.assets.rechargeRules）
  getRechargeRules: function() {
    const r = (MockData.assets && MockData.assets.rechargeRules) || {};
    return {
      boundCardOnly: r.boundCardOnly !== false,
      requireIdVerified: r.requireIdVerified !== false,
      debitOnly: r.debitOnly !== false,
      sameNameOnly: r.sameNameOnly !== false,
      maxPerTx: Number(r.maxPerTx) || 50000,
      arrivalNote: r.arrivalNote || 'T+0 实时到账 · 免手续费',
      note: r.note || '仅支持使用已绑定的本人同名境内银联借记卡充值'
    };
  },

  // 充值可用卡来源：与提现收款、安全设置共用同一份银行卡台账（已绑定才可充值）
  getRechargeCards: function() {
    return this.getBankCards();
  },

  // 校验单张已绑卡能否用于充值，返回 { ok, reason, card }
  // 顺序：已选中已绑卡 → 必须已实名 → 仅限借记卡 → 必须本人同名
  validateRechargeCard: function(cardId) {
    const rules = this.getRechargeRules();
    const card = this.getRechargeCards().find(c => c.id === cardId);
    if (!card) {
      return { ok: false, reason: '请选择用于充值的已绑定借记卡；尚未绑卡请先完成绑卡', card: null };
    }
    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, reason: '账户未完成实名认证，按监管要求不能发起银行卡充值', card };
    }
    if (rules.debitOnly && card.cardType !== 'debit') {
      return { ok: false, reason: `${card.bank}（尾号 ${card.tail}）为${card.cardTypeLabel || '信用卡'}，仅支持使用银行借记卡充值`, card };
    }
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    if (rules.sameNameOnly && card.holder !== realName) {
      return { ok: false, reason: `持卡人「${card.holder}」与实名认证姓名「${realName}」不一致，仅支持使用本人银行卡充值`, card };
    }
    return { ok: true, reason: '', card };
  },

  // 渲染充值银行卡下拉：不合格的已绑卡保留展示但置灰并标注原因，让「只能借记卡」在界面上可见
  renderRechargeCards: function() {
    const sel = document.getElementById('recharge-card-select');
    if (!sel) return null;

    const cards = this.getRechargeCards();
    let firstUsable = null;
    sel.innerHTML = cards.length
      ? cards.map(c => {
          const v = this.validateRechargeCard(c.id);
          if (v.ok && firstUsable === null) firstUsable = c.id;
          const label = `${c.bank}（尾号 ${c.tail}）· ${c.cardTypeLabel || '借记卡'} · ${c.holder}`;
          return `<option value="${c.id}"${v.ok ? '' : ' disabled'}>${label}${v.ok ? '' : ' —— 不可用：' + v.reason}</option>`;
        }).join('')
      : '<option value="">暂无已绑定银行卡，请先绑卡</option>';

    // 优先保留当前选中项：选中项可用则保留，否则回落到首张可用卡（都不可用则为空）
    const keep = this.validateRechargeCard(sel.value).ok ? sel.value : firstUsable;
    sel.value = keep || '';
    return firstUsable;
  },

  // 刷新充值弹窗：合规口径 chips + 已绑卡下拉 + 核验结论 + 提交按钮可用态
  refreshRechargePanel: function() {
    const rules = this.getRechargeRules();
    const verified = this.isIdVerified();

    // ① 合规口径 chips
    const ruleRow = document.getElementById('recharge-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.boundCardOnly ? '✓' : ''} 仅限已绑定银行卡`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`
      ];
      ruleRow.innerHTML = chips.map((c, i) => {
        const bad = i === 0 && !verified;
        return `<span class="recharge-rule-chip${bad ? ' is-error' : ''}">${c}</span>`;
      }).join('');
    }

    // ② 充值银行卡下拉
    const usableId = this.renderRechargeCards();
    this.onRechargeCardChange();

    // ③ 提交按钮可用态（未实名或无可用已绑借记卡时置灰，点击仍会给出具体原因）
    const btn = document.getElementById('recharge-submit-btn');
    if (btn) {
      const blocked = (rules.requireIdVerified && !verified) || !usableId;
      btn.classList.toggle('is-disabled', blocked);
      btn.setAttribute('aria-disabled', blocked ? 'true' : 'false');
    }
  },

  // 充值卡切换：回显所选已绑卡的核验结论（与实名姓名是否一致 / 是否可用）
  onRechargeCardChange: function() {
    const sel = document.getElementById('recharge-card-select');
    const note = document.getElementById('recharge-card-note');
    if (!note) return;

    if (!this.isIdVerified()) {
      note.className = 'recharge-card-note is-error';
      note.innerText = '未实名认证：请先在【安全设置】完成实名认证，绑卡后方可充值';
      return;
    }
    const v = this.validateRechargeCard(sel && sel.value);
    if (!v.card) {
      note.className = 'recharge-card-note is-error';
      note.innerText = '当前账户下没有已绑定的本人借记卡，充值只能使用已绑定的借记卡，请先完成绑卡';
      return;
    }
    note.className = 'recharge-card-note' + (v.ok ? '' : ' is-error');
    note.innerText = v.ok
      ? `${v.card.bank} · ${v.card.cardTypeLabel || '借记卡'} · 持卡人 ${v.card.holder} 与实名一致 · 协议代扣 ${this.getRechargeRules().arrivalNote}`
      : v.reason;
  },

  // 人民币账户充值：打开充值弹窗，回填当前账户余额并刷新已绑卡合规面板
  openAccountRechargeModal: function() {
    const balEl = document.getElementById('recharge-cur-balance');
    if (balEl) balEl.innerText = '¥ ' + (MockData.assets.cards.balance || '0.00');
    const wdEl = document.getElementById('recharge-cur-withdrawable');
    if (wdEl) wdEl.innerText = '可提现 ¥ ' + (MockData.assets.cards.withdrawable || '0.00');

    const activeBtn = document.querySelector('#recharge-preset-grid .recharge-preset-btn.active')
      || document.querySelector('#recharge-preset-grid .recharge-preset-btn:nth-child(2)');
    this.selectRechargePreset(activeBtn, 1000);
    this.refreshRechargePanel();
    this.openModal('modal-account-recharge');
  },

  // 人民币账户充值：快捷档位选择
  selectRechargePreset: function(btn, amount) {
    const grid = document.getElementById('recharge-preset-grid');
    if (grid) {
      grid.querySelectorAll('.recharge-preset-btn').forEach(b => b.classList.remove('active'));
    }
    if (btn) btn.classList.add('active');
    const input = document.getElementById('recharge-amount-input');
    if (input) input.value = amount;
  },

  // 人民币账户充值：三闸校验（① 必须已实名 ② 只能使用已绑定的本人同名借记卡 ③ 金额有效且不超单笔上限）
  // 全部通过才按协议代扣入金，账户总额与可提现余额同步增加并写入收入流水
  submitAccountRecharge: function() {
    const rules = this.getRechargeRules();

    // 闸一：必须已完成实名认证
    if (rules.requireIdVerified && !this.isIdVerified()) {
      this.showToast('🚫 账户尚未完成实名认证，按监管要求不能充值；请先在【安全设置】完成实名认证');
      this.openSecuritySettings('实名认证');
      return;
    }

    // 闸二：只能使用已绑定的本人同名借记卡（不接受临时输入卡号与第三方钱包）
    const sel = document.getElementById('recharge-card-select');
    const cardCheck = this.validateRechargeCard(sel && sel.value);
    if (!cardCheck.ok) {
      this.showToast(`🚫 ${cardCheck.reason}`);
      this.refreshRechargePanel();
      return;
    }
    const card = cardCheck.card;
    const channel = `${card.bank} 借记卡 尾号 ${card.tail}`;

    // 闸三：金额有效性 + 单笔上限
    const input = document.getElementById('recharge-amount-input');
    const amount = Math.round((parseFloat(input && input.value) || 0) * 100) / 100;
    if (isNaN(amount) || amount <= 0) {
      this.showToast('请输入有效的充值金额');
      return;
    }
    if (amount > rules.maxPerTx) {
      this.showToast(`单笔充值上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，请分次充值`);
      return;
    }

    const parseMoney = (v) => parseFloat(String(v || '0').replace(/,/g, '')) || 0;
    const fmt = (n) => this.formatMoney(n);

    const balance = parseMoney(MockData.assets.cards.balance) + amount;
    const withdrawable = parseMoney(MockData.assets.cards.withdrawable) + amount;
    MockData.assets.cards.balance = fmt(balance);
    MockData.assets.cards.withdrawable = fmt(withdrawable);

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = withdrawable;
      availItem.amount = '¥ ' + fmt(withdrawable);
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '收入',
      name: `人民币账户充值 (${channel})`,
      amount: `+ ¥ ${fmt(amount)}`,
      rawAmount: amount,
      status: '已到账',
      statusType: 'success',
      time: '刚刚',
      category: '收入'
    });

    this.refreshAssetDisplays();
    this.renderTransactionsTable();
    if (typeof this.renderAssetsCharts === 'function') this.renderAssetsCharts();
    this.closeModal('modal-account-recharge');
    this.showToast(`充值成功！¥ ${fmt(amount)} 已由${card.bank}借记卡（尾号 ${card.tail}）扣款入账，可在【发票管理】申请开票`);
  },

  // =========================================================================
  // 全站统一余额支付口径（唯一现金支付源）· 算力充值 · 发票管理
  // =========================================================================

  // 账户余额统一读数（元）
  getAccountBalance: function() {
    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = (MockData.assets && MockData.assets.cards) || {};
    return {
      balance: parse(cards.balance),
      withdrawable: parse(cards.withdrawable),
      tokens: parse(cards.tokensAC)
    };
  },

  // 金额千分位格式化
  formatMoney: function(n) {
    return (Number(n) || 0).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  },

  // 是否已开通 Pro 会员
  isProMember: function() {
    const mem = (MockData.systemAdmin && MockData.systemAdmin.membership) || {};
    return mem.currentTier === 'pro';
  },

  // 统一余额支付引擎：全站所有购买行为的唯一扣款入口
  // 成功返回 { ok: true, paid, remaining }；余额不足自动唤起引导弹窗并返回 { ok: false }
  payFromAccountBalance: function(amount, orderName) {
    amount = Number(amount) || 0;
    if (amount <= 0) return { ok: false, reason: 'invalid' };

    const info = this.getAccountBalance();
    if (amount > info.withdrawable) {
      this.openInsufficientBalanceModal(amount, orderName);
      return { ok: false, reason: 'insufficient', shortfall: amount - info.withdrawable };
    }

    const fmt = (n) => this.formatMoney(n);
    MockData.assets.cards.balance = fmt(info.balance - amount);
    MockData.assets.cards.withdrawable = fmt(info.withdrawable - amount);

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = Math.max(0, info.withdrawable - amount);
      availItem.amount = '¥ ' + fmt(availItem.value);
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '支出',
      name: orderName || '账户余额消费',
      amount: `- ¥ ${fmt(amount)}`,
      rawAmount: -amount,
      status: '已完成',
      statusType: 'done',
      time: '刚刚',
      category: '支出'
    });

    this.refreshAssetDisplays();
    return { ok: true, paid: amount, remaining: info.withdrawable - amount };
  },

  // 余额不足统一引导弹窗（展示应付 / 可用 / 尚缺三项）
  openInsufficientBalanceModal: function(needAmount, sceneName) {
    const need = Number(needAmount) || 0;
    const have = this.getAccountBalance().withdrawable;
    const fmt = (n) => this.formatMoney(n);
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };

    set('insufficient-need', '¥ ' + fmt(need));
    set('insufficient-have', '¥ ' + fmt(have));
    set('insufficient-short', '¥ ' + fmt(Math.max(0, need - have)));
    set('insufficient-scene-sub', sceneName
      ? `「${sceneName}」需支付 ¥ ${fmt(need)}，当前可用余额 ¥ ${fmt(have)}，充值后即可继续`
      : '账户余额用于算力充值、付费课程等平台购买行为，充值后即可继续');

    this.openModal('modal-balance-insufficient');
  },

  // ====== 专属普惠算力特权充值（统一由账户余额扣款） ======

  // 打开算力充值弹窗
  openComputeRechargeModal: function() {
    const info = this.getAccountBalance();
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    set('compute-cur-balance', '¥ ' + this.formatMoney(info.withdrawable));
    set('compute-cur-tokens', '算力池 ' + this.formatMoney(info.tokens) + ' 点');

    const proRow = document.getElementById('compute-pro-row');
    if (proRow) proRow.style.display = this.isProMember() ? '' : 'none';

    const packs = MockData.assets.computePacks || [];
    this._currentComputePackId = packs[0] ? packs[0].id : null;

    const grid = document.getElementById('compute-pack-grid');
    if (grid) {
      grid.innerHTML = packs.map(p => `
        <button type="button" class="compute-pack-btn${p.id === this._currentComputePackId ? ' active' : ''}" data-pack-id="${p.id}" onclick="App.selectComputePack('${p.id}')">
          <span class="compute-pack-price">¥ ${p.price.toLocaleString('zh-CN')}</span>
          <span class="compute-pack-tokens">${p.tokens.toLocaleString('zh-CN')} 算力点</span>
          <span class="compute-pack-origin">原价 ¥ ${(p.price / 0.4).toLocaleString('zh-CN')} · ${p.label}</span>
        </button>
      `).join('');
    }

    this.refreshComputeOrderSummary();
    this.openModal('modal-compute-recharge');
  },

  // 算力包档位选择
  selectComputePack: function(packId) {
    this._currentComputePackId = packId;
    const grid = document.getElementById('compute-pack-grid');
    if (grid) {
      grid.querySelectorAll('.compute-pack-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-pack-id') === packId);
      });
    }
    this.refreshComputeOrderSummary();
  },

  // 刷新算力充值订单摘要（应付金额 / 到账算力点）
  refreshComputeOrderSummary: function() {
    const packs = MockData.assets.computePacks || [];
    const pack = packs.find(p => p.id === this._currentComputePackId) || packs[0];
    if (!pack) return;
    const bonus = this.isProMember() ? Math.round(pack.tokens * 0.1) : 0;
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    set('compute-pay-amount', '¥ ' + this.formatMoney(pack.price));
    set('compute-gain-tokens', this.formatMoney(pack.tokens + bonus) + ' 点');
  },

  // 确认算力充值：统一走账户余额支付
  submitComputeRecharge: function() {
    const packs = MockData.assets.computePacks || [];
    const pack = packs.find(p => p.id === this._currentComputePackId) || packs[0];
    if (!pack) return;

    const bonus = this.isProMember() ? Math.round(pack.tokens * 0.1) : 0;
    const gain = pack.tokens + bonus;

    const result = this.payFromAccountBalance(pack.price, `算力特权充值 · ${pack.label} (账户余额扣款)`);
    if (!result.ok) return;

    const info = this.getAccountBalance();
    MockData.assets.cards.tokensAC = this.formatMoney(info.tokens + gain);
    MockData.assets.cards.tokenRMB = MockData.assets.cards.tokensAC;
    const tokenItem = (MockData.assets.breakdown.items || []).find(it => it.label === 'AI 积分');
    if (tokenItem) {
      tokenItem.value = info.tokens + gain;
      tokenItem.amount = this.formatMoney(tokenItem.value);
    }

    this.refreshAssetDisplays();
    this.closeModal('modal-compute-recharge');
    this.showToast(`⚡ 算力充值成功！${this.formatMoney(gain)} 算力点已到账（账户余额扣款 ¥ ${this.formatMoney(pack.price)}）`);
  },

  // ====== 发票管理（人民币账户充值后开票） ======

  // 汇总可开票充值记录（来源：人民币账户充值流水 + 开票记录状态）
  getInvoiceRecords: function() {
    const txs = (MockData.assets.transactions || []).filter(t => String(t.name || '').indexOf('人民币账户充值') === 0);
    const issued = MockData.assets.invoiceRecords || [];
    return txs.map(t => {
      const rec = issued.find(r => r.txId === t.id);
      return {
        txId: t.id,
        time: t.time,
        channel: (String(t.name).match(/\(([^)]+)\)/) || [])[1] || '人民币账户',
        amount: Math.abs(parseFloat(t.rawAmount) || 0),
        status: rec ? '已开票' : '未开票',
        invoiceType: rec ? rec.invoiceType : '',
        issuedTime: rec ? rec.time : ''
      };
    });
  },

  // 打开发票管理弹窗
  openInvoiceModal: function() {
    const records = this.getInvoiceRecords();
    this._invoiceSelectedTxId = (records.find(r => r.status === '未开票') || {}).txId || null;
    this._invoiceType = 'normal';

    const grid = document.getElementById('invoice-type-grid');
    if (grid) {
      grid.querySelectorAll('.invoice-type-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
    }
    const titleType = document.getElementById('invoice-title-type');
    if (titleType) titleType.value = 'personal';
    const hint = document.getElementById('invoice-type-hint');
    if (hint) hint.innerText = '普票支持个人或企业抬头；专票仅支持企业抬头且必须填写纳税人识别号';

    this.renderInvoiceRecords();
    this.openModal('modal-invoice');
  },

  // 渲染可开票记录列表与金额汇总
  renderInvoiceRecords: function() {
    const records = this.getInvoiceRecords();
    const list = document.getElementById('invoice-record-list');
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    const sum = (st) => records.filter(r => r.status === st).reduce((s, r) => s + r.amount, 0);

    set('invoice-total-pending', '¥ ' + this.formatMoney(sum('未开票')));
    set('invoice-total-issued', '¥ ' + this.formatMoney(sum('已开票')));

    if (!list) return;
    if (!records.length) {
      list.innerHTML = '<div class="invoice-empty">暂无充值记录：人民币账户充值成功后可在此申请开票</div>';
      return;
    }

    list.innerHTML = records.map(r => {
      const selectable = r.status === '未开票';
      const active = selectable && r.txId === this._invoiceSelectedTxId;
      return `
        <div class="invoice-record-item${active ? ' active' : ''}${selectable ? '' : ' is-issued'}"${selectable ? ` onclick="App.selectInvoiceRecord('${r.txId}')"` : ''}>
          <div class="invoice-record-main">
            <div class="invoice-record-name">人民币账户充值 · ${r.channel}</div>
            <div class="invoice-record-time">${r.time}${r.issuedTime ? ' · 开票于 ' + r.issuedTime : ''}</div>
          </div>
          <div class="invoice-record-amount">¥ ${this.formatMoney(r.amount)}</div>
          <span class="invoice-record-status ${selectable ? 'is-pending' : 'is-done'}">${r.status}</span>
        </div>
      `;
    }).join('');
  },

  // 选择待开票充值记录
  selectInvoiceRecord: function(txId) {
    const rec = this.getInvoiceRecords().find(r => r.txId === txId);
    if (!rec || rec.status === '已开票') return;
    this._invoiceSelectedTxId = txId;
    this.renderInvoiceRecords();
  },

  // 发票类型切换（专票自动锁定企业抬头）
  selectInvoiceType: function(type) {
    this._invoiceType = type === 'special' ? 'special' : 'normal';
    const grid = document.getElementById('invoice-type-grid');
    if (grid) {
      grid.querySelectorAll('.invoice-type-btn').forEach((b, i) => {
        b.classList.toggle('active', (this._invoiceType === 'special') === (i === 1));
      });
    }
    const titleType = document.getElementById('invoice-title-type');
    if (this._invoiceType === 'special' && titleType) titleType.value = 'company';
    const hint = document.getElementById('invoice-type-hint');
    if (hint) {
      hint.innerText = this._invoiceType === 'special'
        ? '增值税专用发票仅支持企业抬头，请填写纳税人识别号与接收邮箱'
