  switchProPayChannel: function(channel) {
    const ch = channel === '支付宝' ? '支付宝' : '微信支付';
    if (this._proOrder) this._proOrder.channel = ch;

    const btns = document.querySelectorAll('#pro-qr-channel-row .pro-qr-channel-btn');
    for (let i = 0; i < btns.length; i++) {
      btns[i].classList.toggle('active', btns[i].getAttribute('data-channel') === ch);
    }
    const hint = document.getElementById('pro-qr-channel-hint');
