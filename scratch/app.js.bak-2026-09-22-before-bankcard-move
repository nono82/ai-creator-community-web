  // 任务全页二级详情页
  openTaskDetailPage: function(taskId, focus) {
    const task = (MockData.tasks.list || []).find(t => t.id === taskId);
    if (!task) {
      this.showToast('未找到该任务');
      return;
    }
    if (this.currentView !== 'tasks') this.navigateTo('tasks');
    this.closePublishTaskPage(true);
    this.syncTaskApplicantMeta(task);
    this._taskDetailManageMode = this.activeTasksMode === 'mine';
    if (this.activeTasksMode === 'hall') {
      this.setHallLifecycleTab(this.getTaskHallLifecycle(task));
    }
    this.currentDetailTaskId = taskId;
    this._detailFocusApplicants = this._taskDetailManageMode && focus === 'applicants';
    this._detailFocusFulfillment = this._taskDetailManageMode && focus === 'fulfillment';
    this.renderTaskDetailPage();
    this.showTasksSubPage('detail');
  },

  closeTaskDetailPage: function() {
    this.showTasksSubPage('main');
    this.currentDetailTaskId = null;
    this._detailFocusApplicants = false;
    this._detailFocusFulfillment = false;
  },

  showTasksSubPage: function(which) {
    const shell = document.getElementById('tasks-main-shell');
    const pub = document.getElementById('tasks-publish-page');
    const detail = document.getElementById('tasks-detail-page');
    if (shell) {
      shell.hidden = which !== 'main';
      shell.style.display = which === 'main' ? '' : 'none';
    }
    if (pub) {
      pub.hidden = which !== 'publish';
      pub.style.display = which === 'publish' ? '' : 'none';
    }
    if (detail) {
      detail.hidden = which !== 'detail';
      detail.style.display = which === 'detail' ? '' : 'none';
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  },

renderTaskDetailPage: function() {
const body = document.getElementById('tasks-detail-body');
const topActions = document.getElementById('task-detail-top-actions');
const task = (MockData.tasks.list || []).find(t => t.id === this.currentDetailTaskId);
if (!body || !task) return;

this.syncTaskApplicantMeta(task);
const mode = this.getTaskAcceptMode(task);
const modeLabel = this.getAcceptModeLabel(mode);
const life = this.getTaskHallLifecycle(task);
const hallBadge = this.getHallCoverBadge(task);
const manage = !!this._taskDetailManageMode;
const displayStatus = manage
? (life === 'open' ? this.getTaskDisplayStatus(task) : hallBadge)
: hallBadge;
const isPublisher = this.isPublisherOfTask(task);
const myOrder = this.getMyCreatorOrderForTask(task.id);
const myOrderAny = this.getMyCreatorOrderForTask(task.id, { includeDone: true });
// 大厅公开详情：未报名可报名；本人已报名则显示「已报名」
const canApplyPublic = life === 'open' && (task.status === '招募中' || task.status === '待参与')
&& !isPublisher && !myOrderAny;
const iAppliedPublic = !manage && life === 'open' && !!(myOrderAny && ['待选定', '进行中', '待验收'].includes(myOrderAny.status));
const canApplyManage = manage && !isPublisher && !myOrderAny && life === 'open'
&& (task.status === '招募中' || task.status === '待参与');
const canApply = manage ? canApplyManage : canApplyPublic;
const attachments = task.attachments || [];

if (topActions) {
if (!manage) {
if (canApply) {
topActions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.openTaskApplyModal('${task.id}')">${mode === 'manual' ? '去报名' : '立即接单'}</button>`;
} else if (iAppliedPublic) {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" disabled>已报名</button>`;
} else {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" disabled>${displayStatus}</button>`;
}
} else if (isPublisher && life === 'open') {
topActions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="document.getElementById('task-detail-applicants')?.scrollIntoView({behavior:'smooth'})">${mode === 'manual' ? '选定创作者' : '查看名额'}</button>`;
} else if (isPublisher && task.status === '待验收') {
const pubOrder = (MockData.tasks.myOrders || []).find(o => o.role === 'publisher' && o.sourceId === task.id);
topActions.innerHTML = pubOrder
? `<button type="button" class="hero-btn-primary" onclick="App.acceptMyTaskDelivery('${pubOrder.id}')">确认验收通过</button>
<button type="button" class="hero-btn-secondary" style="margin-left:6px; color:#D97706; border-color:#D97706;" onclick="App.openRejectTaskModal('${pubOrder.id}')">驳回返修</button>`
: `<button type="button" class="hero-btn-secondary" disabled>待验收</button>`;
} else if (isPublisher && life === 'active') {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" onclick="document.getElementById('task-detail-fulfillment')?.scrollIntoView({behavior:'smooth'})">查看履约进度</button>`;
} else if (isPublisher && life === 'ended') {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" onclick="App.switchMyTasksView('published', '${task.status === '未成交' || task.status === '已截止' ? '未成交' : '已完成'}'); App.closeTaskDetailPage();">回发布台账</button>`;
} else if (canApply) {
topActions.innerHTML = `<button type="button" class="hero-btn-primary" onclick="App.openTaskApplyModal('${task.id}')">${mode === 'manual' ? '提交报名' : '立即接单'}</button>`;
} else if (myOrder && myOrder.status === '返修中') {
topActions.innerHTML = `<button type="button" class="hero-btn-primary" style="background:#D97706; border-color:#D97706;" onclick="App.openSubmitDeliveryModal('${myOrder.id}')">重新提交交付物</button>`;
} else if (myOrder && myOrder.status === '进行中') {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" onclick="document.getElementById('task-detail-fulfillment')?.scrollIntoView({behavior:'smooth'})">今日汇报</button>
<button type="button" class="hero-btn-primary" onclick="App.openSubmitDeliveryModal('${myOrder.id}')">提交交付</button>`;
} else if (myOrder && myOrder.status === '待验收') {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" onclick="App.remindTaskAcceptance('${myOrder.id}')">催促验收</button>
<button type="button" class="hero-btn-primary" style="margin-left:6px;" onclick="App.simulateAutoAccept('${myOrder.id}')">模拟超时自动打款</button>`;
} else if (myOrderAny && myOrderAny.status === '已完成') {
let evalBtn = myOrderAny.evaluation
? `<button type="button" class="hero-btn-secondary" onclick="App.openTaskEvaluateModal('${myOrderAny.id}')">查看评价</button>`
: `<button type="button" class="hero-btn-primary" style="background:linear-gradient(135deg,#F59E0B,#D97706); border-color:#D97706;" onclick="App.openTaskEvaluateModal('${myOrderAny.id}')">评价对方</button>`;

let gallBtn = myOrderAny.listedToGallery
? `<button type="button" class="hero-btn-secondary" style="margin-left:6px;" onclick="App.setTasksMode('gallery'); App.closeTaskDetailPage();">已上架展厅</button>`
: (myOrderAny.galleryApplyPending
? `<button type="button" class="hero-btn-secondary" style="margin-left:6px;" disabled>展厅审核中</button>`
: `<button type="button" class="hero-btn-secondary" style="margin-left:6px;" onclick="App.requestGalleryListing('${myOrderAny.id}')">申请上架展厅</button>`);
topActions.innerHTML = `${evalBtn}${gallBtn}`;
} else if (myOrderAny) {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" onclick="App.closeTaskDetailPage();">我的任务 · ${this.normalizeOrderStatusLabel(myOrderAny.status)}</button>`;
} else if (life === 'active' || life === 'ended') {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" disabled>${displayStatus}</button>`;
} else {
topActions.innerHTML = `<button type="button" class="hero-btn-secondary" disabled>${displayStatus}</button>`;
}
}

