    set('pro-qr-plan-name', order.planLabel);
    set('pro-qr-amount', '¥ ' + this.formatMoney(order.amount));
    set('pro-qr-order-no', order.orderNo);
    set('pro-qr-expire-hint', `支付成功后有效期至 ${order.expireDate}`);
    this.switchProPayChannel(order.channel);
    this.startProQrCountdown();
    this.openModal('modal-pro-pay-qr');
