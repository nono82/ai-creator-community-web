              </div>
              <div class="qna-meta">${q.from || ''}（${roleLabel(q.role)}）· ${q.at || ''}</div>
              ${answerBlock}
            </div>`;
        }).join('')
      : `<div class="qna-empty">当前暂无项目问答记录。${canAsk ? '可在下方就需求细节、交付口径或排期向对方提问。' : ''}</div>`;

