  // 付费课程选购（统一走账户余额支付）
  buyAcademyPlan: function(planId) {
    const plan = (MockData.academy.plans || []).find(p => p.id === planId);
    if (!plan) return;
    if (plan.isFree || plan.purchased) {
      this.openAcademyCourseDetail(planId);
