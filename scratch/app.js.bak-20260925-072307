            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            商单招募选拔与资金托管规则
          </h3>
          <span class="detail-state-card-badge" style="background:#DCFCE7; color:#15803D;">平台资金 100% 托管存管</span>
        </div>
        <div style="background:#F8FAFC; border-radius:10px; padding:14px 16px; font-size:13px; color:var(--text-secondary); line-height:1.7;">
          <div>• <strong>选拔机制</strong>：当前采用【方案选拔 · 报名制】模式。创作者报名并提交初步思路后，由雇主评估作品集与历史信誉分择优选定。</div>
          <div>• <strong>资金托管</strong>：发布方预先缴纳的赏金 <strong>${task.rewardMoney || '¥ 5,000'}</strong> 已全额锁定在招行/工行第三方资金监管账户中，验收通过前雇主无权单方撤回，保障创作者劳有所得。</div>
          <div>• <strong>知识产权承诺</strong>：未中标方案的知识产权与模型参数仍归创作者个人所有，严禁发布方未经授权商用。</div>
        </div>
      </div>`;
  },

  // ==========================================================================
  // 履约协同域：项目进度 / 项目日报 / 合作双方问答（状态：进行中）
  //   协作对外口径：承接方「随时填报」进度与日报，发布方「随时查看」；
  //   双方就需求细节「互问互答」。三类动作全部留痕在 task.fulfillment 上。
  // ==========================================================================

  // 取当前时间文本（YYYY-MM-DD HH:MM），供日报 / 问答留痕使用
  getDemoNowText: function() {
    const d = new Date();
    const pad = n => String(n).padStart(2, '0');
    return this.getDemoToday() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  },

  // 履约阶段口径（唯一真源）：按进度区间划分四个阶段，避免各处硬编码阶段名
  getFulfillmentStages: function() {
    return [
      { name: '阶段 1：分镜与设定确认', until: 25 },
      { name: '阶段 2：素材生成与粗剪', until: 55 },
      { name: '阶段 3：4K 超分与渲染', until: 85 },
      { name: '阶段 4：版权交付与验收', until: 100 }
    ];
  },

  getFulfillmentStage: function(progress) {
    const p = Math.max(0, Math.min(100, Number(progress) || 0));
    const stages = this.getFulfillmentStages();
    return stages.find(s => p <= s.until) || stages[stages.length - 1];
  },

  // 履约协同数据访问层（唯一入口）：
  //   ① 优先用任务自带的 fulfillment；② 缺失则从台账（creator / publisher 订单）自愈合成，
  //   保证任何「进行中」商单打开看板都不会出现空白或死链。
  getTaskFulfillment: function(task) {
    if (!task) return { creator: '', progress: 0, stage: '', dailyReports: [], questions: [] };
    if (!task.fulfillment) {
      const ledger = MockData.tasks.myOrders || [];
      const order = ledger.find(o => o.sourceId === task.id && typeof o.progress === 'number')
        || ledger.find(o => o.sourceId === task.id)
        || {};
      task.fulfillment = {
        creator: task.selectedCreatorName || order.assigneeName || '',
        progress: Number(order.progress) || 0,
        stage: '',
        dailyReports: [],
        questions: []
      };
    }
    const f = task.fulfillment;
    f.dailyReports = f.dailyReports || [];
    f.questions = f.questions || [];
    f.progress = Math.max(0, Math.min(100, Number(f.progress) || 0));
    if (!f.creator) f.creator = task.selectedCreatorName || '';
    return f;
  },

  // 当前登录用户在该任务中的合作角色：'publisher'（发布方）/ 'creator'（承接方）/ ''（无关第三方）
  // 说明：发布方判定复用唯一口径 isPublisherOfTask；承接方判定以「我的任务 · 承接任务」台账为准，
  //      并用任务上的 selectedCreatorName / 中标候选人兜底。
  getTaskPartyRole: function(task) {
    if (!task) return '';
    if (this.isPublisherOfTask(task)) return 'publisher';
    const me = (MockData.currentUser && MockData.currentUser.name) || '';
    const myOrder = this.getMyCreatorOrderForTask(task.id);
    if (myOrder && ['待接单', '进行中', '待验收', '返修中', '已完成'].includes(myOrder.status)) return 'creator';
    const accepted = (task.applicants || []).find(a => a.status === 'accepted');
    if (accepted && me && accepted.name === me) return 'creator';
    if (task.selectedCreatorName && me && task.selectedCreatorName === me) return 'creator';
    return '';
  },

  // 任务发布方展示名（用于站内消息收件人）：自发布任务取署名主体，否则取「机构 / 团队」斜杠后的团队名
  getTaskPublisherLabel: function(task) {
    const raw = String((task && task.publisherRole) || '').trim();
    if (!raw) return '任务发布方';
    if (/^我发布的任务/.test(raw)) {
      const m = raw.match(/（([^）]+)）/);
      return m ? m[1] : ((MockData.currentUser && MockData.currentUser.name) || raw);
    }
    const parts = raw.split('/');
    return (parts.length > 1 ? parts[1] : parts[0]).trim() || raw;
  },

  // 站内消息收件人：按我方角色取「对手方」名称
  getTaskCounterpartLabel: function(task, role) {
    if (role === 'creator') return this.getTaskPublisherLabel(task);
    const f = this.getTaskFulfillment(task);
    const accepted = (task.applicants || []).find(a => a.status === 'accepted');
    return f.creator || (accepted && accepted.name) || '合作创作者';
  },

  // 履约协同看板：项目进度条 + 四阶段流水 + 项目日报时间线 + 承接方填报入口
  // 权限：合作双方（manage）可看全部日报；大厅访客仅看进度摘要（日报正文脱敏）。
  renderFulfillmentBoard: function(task, isPublisher, manage, myOrderAny) {
    const store = this.getTaskFulfillment(task);
    const progress = store.progress;
    const stages = this.getFulfillmentStages();
    const currentStage = this.getFulfillmentStage(progress);
    const partyRole = this.getTaskPartyRole(task);
    const isParty = manage && !!partyRole;
    const reports = store.dailyReports.slice();

    const stageHtml = stages.map(s => {
      const done = progress > s.until;
      const active = !done && s.name === currentStage.name;
      const color = done ? '#059669' : (active ? '#2563EB' : '#94A3B8');
      const bar = done ? '#10B981' : (active ? '#3B82F6' : '#CBD5E1');
      const label = done ? '已达成 (100%)' : (active ? `进行中 (${progress}%)` : '待启动');
      return `
        <div style="border-left: 3px solid ${bar};">
          <label>${s.name}</label>
          <span style="color:${color}; font-size:12.5px;">${label}</span>
        </div>`;
    }).join('');

    // 项目日报时间线（合作双方可见；承接方与发布方视角一致，保证「双方看到同一份事实」）
    const timelineHtml = reports.length
      ? reports.slice().reverse().map(r => `
          <li class="fulfillment-day${r.risk ? ' is-risk' : ''}">
            <div class="fulfillment-day-top">
              <strong>${r.date || ''} · 进度 ${r.progress != null ? r.progress + '%' : '—'}</strong>
              <span>${r.author || '承接方'} · ${String(r.at || '').slice(11) || '—'} 提交</span>
            </div>
            ${r.stage ? `<p><strong>所处阶段：</strong>${r.stage}</p>` : ''}
            <p><strong>今日完成：</strong>${r.done || r.note || '—'}</p>
            ${r.plan ? `<p><strong>明日计划：</strong>${r.plan}</p>` : ''}
            ${r.risk ? `<p style="color:#B45309;"><strong>风险说明：</strong>${r.risk}</p>` : ''}
          </li>`).join('')
      : `<li class="fulfillment-day is-empty"><p>承接方尚未提交项目日报，发布方可点击【催办日报】提醒补报。</p></li>`;

    // 承接方填报区（仅承接方、且任务进行中时可操作）
    const canFill = isParty && partyRole === 'creator' && task.status === '进行中';
    // 订单 id 解析顺序：我方承接单 → 我方发布单 → 该任务任一承接单（用于按钮回传订单上下文）
    const pubOrderForTask = (MockData.tasks.myOrders || []).find(o => o.role === 'publisher' && o.sourceId === task.id);
    const orderId = (myOrderAny && myOrderAny.id)
      || (pubOrderForTask && pubOrderForTask.id)
      || ((MockData.tasks.myOrders || []).find(o => o.role === 'creator' && o.sourceId === task.id) || {}).id
      || 'MO-TEMP';

    const fillFormHtml = canFill ? `
      <div class="fulfillment-form" id="daily-report-form">
        <div class="fulfillment-form-title">填报今日进度与项目日报</div>
        <div class="fulfillment-form-row" style="display:flex; gap:10px;">
          <div style="flex:1;">
            <label>当前履约进度（%）</label>
            <input type="number" id="daily-report-progress" min="1" max="99" step="1" value="${Math.min(99, Math.max(1, progress))}">
          </div>
          <div style="flex:2;">
            <label>当前所处阶段</label>
            <input type="text" id="daily-report-stage" value="${currentStage.name}">
          </div>
        </div>
        <div class="fulfillment-form-row">
          <label>今日完成内容（必填）</label>
          <textarea id="daily-report-done" rows="3" placeholder="例如：完成 7/12 组分镜线稿，人物三视图一致性已校准。"></textarea>
        </div>
        <div class="fulfillment-form-row">
          <label>明日计划</label>
          <textarea id="daily-report-plan" rows="2" placeholder="例如：交付剩余 5 组分镜并进入整体校色。"></textarea>
        </div>
        <div class="fulfillment-form-row">
          <label>风险与阻塞（选填）</label>
          <textarea id="daily-report-risk" rows="2" placeholder="如涉及交付顺延，请在此说明原因，便于发布方提前决策。"></textarea>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button type="button" class="hero-btn-secondary" onclick="App.resetDailyReportForm()">清空</button>
          <button type="button" class="hero-btn-primary" onclick="App.submitDailyReport('${orderId}')">提交今日日报</button>
        </div>
      </div>` : '';

    let partyBlock = '';
    if (!isParty) {
      partyBlock = `
        <div class="detail-delivery-shield-banner" style="margin-top:2px;">
          <svg class="detail-delivery-shield-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <div class="detail-delivery-shield-text">
            <strong>履约日报与项目协同内容仅对合作双方开放</strong>：任务大厅访客仅可查看整体履约进度与阶段流水；项目日报正文、双方问答与需求确认记录由商单发布方与承接创作者双方专享。
          </div>
        </div>`;
    } else {
      partyBlock = `
        <div class="fulfillment-timeline-head">项目日报 · 共 ${reports.length} 期（最新在前）</div>
        <ul class="fulfillment-timeline">${timelineHtml}</ul>
        ${fillFormHtml}
        ${partyRole === 'publisher'
          ? `<div style="display:flex; justify-content:flex-end; gap:10px;">
               <button type="button" class="hero-btn-secondary" onclick="App.remindDailyReport('${orderId}')">催办日报</button>
               <button type="button" class="hero-btn-secondary" onclick="App.openRejectTaskModal('${orderId}')">驳回返修</button>
             </div>`
          : ''}`;
    }

    return `
      <div class="detail-state-card" id="task-detail-fulfillment">
        <div class="detail-state-card-head">
          <h3 class="detail-state-card-title">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
            项目进度与日报协同看板
          </h3>
          <span style="font-size:12.5px; font-weight:700; color:var(--primary);">总体履约进度 ${progress}%</span>
        </div>
        <div class="fulfillment-summary" style="grid-template-columns: repeat(4, 1fr); margin-bottom:14px;">
          ${stageHtml}
        </div>
        <div class="fulfillment-progress-row" style="margin:0 0 10px 0;">
          <div class="fulfillment-bar"><div class="fulfillment-bar-fill" style="width: ${progress}%; background:linear-gradient(90deg, #10B981, #3B82F6);"></div></div>
          <strong>${progress}%</strong>
        </div>
        <div class="fulfillment-rule" style="margin:0 0 14px;">
          • 承接方每日填报项目进度与日报，发布方可随时在线查看，两端所见为同一份事实；<br>
          • 漏报将按约从托管赏金扣费；需求细节可在下方「商单协同问答」中随时互问互答，问答与日报全程留痕。
        </div>
        ${partyBlock}
      </div>`;
  },

  // 清空日报填报表单（不动任何数据，纯前端重置）
  resetDailyReportForm: function() {
    ['daily-report-done', 'daily-report-plan', 'daily-report-risk'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    this.showToast('已清空本次日报草稿内容（尚未提交，不影响项目进度）');
  },

  // 承接方提交项目日报：唯一写入口，同时刷新进度、台账与发布方站内消息
  submitDailyReport: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order || order.role !== 'creator') { this.showToast('仅承接方可填报项目日报'); return; }
    const task = (MockData.tasks.list || []).find(t => t.id === order.sourceId);
    if (!task) { this.showToast('未找到对应任务'); return; }
    if (task.status !== '进行中') { this.showToast('仅「进行中」的商单可填报项目日报'); return; }

    const readVal = id => { const el = document.getElementById(id); return el ? String(el.value || '').trim() : ''; };
    const progress = Math.round(Number(readVal('daily-report-progress')));
    const done = readVal('daily-report-done');
    if (!Number.isFinite(progress) || progress < 1 || progress > 99) {
      this.showToast('请填写 1~99 之间的履约进度（100% 请走【提交交付】）');
      return;
    }
    if (!done) { this.showToast('请先填写「今日完成内容」再提交日报'); return; }

    const store = this.getTaskFulfillment(task);
    const stage = readVal('daily-report-stage') || this.getFulfillmentStage(progress).name;
    const author = order.assigneeName || store.creator || (MockData.currentUser && MockData.currentUser.name) || '承接方';
    const record = {
      id: 'RPT-' + task.id + '-' + (store.dailyReports.length + 1),
      date: this.getDemoToday(),
      at: this.getDemoNowText(),
      progress: progress,
      stage: stage,
      done: done,
      plan: readVal('daily-report-plan'),
      risk: readVal('daily-report-risk'),
      author: author,
      role: 'creator'
    };
    store.dailyReports.push(record);
    store.progress = progress;
    store.stage = stage;
    task.progress = progress;
    order.progress = progress;
    order.coreInfo = `履约中 · 进度 ${progress}% · 今日日报已填报`;

    // 发布方台账进度同步（双向看板同一份事实）
    const pubOrder = (MockData.tasks.myOrders || []).find(o => o.role === 'publisher' && o.sourceId === task.id);
    if (pubOrder) {
      pubOrder.progress = progress;
      pubOrder.coreInfo = `履约中 · 进度 ${progress}% · 承接方今日日报已更新`;
    }

    // 站内消息留痕：日报同步推送给发布方（收件人为发布方时无需再发给自己）
    if (!this.isPublisherOfTask(task)) {
      this.sendSiteMessage({
        type: 'daily-report',
        typeLabel: '项目日报',
        title: `项目日报：${task.title}`,
        body: `「${author}」已提交今日项目日报，当前进度 ${progress}%（${stage}）。今日完成：${done.slice(0, 60)}${done.length > 60 ? '…' : ''} 可进入任务详情页查看完整日报与项目进度。`,
        to: this.getTaskPublisherLabel(task),
        toAvatar: (task.publisher && task.publisher.avatar) || 'assets/avatars/avatar_business.png',
        taskId: task.id,
        taskTitle: task.title,
        route: 'tasks'
      });
    }

    this.refreshTaskViews();
    if (this.currentDetailTaskId === task.id) this.renderTaskDetailPage();
    this.showToast(`✅ 今日日报已提交 · 进度更新为 ${progress}%，发布方已收到站内通知`);
  },

  // 发布方催办日报：纯提醒动作，不改任务状态、不改进度
  remindDailyReport: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order || order.role !== 'publisher') { this.showToast('仅发布方可催办日报'); return; }
    const task = (MockData.tasks.list || []).find(t => t.id === order.sourceId);
    if (!task) { this.showToast('未找到对应任务'); return; }
    if (task.status !== '进行中') { this.showToast('仅「进行中」的商单可催办日报'); return; }
    const store = this.getTaskFulfillment(task);
    this.sendSiteMessage({
      type: 'daily-report-urge',
      typeLabel: '日报催办',
      title: `日报催办：${task.title}`,
      body: `发布方提示：请按约及时提交《项目日报》并更新履约进度（当前显示进度 ${store.progress}%）。连续漏报将按约从托管赏金中扣费。`,
      to: store.creator || '合作创作者',
      toAvatar: (task.applicants || []).find(a => a.status === 'accepted') ? (task.applicants || []).find(a => a.status === 'accepted').avatar : 'assets/avatars/rank_user_1.png',
      taskId: task.id,
      taskTitle: task.title,
      route: 'tasks'
    });
    this.showToast(`已向「${store.creator || '承接方'}」发送日报催办站内消息（不改变任务状态）`);
  },

  // 合作双方提问（唯一写入口）：写问答台账 + 向对手方推送站内消息
  submitTaskQuestion: function(taskId) {
    const task = (MockData.tasks.list || []).find(t => t.id === (taskId || this.currentDetailTaskId));
    if (!task) { this.showToast('未找到该任务'); return; }
    if (task.status !== '进行中') { this.showToast('仅「进行中」的商单支持合作双方互问互答'); return; }
    const role = this.getTaskPartyRole(task);
    if (!role) { this.showToast('仅该商单的合作双方可参与问答'); return; }
    const input = document.getElementById('task-qa-input');
    const text = String((input && input.value) || '').trim();
    if (!text) { this.showToast('请先输入提问内容'); return; }

    const store = this.getTaskFulfillment(task);
    const me = (MockData.currentUser && MockData.currentUser.name) || '我方';
    const record = {
      id: 'QA-' + task.id + '-' + (store.questions.length + 1),
      at: this.getDemoNowText(),
      from: me,
      role: role,
      text: text,
      answer: '',
      answerAt: '',
      answerBy: '',
      answerRole: ''
    };
    store.questions.push(record);
    if (input) input.value = '';

    this.sendSiteMessage({
      type: 'task-question',
      typeLabel: '项目问答',
      title: `项目提问：${task.title}`,
      body: `「${me}」（${role === 'publisher' ? '发布方' : '承接方'}）在商单协同问答中提出：${text.slice(0, 60)}${text.length > 60 ? '…' : ''} 请及时解答。`,
      to: this.getTaskCounterpartLabel(task, role),
      toAvatar: role === 'publisher'
        ? (((task.applicants || []).find(a => a.status === 'accepted') || {}).avatar || 'assets/avatars/rank_user_1.png')
        : ((task.publisher && task.publisher.avatar) || 'assets/avatars/avatar_business.png'),
      taskId: task.id,
      taskTitle: task.title,
      route: 'tasks'
    });

    this.refreshTaskViews();
    if (this.currentDetailTaskId === task.id) this.renderTaskDetailPage();
    this.showToast('✅ 提问已提交，已向对方推送站内消息，等待解答');
  },

  // 打开「解答问题」弹窗（仅对手方可答、仅未解答的问题可答）
  openTaskAnswerModal: function(taskId, questionId) {
    // 每次进入都先清空上一次的待答上下文，避免被拦截后残留脏上下文
    this._pendingAnswer = null;
    const task = (MockData.tasks.list || []).find(t => t.id === taskId);
    if (!task) { this.showToast('未找到该任务'); return; }
    if (task.status !== '进行中') { this.showToast('仅「进行中」的商单支持解答'); return; }
    const store = this.getTaskFulfillment(task);
    const question = store.questions.find(q => q.id === questionId);
    if (!question) { this.showToast('未找到该提问'); return; }
    const role = this.getTaskPartyRole(task);
    if (!role) { this.showToast('仅该商单的合作双方可解答'); return; }
    if (question.role === role) { this.showToast('不能解答自己提出的问题，请等待对方回复'); return; }
    if (question.answer) { this.showToast('该问题已解答，无需重复回复'); return; }

    this._pendingAnswer = { taskId: taskId, questionId: questionId };
    const title = document.getElementById('qa-answer-title');
    const sub = document.getElementById('qa-answer-sub');
    const preview = document.getElementById('qa-answer-question');
    const input = document.getElementById('qa-answer-input');
    const roleLabel = question.role === 'publisher' ? '发布方' : '承接方';
    if (title) title.innerText = '解答合作方提问';
    if (sub) sub.innerText = `提问方：${question.from}（${roleLabel}）· ${question.at}`;
    if (preview) preview.innerText = question.text;
    if (input) input.value = '';
    this.openModal('modal-qa-answer');
  },

  closeTaskAnswerModal: function() {
    this._pendingAnswer = null;
    this.closeModal('modal-qa-answer');
  },

  // 提交解答：写回问答台账 + 向提问方推送站内消息
  submitTaskAnswer: function() {
    const pending = this._pendingAnswer;
    if (!pending) { this.showToast('解答会话已失效，请重新打开'); return; }
    const task = (MockData.tasks.list || []).find(t => t.id === pending.taskId);
    if (!task) { this.showToast('未找到该任务'); return; }
    const store = this.getTaskFulfillment(task);
    const question = store.questions.find(q => q.id === pending.questionId);
    if (!question) { this.showToast('未找到该提问'); return; }
    const input = document.getElementById('qa-answer-input');
    const text = String((input && input.value) || '').trim();
    if (!text) { this.showToast('请填写解答内容后再提交'); return; }

    const role = this.getTaskPartyRole(task);
    const me = (MockData.currentUser && MockData.currentUser.name) || '我方';
    question.answer = text;
    question.answerAt = this.getDemoNowText();
    question.answerBy = me;
    question.answerRole = role;

    this.sendSiteMessage({
      type: 'task-answer',
      typeLabel: '项目问答',
      title: `问题已解答：${task.title}`,
      body: `「${me}」（${role === 'publisher' ? '发布方' : '承接方'}）已解答你的提问：${text.slice(0, 60)}${text.length > 60 ? '…' : ''}`,
      to: question.from || this.getTaskCounterpartLabel(task, role),
      toAvatar: role === 'publisher'
        ? (((task.applicants || []).find(a => a.status === 'accepted') || {}).avatar || 'assets/avatars/rank_user_1.png')
        : ((task.publisher && task.publisher.avatar) || 'assets/avatars/avatar_business.png'),
      taskId: task.id,
      taskTitle: task.title,
      route: 'tasks'
    });

    this._pendingAnswer = null;
    this.closeModal('modal-qa-answer');
    this.refreshTaskViews();
    if (this.currentDetailTaskId === task.id) this.renderTaskDetailPage();
    this.showToast('✅ 解答已提交，已向提问方推送站内消息');
  },

  // 项目协同问答流（进行中专属）：合作双方互问互答，问答全程留痕
  renderTaskQaThread: function(task, isPublisher, manage) {
    const store = this.getTaskFulfillment(task);
    const questions = store.questions || [];
    const role = this.getTaskPartyRole(task);
    const canAsk = manage && !!role;
    const roleLabel = r => (r === 'publisher' ? '发布方' : '承接方');

    const listHtml = questions.length
      ? questions.slice().reverse().map(q => {
          let answerBlock = '';
          if (q.answer) {
            answerBlock = `
              <div class="detail-qa-a">
                <span class="detail-qa-tag is-a">${roleLabel(q.answerRole)}答</span>
                <span>${q.answer}</span>
              </div>
              <div class="qna-meta is-a">${q.answerBy || ''} · ${q.answerAt || ''}</div>`;
          } else if (canAsk && q.role !== role) {
            answerBlock = `
              <div class="detail-qa-a is-pending">
                <span class="detail-qa-tag is-pending">待解答</span>
                <span>对方正在等待你的解答。</span>
                <button type="button" class="hero-btn-primary" style="padding:4px 12px; font-size:12px; margin-left:auto;" onclick="App.openTaskAnswerModal('${task.id}','${q.id}')">解答该问题</button>
