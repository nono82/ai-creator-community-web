      quota: 1,
      selectedCreatorId: applicantId,
      selectedCreatorName: authorName,
      selectedAt: today,
      escrow: true,
      escrowStatus: `平台已全额托管保障（${moneyText} 待接单）`,
      invoice: true,
      publisherRole: `${me} / ${studio}`,
      customSource: 'gallery',
      sourceWorkId: work.id,
      desc: brief,
      deliverables: '按需求简述与服务套餐约定交付成片及源文件，具体口径以双方站内确认结果为准。',
      tags: ['定向定制', work.category || 'AI短视频', '资金托管'],
      attachments: [],
      applicants: [{
        id: applicantId,
        name: authorName,
        avatar: authorAvatar,
        level: work.authorRole || '高校认证创作者',
        school: work.authorSchool || '高校认证',
        credit: 780,
        appliedAt: nowText,
        proposal: brief || '由展厅作品发起的定向定制邀请',
        status: 'accepted'
      }],
      // 婉拒回退快照：定向商单被婉拒后退回「招募中」，并把该创作者还原为「待选」以便重新发起
      _preSelectStatus: [{ id: applicantId, status: 'pending' }]
    };
    MockData.tasks.list.unshift(task);

    // 发布方台账
    MockData.tasks.myOrders.unshift({
      id: 'ORD_GC_' + stamp,
      sourceId: taskId,
      role: 'publisher',
      type: 'gallery-custom',
      title: title,
      cover: task.cover,
      rewardMoney: moneyText,
      rewardAmount: price,
      escrowFrozen: true,
      status: '待接单',
      creatorName: authorName,
      counterpart: '创作者 / ' + authorName,
      deadline: '待创作者响应接单',
      startDate: today,
      createdAt: '刚刚',
