  // 按时间正序累计，给每条流水补出「变更后余额」快照，最终余额与当前账本一致
  getAiPointLedgerWithBalance: function() {
    const asc = this.getAiPointLedger().slice().sort((a, b) => String(a.time || '').localeCompare(String(b.time || '')));
    const run = { self: 0, integrated: 0 };
    return asc.map(r => {
      run[r.type] = (run[r.type] || 0) + (Number(r.amount) || 0);
      return Object.assign({}, r, { balanceAfter: run[r.type] });
    }).reverse();
  },

