  // 完成指定课节
  completeLessonById: function(planId, lessonId) {
    const plan = (MockData.academy.plans || []).find(p => p.id === planId);
    if (!plan) return;
    const lesson = (plan.lessonList || []).find(l => l.id === lessonId);
    if (!lesson) return;
    if (lesson.status === 'done') {
      this.showToast('本节已完成');
      return;
    }
    // 视频课闸门：未完成观看进度（默认 95%）不允许标记完成，与播放器「防拖拽」闭环
    if (lesson.type === 'video' && this.getPlayerConfig().antiSeek) {
      const durationSec = this.parseLessonDuration(lesson.duration);
      const pct = this.getLessonWatchPercent(lessonId, durationSec);
      const minPct = this.getPlayerConfig().minFinishPercent;
      if (pct < minPct) {
        this.pauseCourseVideo();
        this.showToast(`🔒 本节还需看完 ${minPct}% 才能完成（当前已观看 ${pct}%）；视频不支持拖拽快进，可用播放器右上角倍速加速观看`);
        return;
      }
    }
    lesson.status = 'done';
    // 积分奖励
    MockData.currentUser.learningPoints = (MockData.currentUser.learningPoints || 0) + (lesson.rewardPoints || 30);
    MockData.currentUser.studyHours = (MockData.currentUser.studyHours || 0) + 1;
    // 更新计划进度
    const totalLessons = (plan.lessonList || []).length;
    const doneCount = (plan.lessonList || []).filter(l => l.status === 'done').length;
    plan.progress = Math.round((doneCount / totalLessons) * 100);
    // 标记下一个课节为 learning
    const nextLesson = (plan.lessonList || []).find(l => l.status === 'todo');
    if (nextLesson) nextLesson.status = 'learning';
    this.advanceGrowthPath();
    this.syncLevelBadges();
    this.showToast(`📚 《${lesson.title}》学习完成，+${lesson.rewardPoints} 创作积分`);
    // 刷新当前课程详情页
    this.openAcademyCourseDetail(planId);
  },

  // =========================================================================
  // 定制课程播放器：防拖拽 · 断点续播 · 播放安全
  // 说明：项目受「零依赖、无外部媒体」约束，播放器为**自研 DOM 播放器**——
  // 用虚拟时间轴驱动播放并完全自绘控件，天然屏蔽原生 video 的下载 / 画中画 /
  // 任意倍速与拖条跳播，三大能力全部由本引擎显式实现而非依赖浏览器原生行为。
  // =========================================================================

  // 播放器口径（唯一真源：MockData.academy.playerConfig）
  getPlayerConfig: function() {
    const cfg = (MockData.academy && MockData.academy.playerConfig) || {};
    return {
      antiSeek: cfg.antiSeek !== false,
      resume: cfg.resume !== false,
      watermark: cfg.watermark !== false,
      seekToleranceSec: Number(cfg.seekToleranceSec) || 3,
      heartbeatSec: Number(cfg.heartbeatSec) || 30,
      minFinishPercent: Number(cfg.minFinishPercent) || 95,
      speeds: Array.isArray(cfg.speeds) && cfg.speeds.length ? cfg.speeds : [1, 1.5, 2, 3],
      storageKey: cfg.storageKey || 'occ_lesson_progress_v1'
    };
  },

  // 课节时长文本（"22 分钟" / "1:20"）→ 秒
  parseLessonDuration: function(durationText) {
    const text = String(durationText || '');
    const hm = text.match(/(\d+)\s*:\s*(\d+)/);
    if (hm) return Number(hm[1]) * 60 + Number(hm[2]);
    const m = text.match(/(\d+(?:\.\d+)?)/);
    return m ? Math.round(Number(m[1]) * 60) : 600;
  },

  // 秒 → mm:ss（超过 1 小时自动补 hh）
  formatVideoClock: function(sec) {
    const s = Math.max(0, Math.round(Number(sec) || 0));
    const pad = (n) => String(n).padStart(2, '0');
    const hh = Math.floor(s / 3600);
    const mm = Math.floor((s % 3600) / 60);
    const ss = s % 60;
    return hh > 0 ? `${pad(hh)}:${pad(mm)}:${pad(ss)}` : `${pad(mm)}:${pad(ss)}`;
  },

  // 观看进度台账（会话内 Map + localStorage 持久化；禁用 storage 时降级为会话内有效）
  readLessonProgressMap: function() {
    if (this._lessonProgress) return this._lessonProgress;
    const cfg = this.getPlayerConfig();
    let map = {};
    try {
      if (typeof localStorage !== 'undefined' && localStorage) {
        const raw = localStorage.getItem(cfg.storageKey);
        if (raw) map = JSON.parse(raw) || {};
      }
    } catch (e) { map = {}; }
    this._lessonProgress = map;
    return map;
  },

  writeLessonProgressMap: function() {
    const cfg = this.getPlayerConfig();
    try {
      if (typeof localStorage !== 'undefined' && localStorage) {
        localStorage.setItem(cfg.storageKey, JSON.stringify(this._lessonProgress || {}));
      }
    } catch (e) { /* 隐私模式下忽略持久化，会话内断点续播仍有效 */ }
  },

  getLessonProgress: function(lessonId) {
    return this.readLessonProgressMap()[lessonId] || null;
  },

  saveLessonProgress: function(lessonId, payload) {
    const duration = Number(payload && payload.duration) || 0;
    const position = Math.max(0, Math.min(duration, Number(payload && payload.position) || 0));
    const prev = this.getLessonProgress(lessonId) || { maxWatched: 0 };
    const map = this.readLessonProgressMap();
    map[lessonId] = {
      position: position,
      maxWatched: Math.max(Number(prev.maxWatched) || 0, Number(payload && payload.maxWatched) || 0, position),
      duration: duration,
      updatedAt: Date.now()
    };
    this._lessonProgress = map;
    this.writeLessonProgressMap();
    return map[lessonId];
  },

  // 已观看百分比：以「历史最大观看位置」计，回看不影响达成率
  getLessonWatchPercent: function(lessonId, durationSec) {
    const duration = Number(durationSec) || 0;
    if (!duration) return 0;
    const p = this.getLessonProgress(lessonId);
    if (!p) return 0;
    return Math.min(100, Math.round(((Number(p.maxWatched) || 0) / duration) * 100));
  },

  // 初始化（或重建）播放器，返回自绘播放器 HTML
  initCourseVideoPlayer: function(planId, lessonId, plan, lesson, durationSec) {
    this.stopCourseVideo();
    if (!lesson) return '';
    const cfg = this.getPlayerConfig();
    const duration = Number(durationSec) || this.parseLessonDuration(lesson.duration);
    const saved = cfg.resume ? this.getLessonProgress(lessonId) : null;
    const resumeSec = saved ? Math.max(0, Math.min(duration - 1, Number(saved.position) || 0)) : 0;
    const maxWatched = saved ? Math.max(resumeSec, Math.min(duration, Number(saved.maxWatched) || 0)) : resumeSec;

    this._player = {
      planId: planId,
      lessonId: lessonId,
      duration: duration,
      position: resumeSec,
      maxWatched: maxWatched,
      playing: false,
      speed: 1,
      timer: null,
      wmTimer: null,
      heartbeat: 0,
      lastSaveAt: resumeSec,
      // 本次会话的起播位置：只有在本次会话真正看过（position 偏离起播点）时才回写台账，
      // 避免「重进课节 → 停表」把已有的断点续播位置冲刷成 0
      startPosition: resumeSec
    };

    const u = MockData.currentUser || {};
    const cover = (plan && plan.cover) || '';
    const watchedPct = this.getLessonWatchPercent(lessonId, duration);
    this.bindCourseVideoGuards();
    return `
      <div class="cvp-shell" id="course-video-player" oncontextmenu="return false;">
        <div class="cvp-stage" id="cvp-stage">
          <img src="${cover}" alt="" class="cvp-poster">
          <div class="cvp-scan" id="cvp-scan"></div>
          <div class="cvp-center" id="cvp-center">
            <button type="button" class="cvp-big-play" id="cvp-big-play" onclick="App.toggleCourseVideo()">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            </button>
            <div class="cvp-center-title">${lesson.status === 'done' ? '本节已完成，可回看复习' : '点击开始播放'}</div>
            ${resumeSec > 0 ? `<div class="cvp-resume-tip" id="cvp-resume-tip">断点续播：已为你定位到 ${this.formatVideoClock(resumeSec)}（上次观看到此处）</div>` : ''}
          </div>
          <div class="cvp-toast" id="cvp-toast"></div>
          ${cfg.watermark ? `<div class="cvp-watermark" id="cvp-watermark">${u.name || '学员'} · 学号 ${u.studentId || '—'} · ${this.getDemoNowText()}</div>` : ''}
          <div class="cvp-security-badge">安全播放 · 动态水印 · 已禁用右键 / 下载 / 投屏 / 快进</div>
        </div>
        <div class="cvp-controls">
          <button type="button" class="cvp-btn" id="cvp-play-btn" onclick="App.toggleCourseVideo()">▶</button>
          <span class="cvp-time" id="cvp-time">${this.formatVideoClock(resumeSec)} / ${this.formatVideoClock(duration)}</span>
          <div class="cvp-bar" id="cvp-bar" title="已观看区间可自由回看，未观看区间不可拖拽跳过" onmousedown="App.beginCourseVideoSeek(event)">
            <div class="cvp-bar-bg"></div>
            <div class="cvp-bar-buffer" id="cvp-buffer"></div>
            <div class="cvp-bar-played" id="cvp-played"></div>
            <div class="cvp-bar-lock" id="cvp-lock" title="已观看水位线：不可越过此处向前拖拽"></div>
          </div>
          <button type="button" class="cvp-btn cvp-speed" id="cvp-speed-btn" onclick="App.cycleCourseVideoSpeed()">1.0x</button>
        </div>
        <div class="cvp-foot">
          <span class="cvp-foot-item">防拖拽：未观看内容不可跳过</span>
          <span class="cvp-foot-item">断点续播 · 已观看 <b id="cvp-watched-pct">${watchedPct}%</b></span>
          <span class="cvp-foot-item" id="cvp-heartbeat">观看凭证 · 待校验</span>
        </div>
      </div>
    `;
  },

  toggleCourseVideo: function() {
    const p = this._player;
    if (!p) return;
    if (p.playing) this.pauseCourseVideo();
    else this.playCourseVideo();
  },

  playCourseVideo: function() {
    const p = this._player;
    if (!p || p.timer) return;
    const cfg = this.getPlayerConfig();
    const TICK = 250;
    p.playing = true;
    this.startCourseVideoWatermark();
    p.timer = setInterval(() => {
      const cur = this._player;
      if (!cur) return;
      const step = (TICK / 1000) * cur.speed;
      cur.position = Math.min(cur.duration, cur.position + step);
      cur.maxWatched = Math.max(cur.maxWatched, cur.position);
      const hb = Math.floor(cur.position / cfg.heartbeatSec);
      if (hb !== cur.heartbeat) cur.heartbeat = hb;
      if (Math.abs(cur.position - cur.lastSaveAt) >= 2) {
        cur.lastSaveAt = cur.position;
        this.saveLessonProgress(cur.lessonId, { duration: cur.duration, position: cur.position, maxWatched: cur.maxWatched });
      }
      this.renderCourseVideoState();
      if (cur.position >= cur.duration) {
        this.pauseCourseVideo();
        this.saveLessonProgress(cur.lessonId, { duration: cur.duration, position: cur.duration, maxWatched: cur.duration });
        this.renderCourseVideoState();
        this.showToast('本节视频已看完，可点击「完成本节」领取创作积分');
      }
    }, TICK);
    this.renderCourseVideoState();
  },

  pauseCourseVideo: function() {
    const p = this._player;
    if (!p) return;
    p.playing = false;
    if (p.timer) { clearInterval(p.timer); p.timer = null; }
    if (p.wmTimer) { clearInterval(p.wmTimer); p.wmTimer = null; }
    if (this.getPlayerConfig().resume) {
      this.saveLessonProgress(p.lessonId, { duration: p.duration, position: p.position, maxWatched: p.maxWatched });
    }
    this.renderCourseVideoState();
  },

  // 判断本次会话是否真正产生了观看位移（决定是否需要回写台账）
  _hasWatchedDelta: function(p) {
    return !!p && Math.abs((Number(p.position) || 0) - (Number(p.startPosition) || 0)) > 0.01;
  },

  // 离开课节页时停表并落盘（避免定时器泄漏与脏数位）
  stopCourseVideo: function() {
    const p = this._player;
    this.unbindCourseVideoGuards();
    if (!p) return;
    if (p.timer) clearInterval(p.timer);
    if (p.wmTimer) clearInterval(p.wmTimer);
    p.playing = false;
    p.timer = null;
    p.wmTimer = null;
    if (this.getPlayerConfig().resume && this._hasWatchedDelta(p)) {
      this.saveLessonProgress(p.lessonId, { duration: p.duration, position: p.position, maxWatched: p.maxWatched });
    }
    this._player = null;
  },

  // 进度条拖拽：只能落在「已观看水位线」以内（含容差），越过即回弹并提示
  beginCourseVideoSeek: function(evt) {
    const p = this._player;
    if (!p) return false;
    if (evt && typeof evt.preventDefault === 'function') evt.preventDefault();
    this.applyCourseVideoSeek(evt);
    if (typeof document.addEventListener !== 'function') return false;
    const move = (e) => this.applyCourseVideoSeek(e);
    const up = () => {
      document.removeEventListener('mousemove', move);
      document.removeEventListener('mouseup', up);
    };
    document.addEventListener('mousemove', move);
    document.addEventListener('mouseup', up);
    return false;
  },

  applyCourseVideoSeek: function(evt) {
    const p = this._player;
    if (!p || !evt) return { ok: false };
    const cfg = this.getPlayerConfig();
    const bar = document.getElementById('cvp-bar');
    if (!bar || typeof bar.getBoundingClientRect !== 'function') return { ok: false };
    const rect = bar.getBoundingClientRect();
    const width = Number(rect.width) || 1;
    const ratio = Math.max(0, Math.min(1, ((Number(evt.clientX) || 0) - Number(rect.left || 0)) / width));
    const target = ratio * p.duration;
    if (cfg.antiSeek && target > p.maxWatched + cfg.seekToleranceSec) {
      p.position = p.maxWatched;
      this.renderCourseVideoState();
      this.showCvpToast(`禁止拖拽跳过：已观看至 ${this.formatVideoClock(p.maxWatched)}，请先完整观看`);
      return { ok: false, reason: 'anti-seek' };
    }
    p.position = target;
    p.lastSaveAt = target;
    if (cfg.resume) {
      this.saveLessonProgress(p.lessonId, { duration: p.duration, position: p.position, maxWatched: p.maxWatched });
    }
    this.renderCourseVideoState();
    return { ok: true };
  },

  // 倍速轮播：只允许预设档位，不允许任意倍速（与防拖拽同为学习有效性保护）
  cycleCourseVideoSpeed: function() {
    const p = this._player;
    if (!p) return;
    const speeds = this.getPlayerConfig().speeds;
    const idx = speeds.indexOf(p.speed);
    p.speed = speeds[(idx + 1) % speeds.length];
    this.renderCourseVideoState();
  },

  showCvpToast: function(msg) {
    const el = document.getElementById('cvp-toast');
    if (!el) { this.showToast(msg); return; }
    el.innerText = msg;
    el.classList.add('is-show');
    if (this._cvpToastTimer) clearTimeout(this._cvpToastTimer);
    this._cvpToastTimer = setTimeout(() => { el.classList.remove('is-show'); }, 2600);
  },

  // 播放态 UI 同步（进度条 / 时间 / 水位线 / 观看率 / 观看凭证）
  renderCourseVideoState: function() {
    const p = this._player;
    if (!p) return;
    const cfg = this.getPlayerConfig();
    const setText = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    const pct = p.duration ? (p.position / p.duration) * 100 : 0;
    const lockPct = p.duration ? (p.maxWatched / p.duration) * 100 : 0;
    const played = document.getElementById('cvp-played');
    if (played) played.style.width = pct.toFixed(2) + '%';
    const lock = document.getElementById('cvp-lock');
    if (lock) lock.style.left = lockPct.toFixed(2) + '%';
    const buf = document.getElementById('cvp-buffer');
    if (buf) buf.style.width = Math.min(100, lockPct + 4).toFixed(2) + '%';
    setText('cvp-time', `${this.formatVideoClock(p.position)} / ${this.formatVideoClock(p.duration)}`);
    const btn = document.getElementById('cvp-play-btn');
    if (btn) btn.innerText = p.playing ? '❚❚' : '▶';
    const speedBtn = document.getElementById('cvp-speed-btn');
    if (speedBtn) speedBtn.innerText = p.speed.toFixed(1) + 'x';
    const center = document.getElementById('cvp-center');
    if (center) center.classList.toggle('is-playing', p.playing);
    const scan = document.getElementById('cvp-scan');
    if (scan) scan.classList.toggle('is-playing', p.playing);

    const watchedPct = this.getLessonWatchPercent(p.lessonId, p.duration);
    setText('cvp-watched-pct', watchedPct + '%');
    setText('cvp-finish-pct', watchedPct + '%');
    setText('cvp-heartbeat', p.heartbeat > 0
      ? `观看凭证 · 已签发 ${p.heartbeat} 次`
      : '观看凭证 · 待校验');
    const heartEl = document.getElementById('cvp-heartbeat');
    if (heartEl) heartEl.classList.toggle('is-active', p.heartbeat > 0);
    if (cfg.minFinishPercent) {
      const tip = document.getElementById('cvp-finish-tip');
      if (tip) tip.classList.toggle('is-ok', watchedPct >= cfg.minFinishPercent);
    }
  },

  // 动态水印：滚动时间戳随播放刷新（仅在播放态运行，避免常驻定时器）
  startCourseVideoWatermark: function() {
    const p = this._player;
    if (!p || p.wmTimer) return;
    if (!this.getPlayerConfig().watermark) return;
    if (typeof setInterval !== 'function') return;
    p.wmTimer = setInterval(() => {
      const cur = this._player;
      const el = document.getElementById('cvp-watermark');
      if (!cur || !el) return;
      const u = MockData.currentUser || {};
      el.innerText = `${u.name || '学员'} · 学号 ${u.studentId || '—'} · ${this.getDemoNowText()}`;
    }, 1000);
  },

  // 安全护栏：屏蔽方向键 / PageUp 快进，空格统一走自绘播放按钮
  bindCourseVideoGuards: function() {
    this.unbindCourseVideoGuards();
    if (typeof document.addEventListener !== 'function') return;
    this._cvpKeyGuard = (e) => {
      const p = this._player;
      if (!p) return;
      const key = e && e.key;
      if (!key) return;
      if (key === ' ' || key === 'Spacebar') { e.preventDefault(); this.toggleCourseVideo(); return; }
      if (['ArrowRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End'].indexOf(key) >= 0) {
        e.preventDefault();
        this.showCvpToast('已启用防拖拽：不支持方向键快进 / 快退');
      }
    };
    document.addEventListener('keydown', this._cvpKeyGuard);
  },

  unbindCourseVideoGuards: function() {
    if (this._cvpKeyGuard && typeof document.removeEventListener === 'function') {
      document.removeEventListener('keydown', this._cvpKeyGuard);
    }
    this._cvpKeyGuard = null;
  },

  // 全量课程中心 · 课程类型维度（唯一真源：MockData.academy.plans 的 badge / category）
  getAcademyCourseCategories: function() {
    const plans = MockData.academy.plans || [];
    const order = [];
    const counts = {};
    plans.forEach(p => {
      const cat = p.badge || p.category || '其他';
      if (!counts[cat]) { counts[cat] = 0; order.push(cat); }
      counts[cat] += 1;
    });
    return order.map(name => ({ name: name, count: counts[name] }));
  },

