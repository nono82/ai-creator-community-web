    if (!body) return;
    const tab = this._messagesTab === 'sent' ? 'sent' : 'inbox';
    const list = this.getSiteMessages(tab === 'sent' ? 'out' : 'in');
    const unread = this.countUnreadMessages();

    const tabInbox = document.getElementById('messages-tab-inbox');
    const tabSent = document.getElementById('messages-tab-sent');
    if (tabInbox) {
      tabInbox.classList.toggle('active', tab === 'inbox');
      tabInbox.innerText = unread > 0 ? `收件箱 (${unread})` : '收件箱';
    }
    if (tabSent) {
      tabSent.classList.toggle('active', tab === 'sent');
      tabSent.innerText = '已发送';
    }
    const markAllBtn = document.getElementById('messages-mark-all-btn');
    if (markAllBtn) markAllBtn.hidden = !(tab === 'inbox' && unread > 0);

    if (!list.length) {
      body.innerHTML = `<div class="messages-empty">${tab === 'sent' ? '还没有发出过站内消息' : '暂无站内消息'}</div>`;
      return;
    }

    body.innerHTML = list.map(r => {
      const isOut = r.direction === 'out';
      const who = isOut ? r.to : r.from;
      const avatar = isOut ? (r.toAvatar || '') : (r.fromAvatar || '');
      return `
        <button type="button" class="message-item${r.read ? '' : ' is-unread'}" onclick="${this.buildMessageAction(r, true)}">
          ${avatar ? `<img class="message-item-avatar" src="${avatar}" alt="${who}">` : ''}
          <div class="message-item-main">
            <div class="message-item-top">
              <span class="message-item-type${isOut ? ' is-out' : ''}">${r.typeLabel}</span>
              <span class="message-item-who">${isOut ? '发给' : '来自'} ${who}</span>
              <span class="message-item-ts">${r.ts}</span>
            </div>
            <div class="message-item-title">${r.title}</div>
            <div class="message-item-body">${r.body}</div>
            ${isOut ? `<div class="message-item-status">${r.status || '已送达'}${r.taskId ? ' · 关联 ' + r.taskId : ''}</div>` : ''}
