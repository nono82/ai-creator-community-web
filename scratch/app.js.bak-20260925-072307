  ADMISSION_REQUIREMENTS: {
    acceptTask: ['account', 'identity'],
    publishTask: ['account', 'identity'],
    publishShowcase: ['account', 'identity'],
    withdraw: ['account', 'identity'],
    receiveSettlement: ['account', 'identity', 'merchant'] // 多一道业务前置（FR-001-16 / CON-055）
  },

  // 缺失项 → { label: 中文名（用于提示与断言）, guide: App 上**真实存在**的方法名 }
  ADMISSION_MISSING_SPEC: {
    account: { label: '账号状态', guide: 'openSecuritySettings' },
    identity: { label: '实名认证', guide: 'openIdentityVerifyModal' },
    campus: { label: '学籍认证', guide: 'openSecuritySettings' }, // Phase 1 无动作需要（预留给 SPEC-002）
    merchant: { label: '收款主体资格', guide: 'openMerchantOnboardingModal' }
  },

  /**
   * 年龄闸门（FR-001-45 / 46；SC-001-17 / 18；EX-001-13）
   * **纯函数、无副作用**（因此不在内部计数 —— 防规避计数由调用方做，见 bumpAgeGateReject）。
   *
   * 🔴 口径见 research.md R2：
   *   · **手工解析 `YYYY-MM-DD`，不使用 new Date(str)** —— 后者按 **UTC** 解析，
   *     而「今天」取本地时间 ⇒ GMT+8 下**边界日会判错**
   *   · 用**日历三元组比较**（闰年 2/29 天然正确，无需特例）
   *   · 出生日期**缺失 / 不可解析 ⇒ passed=false**，禁止「未提供即视为成年」
   *
   * @param {string|Date|null|undefined} birthDate
   * @returns {{passed: boolean, reason: string}} 失败时 reason 必为非空字符串
   */
  evaluateAgeGate: function(birthDate) {
    const REQUIRED_AGE = 18;
    const fail = function(reason) { return { passed: false, reason: reason }; };

    const b = this.parseBirthDate(birthDate);
    if (!b) return fail('无法确认年龄：出生日期缺失或不可解析，请联系人工客服');

    const now = new Date();
    const ty = now.getFullYear();
    const tm = now.getMonth() + 1;
    const td = now.getDate();

    let age = ty - b.y;
    // 今年生日尚未到 ⇒ 减 1。恰好生日当天 ⇒ 不减（「已满 18 周岁」当日起算，SC-001-18）
    if (tm < b.m || (tm === b.m && td < b.d)) age -= 1;

    if (age < REQUIRED_AGE) {
      return fail('本平台不面向未满 18 周岁用户，暂无法注册');
    }
    return { passed: true, reason: '' };
  },

  /**
   * 解析出生日期为 { y, m, d }；非法一律返回 null。
   * 🔴 **不使用 `new Date(str)`**（UTC 陷阱，见 evaluateAgeGate 注释）。
   * 「不可解析」的判定面（EX-001-13 / research.md R2）：null / 格式不符 /
   * 月日越界 / 日期不存在（如 2/30）/ 未来日期 / 年龄 > 150。
   */
  parseBirthDate: function(v) {
    if (v === null || v === undefined) return null;

    if (v instanceof Date) {
      if (isNaN(v.getTime())) return null;
      return { y: v.getFullYear(), m: v.getMonth() + 1, d: v.getDate() }; // 取**本地**分量
    }

    const s = String(v).trim();
    const mm = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
    if (!mm) return null;
    const y = Number(mm[1]);
    const mo = Number(mm[2]);
    const d = Number(mm[3]);
    if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
    if (d > new Date(y, mo, 0).getDate()) return null; // 该月无此日（如 2026-02-30）

    const now = new Date();
    if (y > now.getFullYear()) return null;                       // 未来日期
    if (y === now.getFullYear() && mo > now.getMonth() + 1) return null;
    if (now.getFullYear() - y > 150) return null;                 // 显然异常
    return { y: y, m: mo, d: d };
  },

  /**
   * 统一准入判定 —— **全站唯一入口**（FR-001-20 ~ 26）
   * ✅ 幂等且**无副作用**（只读真源，不写任何数据 —— 红灯 C8 断言）
   * ✅ **每次读真源、不缓存**（FR-001-25：凭据变更须即时反映）
   * ✅ 不产生"缺数据默认放行"：`undefined` 一律视为不满足（plan.md §8.5）
   *
   * @param {string} action 见 ADMISSION_ACTIONS
   * @returns {{allowed: boolean, missing: string[], guide: string}}
   */
  checkAdmission: function(action) {
    const reqs = this.ADMISSION_REQUIREMENTS[action] || [];
    const missKeys = [];
    for (let i = 0; i < reqs.length; i++) {
      if (!this.isCredentialMet(reqs[i])) missKeys.push(reqs[i]);
    }
    const spec = this.ADMISSION_MISSING_SPEC;
    return {
      allowed: missKeys.length === 0,
      missing: missKeys.map(function(k) { return (spec[k] && spec[k].label) || k; }),
      guide: missKeys.length === 0 ? '' : ((spec[missKeys[0]] && spec[missKeys[0]].guide) || '')
    };
  },

  /**
   * 单项凭据是否满足 —— **全站唯一的凭据真源读取点**。
   * 所有"是否已实名"的判断（含 isIdVerified 与绑卡 / 充值的闸一）都收敛到这里，
   * 避免同一事实两处维护（原则 2）。
   * Phase 2 把布尔升为五态凭据时，**只改本方法，契约不变**（research.md R3）。
   */
  isCredentialMet: function(key) {
    const u = (MockData && MockData.currentUser) || {};
    if (key === 'account') {
      // 🔴 undefined 不得视为「正常」—— 缺数据须视为**不满足**
      return u.accountStatus === '正常';
    }
    if (key === 'identity') {
      // ⚠️ 只认 idVerified === true：Phase 1 无法表达「认证中」，按保守方向视为未通过（FR-001-11）
      return u.idVerified === true;
    }
    if (key === 'campus') return u.campusVerified === true;
    if (key === 'merchant') return u.merchantStatus === '已入驻';
    return false;
  },

  /**
   * 准入守卫包装：判定 → 拦截（Toast 指明**唯一缺失项** + 唯一引导入口）+ 审计留痕。
   * 入口层统一用法：`if (!this.assertAdmission('withdraw')) return;`
   * @returns {boolean} true = 放行
   */
  assertAdmission: function(action) {
    const r = this.checkAdmission(action);
    if (r.allowed) return true;
    const label = r.missing[0] || '所需资质';
    this.showToast('🚫 需先完成「' + label + '」后方可继续');   // 禁止静默失败（FR-001-21）
    this.recordAdmissionBlock(action, r);
    if (r.guide && typeof this[r.guide] === 'function') this[r.guide](label);
    return false;
  },

  /** 审计留痕（T-001-31；FR-001-43）。Stage A 为内存追加数组；生产形态属 Stage B */
  recordAdmissionBlock: function(action, result) {
    if (!this._auditLog) this._auditLog = [];
    const entry = {
      at: new Date().toISOString(),
      type: 'admission-block',
      action: action,
      missing: (result && result.missing) || [],
      guide: (result && result.guide) || '',
      actor: (MockData.currentUser && MockData.currentUser.name) || '-'
    };
    this._auditLog.push(entry);
    return entry;
  },

  /** 审计日志只读视图（供断言 / 演示查看；FR-001-22 拦截可回放） */
  getAuditLog: function(type) {
    const log = this._auditLog || [];
    if (!type) return log.slice();
    return log.filter(function(e) { return e.type === type; });
  },

  /**
   * 防规避计数（T-001-32；FR-001-48 要求的「存在计数」）
   * 🔴 由**调用方**（注册流程）在年龄判定被拒后调用 ——
   *    不能在 evaluateAgeGate 内部计数，否则破坏其纯函数契约（research.md R2）。
   * ⚠️ 阈值与拦截策略归 SPEC-014 风控；本方法只提供**可观察的计数值**。
   */
  bumpAgeGateReject: function(identityKey) {
    if (!this._admissionFunnel) this._admissionFunnel = { ageGateReject: 0, byIdentity: {} };
    this._admissionFunnel.ageGateReject += 1;
    const k = String(identityKey || '__anonymous__');
    this._admissionFunnel.byIdentity[k] = (this._admissionFunnel.byIdentity[k] || 0) + 1;
    return this._admissionFunnel.ageGateReject;
  },

  /** 防规避计数只读视图（FR-001-48 的"存在计数"可观察） */
  getAdmissionFunnel: function() {
    return this._admissionFunnel || { ageGateReject: 0, byIdentity: {} };
  },

  /**
   * 实名认证引导入口（FR-001-21 的「唯一引导入口」；红灯 C6 要求它是 App 上的真实方法）
   * 不新增 HTML 骨架 ⇒ 复用既有「安全设置」弹窗的实名认证区块（CON-027：不改 index.html）
   */
  openIdentityVerifyModal: function() {
    this.openSecuritySettings('实名认证');
  },

  /**
   * 收款主体资格（微信支付二级商户入驻）引导入口（FR-001-16 / 21）
   * Phase 1 只提供**引导**；机构侧开户对接归 SPEC-008（CON-055）
   */
  openMerchantOnboardingModal: function() {
    this.openSecuritySettings('收款主体资格');
  },

  // 是否已完成实名认证（提现 / 绑卡 / 充值的共同前置）
  // ✅ T-001-24：**委托** isCredentialMet('identity') —— 本方法保留为对外契约名
  //    （wb-withdraw H12 断言其定义唯一），但**不再是独立的判定实现**（原则 2）。
  isIdVerified: function() {
    return this.isCredentialMet('identity');
  },

  // 校验单张卡是否可用于提现，返回 { ok, reason, card }
  // 校验顺序：实名 → 卡类型（仅借记卡）→ 同名（持卡人 = 实名姓名）
  validateWithdrawAccount: function(cardId) {
    const rules = this.getWithdrawRules();
    const card = this.getWithdrawAccounts().find(c => c.id === cardId);
    if (!card) return { ok: false, reason: '请选择用于收款的银行借记卡', card: null };

    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, reason: '账户未完成实名认证，暂不可提现', card };
    }
    if (rules.debitOnly && card.cardType !== 'debit') {
      return { ok: false, reason: `${card.bank}（尾号 ${card.tail}）为${card.cardTypeLabel || '信用卡'}，仅支持提现至银行借记卡`, card };
    }
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    if (rules.sameNameOnly && card.holder !== realName) {
      return { ok: false, reason: `持卡人「${card.holder}」与实名认证姓名「${realName}」不一致，必须同名提现`, card };
    }
    return { ok: true, reason: '', card };
  },

  // 渲染收款账户下拉：不可用的卡保留展示但置灰并标注原因，让四条合规规则在 UI 上可见
  renderWithdrawAccounts: function() {
    const sel = document.getElementById('withdraw-account-select');
    if (!sel) return null;

    const cards = this.getWithdrawAccounts();
    let firstUsable = null;
    sel.innerHTML = cards.map(c => {
      const v = this.validateWithdrawAccount(c.id);
      if (v.ok && firstUsable === null) firstUsable = c.id;
      const label = `${c.bank}（尾号 ${c.tail}）· ${c.cardTypeLabel || '借记卡'} · ${c.holder}`;
      return `<option value="${c.id}"${v.ok ? '' : ' disabled'}>${label}${v.ok ? '' : ' —— 不可用：' + v.reason}</option>`;
    }).join('');

    // 优先落到当前选中项：选中项可用则保留，否则回落到首张可用卡（都不可用则为空）
    const keep = this.validateWithdrawAccount(sel.value).ok ? sel.value : firstUsable;
    sel.value = keep || '';
    return firstUsable;
  },

  // 刷新提现弹窗：实名状态条 + 规则说明 + 收款账户 + 提交按钮可用态
  refreshWithdrawPanel: function() {
    const rules = this.getWithdrawRules();
    const verified = this.isIdVerified();
    const u = MockData.currentUser || {};
    const src = this.getWithdrawSource();

    // ⓪ 资金来源条（明确「创作收益」为唯一可提现钱包）
    const srcText = document.getElementById('withdraw-source-text');
    if (srcText) {
      srcText.innerText = `资金来源：${src.label}（唯一可提现）· 可用 ¥ ${this.formatMoney(src.amount)}`;
    }
    const srcLock = document.getElementById('withdraw-source-lock');
    if (srcLock) srcLock.innerText = src.note || '账户余额只可充值，不可提现';

    // ① 实名状态条
    const strip = document.getElementById('withdraw-verify-strip');
    const text = document.getElementById('withdraw-verify-text');
    const state = document.getElementById('withdraw-verify-state');
    if (strip) strip.classList.toggle('is-unverified', !verified);
    if (text) {
      text.innerText = verified
        ? `实名认证已通过 · ${u.realName || ''}（${u.phone || ''}）· 收款人必须与此姓名一致`
        : '账户尚未完成实名认证，按监管要求不能提现';
    }
    if (state) state.innerText = verified ? '已实名' : '未实名';

    // ② 四条合规规则 chips
    const ruleRow = document.getElementById('withdraw-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.sameNameOnly ? '✓' : ''} 必须同名提现`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`
      ];
      ruleRow.innerHTML = chips.map((c, i) => {
        const bad = i === 0 && !verified;
        return `<span class="withdraw-rule-chip${bad ? ' is-error' : ''}">${c}</span>`;
      }).join('');
    }

    // ③ 收款账户
    const usableId = this.renderWithdrawAccounts();
    this.onWithdrawAccountChange();

    // ④ 提交按钮可用态（未实名或无可用同名借记卡时给出置灰视觉，点击仍会给出原因提示）
    const btn = document.getElementById('withdraw-submit-btn');
    if (btn) {
      const blocked = (rules.requireIdVerified && !verified) || !usableId;
      btn.classList.toggle('is-disabled', blocked);
      btn.setAttribute('aria-disabled', blocked ? 'true' : 'false');
    }
  },

  // 打开申请提现弹窗（统一入口；source 恒为唯一的资金来源「创作收益」）
  openWithdrawModal: function(source) {
    // 【准入守卫 · T-001-21】提现是准入动作 ⇒ 统一走 checkAdmission（唯一入口）
    // 🔴 必须在 openModal 之前拦截，确保拦截时弹窗不打开、且零副作用（红灯 F1 / F2）
    if (!this.assertAdmission('withdraw')) return;
    this._withdrawSource = source || 'income';
    this.openModal('modal-withdraw');
  },

  // 收款账户切换：回显所选卡的同名核验结论
  onWithdrawAccountChange: function() {
    const sel = document.getElementById('withdraw-account-select');
    const note = document.getElementById('withdraw-account-note');
    if (!note) return;

    if (!this.isIdVerified()) {
      note.className = 'withdraw-account-note is-error';
      note.innerText = '未实名认证：请先完成实名认证，再选择本人同名借记卡收款';
      return;
    }
    const v = this.validateWithdrawAccount(sel && sel.value);
    if (!v.card) {
      note.className = 'withdraw-account-note is-error';
      note.innerText = '当前账户下没有可用于提现的同名借记卡，请先添加本人借记卡（不支持信用卡与异名卡）';
      return;
    }
    note.className = 'withdraw-account-note' + (v.ok ? '' : ' is-error');
    note.innerText = v.ok
      ? `${v.card.bank} · ${v.card.cardTypeLabel || '借记卡'} · 持卡人 ${v.card.holder} 与实名一致 · ${this.getWithdrawRules().arrivalNote}`
      : v.reason;
  },

  // 金额实时校验提示（单笔上限 ¥10,000 / 可提现余额）
  onWithdrawAmountInput: function() {
    const input = document.getElementById('withdraw-amount-input');
    const hint = document.getElementById('withdraw-amount-hint');
    if (!input || !hint) return;

    const rules = this.getWithdrawRules();
    const src = this.getWithdrawSource();
    const avail = src.amount;
    const base = `当前可提现「${src.label}」¥ ${this.formatMoney(avail)} · 单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`;
    const amount = parseFloat(input.value);

    if (isNaN(amount) || amount <= 0) {
      hint.className = 'withdraw-amount-hint';
      hint.innerText = base;
      return;
    }
    if (amount > rules.maxPerTx) {
      hint.className = 'withdraw-amount-hint is-error';
      hint.innerText = `单笔提现上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，你输入了 ¥ ${this.formatMoney(amount)}，请拆分为多笔提现`;
      return;
    }
    if (amount > avail) {
      hint.className = 'withdraw-amount-hint is-error';
      hint.innerText = `超出可提现「${src.label}」¥ ${this.formatMoney(avail)}（账户余额为平台充值钱包，不可提现）`;
      return;
    }
    hint.className = 'withdraw-amount-hint is-ok';
    hint.innerText = `本次提现将从「${src.label}」扣减 ¥ ${this.formatMoney(amount)}，提现后剩余 ¥ ${this.formatMoney(avail - amount)}`;
  },

  // 提交提现申请：四道闸全通过才扣减余额并写入「提现 · 处理中」流水
  submitWithdraw: function() {
    const rules = this.getWithdrawRules();

    // 闸一：必须已完成实名认证
    // 【T-001-24 委托化】改为由 App.checkAdmission('withdraw') 出结论 —— 提现是准入动作，
    // 不得在本方法内再写第二套判定（Constitution 原则 2）。收益：① 冻结态也会正确拦截
    // （FR-001-24）；② 提示归因于**真实缺失项**（不再一律归咎"未实名"）。
    // ⚠️ 文案保留既有口径（wb-withdraw G01/G02 断言 '实名认证' / '不能提现'；G03 断言引导项）
    const admWithdraw = this.checkAdmission('withdraw');
    if (rules.requireIdVerified && !admWithdraw.allowed) {
      const missLabel = admWithdraw.missing[0] || '实名认证';
      this.showToast('🚫 按监管要求不能提现：' + missLabel + '未满足；请先在【安全设置】处理');
      this.openSecuritySettings(missLabel);
      return;
    }

    // 闸二：必须提现到本人同名借记卡
    const sel = document.getElementById('withdraw-account-select');
    const accountCheck = this.validateWithdrawAccount(sel && sel.value);
    if (!accountCheck.ok) {
      this.showToast(`🚫 ${accountCheck.reason}`);
      this.refreshWithdrawPanel();
      return;
    }
    const card = accountCheck.card;

    // 闸三：金额有效性 + 单笔上限 ¥10,000
    const input = document.getElementById('withdraw-amount-input');
    const amount = Math.round((parseFloat(input && input.value) || 0) * 100) / 100;
    if (isNaN(amount) || amount <= 0) {
      this.showToast('请输入有效的提现金额');
      return;
    }
    if (amount > rules.maxPerTx) {
      this.showToast(`🚫 单笔提现上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，请拆分为多笔提现`);
      this.onWithdrawAmountInput();
      return;
    }

    // 闸四：资金来源（创作收益）充足
    const src = this.getWithdrawSource();
    const avail = src.amount;
    if (amount > avail) {
      this.showToast(`超出可提现「${src.label}」（¥ ${this.formatMoney(avail)}）；账户余额为平台充值钱包，不可提现`);
      this.onWithdrawAmountInput();
      return;
    }

    // 校验全通过：只扣减「创作收益」这一唯一出金钱包，账户余额（含冻结额）一分不动
    const cards = (MockData.assets && MockData.assets.cards) || {};
    cards[src.key] = this.formatMoney(Math.max(0, avail - amount));
    cards.totalWithdrawn = this.formatMoney((parseFloat(String(cards.totalWithdrawn || '0').replace(/,/g, '')) || 0) + amount);

    const earnItem = (MockData.assets.breakdown.items || []).find(it => it.label === '创作收益');
    if (earnItem) {
      earnItem.value = Math.max(0, avail - amount);
      earnItem.amount = '¥ ' + this.formatMoney(earnItem.value);
    }
    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '提现',
      name: `创作收益提现到${card.bank}借记卡 (尾号 ${card.tail})`,
      amount: `- ¥ ${this.formatMoney(amount)}`,
      rawAmount: -amount,
      status: '处理中',
      statusType: 'done',
      time: '刚刚',
      category: '提现'
    });

    this.refreshAssetDisplays();
    this.renderTransactionsTable();
    this.closeModal('modal-withdraw');
    this.showToast(`提现申请已提交！¥ ${this.formatMoney(amount)} 已从「${src.label}」扣减，${rules.arrivalNote}至${card.bank}借记卡（尾号 ${card.tail}），收款人 ${card.holder} 与实名一致`);
  },

  // =========================================================================
  // 资产安全中心 · 银行卡绑定与换绑（仅支持本人同名境内银联借记卡）
  // =========================================================================

  // 绑卡规则总口径（唯一真源：MockData.assets.bankBindRules）
  getBankBindRules: function() {
    const r = (MockData.assets && MockData.assets.bankBindRules) || {};
    return {
      requireIdVerified: r.requireIdVerified !== false,
      debitOnly: r.debitOnly !== false,
      sameNameOnly: r.sameNameOnly !== false,
      unionPayOnly: r.unionPayOnly !== false,
      codeRequired: r.codeRequired !== false,
      maxCards: Number(r.maxCards) || 2,
      note: r.note || '仅支持绑定本人同名境内银联借记卡（储蓄卡）'
    };
  },

  // 已绑定银行卡台账
  getBankCards: function() {
    return (MockData.assets && MockData.assets.bankCards) || [];
  },

  // 卡号掩码展示：6225 **** **** 1234
  maskBankCardNo: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (d.length < 8) return d;
    return `${d.slice(0, 4)} **** **** ${d.slice(-4)}`;
  },

  // Luhn 校验（离线零依赖，识别卡号是否合法）
  luhnCheck: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (!d) return false;
    let sum = 0;
    let alt = false;
    for (let i = d.length - 1; i >= 0; i--) {
      let n = Number(d[i]);
      if (alt) { n *= 2; if (n > 9) n -= 9; }
      sum += n;
      alt = !alt;
    }
    return sum % 10 === 0;
  },

  // 依据 BIN 号段离线识别发卡行与卡种（取最长前缀匹配）
  detectBankCard: function(cardNo) {
    const d = String(cardNo || '').replace(/\D/g, '');
    if (!/^\d{16,19}$/.test(d)) {
      return { ok: false, cardNo: d, reason: '银行卡号应为 16-19 位数字，请核对后重新输入' };
    }
    if (!this.luhnCheck(d)) {
      return { ok: false, cardNo: d, reason: '卡号格式校验未通过（Luhn 校验失败），请核对卡号' };
    }
    const table = (MockData.assets && MockData.assets.bankBinTable) || [];
    const hit = table.filter(t => d.indexOf(t.prefix) === 0)
      .sort((a, b) => b.prefix.length - a.prefix.length)[0];
    if (hit) {
      return {
        ok: true, cardNo: d, tail: d.slice(-4), bank: hit.bank,
        cardType: hit.cardType, cardTypeLabel: hit.cardTypeLabel, binPrefix: hit.prefix
      };
    }
    if (/^(4|5|3[47])/.test(d)) {
      return {
        ok: false, cardNo: d, bank: '国际卡组织', cardType: 'credit', cardTypeLabel: '国际信用卡',
        reason: '识别为 Visa / MasterCard 等国际卡组织号段，仅支持绑定境内银联借记卡'
      };
    }
    return {
      ok: false, cardNo: d, bank: '未知发卡行', cardType: 'unknown',
      reason: '未能识别的银联卡号段，暂不支持绑定该银行卡'
    };
  },

  // 单张卡在「资产安全中心」的可用状态（依据规则实时推导，不落库）
  getBankCardStatus: function(card) {
    const rules = this.getBankBindRules();
    if (!card) return { ok: false, key: 'invalid', shortLabel: '异常', reason: '银行卡不存在' };
    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, key: 'invalid', shortLabel: '待实名', reason: '账户未完成实名认证，完成实名后方可绑定与使用银行卡' };
    }
    if (rules.debitOnly && card.cardType !== 'debit') {
      return {
        ok: false, key: 'invalid', shortLabel: '非借记卡',
        reason: `${card.bank}（尾号 ${card.tail}）为${card.cardTypeLabel || '信用卡'}，仅支持绑定与使用银行借记卡`
      };
    }
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    if (rules.sameNameOnly && card.holder !== realName) {
      return {
        ok: false, key: 'invalid', shortLabel: '非本人卡',
        reason: `持卡人「${card.holder}」与实名认证姓名「${realName}」不一致，仅支持绑定本人银行卡`
      };
    }
    return { ok: true, key: 'active', shortLabel: '可用', reason: '' };
  },

  // 绑定 / 换绑统一校验：实名 → 持卡人同名 → 卡号识别 → 仅限借记卡 → 不得重复 → 张数上限
  // options.excludeId：换绑时排除被替换的原卡（允许占用同名卡位）
  validateBankCardBind: function(cardNo, holder, options) {
    const opts = options || {};
    const rules = this.getBankBindRules();
    const realName = (MockData.currentUser && MockData.currentUser.realName) || '';
    const name = String(holder || '').trim();

    if (rules.requireIdVerified && !this.isIdVerified()) {
      return { ok: false, gate: 'id-verified', reason: '账户未完成实名认证，按监管要求完成实名后方可绑定银行卡' };
    }
    if (rules.sameNameOnly && name !== realName) {
      return {
        ok: false, gate: 'same-name',
        reason: name
          ? `持卡人「${name}」与实名认证姓名「${realName}」不一致，仅支持绑定本人银行卡`
          : '请填写持卡人姓名，且必须与实名认证姓名一致'
      };
    }
    const d = this.detectBankCard(cardNo);
    if (!d.ok) return Object.assign({ gate: 'card-no' }, d);
    if (rules.debitOnly && d.cardType !== 'debit') {
      return Object.assign({}, d, {
        ok: false, gate: 'debit-only',
        reason: `${d.bank}（尾号 ${d.tail}）为${d.cardTypeLabel}，仅支持绑定银行借记卡（储蓄卡）`
      });
    }
    const dup = this.getBankCards().find(c => c.cardNo === d.cardNo && c.id !== opts.excludeId);
    if (dup) {
      return Object.assign({}, d, {
        ok: false, gate: 'duplicate',
        reason: `${d.bank}（尾号 ${d.tail}）已绑定，请勿重复绑定`
      });
    }
    if (!opts.excludeId && this.getBankCards().length >= rules.maxCards) {
      return Object.assign({}, d, {
        ok: false, gate: 'max-cards',
        reason: `单个账户最多绑定 ${rules.maxCards} 张银行卡（当前在册 ${this.getBankCards().length} 张），请先解绑不再使用的卡`
      });
    }
    return Object.assign({ ok: true, gate: '' }, d);
  },

  // 单张银行卡行渲染（唯一陈列位：常用功能「银行卡管理」弹窗）
  bankCardRowHtml: function(card) {
    const st = this.getBankCardStatus(card);
    const tags = [];
    if (card.isDefault) tags.push('<span class="bank-card-tag is-default">默认结算卡</span>');
    tags.push(`<span class="bank-card-tag">${card.cardTypeLabel || '借记卡'}</span>`);
    if (!st.ok) tags.push(`<span class="bank-card-tag is-invalid">${st.shortLabel}</span>`);

    const acts = [];
    if (!st.ok) {
      // 待整改存量卡：可【去换绑】整改，也可直接【解绑】腾出卡位（否则存量超限时无法再新增）
      acts.push(`<button type="button" class="bank-card-act is-primary" onclick="App.openBankCardBindModal('rebind','${card.id}')">去换绑</button>`);
      if (card.isDefault) {
        acts.push('<span class="bank-card-act-hint">默认卡不可解绑</span>');
      } else if (this._unbindConfirmId === card.id) {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.confirmUnbindBankCard('${card.id}')">确认解绑</button>`);
        acts.push('<button type="button" class="bank-card-act" onclick="App.cancelUnbindBankCard()">取消</button>');
      } else {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.armUnbindBankCard('${card.id}')">解绑</button>`);
      }
    } else {
      if (!card.isDefault) {
        acts.push(`<button type="button" class="bank-card-act" onclick="App.setPayoutBankCard('${card.id}')">设为默认</button>`);
      }
      acts.push(`<button type="button" class="bank-card-act" onclick="App.openBankCardBindModal('rebind','${card.id}')">换绑</button>`);
      if (card.isDefault) {
        acts.push('<span class="bank-card-act-hint">默认卡不可解绑</span>');
      } else if (this._unbindConfirmId === card.id) {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.confirmUnbindBankCard('${card.id}')">确认解绑</button>`);
        acts.push('<button type="button" class="bank-card-act" onclick="App.cancelUnbindBankCard()">取消</button>');
      } else {
        acts.push(`<button type="button" class="bank-card-act is-danger" onclick="App.armUnbindBankCard('${card.id}')">解绑</button>`);
      }
    }

    return `
      <div class="bank-card-row${st.ok ? '' : ' is-invalid'}">
        <div class="bank-card-head">
          <span class="bank-card-logo">${String(card.bank || '').slice(0, 2)}</span>
          <div class="bank-card-info">
            <div class="bank-card-name">${card.bank}<span class="bank-card-tail">尾号 ${card.tail}</span></div>
            <div class="bank-card-no">${this.maskBankCardNo(card.cardNo)}</div>
            <div class="bank-card-tags">${tags.join('')}</div>
          </div>
        </div>
        ${st.ok ? '' : `<div class="bank-card-invalid-reason">⚠️ ${st.reason}</div>`}
        <div class="bank-card-meta">持卡人 ${card.holder} · ${card.branch || '—'} · 绑定于 ${card.boundAt || '—'}</div>
        <div class="bank-card-actions">${acts.join('')}</div>
      </div>
    `;
  },

  // 渲染常用功能「银行卡管理」弹窗内的银行卡台账（资产主面板与安全设置均不再陈列卡明细）
  renderBankCardBlocks: function() {
    const cards = this.getBankCards();
    const rules = this.getBankBindRules();
    const verified = this.isIdVerified();
    const usable = cards.filter(c => this.getBankCardStatus(c).ok).length;

    const list = document.getElementById('bank-manage-list');
    if (list) {
      list.innerHTML = cards.length
        ? cards.map(c => this.bankCardRowHtml(c)).join('')
        : '<div class="bank-card-empty">尚未绑定银行卡，绑定本人同名借记卡后即可提现收款与账户充值</div>';
    }

    // 绑卡口径 chips
    const ruleRow = document.getElementById('bank-manage-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.sameNameOnly ? '✓' : ''} 仅限本人卡`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `${rules.unionPayOnly ? '✓' : ''} 仅限银联卡`,
        `最多 ${rules.maxCards} 张`
      ];
      ruleRow.innerHTML = chips
        .map((c, i) => `<span class="recharge-rule-chip${i === 0 && !verified ? ' is-error' : ''}">${c}</span>`)
        .join('');
    }

    // 张数统计 / 实名前置 / 已达上限 / 存量超限四种口径提示
    const tip = document.getElementById('bank-manage-tip');
    if (tip) {
      const atLimit = cards.length >= rules.maxCards;
      const overLimit = cards.length > rules.maxCards;
      tip.className = 'bank-card-block-tip' + (verified && !overLimit ? '' : ' is-error');
      if (!verified) {
        tip.innerText = `未完成实名认证，暂不可绑定或使用银行卡 · ${rules.note}`;
      } else if (overLimit) {
        tip.innerText = `已绑定 ${cards.length} 张（其中 ${usable} 张可用），存量已超出上限 ${rules.maxCards} 张 · ${rules.note} · 请先解绑不再使用的卡后再新增`;
      } else if (atLimit) {
        tip.innerText = `已绑定 ${cards.length} / ${rules.maxCards} 张（其中 ${usable} 张可用） · ${rules.note} · 已达上限，如需新增请先解绑不再使用的卡`;
      } else {
        tip.innerText = `已绑定 ${cards.length} / ${rules.maxCards} 张（其中 ${usable} 张可用） · ${rules.note}`;
      }
    }

    // 未实名时绑定入口给出置灰视觉（点击仍会给出具体原因）
    const addBtn = document.getElementById('bank-manage-add');
    if (addBtn) addBtn.classList.toggle('is-disabled', !verified);
  },

  // 打开银行卡管理弹窗（入口：常用功能「银行卡管理」）
  openBankCardManageModal: function() {
    this._unbindConfirmId = '';
    this.openModal('modal-bank-card-manage');
    this.renderBankCardBlocks();
  },

  // 打开绑定 / 换绑银行卡弹窗（mode: 'bind' 绑定新卡 | 'rebind' 换绑）
  openBankCardBindModal: function(mode, cardId) {
    const isRebind = mode === 'rebind';
    const target = isRebind ? this.getBankCards().find(c => c.id === cardId) : null;
    if (isRebind && !target) {
      this.showToast('未找到需要换绑的银行卡');
      return;
    }

    this._bankBind = { mode: isRebind ? 'rebind' : 'bind', targetId: target ? target.id : '', codeSent: false, code: '' };
    this._unbindConfirmId = '';

    const setText = (id, txt) => {
      const el = document.getElementById(id);
      if (el) el.innerText = txt;
    };
    const setVal = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.value = val;
    };

    setText('bank-bind-title', isRebind ? '换绑银行卡' : '绑定银行卡');
    setText('bank-bind-sub', isRebind
      ? `换绑后原卡（${target.bank} 尾号 ${target.tail}）将即刻解绑，收款账户切换为新卡`
      : '仅支持绑定本人同名境内银联借记卡（储蓄卡）');
    setVal('bank-bind-holder', (MockData.currentUser && MockData.currentUser.realName) || '');
    setVal('bank-bind-cardno', '');
    setVal('bank-bind-branch', '');
    setVal('bank-bind-code', '');

    const codeBtn = document.getElementById('bank-bind-code-btn');
    if (codeBtn) {
      codeBtn.classList.remove('is-disabled');
      codeBtn.innerText = '获取验证码';
    }

    const strip = document.getElementById('bank-bind-rebind-strip');
    if (strip) {
      strip.className = 'bank-bind-rebind-strip' + (isRebind ? ' is-on' : '');
      strip.innerHTML = isRebind
        ? `<span class="bank-bind-rebind-label">待换绑原卡</span>
           <span class="bank-bind-rebind-card">${target.bank} · ${target.cardTypeLabel || '借记卡'} · 尾号 ${target.tail}</span>`
        : '';
    }

    this.onBankCardNoInput();
    this.refreshBankBindPanel();
    this.openModal('modal-bank-card-bind');
  },

  // 刷新绑卡弹窗：实名状态条 + 规则 chips + 演示卡号 + 提交按钮可用态
  refreshBankBindPanel: function() {
    const rules = this.getBankBindRules();
    const verified = this.isIdVerified();
    const u = MockData.currentUser || {};
    const bind = this._bankBind || { mode: 'bind' };

    const strip = document.getElementById('bank-bind-verify-strip');
    const text = document.getElementById('bank-bind-verify-text');
