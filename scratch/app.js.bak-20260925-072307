  // ====== 站内消息中心 ======
  // 设计口径：全站「发站内消息」只有一个写入口 —— App.sendSiteMessage()。
  // 任何业务流程（选定创作者 / 催办响应 / 后续其他动作）都必须经它写入，
  // 禁止各处直接 push MockData.messages.records，避免多真源漂移。
  sendSiteMessage: function(payload) {
    const cfg = payload || {};
    if (!cfg.to) { this.showToast('缺少消息接收方，站内消息未发送'); return null; }
    MockData.messages = MockData.messages || { records: [] };
    MockData.messages.records = MockData.messages.records || [];

    const record = {
      id: 'MSG-OUT-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
      direction: 'out',
      type: cfg.type || 'platform-notice',
      typeLabel: cfg.typeLabel || '平台通知',
      title: cfg.title || '站内消息',
      body: cfg.body || '',
      from: MockData.currentUser.name,
      fromAvatar: MockData.currentUser.avatar,
      to: cfg.to,
      toAvatar: cfg.toAvatar || 'assets/avatars/rank_user_1.png',
      taskId: cfg.taskId || '',
      taskTitle: cfg.taskTitle || '',
      ts: '刚刚',
      read: true,          // 我发出的消息对我自己恒为已读，不计入未读角标
      status: '已送达',
      route: cfg.route || ''
    };
    // 全表按时间倒序（最新在前），收件箱与已发送共用同一份序列
    MockData.messages.records.unshift(record);
    this.refreshMessages();
    return record;
  },

  getSiteMessages: function(direction) {
    const all = (MockData.messages && MockData.messages.records) || [];
    if (!direction) return all.slice();
    return all.filter(r => r.direction === direction);
  },

  // 未读角标只统计「收件箱」——我发出的消息不构成我自己的未读
  countUnreadMessages: function() {
    return this.getSiteMessages('in').filter(r => !r.read).length;
  },

  updateNotifyBadge: function() {
    const badge = document.getElementById('notify-badge');
    if (!badge) return;
    badge.hidden = this.countUnreadMessages() === 0;
  },

  markMessageRead: function(messageId) {
    const rec = this.getSiteMessages().find(r => r.id === messageId);
    if (rec) rec.read = true;
    this.refreshMessages();
  },

  markAllMessagesRead: function() {
    this.getSiteMessages('in').forEach(r => { r.read = true; });
    this.refreshMessages();
  },

  // 消息条目点击行为：关面板 → 标记已读（仅收件箱）→ 按 route 跳转
  // ⚠️ 各语句必须用 '; ' 分隔：内联 onclick 里多条调用裸拼会直接 SyntaxError
  buildMessageAction: function(record, fromCenter) {
    const parts = [fromCenter ? 'App.closeMessagesModal()' : 'App.closeNotifyDropdown()'];
    if (record.direction === 'in') parts.push(`App.markMessageRead('${record.id}')`);
    const go = {
      tasks: "App.navigateTo('tasks'); App.setTasksMode('mine')",
      community: "App.navigateTo('community')",
      assets: "App.navigateTo('assets')"
    }[record.route];
    if (go) parts.push(go);
    return parts.join('; ') + ';';
  },

  // 唯一刷新出口：角标 + 下拉 + 消息中心三处同源
  refreshMessages: function() {
    this.updateNotifyBadge();
    const drop = document.getElementById('notify-dropdown');
    if (drop && !drop.hidden) this.renderNotifyDropdown();
    if (document.getElementById('messages-center-body')) this.renderMessagesModal();
  },

  renderNotifyDropdown: function() {
    const drop = document.getElementById('notify-dropdown');
    if (!drop) return;
    const inbox = this.getSiteMessages('in');
    const sent = this.getSiteMessages('out').slice(0, 2);
    const unread = this.countUnreadMessages();

    let html = `<div class="notify-dropdown-head">
      <span>通知消息</span>
      ${unread > 0 ? `<button type="button" class="notify-dropdown-markall" onclick="App.markAllMessagesRead()">全部已读</button>` : ''}
    </div>`;

    html += inbox.length
      ? inbox.slice(0, 3).map(r => `
        <button type="button" class="notify-dropdown-item${r.read ? '' : ' is-unread'}" onclick="${this.buildMessageAction(r, false)}">
          <strong>${r.title}</strong>
          <span>${r.body}</span>
        </button>`).join('')
      : '<div class="notify-dropdown-empty">暂无站内消息</div>';

    if (sent.length) {
      html += '<div class="notify-dropdown-sub">我发出的站内消息</div>';
      html += sent.map(r => `
        <button type="button" class="notify-dropdown-item is-out" onclick="${this.buildMessageAction(r, false)}">
          <strong>已通知「${r.to}」· ${r.typeLabel}</strong>
          <span>${r.title}</span>
        </button>`).join('');
    }

    html += '<button type="button" class="notify-dropdown-foot" onclick="App.openMessagesModal()">查看全部站内消息</button>';
    drop.innerHTML = html;
    drop.hidden = false;
  },

  toggleNotifyDropdown: function(e) {
    if (e) e.stopPropagation();
    const drop = document.getElementById('notify-dropdown');
    if (!drop) return;
    if (!drop.hidden) {
      drop.hidden = true;
      return;
    }
    this.renderNotifyDropdown();
  },

  closeNotifyDropdown: function() {
    const drop = document.getElementById('notify-dropdown');
    if (drop) drop.hidden = true;
  },

  // ----- 站内消息中心（收件箱 / 已发送 双 Tab） -----
  openMessagesModal: function(tab) {
    if (tab === 'inbox' || tab === 'sent') this._messagesTab = tab;
    if (!this._messagesTab) this._messagesTab = 'inbox';
    this.closeNotifyDropdown();
    this.renderMessagesModal();
