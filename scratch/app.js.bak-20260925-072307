      coreInfo: `已向「${authorName}」发出定制邀请 · 等待对方响应接单`
    });

    // 承接方台账：使该定向商单出现在「我的任务 · 承接任务 · 待接单」并提供【响应商单】
    MockData.tasks.myOrders.unshift({
      id: 'ORD_CGC_' + stamp,
      sourceId: taskId,
      role: 'creator',
      type: 'gallery-custom',
      title: title,
      cover: task.cover,
