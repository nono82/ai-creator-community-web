  // 刷新算力充值订单摘要（充值类型 / 应付金额 / 到账算力点）
  refreshComputeOrderSummary: function() {
    const packs = MockData.assets.computePacks || [];
    const pack = packs.find(p => p.id === this._currentComputePackId) || packs[0];
    const type = this.getComputeType(this._currentComputeTypeId);
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };

    set('compute-pay-amount', pack ? '¥ ' + this.formatMoney(pack.price) : '—');
    set('compute-type-result', type ? `${type.name}（${type.shortName || ''}）` : '未选择');

    // 扣款构成：按所选资金来源实时拆分（组合来源先扣账户余额、不足部分扣创作收益）
    const fund = this.getComputeFundSource(this._currentComputeFundId);
    const fundNote = document.getElementById('compute-fund-note');
    const price = pack ? Number(pack.price) || 0 : 0;
    if (fund) {
      const split = this.getComputeFundSplit(price, fund.id);
      const parts = [];
      if (split.fromBalance > 0) parts.push(`账户余额 ¥ ${this.formatMoney(split.fromBalance)}`);
      if (split.fromEarnings > 0) parts.push(`创作收益 ¥ ${this.formatMoney(split.fromEarnings)}`);
      set('compute-pay-split', split.ok
        ? (parts.join(' + ') || '—')
        : `${parts.join(' + ') || '—'} · 尚缺 ¥ ${this.formatMoney(split.shortfall)}`);
      if (fundNote) {
        if (split.ok) {
          fundNote.className = 'compute-type-note is-ok';
          fundNote.innerText = fund.id === 'mix'
            ? `${fund.availNote}；本次扣款 ${parts.join(' + ')}`
            : `${fund.availNote}；本次从「${fund.name}」扣款 ¥ ${this.formatMoney(price)}`;
        } else {
          fundNote.className = 'compute-type-note is-warn';
          fundNote.innerText = `「${fund.name}」可用额不足，尚缺 ¥ ${this.formatMoney(split.shortfall)}`
            + (fund.id === 'earnings' ? '；创作收益不可充值，只能靠承接商单累积，建议改用账户余额或组合扣款' : '；请先充值账户余额');
        }
      }
    } else {
      set('compute-pay-split', '—');
      if (fundNote) {
        fundNote.className = 'compute-type-note is-warn';
        fundNote.innerText = '请先选择本次充值的扣款资金来源（账户余额 / 创作收益 / 两者组合）';
      }
    }

    const note = document.getElementById('compute-type-note');
    const btn = document.getElementById('compute-submit-btn');
    if (!type) {
      set('compute-gain-tokens', '—');
      set('compute-pro-bonus', '—');
      if (note) {
        note.className = 'compute-type-note is-warn';
        note.innerText = '充值前必须先选择算力类型：自有算力单价更低，集成算力高峰期不排队';
      }
      if (btn) {
        btn.classList.add('is-disabled');
        btn.setAttribute('aria-disabled', 'true');
      }
      return;
    }

    const t = this.getComputePackTokens(pack, type);
    set('compute-gain-tokens', `${this.formatMoney(t.total)} 点 · 计入「${type.name}」`);
    set('compute-pro-bonus', t.bonus > 0 ? `+ ${t.bonus.toLocaleString('zh-CN')} 点（${Math.round(t.bonusRate * 100)}%）` : '未开通 Pro');
    if (note) {
      note.className = 'compute-type-note is-ok';
      note.innerText = `${type.provider} · ${type.unitNote} · ${type.sla}；到账点数计入「${type.name}」独立账本`;
    }
    if (btn) {
      btn.classList.remove('is-disabled');
      btn.setAttribute('aria-disabled', 'false');
    }
  },

  // 确认算力充值：必须先选类型，再统一走账户余额支付并计入该类型账本
  submitComputeRecharge: function() {
    const type = this.getComputeType(this._currentComputeTypeId);
    if (!type) {
      this.showToast('请先选择算力类型（自有算力 / 集成算力），再提交充值');
      const note = document.getElementById('compute-type-note');
      if (note) note.className = 'compute-type-note is-warn is-shake';
      return;
    }
    const packs = MockData.assets.computePacks || [];
    const pack = packs.find(p => p.id === this._currentComputePackId) || packs[0];
    if (!pack) return;

    const gain = this.getComputePackTokens(pack, type);

    const fund = this.getComputeFundSource(this._currentComputeFundId);
    if (!fund) {
      this.showToast('请先选择扣款资金来源（账户余额 / 创作收益 / 两者组合）');
      const fundNote = document.getElementById('compute-fund-note');
      if (fundNote) fundNote.className = 'compute-type-note is-warn is-shake';
      return;
    }
    const split = this.getComputeFundSplit(pack.price, fund.id);
    if (!split.ok) {
      this.openInsufficientBalanceModal(pack.price, `算力特权充值 · ${type.name} · ${pack.label}`, fund.id);
      return;
    }

    const result = this.payFromFundSources(pack.price, `算力特权充值 · ${type.name} · ${pack.label}`, fund.id);
    if (!result.ok) return;

    const before = this.getComputeBalances();
    const nextSelf = type.id === 'integrated' ? before.self : (before.self + gain.total);
    const nextIntegrated = type.id === 'integrated' ? (before.integrated + gain.total) : before.integrated;
    this.syncComputeBalances(nextSelf, nextIntegrated);

    // 写入 AI 积分流水台账（类型分账，供「AI 积分明细」穿透查看）
    MockData.assets.aiPointLedger = MockData.assets.aiPointLedger || [];
    MockData.assets.aiPointLedger.push({
      id: 'AP' + Date.now(),
      type: type.id,
      kind: 'recharge',
      name: `算力充值 · ${pack.label}（${type.name}）`,
      amount: gain.total,
      time: this.getDemoNowText()
    });

    this.refreshAssetDisplays();
    this.closeModal('modal-compute-recharge');
    const payDesc = [
      split.fromBalance > 0 ? `账户余额 ¥ ${this.formatMoney(split.fromBalance)}` : '',
      split.fromEarnings > 0 ? `创作收益 ¥ ${this.formatMoney(split.fromEarnings)}` : ''
    ].filter(Boolean).join(' + ');
    this.showToast(`⚡ ${type.name}充值成功！${this.formatMoney(gain.total)} 点已计入「${type.name}」账本（${fund.name}扣款 ${payDesc}）`);
  },

  // ====== AI 积分明细（按算力类型分账展示） ======

  getAiPointLedger: function(typeId) {
    const list = (MockData.assets && MockData.assets.aiPointLedger) || [];
    return (!typeId || typeId === 'all') ? list : list.filter(r => r.type === typeId);
