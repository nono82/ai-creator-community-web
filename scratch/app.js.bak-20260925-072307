  //    审计留痕由调用方 assertAdmission 负责 —— 不在判定内部写。
  // =========================================================================

  // 需准入判定的动作（枚举即契约，FR-001-20）
  // ⚠️ 充值 / 绑卡 / 浏览学习**不是**准入动作（既有套件已验收：未实名时充值弹窗仍可打开）
  ADMISSION_ACTIONS: ['acceptTask', 'publishTask', 'publishShowcase', 'withdraw', 'receiveSettlement'],

