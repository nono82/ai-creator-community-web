      if (this.activeCourseCategory !== '全部' && cat !== this.activeCourseCategory) return false;
      const free = p.isFree === true || Number(p.price) === 0;
      if (this.activeCourseFee === '免费' && !free) return false;
      if (this.activeCourseFee === '付费' && free) return false;
      return true;
    });
