    let left = 15 * 60;
    const tick = () => {
      const el = document.getElementById('pro-qr-countdown');
      if (el) el.innerText = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
