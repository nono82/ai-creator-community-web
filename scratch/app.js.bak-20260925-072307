      this.showToast(`🤝 已响应接单！《${task.title}》正式进入履约，请按期推进制作并提交每日进度`);
      return;
    }

    order.status = '进行中';
    order.coreInfo = '履约中 · 定制商单制作中 · 待交付';
    this.closeModal('modal-custom-confirm');
    this.refreshTaskViews();
