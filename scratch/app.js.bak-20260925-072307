  // ====== 发票管理（人民币账户充值后开票） ======

  // 汇总可开票充值记录（来源：人民币账户充值流水 + 开票记录状态）
  getInvoiceRecords: function() {
    const txs = (MockData.assets.transactions || []).filter(t => String(t.name || '').indexOf('人民币账户充值') === 0);
    const issued = MockData.assets.invoiceRecords || [];
    return txs.map(t => {
      const rec = issued.find(r => r.txId === t.id);
      return {
        txId: t.id,
        time: t.time,
        channel: (String(t.name).match(/\(([^)]+)\)/) || [])[1] || '人民币账户',
        amount: Math.abs(parseFloat(t.rawAmount) || 0),
        status: rec ? '已开票' : '未开票',
        invoiceType: rec ? rec.invoiceType : '',
        issuedTime: rec ? rec.time : ''
      };
    });
  },

  // 打开发票管理弹窗
  openInvoiceModal: function() {
    const records = this.getInvoiceRecords();
    this._invoiceSelectedTxId = (records.find(r => r.status === '未开票') || {}).txId || null;
    this._invoiceType = 'normal';

    const grid = document.getElementById('invoice-type-grid');
    if (grid) {
      grid.querySelectorAll('.invoice-type-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
    }
    const titleType = document.getElementById('invoice-title-type');
    if (titleType) titleType.value = 'personal';
    const hint = document.getElementById('invoice-type-hint');
    if (hint) hint.innerText = '普票支持个人或企业抬头；专票仅支持企业抬头且必须填写纳税人识别号';

    this.renderInvoiceRecords();
    this.openModal('modal-invoice');
  },

  // 渲染可开票记录列表与金额汇总
  renderInvoiceRecords: function() {
    const records = this.getInvoiceRecords();
    const list = document.getElementById('invoice-record-list');
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    const sum = (st) => records.filter(r => r.status === st).reduce((s, r) => s + r.amount, 0);

    set('invoice-total-pending', '¥ ' + this.formatMoney(sum('未开票')));
    set('invoice-total-issued', '¥ ' + this.formatMoney(sum('已开票')));

    if (!list) return;
    if (!records.length) {
      list.innerHTML = '<div class="invoice-empty">暂无充值记录：人民币账户充值成功后可在此申请开票</div>';
      return;
    }

    list.innerHTML = records.map(r => {
      const selectable = r.status === '未开票';
      const active = selectable && r.txId === this._invoiceSelectedTxId;
      return `
        <div class="invoice-record-item${active ? ' active' : ''}${selectable ? '' : ' is-issued'}"${selectable ? ` onclick="App.selectInvoiceRecord('${r.txId}')"` : ''}>
          <div class="invoice-record-main">
            <div class="invoice-record-name">人民币账户充值 · ${r.channel}</div>
            <div class="invoice-record-time">${r.time}${r.issuedTime ? ' · 开票于 ' + r.issuedTime : ''}</div>
          </div>
          <div class="invoice-record-amount">¥ ${this.formatMoney(r.amount)}</div>
          <span class="invoice-record-status ${selectable ? 'is-pending' : 'is-done'}">${r.status}</span>
        </div>
      `;
    }).join('');
  },

  // 选择待开票充值记录
  selectInvoiceRecord: function(txId) {
    const rec = this.getInvoiceRecords().find(r => r.txId === txId);
    if (!rec || rec.status === '已开票') return;
    this._invoiceSelectedTxId = txId;
    this.renderInvoiceRecords();
  },

  // 发票类型切换（专票自动锁定企业抬头）
  selectInvoiceType: function(type) {
    this._invoiceType = type === 'special' ? 'special' : 'normal';
    const grid = document.getElementById('invoice-type-grid');
    if (grid) {
      grid.querySelectorAll('.invoice-type-btn').forEach((b, i) => {
        b.classList.toggle('active', (this._invoiceType === 'special') === (i === 1));
      });
    }
    const titleType = document.getElementById('invoice-title-type');
    if (this._invoiceType === 'special' && titleType) titleType.value = 'company';
    const hint = document.getElementById('invoice-type-hint');
    if (hint) {
      hint.innerText = this._invoiceType === 'special'
        ? '增值税专用发票仅支持企业抬头，请填写纳税人识别号与接收邮箱'
        : '普票支持个人或企业抬头；专票仅支持企业抬头且必须填写纳税人识别号';
    }
  },

  // 提交开票申请（校验抬头 / 税号 / 邮箱，回写开票状态）
  submitInvoiceApply: function() {
    const target = this.getInvoiceRecords().find(r => r.txId === this._invoiceSelectedTxId && r.status === '未开票');
    if (!target) {
      this.showToast('请先选择一条未开票的充值记录');
      return;
    }

    const val = (id) => { const el = document.getElementById(id); return el ? String(el.value || '').trim() : ''; };
    const titleType = val('invoice-title-type') || 'personal';
    const titleName = val('invoice-title-name');
    const taxNo = val('invoice-tax-no');
    const email = val('invoice-email');
    const typeName = this._invoiceType === 'special' ? '增值税专用发票' : '增值税普通发票';

    if (!titleName) { this.showToast('请填写发票抬头'); return; }
    if (this._invoiceType === 'special' && titleType !== 'company') { this.showToast('增值税专用发票仅支持企业抬头'); return; }
    if (titleType === 'company' && !taxNo) { this.showToast('企业抬头必须填写纳税人识别号'); return; }
    if (!email) { this.showToast('请填写接收电子发票的邮箱'); return; }

    if (!MockData.assets.invoiceRecords) MockData.assets.invoiceRecords = [];
    MockData.assets.invoiceRecords.unshift({
      id: 'INV' + Date.now(),
      txId: target.txId,
      amount: target.amount,
      time: '刚刚',
      invoiceType: typeName,
      titleType: titleType,
      titleName: titleName,
      taxNo: taxNo,
      email: email,
      remark: val('invoice-remark'),
      status: '已开票'
    });

    this._invoiceSelectedTxId = null;
    const titleEl = document.getElementById('invoice-title-name');
    if (titleEl) titleEl.value = '';
    const taxEl = document.getElementById('invoice-tax-no');
    if (taxEl) taxEl.value = '';
    this.renderInvoiceRecords();
    this.showToast(`发票申请已提交，¥ ${this.formatMoney(target.amount)} 的${typeName}将于 3 个工作日内推送至 ${email}`);
  },

