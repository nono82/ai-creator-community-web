  declineCustomOrder: function() {
    const id = document.getElementById('custom-confirm-order-id')?.value;
    const order = (MockData.tasks.myOrders || []).find(o => o.id === id);
    if (!order) return;
    const task = (MockData.tasks.list || []).find(t => t.id === order.sourceId);

    // 广场商单：创作者婉拒 → 任务退回「招募中」，候选人池整体还原（婉拒者标记为未入选）
    if (task && order.status === '待接单') {
      // 展厅定向定制商单：没有公开候选人池，婉拒后退回「招募中」并把该创作者还原为「待选」，
      // 避免走通用分支被标记 rejected 后无人可选、任务卡死在「招募中」。
      if (task.customSource === 'gallery') {
        task.status = '招募中';
        task.selectedCreatorId = null;
        task.selectedAt = null;
        (task.applicants || []).forEach(a => { a.status = 'pending'; });
        delete task._preSelectStatus;
        const gPub = (MockData.tasks.myOrders || []).find(o => o.role === 'publisher' && o.sourceId === task.id);
        if (gPub) {
          gPub.status = '招募中';
          gPub.deadline = '邀请被婉拒 · 可重新发起';
          gPub.tags = ['招募中', '资金托管中'];
          gPub.coreInfo = `「${order.assigneeName || '创作者'}」档期冲突已婉拒 · 可调整报价或周期后重新邀请`;
        }
        order.status = '未成交';
        order.coreInfo = '未成交 · 已婉拒该定向定制邀请';
        this.closeModal('modal-custom-confirm');
        this.refreshTaskViews();
        this.syncTaskStats();
        if (this.currentDetailTaskId === task.id) this.renderTaskDetailPage();
        this.showToast('已婉拒该定制邀请，定向商单退回「招募中」，可调整报价或交付周期后重新发起');
        return;
      }
      task.status = '招募中';
      task.selectedCreatorId = null;
      task.selectedAt = null;
      if (Array.isArray(task._preSelectStatus)) {
        (task.applicants || []).forEach(a => {
          const prev = task._preSelectStatus.find(p => p.id === a.id);
          if (prev) a.status = prev.status;
        });
        delete task._preSelectStatus;
      }
      const decliner = (task.applicants || []).find(a => a.id === order.applicantId || a.name === order.assigneeName);
      if (decliner) decliner.status = 'rejected';

      const pubOrder = (MockData.tasks.myOrders || []).find(o => o.role === 'publisher' && o.sourceId === task.id);
      const pendingCount = (task.applicants || []).filter(a => a.status === 'pending').length;
      if (pubOrder) {
        pubOrder.status = '招募中';
        pubOrder.creatorName = '';
        pubOrder.counterpart = '待选定创作者';
        pubOrder.deadline = '招募中 · 待选定';
        pubOrder.tags = ['招募中', '资金托管中'];
        pubOrder.coreInfo = `${pendingCount} 人报名 · 待选定`;
      }
      order.status = '未成交';
      order.coreInfo = '未成交 · 已婉拒合作邀请 · 任务退回招募中';
      this.closeModal('modal-custom-confirm');
      this.refreshTaskViews();
      this.syncTaskStats();
      if (this.currentDetailTaskId === task.id) this.renderTaskDetailPage();
      this.showToast('已婉拒该合作邀请，任务退回「招募中」，发布方可重新选定创作者');
      return;
    }

    order.status = '未成交';
    order.coreInfo = '未成交 · 创作者档期冲突已婉拒 · 赏金已全额退还客户';
    this.closeModal('modal-custom-confirm');
    this.refreshTaskViews();
    this.showToast('已婉拒该定制邀请，客户托管赏金已全额退还');
  },

