  // =========================================================================
  // 全局交互模态弹窗与工具方法
  // =========================================================================
  openModal: function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      // 下钻弹窗层级：若当前已有其他弹窗处于打开状态，则本弹窗自动提升到父弹窗之上
      // （配合 .modal-backdrop.is-stacked，避免后开的子弹窗被「DOM 顺序更靠后」的父弹窗盖住，
      //   典型场景：银行卡管理弹窗 → 【+ 绑定新银行卡】→ 绑定弹窗）
      let otherOpen = 0;
      if (typeof document.querySelectorAll === 'function') {
        const opens = document.querySelectorAll('.modal-backdrop.active');
        for (let i = 0; i < opens.length; i++) {
          if (opens[i] !== modal) otherOpen += 1;
        }
      }
      modal.classList.toggle('is-stacked', otherOpen > 0);
      modal.classList.add('active');
    }
    if (modalId === 'modal-withdraw') {
      // 提现四道闸静态口径：资金来源（创作收益）/ 实名状态 / 规则校验 / 收款账户（仅同名借记卡可用）
      const rules = this.getWithdrawRules();
      const src = this.getWithdrawSource();
      const cap = Math.min(src.amount, rules.maxPerTx);
      const input = document.getElementById('withdraw-amount-input');
      if (input) {
        input.max = rules.maxPerTx;
        input.placeholder = `输入提现金额，当前可提现「${src.label}」¥ ${this.formatMoney(src.amount)}`;
        const v = parseFloat(input.value);
        if (isNaN(v) || v <= 0 || v > cap) {
          input.value = Math.max(0, Math.min(1000, cap)).toFixed(0);
        }
      }
      this.refreshWithdrawPanel();
      this.onWithdrawAmountInput();
    }
    if (modalId === 'modal-pro') {
      // Pro 订阅走独立结算通道：弹窗内只需同步「方案选择」与「会员有效期」状态
      this.selectProPlan(this._proPlan || 'year');
      this.renderProMembershipStrip();
    }
    if (modalId === 'modal-bank-card-bind') {
      // 绑卡 / 换绑弹窗：同步实名状态条与提交按钮可用态
      this.refreshBankBindPanel();
    }
    if (modalId === 'modal-bank-card-manage') {
      // 银行卡管理弹窗：同步口径 chips、卡台账列表与张数上限提示
      this.renderBankCardBlocks();
    }
    if (modalId === 'modal-account-recharge') {
      // 充值口径兜底：同步实名状态 chips 与微信 / 支付宝渠道组（防止绕过 openAccountRechargeModal 直开）
      this.refreshRechargePanel();
    }
  },

