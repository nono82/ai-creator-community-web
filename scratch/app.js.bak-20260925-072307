  // 创作者档案唯一真源解析：竞标候选人 / 展厅创作者 → 统一档案对象
  // 匹配优先级：① MockData.tasks.creatorProfiles 显式档案（含履约口碑与作品集）
  //             ② 作品展厅 gallery.works 按作者名聚合（无显式档案时的兜底）
  //             ③ 由候选人报名记录现场合成（保证任何候选人都能打开主页，不出现死链）
  getCreatorProfile: function(creatorOrName) {
    const name = typeof creatorOrName === 'string' ? creatorOrName : ((creatorOrName && creatorOrName.name) || '');
    if (!name) return null;

    const profiles = (MockData.tasks && MockData.tasks.creatorProfiles) || [];
    const hit = profiles.find(p => p.name === name);
    if (hit) {
      return Object.assign({}, hit, { available: true, source: 'profile' });
    }

    const galleryWorks = ((MockData.tasks.gallery && MockData.tasks.gallery.works) || [])
      .filter(w => w.creator && w.creator.name === name);
    if (galleryWorks.length) {
      const c = galleryWorks[0].creator || {};
      return {
        name: name,
        avatar: c.avatar,
        level: c.level,
        school: c.school,
        role: c.level || '平台认证创作者',
        credit: null,
        tags: galleryWorks[0].tags || [],
        intro: '',
        stats: {
          completed: galleryWorks.reduce((s, w) => s + (w.delivered || 0), 0),
          rating: '—', onTime: '—', response: '—'
        },
        works: galleryWorks.map(w => ({
          id: w.id, title: w.title, cover: w.cover, category: w.category,
          price: w.priceRange || w.basePrice || '面议', likes: w.likes, views: w.views
        })),
        available: galleryWorks.some(w => w.available),
        source: 'gallery'
      };
    }

    // 兜底：由报名记录现场合成（候选人的诉求与信誉分直接可见）
    const me = (creatorOrName && typeof creatorOrName === 'object') ? creatorOrName : {};
    return {
      name: name,
      avatar: me.avatar || 'assets/avatars/rank_user_1.png',
      level: me.level || 'Lv.4 商业创作者',
      school: me.school || '高校认证创作者',
      role: me.level || '平台认证创作者',
      credit: me.credit || 98,
      tags: [],
      intro: me.proposal || '',
      stats: { completed: '—', rating: '—', onTime: '—', response: '—' },
      works: [],
      available: true,
      source: 'applicant'
    };
  },

