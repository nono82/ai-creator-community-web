    const p = (MockData.academy.paths || [])[idx];
    if (!p) return;
    this._growthLevelIdx = idx;
    this.renderGrowthLevelModal();
    this.openModal('modal-growth-level');
  },

  closeGrowthLevelModal: function() {
    this.closeModal('modal-growth-level');
  },

  renderGrowthLevelModal: function() {
    const idx = this._growthLevelIdx;
    const p = (MockData.academy.paths || [])[idx];
    const head = document.getElementById('growth-level-head');
    const body = document.getElementById('growth-level-body');
    const actions = document.getElementById('growth-level-actions');
    if (!p || !head || !body) return;

    const prog = this.getGrowthLevelProgress(idx);
    const lvNum = idx + 1;
    const stateText = p.done ? '已达成' : (p.active ? '冲刺中' : '未解锁');
    const stateClass = p.done ? 'is-done' : (p.active ? 'is-current' : 'is-locked');

    head.innerHTML = `
      <div class="growth-level-icon-wrap">
        <img src="assets/icons/academy/${p.icon}.png" alt="" draggable="false">
      </div>
      <div class="growth-level-title">
        <div class="growth-level-lv-row">
          <span class="growth-level-lv">${p.level}</span>
          <span class="growth-level-name">${p.name}</span>
          <span class="growth-level-state ${stateClass}">${stateText}</span>
        </div>
        <div class="growth-level-goal">${p.goal || ''}</div>
      </div>`;

    // 积分门槛进度：按该等级区间换算（最高级按门槛线性换算）
    const span = p.pointsMax ? Math.max(1, p.pointsMax - p.pointsMin) : Math.max(1, p.pointsMin);
    const base = p.pointsMax ? p.pointsMin : 0;
    const ptsBar = Math.max(0, Math.min(100, Math.round(((prog.points - base) / span) * 100)));
    const rangeText = p.pointsMax
      ? `${Number(p.pointsMin).toLocaleString('zh-CN')} ~ ${Number(p.pointsMax).toLocaleString('zh-CN')} 积分`
      : `≥ ${Number(p.pointsMin).toLocaleString('zh-CN')} 积分`;
    const gapText = prog.pointsOk ? '积分门槛已达成' : `距该等级还差 ${prog.pointsGap.toLocaleString('zh-CN')} 积分`;

    const checks = (p.requirements || []).map(r => {
      const st = this.getGrowthRequirementState(r);
      return `
        <li class="growth-level-check ${st.done ? 'is-done' : ''}">
          <span class="growth-level-check-icon" aria-hidden="true">${st.done ? '✓' : '○'}</span>
          <span class="growth-level-check-text">${r.text}</span>
          ${st.metric ? `<span class="growth-level-check-metric">${st.metric}</span>` : ''}
        </li>`;
    }).join('');

    const perkTags = (p.perks || []).map(t => `<span class="growth-level-perk">${t}</span>`).join('');

    body.innerHTML = `
      <div class="growth-level-sec">
        <div class="growth-level-sec-title">晋级门槛</div>
        <div class="growth-level-thresh">
          <div class="growth-level-thresh-row">
            <span>创作积分门槛 <strong>${rangeText}</strong></span>
            <span class="growth-level-thresh-gap ${prog.pointsOk ? 'is-ok' : ''}">${gapText}</span>
          </div>
          <div class="growth-level-bar"><div class="growth-level-bar-fill" style="width: ${ptsBar}%;"></div></div>
          <div class="growth-level-thresh-note">当前创作积分 ${prog.points.toLocaleString('zh-CN')} · 累计获得 ${Number(MockData.currentUser.learningPointsLifetime || prog.points).toLocaleString('zh-CN')}</div>
        </div>
      </div>

      <div class="growth-level-sec">
        <div class="growth-level-sec-title">需完成内容 <span class="growth-level-count">${prog.done} / ${prog.total}</span></div>
        <ul class="growth-level-checklist">${checks}</ul>
      </div>

      <div class="growth-level-sec">
        <div class="growth-level-sec-title">达成后解锁</div>
        <div class="growth-level-perks">${perkTags}</div>
        <div class="growth-level-scope">${p.scope || ''}</div>
      </div>`;

    if (actions) {
      const goBtn = lvNum >= 3
        ? `<button class="hero-btn-primary" onclick="App.closeGrowthLevelModal(); App.navigateTo('tasks'); App.setTasksMode('${lvNum >= 4 ? 'gallery' : 'hall'}', true);">去${lvNum >= 4 ? '作品展厅接单' : '任务广场接单'}</button>`
        : `<button class="hero-btn-primary" onclick="App.closeGrowthLevelModal(); App.navigateTo('academy');">去学院学习</button>`;
      actions.innerHTML = `<button class="hero-btn-secondary" onclick="App.closeGrowthLevelModal()">关闭</button>${goBtn}`;
    }
  },

