  closeSelectCreatorModal: function() {
    this.closeModal('modal-select-creator');
    this._pendingSelectCreator = null;
  },

  confirmSelectCreator: function() {
    const taskId = (document.getElementById('select-creator-task-id') || {}).value;
    const applicantId = (document.getElementById('select-creator-applicant-id') || {}).value;
    const pending = this._pendingSelectCreator;
    const finalTaskId = taskId || (pending && pending.taskId);
    const finalApplicantId = applicantId || (pending && pending.applicantId);
    this._pendingSelectCreator = null;
    this.closeModal('modal-select-creator');
    if (!finalTaskId || !finalApplicantId) return;
    this.selectTaskApplicant(finalTaskId, finalApplicantId);
  },

  // 提交选定：唯一真源动作（任务转「待接单」，同时向创作者侧下发待响应商单）
  selectTaskApplicant: function(taskId, applicantId) {
    const task = (MockData.tasks.list || []).find(t => t.id === taskId);
    if (!task) { this.showToast('未找到该任务'); return; }
    const applicant = (task.applicants || []).find(a => a.id === applicantId);
    if (!applicant) { this.showToast('未找到该竞标创作者'); return; }

    // 发布方身份闸门：只有该任务的发布方本人才能选定合作创作者
    if (!this.isPublisherOfTask(task)) {
      this.showToast('仅该任务的发布方可选定合作创作者');
      return;
    }

    // 标记选定：中标者转「已入选」，同批其余候选人转「未入选」
    // 同时快照选定前的候选人状态，供「创作者婉拒 → 任务退回招募中」时整体还原
    task._preSelectStatus = (task.applicants || []).map(a => ({ id: a.id, status: a.status }));
    (task.applicants || []).forEach(a => {
      a.status = a.id === applicantId ? 'accepted' : 'rejected';
    });
    task.selectedCreatorId = applicantId;
    // 关键状态：不是直接「进行中」，而是「待接单」——须由创作者响应后才进入履约
    task.status = '待接单';
    task.selectedAt = this.getDemoToday();

    const publisherName = task.publisherRole || '平台发布方';
    MockData.tasks.myOrders = MockData.tasks.myOrders || [];

    // 发布方台账收敛：优先把既有「招募中 / 待选定」的发布订单**就地转为「待接单」**，
    // 避免同一任务在台账里同时挂「招募中」与「待接单」两条重复条目。
    const existingPub = MockData.tasks.myOrders.find(o => (o.role === 'publisher' || o.role === 'buyer')
      && o.sourceId === taskId && ['招募中', '待选定', '待接单'].includes(o.status));
    if (existingPub) {
      existingPub.status = '待接单';
      existingPub.creatorName = applicant.name;
      existingPub.counterpart = '创作者 / ' + applicant.name;
      existingPub.deadline = '待创作者响应接单';
      existingPub.startDate = this.getDemoToday();
      existingPub.tags = ['已选定创作者', '待接单', '资金托管中'];
      existingPub.coreInfo = `已选定创作者「${applicant.name}」· 等待对方响应接单`;
      delete existingPub.isDraft;
    } else {
      MockData.tasks.myOrders.push({
        id: 'ORD_' + Date.now(),
        sourceId: taskId,
        role: 'publisher',
        type: 'plaza',
        title: task.title,
        status: '待接单',
        creatorName: applicant.name,
        counterpart: '创作者 / ' + applicant.name,
        deadline: '待创作者响应接单',
        startDate: this.getDemoToday(),
        tags: ['已选定创作者', '待接单', '资金托管中'],
        coreInfo: `已选定创作者「${applicant.name}」· 等待对方响应接单`
      });
    }

    // 创作者侧台账：下发一条「待接单」商单，使其出现在「我的任务 · 承接任务」并可【响应商单】
    const existingCreator = MockData.tasks.myOrders.find(o => o.role === 'creator'
      && o.sourceId === taskId && ['待选定', '待接单', '进行中'].includes(o.status));
    if (existingCreator) {
      existingCreator.status = '待接单';
      existingCreator.assigneeName = applicant.name;
      existingCreator.applicantId = applicantId;
      existingCreator.rewardMoney = task.rewardMoney || existingCreator.rewardMoney;
      existingCreator.counterpart = '发布方 / ' + publisherName;
      existingCreator.deadline = '待你响应接单';
      existingCreator.tags = ['待接单', '资金托管中'];
      existingCreator.coreInfo = `受「${publisherName}」选定 · 待你响应接单`;
    } else {
      MockData.tasks.myOrders.push({
        id: 'ORD_C' + Date.now(),
        sourceId: taskId,
        role: 'creator',
        type: 'plaza',
        title: task.title,
        status: '待接单',
        cover: task.cover,
        rewardMoney: task.rewardMoney,
        assigneeName: applicant.name,
        applicantId: applicantId,
        creatorName: applicant.name,
        counterpart: '发布方 / ' + publisherName,
        deadline: '待你响应接单',
        startDate: this.getDemoToday(),
        tags: ['待接单', '资金托管中'],
        coreInfo: `受「${publisherName}」选定 · 待你响应接单`
      });
    }

    // 站内消息通知：选定即向中标创作者下发一条「合作邀请」站内消息（唯一写入口）
