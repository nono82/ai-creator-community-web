  switchCouponStatus: function(status) {
    this.activeCouponStatus = status || 'unused';
    this.renderCoupons();
  },

  renderCoupons: function() {
    const tabsEl = document.getElementById('coupon-status-tabs');
    const listEl = document.getElementById('coupon-list');
    const tabs = [
      { key: 'unused', label: '可用' },
      { key: 'used', label: '已使用' },
      { key: 'expired', label: '已过期' }
    ];
    if (tabsEl) {
      tabsEl.innerHTML = tabs.map(t => {
        const n = this.getCoupons(t.key).length;
        return `<button type="button" class="coupon-tab${this.activeCouponStatus === t.key ? ' active' : ''}" onclick="App.switchCouponStatus('${t.key}')">${t.label} ${n}</button>`;
      }).join('');
    }
    if (!listEl) return;
    const list = this.getCoupons(this.activeCouponStatus);
    listEl.innerHTML = list.map(c => {
      const usable = c.status === 'unused';
      const action = usable
        ? `<button type="button" class="hero-btn-primary" onclick="App.useCoupon('${c.id}')">去使用</button>`
        : `<span class="coupon-status-tag" style="background:#F3F4F6; color:#6B7280;">${c.status === 'used' ? '已使用 ' + (c.usedAt || '') : '已过期'}</span>`;
      return `
        <div class="coupon-item${usable ? '' : ' is-disabled'}">
          <div class="coupon-face">
            <div class="coupon-face-value">${c.value}</div>
            <div class="coupon-face-scope">${c.scope}</div>
          </div>
          <div class="coupon-main">
            <div class="coupon-name">${c.name}</div>
            <div class="coupon-meta">${c.threshold} · 有效期至 ${c.expire}</div>
          </div>
          <div class="coupon-action">${action}</div>
        </div>`;
    }).join('') || '<div class="coupon-item"><div class="coupon-main">该状态下暂无优惠券</div></div>';

    const usableList = this.getCoupons('unused');
    const amount = usableList.reduce((s, c) => s + (Number(c.valueNum) || 0), 0);
    const now = new Date();
    const soon = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 30);
    const expiring = usableList.filter(c => {
      const exp = new Date(String(c.expire || '').replace(/-/g, '/'));
      return !isNaN(exp.getTime()) && exp <= soon;
    }).length;
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    set('coupon-usable-count', String(usableList.length));
    set('coupon-usable-amount', '¥ ' + this.formatMoney(amount));
    set('coupon-expiring-count', String(expiring));
  },

  // 去使用：按券的适用场景跳转到对应结算入口
  useCoupon: function(couponId) {
    const c = this.getCoupons().find(x => x.id === couponId);
    if (!c || c.status !== 'unused') { this.showToast('该优惠券不可用'); return; }
    c.status = 'used';
    c.usedAt = this.getTodayText();
    this.renderCoupons();
    this.closeModal('modal-coupon');
    if (c.go === 'compute') {
      this.openComputeRechargeModal();
      this.showToast('已带上「' + c.name + '」，充值结算时自动抵扣 ' + c.value);
    } else if (c.go === 'course') {
      this.navigateTo('academy');
      this.showToast('已带上「' + c.name + '」，课程结算时自动抵扣 ' + c.value);
    } else if (c.go === 'task') {
      this.navigateTo('tasks');
      this.showToast('已带上「' + c.name + '」，发布商单时自动抵扣 ' + c.value);
    } else if (c.go === 'pro') {
      this.openModal('modal-pro');
      this.showToast('已带上「' + c.name + '」，会员订阅时自动抵扣 ' + c.value);
    } else if (c.go === 'recharge') {
      this.openAccountRechargeModal();
      this.showToast('已带上「' + c.name + '」，充值时自动抵扣 ' + c.value);
    } else {
      this.navigateTo('discover');
      this.showToast('已带上「' + c.name + '」，定制结算时自动抵扣 ' + c.value);
    }
  },

