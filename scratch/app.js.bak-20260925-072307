    if (text) {
      text.innerText = verified
        ? `实名认证已通过 · ${u.realName || ''}（${u.phone || ''}）· 仅可绑定此姓名的银行卡`
        : '账户尚未完成实名认证，按监管要求不能绑定银行卡';
    }
    if (state) state.innerText = verified ? '已实名' : '未实名';

    const ruleRow = document.getElementById('bank-bind-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.sameNameOnly ? '✓' : ''} 仅限本人卡`,
        `${rules.debitOnly ? '✓' : ''} 仅限借记卡`,
        `${rules.unionPayOnly ? '✓' : ''} 仅限银联卡`,
        `最多 ${rules.maxCards} 张`
      ];
      ruleRow.innerHTML = chips
        .map((c, i) => `<span class="withdraw-rule-chip${i === 0 && !verified ? ' is-error' : ''}">${c}</span>`)
        .join('');
    }

    const box = document.getElementById('bank-bind-demo');
    if (box) {
      const list = (MockData.assets && MockData.assets.bankCardDemos) || [];
      box.innerHTML = '<span class="bank-bind-demo-label">演示卡号：</span>'
        + list.map(d => `<span class="bank-bind-demo-chip" onclick="App.fillBankCardDemo('${d.key}')">${d.label}</span>`).join('');
    }

    const btn = document.getElementById('bank-bind-submit-btn');
    if (btn) {
      btn.innerText = bind.mode === 'rebind' ? '确认换绑' : '确认绑定';
      btn.classList.toggle('is-disabled', !verified);
      btn.setAttribute('aria-disabled', verified ? 'false' : 'true');
    }
  },

  // 卡号实时识别：发卡行 / 卡种 / 是否可用于绑定
  onBankCardNoInput: function() {
    const input = document.getElementById('bank-bind-cardno');
    const box = document.getElementById('bank-bind-detect');
    if (!input || !box) return;

    const raw = String(input.value || '');
    const digits = raw.replace(/\D/g, '');
    if (digits && digits !== raw) {
      const caretAtEnd = (input.selectionStart == null) || (input.selectionStart >= raw.length);
      if (caretAtEnd) input.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
    }

    if (!digits) {
      box.className = 'bank-bind-detect';
      box.innerText = '输入卡号后自动识别发卡行与卡种，识别依据为银联 BIN 号段';
      return;
    }
    const d = this.detectBankCard(digits);
    if (!d.ok) {
      box.className = 'bank-bind-detect is-error';
      box.innerText = `✕ ${d.reason}`;
      return;
    }
    if (d.cardType !== 'debit') {
      box.className = 'bank-bind-detect is-error';
      box.innerText = `✕ ${d.bank} · ${d.cardTypeLabel} —— 仅支持绑定银行借记卡，信用卡不支持绑定`;
      return;
    }
    box.className = 'bank-bind-detect is-ok';
    box.innerText = `✓ ${d.bank} · ${d.cardTypeLabel} · 尾号 ${d.tail} —— 借记卡，可用于绑定与提现`;
  },

  // 演示卡号一键填充（便于快速验证「借记卡通过 / 信用卡拦截」）
  fillBankCardDemo: function(key) {
    const list = (MockData.assets && MockData.assets.bankCardDemos) || [];
    const demo = list.find(d => d.key === key);
    if (!demo) return;
    const input = document.getElementById('bank-bind-cardno');
    if (input) input.value = demo.cardNo.replace(/(\d{4})(?=\d)/g, '$1 ');
    this.onBankCardNoInput();
    this.refreshBankBindPanel();
  },

  // 获取绑卡短信验证码（校验持卡人手机号）
  sendBankBindCode: function() {
    const bind = this._bankBind || (this._bankBind = { mode: 'bind', targetId: '', codeSent: false, code: '' });
    if (!this.isIdVerified()) {
      this.showToast('🚫 账户未完成实名认证，无法绑定银行卡；请先在【安全设置】完成实名认证');
      this.openSecuritySettings('实名认证');
      return;
    }
    bind.codeSent = true;
    bind.code = String(Math.floor(100000 + Math.random() * 900000));
    const u = MockData.currentUser || {};
    const btn = document.getElementById('bank-bind-code-btn');
    if (btn) {
      btn.classList.add('is-disabled');
      btn.innerText = '已发送';
    }
    this.showToast(`短信验证码已发送至 ${u.phone || '实名预留手机号'}，演示环境验证码：${bind.code}`);
    this.refreshBankBindPanel();
  },

  // 提交绑定 / 换绑：实名 → 同名 → 卡号 → 仅限借记卡 → 验证码 → 落库
  submitBankCardBind: function() {
    const rules = this.getBankBindRules();
    const bind = this._bankBind || { mode: 'bind', targetId: '', codeSent: false, code: '' };
    const holderEl = document.getElementById('bank-bind-holder');
    const cardEl = document.getElementById('bank-bind-cardno');
    const branchEl = document.getElementById('bank-bind-branch');
    const codeEl = document.getElementById('bank-bind-code');
    const hint = document.getElementById('bank-bind-hint');

    const fail = (msg) => {
      if (hint) {
        hint.className = 'bank-bind-hint is-error';
        hint.innerText = '🚫 ' + msg;
      }
      this.showToast('🚫 ' + msg);
    };

    // 闸一：必须已实名认证
    if (rules.requireIdVerified && !this.isIdVerified()) {
      fail('账户未完成实名认证，按监管要求不能绑定银行卡');
      this.openSecuritySettings('实名认证');
      return;
    }

    // 闸二：持卡人同名 / 卡号识别 / 仅限借记卡 / 不得重复 / 张数上限
    const check = this.validateBankCardBind(
      cardEl && cardEl.value, holderEl && holderEl.value, { excludeId: bind.targetId }
    );
    if (!check.ok) {
      fail(check.reason);
      if (['card-no', 'debit-only', 'duplicate'].indexOf(check.gate) >= 0) this.onBankCardNoInput();
      return;
    }

    // 闸三：短信验证码（校验持卡人手机号）
    if (rules.codeRequired) {
      const code = String((codeEl && codeEl.value) || '').trim();
      if (!bind.codeSent) return fail('请先点击【获取验证码】完成手机号校验');
      if (!/^\d{6}$/.test(code)) return fail('请输入 6 位短信验证码');
      if (code !== bind.code) return fail('短信验证码不正确，请核对后重新输入');
    }

    const cards = this.getBankCards();
    const holder = String((holderEl && holderEl.value) || '').trim();
    const branch = String((branchEl && branchEl.value) || '').trim() || `${check.bank}南京分行`;

    if (bind.mode === 'rebind' && bind.targetId) {
      const target = cards.find(c => c.id === bind.targetId);
      if (!target) return fail('待换绑的银行卡不存在');
      const oldLabel = `${target.bank}（尾号 ${target.tail}）`;
      target.bank = check.bank;
      target.cardNo = check.cardNo;
      target.tail = check.tail;
      target.cardType = check.cardType;
      target.cardTypeLabel = check.cardTypeLabel;
      target.holder = holder;
      target.branch = branch;
      target.boundAt = this.formatDate(new Date());
      this.closeModal('modal-bank-card-bind');
      this.refreshBankCardViews();
      this.showToast(`✅ 换绑成功！原卡 ${oldLabel} 已解绑，收款与充值账户切换为${check.bank}${check.cardTypeLabel}（尾号 ${check.tail}）`);
      return;
    }

    let seq = cards.length + 1;
    while (cards.some(c => c.id === 'BC' + seq)) seq++;
    cards.push({
      id: 'BC' + seq,
      bank: check.bank,
      cardNo: check.cardNo,
      tail: check.tail,
      cardType: check.cardType,
      cardTypeLabel: check.cardTypeLabel,
      holder,
      branch,
      boundAt: this.formatDate(new Date()),
      isDefault: cards.length === 0
    });
    this.closeModal('modal-bank-card-bind');
    this.refreshBankCardViews();
    this.showToast(`✅ 绑定成功！${check.bank}${check.cardTypeLabel}（尾号 ${check.tail}）已可用于提现收款与账户充值`);
  },

  // 设为默认结算卡（仅可用卡可设）
  setPayoutBankCard: function(cardId) {
    const cards = this.getBankCards();
    const card = cards.find(c => c.id === cardId);
    if (!card) return;
    const st = this.getBankCardStatus(card);
    if (!st.ok) {
      this.showToast('🚫 ' + st.reason);
      return;
    }
    cards.forEach(c => { c.isDefault = (c.id === cardId); });
    this.refreshBankCardViews();
    this.showToast(`✅ 已将${card.bank}（尾号 ${card.tail}）设为默认结算卡`);
  },

  // 解绑第一步：二次确认（默认结算卡不可解绑，须先换绑其他卡为默认）
  armUnbindBankCard: function(cardId) {
    const card = this.getBankCards().find(c => c.id === cardId);
    if (!card) return;
    if (card.isDefault) {
      this.showToast('🚫 默认结算卡不可解绑，请先换绑其他卡并设为默认');
      return;
    }
    this._unbindConfirmId = cardId;
    this.renderBankCardBlocks();
  },

  // 解绑：取消二次确认
  cancelUnbindBankCard: function() {
    this._unbindConfirmId = '';
    this.renderBankCardBlocks();
  },

  // 解绑第二步：确认解绑并从台账移除
  confirmUnbindBankCard: function(cardId) {
    const cards = this.getBankCards();
    const idx = cards.findIndex(c => c.id === cardId);
    if (idx < 0) return;
    const card = cards[idx];
    if (card.isDefault) {
      this._unbindConfirmId = '';
      this.renderBankCardBlocks();
      this.showToast('🚫 默认结算卡不可解绑，请先换绑其他卡并设为默认');
      return;
    }
    cards.splice(idx, 1);
    this._unbindConfirmId = '';
    this.refreshBankCardViews();
    this.showToast(`✅ 已解绑${card.bank}（尾号 ${card.tail}），提现收款将不再使用该卡`);
  },

  // 银行卡变更后统一刷新：银行卡管理弹窗列表 / 提现收款账户 / 充值银行卡（三处共用同一份台账）
  refreshBankCardViews: function() {
    this._unbindConfirmId = '';
    this.renderBankCardBlocks();
    this.refreshWithdrawPanel();
    this.refreshRechargePanel();
  },

  // =========================================================================
  // 人民币账户充值：官方收款二维码扫码入金（微信支付 / 支付宝）
  // 2026-09-24 改口径：银行卡（本人同名借记卡）协议代扣通道整体下线
  // 流程：表单弹窗选渠道 + 填金额 → 生成充值单 → 唤起扫码弹窗 → 确认已支付 → 入金
  // =========================================================================

  // 充值规则总口径（唯一真源：MockData.assets.rechargeRules）
  getRechargeRules: function() {
    const r = (MockData.assets && MockData.assets.rechargeRules) || {};
    const fallbackChannels = [
      { id: 'wechat', name: '微信支付', shortName: '微信', icon: '💚', color: '#07C160', hint: '打开微信「扫一扫」' },
      { id: 'alipay', name: '支付宝', shortName: '支付宝', icon: '💙', color: '#1677FF', hint: '打开支付宝「扫一扫」' }
    ];
    const channels = (Array.isArray(r.channels) && r.channels.length) ? r.channels : fallbackChannels;
    return {
      qrOnly: r.qrOnly !== false,
      channels: channels,
      defaultChannel: r.defaultChannel || channels[0].id,
      requireIdVerified: r.requireIdVerified !== false,
      minPerTx: Number(r.minPerTx) || 1,
      maxPerTx: Number(r.maxPerTx) || 50000,
      qrExpireSec: Number(r.qrExpireSec) || 900,
      arrivalNote: r.arrivalNote || '扫码支付成功即时到账 · 免手续费',
      note: r.note || '仅支持通过微信支付 / 支付宝官方收款二维码充值'
    };
  },

  // 充值渠道列表（微信支付 / 支付宝）
  getRechargeChannels: function() {
    return this.getRechargeRules().channels;
  },

  // 按 id 取单个渠道；非法 id 回落默认渠道，保证任何时刻都有确定的展示
  getRechargeChannel: function(id) {
    const rules = this.getRechargeRules();
    return rules.channels.find(c => c.id === id)
      || rules.channels.find(c => c.id === rules.defaultChannel)
      || rules.channels[0];
  },

  // 当前已选渠道 id（会话内存；未选过则回落默认渠道）
  getRechargeChannelId: function() {
    const rules = this.getRechargeRules();
    const cur = this._rechargeChannelId;
    if (cur && rules.channels.some(c => c.id === cur)) return cur;
    return rules.defaultChannel;
  },

  // 切换充值渠道（表单弹窗内）
  selectRechargeChannel: function(channelId) {
    this._rechargeChannelId = channelId;
    this.renderRechargeChannelRow();
  },

  // 渲染渠道按钮组与渠道说明（充值表单弹窗 + 扫码弹窗共用同一份渠道真源）
  renderRechargeChannelRow: function() {
    const cur = this.getRechargeChannelId();
    const row = document.getElementById('recharge-channel-row');
    if (row) {
      const btns = row.querySelectorAll('.recharge-channel-btn');
      for (let i = 0; i < btns.length; i++) {
        btns[i].classList.toggle('active', btns[i].getAttribute('data-channel') === cur);
      }
    }
    const note = document.getElementById('recharge-channel-note');
    if (note) {
      const ch = this.getRechargeChannel(cur);
      note.className = 'recharge-channel-note';
      note.innerText = `${ch.hint}，扫描下一步生成的官方收款二维码完成支付 · ${this.getRechargeRules().arrivalNote}`;
    }
  },

  // 刷新充值弹窗：合规口径 chips + 渠道按钮组 + 提交按钮可用态
  refreshRechargePanel: function() {
    const rules = this.getRechargeRules();
    const verified = this.isIdVerified();

    // ① 合规口径 chips
    const ruleRow = document.getElementById('recharge-rule-row');
    if (ruleRow) {
      const chips = [
        `${verified ? '✓' : '✕'} 必须已实名`,
        `${rules.qrOnly ? '✓' : ''} 仅官方收款二维码`,
        `单笔上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}`
      ];
      ruleRow.innerHTML = chips.map((c, i) => {
        const bad = i === 0 && !verified;
        return `<span class="recharge-rule-chip${bad ? ' is-error' : ''}">${c}</span>`;
      }).join('');
    }

    // ② 支付方式渠道按钮组
    this.renderRechargeChannelRow();

    // ③ 提交按钮可用态（未实名时置灰，点击仍会给出具体原因）
    const btn = document.getElementById('recharge-submit-btn');
    if (btn) {
      const blocked = !!(rules.requireIdVerified && !verified);
      btn.classList.toggle('is-disabled', blocked);
      btn.setAttribute('aria-disabled', blocked ? 'true' : 'false');
    }
  },

  // 人民币账户充值：打开充值弹窗，回填当前账户余额并刷新已绑卡合规面板
  openAccountRechargeModal: function() {
    const balEl = document.getElementById('recharge-cur-balance');
    if (balEl) balEl.innerText = '¥ ' + (MockData.assets.cards.balance || '0.00');
    const wdEl = document.getElementById('recharge-cur-withdrawable');
    if (wdEl) wdEl.innerText = '可提现 ¥ ' + (MockData.assets.cards.withdrawable || '0.00');

    const activeBtn = document.querySelector('#recharge-preset-grid .recharge-preset-btn.active')
      || document.querySelector('#recharge-preset-grid .recharge-preset-btn:nth-child(2)');
    this.selectRechargePreset(activeBtn, 1000);
    this.refreshRechargePanel();
    this.openModal('modal-account-recharge');
  },

  // 人民币账户充值：快捷档位选择
  selectRechargePreset: function(btn, amount) {
    const grid = document.getElementById('recharge-preset-grid');
    if (grid) {
      grid.querySelectorAll('.recharge-preset-btn').forEach(b => b.classList.remove('active'));
    }
    if (btn) btn.classList.add('active');
    const input = document.getElementById('recharge-amount-input');
    if (input) input.value = amount;
  },

  // 人民币账户充值：三闸校验（① 必须已实名 ② 支付渠道合法 ③ 金额有效且不超单笔上限）
  // 三闸全过 → 生成充值单并唤起官方收款二维码弹窗；真正的入金发生在「确认已支付」时
  submitAccountRecharge: function() {
    const rules = this.getRechargeRules();

    // 闸一：必须已完成实名认证
    if (rules.requireIdVerified && !this.isIdVerified()) {
      this.showToast('🚫 账户尚未完成实名认证，按监管要求不能充值；请先在【安全设置】完成实名认证后再发起扫码充值');
      this.openSecuritySettings('实名认证');
      return;
    }

    // 闸二：支付渠道必须是二维码渠道白名单内的渠道（微信支付 / 支付宝）
    const channel = this.getRechargeChannel(this.getRechargeChannelId());
    if (!channel) {
      this.showToast('请选择微信支付或支付宝作为充值渠道');
      return;
    }

    // 闸三：金额有效性 + 单笔上限
    const input = document.getElementById('recharge-amount-input');
    const amount = Math.round((parseFloat(input && input.value) || 0) * 100) / 100;
    if (isNaN(amount) || amount <= 0) {
      this.showToast('请输入有效的充值金额');
      return;
    }
    if (rules.minPerTx && amount < rules.minPerTx) {
      this.showToast(`单笔充值不得低于 ¥ ${this.formatMoney(rules.minPerTx)}`);
      return;
    }
    if (amount > rules.maxPerTx) {
      this.showToast(`单笔充值上限 ¥ ${rules.maxPerTx.toLocaleString('zh-CN')}，请分次充值`);
      return;
    }

    // 生成充值单（未入金，账户余额零变动）
    this._rechargeOrder = {
      orderNo: 'RC' + String(Date.now()),
      amount: amount,
      channelId: channel.id,
      channelName: channel.name,
      status: '待支付',
      createdAt: this.formatDate(new Date()),
      expireSec: rules.qrExpireSec
    };

    this.closeModal('modal-account-recharge');
    this.openRechargeQrModal(this._rechargeOrder);
  },

  // 打开充值扫码支付弹窗
  openRechargeQrModal: function(order) {
    order = order || this._rechargeOrder;
    if (!order) return;
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };
    set('rc-qr-amount', '¥ ' + this.formatMoney(order.amount));
    set('rc-qr-order-no', order.orderNo);
    this.switchRechargeChannel(order.channelId, true);
    this.startRechargeQrCountdown();
    this.openModal('modal-recharge-qr');
  },

  // 切换充值扫码渠道并重绘二维码（订单号不变、仅渠道与图案变化）
  switchRechargeChannel: function(channelId, silent) {
    const ch = this.getRechargeChannel(channelId);
    if (this._rechargeOrder) {
      this._rechargeOrder.channelId = ch.id;
      this._rechargeOrder.channelName = ch.name;
    }
    if (!silent) {
      this._rechargeChannelId = ch.id;
      this.renderRechargeChannelRow();
    }

    const row = document.getElementById('rc-qr-channel-row');
    if (row) {
      const btns = row.querySelectorAll('.rc-qr-channel-btn');
      for (let i = 0; i < btns.length; i++) {
        btns[i].classList.toggle('active', btns[i].getAttribute('data-channel') === ch.id);
      }
    }
    const hint = document.getElementById('rc-qr-channel-hint');
    if (hint) hint.innerText = ch.shortName || ch.name;

    this.renderRechargeQr();
  },

  // 渲染充值收款二维码（确定性伪码图案，由充值单号与渠道派生，零依赖内联 SVG）
  renderRechargeQr: function() {
    const frame = document.getElementById('rc-qr-frame');
    const order = this._rechargeOrder;
    if (!frame || !order) return;

    const ch = this.getRechargeChannel(order.channelId);
    return this.buildQrSvg(frame, {
      seedStr: order.orderNo + '|' + ch.id,
      svgClass: 'rc-qr-svg',
      ariaLabel: ch.name + ' 官方收款二维码',
      centerText: '¥',
      centerColor: ch.color || '#0F172A'
    });
  },

  // 通用二维码 SVG 生成（确定性伪随机，图案只由 seedStr 决定，同一订单重复渲染结果一致）
  buildQrSvg: function(frame, opt) {
    if (!frame) return null;
    let seed = 0;
    const seedStr = String(opt.seedStr || 'seed');
    for (let i = 0; i < seedStr.length; i++) seed = (seed * 31 + seedStr.charCodeAt(i)) >>> 0;
    const rnd = () => { seed = (seed * 1103515245 + 12345) >>> 0; return seed / 4294967296; };

    const N = 25, CELL = 12, PAD = 2, SIZE = (N + PAD * 2) * CELL;
    let rects = '';
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const cornerX = x >= N - 7 ? x - (N - 7) : x;
        const cornerY = y >= N - 7 ? y - (N - 7) : y;
        const inFinder = (x < 7 || x >= N - 7) && (y < 7 || y >= N - 7);
        // 三个定位角外侧各留 1 格空白分隔带（仅在定位角邻域生效，不贯穿整图）
        const isSeparator = !inFinder && (
          ((x === 7 || x === N - 8) && (y <= 7 || y >= N - 8)) ||
          ((y === 7 || y === N - 8) && (x <= 7 || x >= N - 8))
        );
        let dark;
        if (inFinder) {
          const edge = cornerX === 0 || cornerX === 6 || cornerY === 0 || cornerY === 6;
          const core = cornerX >= 2 && cornerX <= 4 && cornerY >= 2 && cornerY <= 4;
          dark = edge || core;
        } else if (isSeparator) {
          dark = false;
        } else {
          dark = rnd() > 0.52;
        }
        if (dark) {
          rects += '<rect x="' + ((x + PAD) * CELL) + '" y="' + ((y + PAD) * CELL) + '" width="' + CELL + '" height="' + CELL + '" rx="1.6"/>';
        }
      }
    }

    frame.innerHTML = ''
      + '<svg class="' + (opt.svgClass || 'qr-svg') + '" viewBox="0 0 ' + SIZE + ' ' + SIZE + '" width="196" height="196" role="img" aria-label="' + (opt.ariaLabel || '支付二维码') + '">'
      + '<rect x="0" y="0" width="' + SIZE + '" height="' + SIZE + '" fill="#FFFFFF"></rect>'
      + '<g fill="#0F172A">' + rects + '</g>'
      + '<rect x="' + (SIZE / 2 - 23) + '" y="' + (SIZE / 2 - 23) + '" width="46" height="46" rx="11" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5"></rect>'
      + '<text x="' + (SIZE / 2) + '" y="' + (SIZE / 2 + 8) + '" text-anchor="middle" font-size="22" font-weight="800" fill="' + (opt.centerColor || '#0F172A') + '">' + (opt.centerText || '') + '</text>'
      + '</svg>';
    return frame.innerHTML;
  },

  // 充值单支付倒计时（15 分钟未完成则订单自动失效，账户余额零变动）
  startRechargeQrCountdown: function() {
    this.stopRechargeQrCountdown();
    const total = (this._rechargeOrder && this._rechargeOrder.expireSec) || this.getRechargeRules().qrExpireSec;
    let left = total;
    const tick = () => {
      const el = document.getElementById('rc-qr-countdown');
      if (el) el.innerText = String(Math.floor(left / 60)).padStart(2, '0') + ':' + String(left % 60).padStart(2, '0');
      if (left <= 0) {
        this.stopRechargeQrCountdown();
        this.closeModal('modal-recharge-qr');
        this._rechargeOrder = null;
        this.showToast('支付超时，充值订单已自动失效，账户余额未发生变动');
        return;
      }
      left -= 1;
    };
    tick();
    this._rechargeQrTimer = setInterval(tick, 1000);
  },

  stopRechargeQrCountdown: function() {
    if (this._rechargeQrTimer) {
      clearInterval(this._rechargeQrTimer);
      this._rechargeQrTimer = null;
    }
  },

  // 放弃充值：停表、关弹窗、撤单（全程零入金、零流水）
  cancelRechargeOrder: function() {
    this.stopRechargeQrCountdown();
    this._rechargeOrder = null;
    this.closeModal('modal-recharge-qr');
    this.showToast('充值订单已取消，本次未产生任何入金与流水');
  },

  // 确认已扫码支付：唯一入金口（账户总额 / 可提现余额同步增加 + 写入「人民币账户充值」流水）
  confirmRechargePayment: function() {
    const order = this._rechargeOrder;
    if (!order) {
      this.showToast('充值订单不存在或已失效，请重新发起充值');
      this.closeModal('modal-recharge-qr');
      return;
    }

    const amount = Number(order.amount) || 0;
    const channelName = order.channelName || this.getRechargeChannel(order.channelId).name;
    const parseMoney = (v) => parseFloat(String(v || '0').replace(/,/g, '')) || 0;
    const fmt = (n) => this.formatMoney(n);

    const balance = parseMoney(MockData.assets.cards.balance) + amount;
    const withdrawable = parseMoney(MockData.assets.cards.withdrawable) + amount;
    MockData.assets.cards.balance = fmt(balance);
    MockData.assets.cards.withdrawable = fmt(withdrawable);

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = withdrawable;
      availItem.amount = '¥ ' + fmt(withdrawable);
    }

    // 流水名以「人民币账户充值」开头：发票管理的可开票记录由此派生，括号内为充值渠道
    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '收入',
      name: '人民币账户充值 (' + channelName + ')',
      amount: '+ ¥ ' + fmt(amount),
      rawAmount: amount,
      status: '已到账',
      statusType: 'success',
      time: '刚刚',
      category: '收入'
    });

    this.stopRechargeQrCountdown();
    this._rechargeOrder = null;
    this.closeModal('modal-recharge-qr');
    this.refreshAssetDisplays();
    this.renderTransactionsTable();
    this.showToast('充值成功！¥ ' + fmt(amount) + ' 已通过' + channelName + '扫码入账，可在【发票管理】申请开票');
  },

  // =========================================================================
  // 全站统一余额支付口径（唯一现金支付源）· 算力充值 · 发票管理
  // =========================================================================

  // 账户余额统一读数（元）
  getAccountBalance: function() {
    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = (MockData.assets && MockData.assets.cards) || {};
    return {
      balance: parse(cards.balance),
      withdrawable: parse(cards.withdrawable),
      tokens: parse(cards.tokensAC)
    };
  },

  // 金额千分位格式化
  formatMoney: function(n) {
    return (Number(n) || 0).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  },

  // 是否已开通 Pro 会员
  isProMember: function() {
    const mem = (MockData.systemAdmin && MockData.systemAdmin.membership) || {};
    return mem.currentTier === 'pro';
  },

  // 统一余额支付引擎：全站所有购买行为的唯一扣款入口
  // 成功返回 { ok: true, paid, remaining }；余额不足自动唤起引导弹窗并返回 { ok: false }
  payFromAccountBalance: function(amount, orderName) {
    amount = Number(amount) || 0;
    if (amount <= 0) return { ok: false, reason: 'invalid' };

    const info = this.getAccountBalance();
    if (amount > info.withdrawable) {
      this.openInsufficientBalanceModal(amount, orderName);
      return { ok: false, reason: 'insufficient', shortfall: amount - info.withdrawable };
    }

    const fmt = (n) => this.formatMoney(n);
    MockData.assets.cards.balance = fmt(info.balance - amount);
    MockData.assets.cards.withdrawable = fmt(info.withdrawable - amount);

    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = Math.max(0, info.withdrawable - amount);
      availItem.amount = '¥ ' + fmt(availItem.value);
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '支出',
      name: orderName || '账户余额消费',
      amount: `- ¥ ${fmt(amount)}`,
      rawAmount: -amount,
      status: '已完成',
      statusType: 'done',
      time: '刚刚',
      category: '支出'
    });

    this.refreshAssetDisplays();
    return { ok: true, paid: amount, remaining: info.withdrawable - amount };
  },

  // 余额不足统一引导弹窗（展示应付 / 可用 / 尚缺三项）
  // fundId 为空或 'balance' 时按「账户余额不足」引导充值；'earnings' / 'mix' 时按资金来源分别提示
  openInsufficientBalanceModal: function(needAmount, sceneName, fundId) {
    const need = Number(needAmount) || 0;
    const avail = this.getFundSourceAvailability();
    const fund = fundId ? this.getComputeFundSource(fundId) : null;
    const have = fund
      ? (fund.id === 'earnings' ? avail.earnings : (fund.id === 'mix' ? avail.total : avail.balance))
      : avail.balance;
    const fmt = (n) => this.formatMoney(n);
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };

    set('insufficient-need', '¥ ' + fmt(need));
    set('insufficient-have', '¥ ' + fmt(have));
    set('insufficient-short', '¥ ' + fmt(Math.max(0, need - have)));

    let sub = '';
    if (fund && fund.id === 'earnings') {
      sub = `「${sceneName || '本次支付'}」需支付 ¥ ${fmt(need)}，当前创作收益 ¥ ${fmt(have)}；创作收益不可充值，只能靠承接商单与带教分润累积，建议改用账户余额或组合扣款`;
    } else if (fund && fund.id === 'mix') {
      sub = `「${sceneName || '本次支付'}」需支付 ¥ ${fmt(need)}，账户余额 ¥ ${fmt(avail.balance)} + 创作收益 ¥ ${fmt(avail.earnings)} 合计仍不足，充值账户余额后即可继续`;
    } else {
      sub = sceneName
        ? `「${sceneName}」需支付 ¥ ${fmt(need)}，当前可用余额 ¥ ${fmt(have)}，充值后即可继续`
        : '账户余额用于算力充值、付费课程等平台购买行为，充值后即可继续';
    }
    set('insufficient-scene-sub', sub);

    this.openModal('modal-balance-insufficient');
  },

  // ====== 专属普惠算力特权充值（统一由账户余额扣款） ======

  // ====== 算力类型与 AI 积分分账（唯一真源：MockData.assets.computeTypes） ======

  getComputeTypes: function() {
    return (MockData.assets && MockData.assets.computeTypes) || [];
  },

  getComputeType: function(typeId) {
    return this.getComputeTypes().find(t => t.id === typeId) || null;
  },

  // 两类算力账本余额 + 合计（合计恒等于 cards.tokensAC）
  getComputeBalances: function() {
    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = (MockData.assets && MockData.assets.cards) || {};
    const self = parse(cards.tokensSelf);
    const integrated = parse(cards.tokensIntegrated);
    return { self: self, integrated: integrated, total: self + integrated };
  },

  // 写回两类账本，并同步合计额度与 breakdown「AI 积分」项
  syncComputeBalances: function(selfVal, integratedVal) {
    const cards = (MockData.assets && MockData.assets.cards) || {};
    cards.tokensSelf = this.formatMoney(Math.max(0, Number(selfVal) || 0));
    cards.tokensIntegrated = this.formatMoney(Math.max(0, Number(integratedVal) || 0));
    const bal = this.getComputeBalances();
    cards.tokensAC = this.formatMoney(bal.total);
    cards.tokenRMB = cards.tokensAC;
    const tokenItem = (MockData.assets.breakdown.items || []).find(it => it.label === 'AI 积分');
    if (tokenItem) {
      tokenItem.value = bal.total;
      tokenItem.amount = this.formatMoney(bal.total);
    }
    return bal;
  },

  // AI 积分卡 / 积分明细弹窗共用的分析展示口径（一次刷新，全站同源）
  refreshTokenDisplays: function() {
    const bal = this.getComputeBalances();
    const set = (id, t) => { const el = document.getElementById(id); if (el) el.innerText = t; };
    set('asset-display-ai-points', this.formatMoney(bal.total));
    set('asset-display-tokens-self', this.formatMoney(bal.self));
    set('asset-display-tokens-integrated', this.formatMoney(bal.integrated));
  },

  // 某算力包在某算力类型下的到账点数（按 pointsRatio 折算，Pro 会员另加 10%）
  getComputePackTokens: function(pack, type) {
    const baseTokens = Number(pack && pack.tokens) || 0;
    const ratio = Number(type && type.pointsRatio) || 0;
    const proBonusRate = this.isProMember() ? 0.1 : 0;
    const base = Math.round(baseTokens * ratio);
    const bonus = Math.round(base * proBonusRate);
    return { base: base, bonus: bonus, total: base + bonus, bonusRate: proBonusRate };
  },

  // ====== 算力充值的「扣款资金来源」三选一 ======

  getComputeFundSources: function() {
    return (MockData.assets && MockData.assets.computeFundSources) || [];
  },

  getComputeFundSource: function(fundId) {
    return this.getComputeFundSources().find(f => f.id === fundId) || null;
  },

  // 两类资金来源的实时可用额（账户余额读可消费、创作收益读 monthlyEarnings）
  getFundSourceAvailability: function() {
    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = (MockData.assets && MockData.assets.cards) || {};
    const balance = parse(cards.withdrawable);
    const earnings = parse(cards.monthlyEarnings);
    return { balance: balance, earnings: earnings, total: balance + earnings };
  },

  // 按资金来源拆出扣款构成（组合扣款顺序是契约：先账户余额、后创作收益）
  getComputeFundSplit: function(amount, fundId) {
    const need = Number(amount) || 0;
    const avail = this.getFundSourceAvailability();
    let fromBalance = 0;
    let fromEarnings = 0;
    if (fundId === 'balance') {
      fromBalance = Math.min(need, avail.balance);
    } else if (fundId === 'earnings') {
      fromEarnings = Math.min(need, avail.earnings);
    } else if (fundId === 'mix') {
      fromBalance = Math.min(need, avail.balance);
      fromEarnings = Math.min(need - fromBalance, avail.earnings);
    }
    const paid = fromBalance + fromEarnings;
    return {
      fromBalance: fromBalance,
      fromEarnings: fromEarnings,
      paid: paid,
      ok: paid >= need - 0.0001,
      shortfall: Math.max(0, need - paid),
      avail: avail
    };
  },

  // 统一资金扣款引擎：按来源扣账户余额 / 创作收益 / 两者组合
  // 成功返回 { ok:true, fromBalance, fromEarnings }；不足则唤起引导弹窗并返回 { ok:false }
  payFromFundSources: function(amount, orderName, fundId) {
    amount = Number(amount) || 0;
    if (amount <= 0) return { ok: false, reason: 'invalid' };
    const source = this.getComputeFundSource(fundId);
    if (!source) return { ok: false, reason: 'nosource' };

    const split = this.getComputeFundSplit(amount, fundId);
    if (!split.ok) {
      this.openInsufficientBalanceModal(amount, orderName, fundId);
      return { ok: false, reason: 'insufficient', shortfall: split.shortfall };
    }

    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = MockData.assets.cards || {};
    const items = MockData.assets.breakdown.items || [];
    const balNow = parse(cards.balance);
    const wdNow = parse(cards.withdrawable);
    const earnNow = parse(cards.monthlyEarnings);

    // ① 账户余额腿：可消费与账户总额同步减少（不产生冻结额）
    if (split.fromBalance > 0) {
      cards.balance = this.formatMoney(Math.max(0, balNow - split.fromBalance));
      cards.withdrawable = this.formatMoney(Math.max(0, wdNow - split.fromBalance));
      const availItem = items.find(it => it.label === '可提现余额');
      if (availItem) {
        availItem.value = Math.max(0, wdNow - split.fromBalance);
        availItem.amount = '¥ ' + this.formatMoney(availItem.value);
      }
    }

    // ② 创作收益腿：只扣创作收益，账户余额与冻结额一分不动
    if (split.fromEarnings > 0) {
      cards.monthlyEarnings = this.formatMoney(Math.max(0, earnNow - split.fromEarnings));
      const incomeItem = items.find(it => it.label === '创作收益');
      if (incomeItem) {
        incomeItem.value = Math.max(0, earnNow - split.fromEarnings);
        incomeItem.amount = '¥ ' + this.formatMoney(incomeItem.value);
      }
    }

    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '支出',
      name: `${orderName || '账户资金扣款'}（${source.name}扣款）`,
      amount: `- ¥ ${this.formatMoney(amount)}`,
      rawAmount: -amount,
      status: '已完成',
      statusType: 'done',
      time: '刚刚',
      category: '支出'
    });

    this.refreshAssetDisplays();
    return { ok: true, fromBalance: split.fromBalance, fromEarnings: split.fromEarnings, paid: amount };
  },

