  // ====== 申请上架展厅 ======
  requestGalleryListing: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) { this.showToast('未找到对应订单'); return; }
    if (order.listedToGallery) { this.showToast('该作品已在展厅上架'); return; }
    if (order.galleryApplyPending) { this.showToast('展厅申请审核中，请耐心等待'); return; }
    order.galleryApplyPending = true;
    this.refreshTaskViews();
    this.showToast('🎨 展厅上架申请已提交，平台将在 24 小时内完成审核并通知结果');
    // 模拟 2 秒后自动审核通过
    setTimeout(() => {
      order.galleryApplyPending = false;
      order.listedToGallery = true;
      this.refreshTaskViews();
      this.showToast('✅ 展厅审核通过！作品已正式上架精选展厅');
    }, 2000);
  },

  // ====== 确认验收并结算打款 ======
  acceptMyTaskDelivery: function(orderId) {
    const order = (MockData.tasks.myOrders || []).find(o => o.id === orderId);
    if (!order) { this.showToast('未找到对应订单'); return; }
    const task = (MockData.tasks.list || []).find(t => t.id === order.sourceId);

    // 结算金额必须取自订单/任务自身的真实金额（Q-030 修复：禁止使用兜底常量）
    // - 任务广场商单：金额取自 task.rewardMoney
    // - 作品展厅定向定制商单：sourceId 为 GW 系列、不在 tasks.list 中，金额取自 order.rewardMoney
    const pickAmount = (v) => parseFloat(String(v == null ? '' : v).replace(/[^0-9.]/g, '')) || 0;
    const reward = task ? (pickAmount(task.rewardMoney) || pickAmount(order.rewardMoney)) : pickAmount(order.rewardMoney);
    if (!reward) {
      this.showToast('结算已中止：该订单缺少赏金金额，请联系平台核对后再试');
      return;
    }

    // 更新订单状态
    order.status = '已完成';
    if (task) task.status = '已完成';

    // 结算赏金（资金口径硬约束：只进创作收益，创作者的账户余额零变动）
    // 注：不再写 MockData.currentUser.balance —— 结算款不进入现金账户
    MockData.currentUser.totalEarnings = (MockData.currentUser.totalEarnings || 0) + reward;
    MockData.currentUser.completedTasks = (MockData.currentUser.completedTasks || 0) + 1;

    if (task) {
      this.settleTaskReward(reward, task.title || '商单验收通过');
    } else {
      // 定制商单（作品展厅定向定制）：无对应 tasks.list 条目，走定制结算语义
      this.releaseEscrow(reward, order.title || '定制商单验收通过');
    }

    this.refreshTaskViews();
    if (this.currentDetailTaskId) this.renderTaskDetailPage();
    this.showToast(`🎉 验收通过！¥${reward.toLocaleString()} 赏金已计入创作收益（账户余额不变，仅创作收益可提现）`);
  },

  // ====== 选定竞标创作者（二次确认 → 提交） ======
  // 选定是不可逆的排他动作（其余候选人立即落选），故必须先过二次确认弹窗。
  requestSelectApplicant: function(taskId, applicantId) {
    const task = (MockData.tasks.list || []).find(t => t.id === taskId);
    if (!task) { this.showToast('未找到该任务'); return; }
    const applicant = (task.applicants || []).find(a => a.id === applicantId);
    if (!applicant) { this.showToast('未找到该竞标创作者'); return; }
    if (!this.isPublisherOfTask(task)) {
      this.showToast('仅该任务的发布方可选定合作创作者');
      return;
    }
    if (this.getTaskDisplayStatus(task) !== '招募中') {
      this.showToast('该任务当前不在招募中，无法选定创作者');
      return;
    }
    if (applicant.status !== 'pending') {
      this.showToast('该候选人已完成评选，无法重复选定');
      return;
    }
    this._pendingSelectCreator = { taskId: taskId, applicantId: applicantId };
    this.renderSelectCreatorModal(task, applicant);
    this.openModal('modal-select-creator');
  },

