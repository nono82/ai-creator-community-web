  submitPublishTask: function(isDraft) {
    // 【准入守卫 · T-001-23】发包是准入动作 ⇒ 统一走 checkAdmission（唯一入口）
    // 🔴 必须在读取字段与 freezeEscrow **之前**：拦截时不得托管任何资金、不得产生订单
    //    （红灯 G3 / G4；同时守住 Constitution 原则 8 资金恒等式）
    if (!this.assertAdmission('publishTask')) return;
    const title = (document.getElementById('task-pub-title') || {}).value || '新发布的创意商单';
    const budget = parseFloat((document.getElementById('task-pub-budget') || {}).value) || 3000;
    const desc = (document.getElementById('task-pub-desc') || {}).value || '需求描述';

    const frozen = this.freezeEscrow(budget, `发布商单全额托管 · ${title}`);
    if (!frozen) return;

    const newTask = {
      id: 'TK_' + Date.now(),
      title: title,
      desc: desc,
      rewardMoney: `¥ ${budget.toLocaleString('zh-CN')}`,
      rewardAmount: budget,
      rewardPoints: '500',
      category: 'AI短视频',
      tags: ['新发布', '商业定制'],
      status: '招募中',
      acceptMode: 'manual',
      publisherRole: '企业雇主 / ' + MockData.currentUser.name,
      escrow: true,
      deadlineDate: '2026-10-01',
      cover: 'assets/covers/task_main_1.png',
      applicants: []
    };
    MockData.tasks.list.unshift(newTask);

    if (!MockData.tasks.myOrders) MockData.tasks.myOrders = [];
    MockData.tasks.myOrders.unshift({
      id: 'MO_' + Date.now(),
      sourceId: newTask.id,
      role: 'publisher',
      title: newTask.title,
      cover: newTask.cover,
      rewardMoney: newTask.rewardMoney,
      rewardAmount: budget,
      status: '招募中',
      counterpart: '平台待选定',
      deadline: '2026-10-01',
      createdAt: '刚刚',
      coreInfo: desc
    });

    // 草稿转化：从「编辑草稿」进入发布页并正式发布时，移除原草稿，
    // 使台账呈现「草稿 → 招募中」的状态转化而非残留两条重复条目。
    if (!isDraft && this.editingDraftOrderId) {
      const orders = MockData.tasks.myOrders;
      const draftIdx = orders.findIndex(o => o.id === this.editingDraftOrderId);
      if (draftIdx !== -1 && this.isDraftOrder(orders[draftIdx])) orders.splice(draftIdx, 1);
      this.editingDraftOrderId = null;
    }

    this.closePublishTaskPage(true);
    this.syncTaskStats();
    this.renderTasksPlaza();
    this.renderMyTasks();
    this.showToast('商单已成功发布并托管资金至监管账户！');
  },

