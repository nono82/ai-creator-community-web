// 资金托管与创作者结算
  freezeEscrow: function(amount, label) {
    amount = Number(amount) || 0;
    if (amount <= 0) return true;
    // 口径：账户余额 = 已冻结 + 可消费。冻结只是把「可消费」转为「已冻结」，账户余额不变
    let wd0 = parseFloat(String(MockData.assets.cards.withdrawable).replace(/,/g, '')) || 0;
    if (amount > wd0) {
      this.showToast('可消费余额不足，无法完成平台托管冻结');
      return false;
    }
    const wd = Math.max(0, wd0 - amount);
    MockData.assets.cards.withdrawable = wd.toLocaleString('zh-CN', { minimumFractionDigits: 2 });

    const freezeItem = (MockData.assets.breakdown.items || []).find(it => it.label === '冻结金额');
    if (freezeItem) {
      freezeItem.value = (freezeItem.value || 0) + amount;
      freezeItem.amount = '¥ ' + freezeItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }
    const availItem = (MockData.assets.breakdown.items || []).find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = Math.max(0, (availItem.value || 0) - amount);
      availItem.amount = '¥ ' + availItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }

    const txId = 'TX' + Date.now();
    MockData.assets.transactions.unshift({
      id: txId,
      type: '支出',
      name: label || '定制商单资金托管冻结',
      amount: `- ¥ ${amount.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}`,
      rawAmount: -amount,
      status: '托管中',
      statusType: 'escrow',
      time: '刚刚',
      category: '支出'
    });

    // 同步登记一条托管项目：托管库按冻结时间倒序展示，本笔为最新一条
    MockData.assets.escrowProjects = MockData.assets.escrowProjects || [];
    MockData.assets.escrowProjects.push({
      id: 'ESC' + Date.now(),
      txId: txId,
      orderNo: 'MO-' + String(Date.now()).slice(-10),
      title: String(label || '新发布商单').replace(/^[^·]*·\s*/, '') || '新发布商单',
      counterpart: '待匹配创作者',
      role: '发包方',
      amount: amount,
      frozenAt: '刚刚',
      frozenAtTs: Date.now(),
      status: '招募选拔中',
      statusKey: 'active',
      stage: '任务已上架大厅，等待创作者报名',
      progress: 0,
      settleRule: '验收通过后 T+0 划转创作者，流标则全额原路退回'
    });

    this.refreshAssetDisplays();
    return true;
  },

  // ====== 商单验收结算（资金口径硬约束 · 2026-09-24 重订）======
  // 口径：验收通过后，托管赏金**只进「创作收益」**，创作者的账户余额体系零变动。
  // 托管释放走「已冻结 → 可消费」的同额转移（账户余额总额不变），结算所得记入创作收益（唯一可提现来源）。
  // 三条恒等式全部保持：①账户余额 = 已冻结 + 可消费 ②进行中托管项目合计 = 冻结金额 ③tokensAC = 自有 + 集成
  settleTaskReward: function(amount, taskTitle) {
    amount = Number(amount) || 0;
    if (amount <= 0) return null;

    const parse = (v) => parseFloat(String(v == null ? '0' : v).replace(/,/g, '')) || 0;
    const cards = MockData.assets.cards || {};
    const items = MockData.assets.breakdown.items || [];
    const freezeItem = items.find(it => it.label === '冻结金额');
    const frozenNow = freezeItem ? (freezeItem.value || 0) : 0;

    // ③ 先定位待结算的托管项目（优先按金额精确匹配冻结最早者，其次退回最早进行中项目），
    //    释放额 = min(赏金, 该项目金额) —— 保证「进行中托管项目合计 = 冻结金额」恒等不破
    const projects = MockData.assets.escrowProjects || [];
    const activeSorted = projects
      .filter((p) => p.statusKey === 'active')
      .sort((a, b) => (a.frozenAtTs || 0) - (b.frozenAtTs || 0));
    const target = activeSorted.find((p) => Number(p.amount) === amount) || activeSorted[0] || null;
    const release = target ? Math.min(amount, Math.max(0, frozenNow), Number(target.amount) || 0) : 0;

    // ① 托管释放：已冻结 -release、可消费 +release（账户余额总额不变）
    if (freezeItem) {
      freezeItem.value = Math.max(0, frozenNow - release);
      freezeItem.amount = '¥ ' + freezeItem.value.toLocaleString('zh-CN', { minimumFractionDigits: 2 });
    }
    const nextWithdrawable = parse(cards.withdrawable) + release;
    cards.withdrawable = this.formatMoney(nextWithdrawable);
    const availItem = items.find(it => it.label === '可提现余额');
    if (availItem) {
      availItem.value = nextWithdrawable;
      availItem.amount = '¥ ' + this.formatMoney(nextWithdrawable);
    }
    // 账户余额总额在此口径下恒定不变（已冻结↓ = 可消费↑），故不写 cards.balance

    // ② 结算所得只进创作收益（唯一可提现资金来源）
    const nextEarnings = parse(cards.monthlyEarnings) + amount;
    cards.monthlyEarnings = this.formatMoney(nextEarnings);
    const incomeItem = items.find(it => it.label === '创作收益');
    if (incomeItem) {
      incomeItem.value = nextEarnings;
      incomeItem.amount = '¥ ' + this.formatMoney(nextEarnings);
    }

    // ③ 托管项目转「已结算 · 100%」
    if (target) {
      target.statusKey = 'settled';
      target.status = '已结算';
      target.stage = '验收通过 · 赏金已计入创作者创作收益';
      target.progress = 100;
      target.settleRule = '已完成结算，赏金划入创作收益（账户余额不变）';
    }

    // ④ 只写一条收入流水，明确标注资金去向
    MockData.assets.transactions.unshift({
      id: 'TX' + Date.now(),
      type: '收入',
      name: `商单结算收入 · ${taskTitle || '商单验收通过'}`,
      amount: `+ ¥ ${amount.toLocaleString('zh-CN', { minimumFractionDigits: 2 })}`,
      rawAmount: amount,
      status: '已到账',
      statusType: 'success',
      time: '刚刚',
      category: '收入'
    });

    this.bumpOverviewStats({ income: amount, fans: 30 });
    this.refreshAssetDisplays();
    return { released: release, earnings: nextEarnings, settledProject: target ? target.id : null };
  },

  releaseEscrow: function(amount, label) {
    // 兼容旧调用名：语义已统一为「托管释放 + 赏金计入创作收益，账户余额不变」
    return this.settleTaskReward(amount, String(label || '').replace(/^定制托管解冻并结算给创作者/, '') || '商单验收通过');
  },

  // 兼容旧调用名（契约名，见 我的资产设计.md）：同样是 settleTaskReward 的**转发别名**。
  // ⚠️ 此处**不得**重复实现入账逻辑 —— 那会形成「第二事实源」，
  //    一旦被调用将绕过托管释放，破坏恒等式「进行中托管项目合计 = 冻结金额」（Q-030）。
  creditCreatorIncome: function(amount, label) {
    return this.settleTaskReward(Number(amount) || 0, String(label || '').replace(/^定制托管解冻并结算给创作者/, '') || '任务验收入账');
  },

  // ====== 商单资金托管库 · 托管进度（当前商户名下全部托管项目） ======

  // 读取当前商户名下全部托管项目，按冻结时间倒序（最新在前）
  getEscrowProjects: function() {
    const list = (MockData.assets.escrowProjects || []).slice();
    return list.sort((a, b) => (b.frozenAtTs || 0) - (a.frozenAtTs || 0));
  },

  // 汇总托管台账：托管中金额 / 进行中项目数 / 累计已结算金额
  getEscrowSummary: function(list) {
    const all = list || this.getEscrowProjects();
    let frozen = 0, activeCount = 0, settled = 0;
    all.forEach((p) => {
      const amt = Number(p.amount) || 0;
      if (p.statusKey === 'active') {
        frozen += amt;
        activeCount += 1;
      } else if (p.status === '已结算') {
        settled += amt;
      }
    });
    return { frozen: frozen, activeCount: activeCount, settled: settled, total: all.length };
  },

