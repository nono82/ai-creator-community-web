/* =========================================================================
   AI创作者社区 - 全局样式与设计系统 (100% 像素级高保真复刻)
   ========================================================================= */

:root {
  --primary: #6366F1;
  --primary-hover: #4F46E5;
  --primary-light: #EEF2FF;
  --primary-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  --secondary: #8B5CF6;
  --accent-gold: #F59E0B;
  --accent-green: #10B981;
  --accent-blue: #3B82F6;
  --accent-pink: #EC4899;

  --text-primary: #1E293B;
  --text-secondary: #64748B;
  --text-muted: #94A3B8;
  --border-color: #E2E8F0;
  --bg-page: #F8FAFC;
  --bg-card: #FFFFFF;

  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-pill: 9999px;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 2px 10px rgba(0, 0, 0, 0.04);
  --shadow-hover: 0 8px 24px rgba(99, 102, 241, 0.12);
  --shadow-modal: 0 20px 40px rgba(15, 23, 42, 0.2);

  --font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  /* 全局密度：略缩小字号与留白，右侧栏更易完整展示 */
  --fs-base: 13px;
  --fs-title: 14px;
  --fs-title-side: 13px;
  --fs-meta: 11px;
  --space-card: 12px 14px;
  --space-section-mb: 10px;
  --side-width: 318px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  background-color: var(--bg-page);
  color: var(--text-primary);
  font-size: var(--fs-base);
  line-height: 1.45;
  overflow: hidden;
  height: 100vh;
  width: 100vw;
  user-select: none;
  -webkit-font-smoothing: antialiased;
}

/* 按钮通用 */
button {
  font-family: inherit;
  border: none;
  background: none;
  cursor: pointer;
  outline: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

input, textarea, select {
  font-family: inherit;
  font-size: var(--fs-base);
  outline: none;
}

a {
  text-decoration: none;
  color: inherit;
}

/* =========================================================================
   App Shell 布局
   ========================================================================= */
#app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

/* 顶部顶栏 */
.top-header {
  height: 56px;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  flex-shrink: 0;
  z-index: 50;
}

.brand-area {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  flex-shrink: 0;
}

.brand-logo-mark {
  width: 34px;
  height: 34px;
  object-fit: contain;
  flex-shrink: 0;
  display: block;
}

.brand-logo-img {
  height: 34px;
  width: auto;
  object-fit: contain;
}

.brand-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
  line-height: 1.15;
  min-width: 0;
}

.brand-title {
  font-size: 16px;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 0.2px;
  white-space: nowrap;
}

.brand-subtitle {
  font-size: 10.5px;
  font-weight: 500;
  color: #64748B;
  letter-spacing: 0.15px;
  white-space: nowrap;
}

.global-search-container {
  position: relative;
  width: 440px;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #F1F5F9;
  border-radius: var(--radius-pill);
  padding: 4px 6px 4px 16px;
  border: 1px solid transparent;
  transition: all 0.25s;
}

.search-input-wrapper:focus-within {
  background: #FFF;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.search-icon-svg,
.search-icon-img {
  color: var(--text-muted);
  width: 18px;
  height: 18px;
  margin-right: 8px;
  flex-shrink: 0;
  object-fit: contain;
  display: block;
}

.search-input {
  border: none;
  background: transparent;
  flex: 1;
  color: var(--text-primary);
  font-size: 13.5px;
}

.search-input::placeholder {
  color: #94A3B8;
}

.search-btn {
  background: var(--primary);
  color: #FFF;
  padding: 6px 20px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 500;
  transition: background 0.2s;
}

.search-btn:hover {
  background: var(--primary-hover);
}

.search-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: #FFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-modal);
  border: 1px solid var(--border-color);
  padding: 12px;
  display: none;
  z-index: 100;
}

.search-dropdown.active {
  display: block;
}

.search-dropdown-item {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  cursor: pointer;
  color: var(--text-primary);
  font-size: 13px;
  transition: background 0.15s;
}

.search-dropdown-item:hover {
  background: var(--primary-light);
  color: var(--primary);
}

/* 顶栏右侧 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  position: relative;
}

.notify-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 48px;
  width: 320px;
  background: #FFF;
  border: 1px solid #E2E8F0;
  border-radius: 14px;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
  z-index: 80;
  overflow: hidden;
}

.notify-dropdown[hidden] {
  display: none !important;
}

.notify-dropdown-head {
  padding: 12px 14px 8px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  border-bottom: 1px solid #F1F5F9;
}

.notify-dropdown-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  width: 100%;
  padding: 12px 14px;
  border: 0;
  background: #FFF;
  text-align: left;
  cursor: pointer;
}

.notify-dropdown-item:hover {
  background: #F8FAFC;
}

.notify-dropdown-item strong {
  font-size: 13px;
  color: var(--text-primary);
}

.notify-dropdown-item span {
  font-size: 12px;
  color: var(--text-muted);
}

.assets-profile-hub {
  margin-bottom: 14px;
}

.assets-profile-top {
  display: flex;
  gap: 16px;
  align-items: center;
}

.assets-profile-avatar {
  width: 72px;
  height: 72px;
  border-radius: 18px;
  object-fit: cover;
  border: 2px solid #EEF2FF;
  flex-shrink: 0;
}

.assets-profile-meta {
  flex: 1;
  min-width: 0;
}

.assets-profile-head-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20px;
}

.assets-profile-name-block {
  min-width: 0;
  flex-shrink: 0;
}

.assets-profile-name-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.assets-profile-name {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
}

.assets-profile-sub {
  font-size: 12.5px;
  color: var(--text-secondary);
  margin-bottom: 0;
}

.assets-profile-stats {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 20px;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  text-align: center;
  flex: 0 0 auto;
  justify-content: flex-end;
}

.assets-profile-stats > div {
  min-width: 0;
  flex-shrink: 0;
}

.assets-profile-stats .profile-stat-val {
  font-size: 16px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 2px;
  color: var(--text-primary);
}

.assets-profile-stats .profile-stat-lbl {
  font-size: 11.5px;
  color: var(--text-muted);
}

.assets-profile-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  flex-shrink: 0;
  align-items: center;
  margin-left: 16px;
}

.edge-works-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 8px 0 16px;
}

.edge-work-card {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
  background: #FFF;
}

.edge-work-card img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  display: block;
}

.edge-work-meta {
  padding: 10px 12px;
}

.edge-work-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.edge-work-source {
  font-size: 11.5px;
  color: var(--text-muted);
  margin-top: 2px;
}

.edge-certs-section {
  margin-bottom: 16px;
}

.edge-certs-label {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.edge-certs-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.edge-cert-card {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 12px;
  background: linear-gradient(180deg, #F8FAFF 0%, #FFF 70%);
}

.edge-cert-level {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6px;
}

.edge-cert-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.edge-cert-sub {
  font-size: 11.5px;
  color: var(--text-muted);
}

.edge-cert-medal {
  width: 36px;
  height: 36px;
  object-fit: contain;
  margin-bottom: 6px;
}

.edge-cert-nft-img {
  width: 100%;
  height: 72px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 8px;
}

.edge-announcement-body {
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--text-secondary);
  margin: 8px 0 18px;
}

.modal-dialog-lightbox {
  width: min(920px, 96vw);
  padding: 20px;
}

.lightbox-frame {
  border-radius: 12px;
  overflow: hidden;
  background: #0F172A;
}

.lightbox-frame img {
  width: 100%;
  max-height: 70vh;
  object-fit: contain;
  display: block;
}

.lightbox-caption {
  margin-top: 10px;
  font-size: 13px;
  color: var(--text-secondary);
  text-align: center;
}

.edge-faq-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 8px 0 16px;
}

.edge-faq-item {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 12px 14px;
  background: #F8FAFC;
}

.edge-faq-q {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.edge-faq-a {
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--text-secondary);
}

.edge-list-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 8px 0 16px;
  max-height: 360px;
  overflow-y: auto;
}

.edge-list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #E2E8F0;
  border-radius: 10px;
  background: #FFF;
  cursor: pointer;
  text-align: left;
}

.edge-list-row.is-static {
  cursor: default;
}

.edge-list-row:hover:not(.is-static) {
  border-color: #C7D2FE;
  background: #F8FAFF;
}

.edge-list-row strong {
  font-size: 13px;
  color: var(--text-primary);
}

.edge-list-row span {
  font-size: 12px;
  color: var(--text-muted);
  flex-shrink: 0;
}

.circle-item-row.is-highlight {
  border-radius: 12px;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
  background: #EEF2FF;
}

@media (max-width: 900px) {
  .assets-profile-head-row {
    flex-wrap: wrap;
  }
  .assets-profile-stats {
    order: 3;
    flex: 1 1 100%;
    padding-left: 0;
    gap: 16px 24px;
  }
  .assets-profile-actions {
    margin-left: 0;
  }
}

@media (max-width: 760px) {
  .assets-profile-stats {
    gap: 12px 20px;
  }
  .edge-works-grid,
  .edge-certs-cards {
    grid-template-columns: 1fr 1fr;
  }
  .notify-dropdown {
    right: 8px;
    width: min(320px, calc(100vw - 24px));
  }
  .modal-dialog,
  .modal-dialog-wide {
    width: 94vw;
    padding: 20px;
  }
}

.btn-creation-center {
  padding: 8px 18px;
  background: #FFF;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-pill);
  font-size: 13.5px;
  color: var(--text-primary);
  font-weight: 500;
}

.btn-creation-center:hover {
  background: #F8FAFC;
  border-color: #CBD5E1;
}

.btn-publish {
  padding: 8px 22px;
  background: var(--primary-gradient);
  color: #FFF;
  border-radius: var(--radius-pill);
  font-size: 13.5px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.btn-publish:hover {
  opacity: 0.95;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(99, 102, 241, 0.38);
}

.btn-icon-notify {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  position: relative;
  transition: background 0.2s;
}

.btn-icon-notify:hover {
  background: #F1F5F9;
  color: var(--text-primary);
}

.notify-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 7px;
  height: 7px;
  background: #EF4444;
  border-radius: 50%;
  border: 1.5px solid #FFF;
}

.header-user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid #EEF2FF;
  cursor: pointer;
  transition: transform 0.2s;
}

.header-user-avatar:hover {
  transform: scale(1.06);
}

/* 主工作区结构 */
.main-wrapper {
  display: flex;
  flex: 1;
  overflow: hidden;
  position: relative;
}

/* 左侧导航栏 */
.left-sidebar {
  width: 172px;
  background: var(--bg-card);
  border-right: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 14px 8px;
  flex-shrink: 0;
  z-index: 20;
}

.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.nav-icon-wrap {
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon-wrap svg,
.nav-icon-wrap .nav-icon-img {
  width: 20px;
  height: 20px;
  object-fit: contain;
  display: block;
}

.nav-item svg {
  width: 20px;
  height: 20px;
  stroke-width: 1.8;
  transition: stroke 0.2s, fill 0.2s;
}

.icon-3d-img {
  object-fit: contain;
  display: block;
  flex-shrink: 0;
}

.notify-icon-img,
.help-icon-img {
  object-fit: contain;
  display: block;
}

.nav-item:hover {
  background: #F1F5F9;
  color: var(--text-primary);
}

.nav-item.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.nav-item.active .nav-icon-wrap {
  color: var(--primary);
}

.nav-item.active svg {
  stroke: var(--primary);
}

.nav-icon-discover .nav-svg-active {
  display: none;
}

.nav-icon-discover .nav-svg-inactive {
  display: block;
}

.nav-item.active .nav-icon-discover .nav-svg-active {
  display: block;
}

.nav-item.active .nav-icon-discover .nav-svg-inactive {
  display: none;
}

.nav-item.active .nav-icon-discover .nav-svg-active {
  stroke: none;
}

/* 左侧下方 Pro 卡片 */
.sidebar-footer {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.pro-widget-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1px solid #FDE68A;
  border-radius: var(--radius-md);
  padding: 14px 12px;
  text-align: center;
}

.pro-widget-title {
  font-size: 13.5px;
  font-weight: 700;
  color: #92400E;
  margin-bottom: 2px;
}

.pro-widget-desc {
  font-size: 11px;
  color: #B45309;
  margin-bottom: 10px;
}

.btn-pro-open {
  width: 100%;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #78350F;
  font-size: 12px;
  font-weight: 700;
  padding: 6px 0;
  border-radius: var(--radius-sm);
  box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
}

.btn-pro-open:hover {
  opacity: 0.92;
}

.help-center-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  color: var(--text-secondary);
  font-size: 13px;
  cursor: pointer;
  border-radius: var(--radius-sm);
}

.help-center-link:hover {
  color: var(--text-primary);
  background: #F1F5F9;
}

/* 主内容容器 (7大页面承载区) */
.content-viewport {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--bg-page);
  padding: 14px 16px;
}

.view-container {
  display: none;
  animation: fadeIn 0.25s ease-out;
}

.view-container.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 双栏排版结构 */
.view-grid-layout {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  max-width: 1440px;
  margin: 0 auto;
}

.col-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.col-side {
  width: var(--side-width);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 12.5px;
}

/* 顶部高颜值 3D 渐变 Banner 卡片 */
.hero-banner-card {
  height: 176px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-sm);
}

.hero-banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
  display: block;
}

.hero-banner-overlay {
  display: none;
}

/* 各页 Banner：统一高度比例 */
.hero-banner-discover,
.hero-banner-academy,
.hero-banner-tools,
.hero-banner-community,
.hero-banner-tasks,
.hero-banner-analytics,
.hero-banner-assets {
  height: auto;
  aspect-ratio: 1024 / 197;
  min-height: 156px;
  max-height: 210px;
}

.hero-banner-discover .hero-banner-overlay,
.hero-banner-academy .hero-banner-overlay,
.hero-banner-tools .hero-banner-overlay,
.hero-banner-community .hero-banner-overlay,
.hero-banner-tasks .hero-banner-overlay,
.hero-banner-analytics .hero-banner-overlay,
.hero-banner-assets .hero-banner-overlay {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  position: absolute;
  inset: 0;
  z-index: 2;
  width: min(52%, 460px);
  padding: 20px 0 20px 48px;
  pointer-events: none;
  box-sizing: border-box;
}

.hero-banner-title {
  margin: 0;
  font-size: 26px;
  font-weight: 800;
  color: #1E1B4B;
  letter-spacing: 0.5px;
  line-height: 1.25;
}

.hero-banner-desc {
  margin: 8px 0 0;
  font-size: 12.5px;
  font-weight: 600;
  color: #475569;
  line-height: 1.55;
}

.hero-banner-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  pointer-events: auto;
}

.hero-btn-primary {
