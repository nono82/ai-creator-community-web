}

.doc-title {
  font-size: 15px;
  font-weight: 700;
  color: #1E293B;
  margin: 0;
}

.doc-cat-tag {
  font-size: 11px;
  background: #F1F5F9;
  color: #64748B;
  padding: 1px 7px;
  border-radius: 4px;
}

.doc-summary {
  font-size: 12.5px;
  color: #64748B;
  margin: 0 0 10px;
  line-height: 1.5;
}

.doc-meta-row {
  display: flex;
  gap: 16px;
  font-size: 11.5px;
  color: #94A3B8;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.doc-meta-row strong {
  color: #475569;
}

.doc-toc-preview {
  background: #F8FAFC;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 11.5px;
}

.doc-toc-preview strong {
  color: #475569;
  display: block;
  margin-bottom: 4px;
}

.doc-toc-preview ul {
  margin: 0;
  padding-left: 16px;
