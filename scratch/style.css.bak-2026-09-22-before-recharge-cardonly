  gap: 6px;
  border: none;
  background: #4F46E5;
  color: #FFF;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 8px;
  cursor: pointer;
}

/* R3 案例库 */
.res-case-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 20px;
}

.res-case-card {
  background: #FFF;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.case-cover-box {
  position: relative;
