/* Banner 透明交互热区（已停用，保留样式以免历史引用报错） */
.banner-hotspots {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.banner-hotspot {
  position: absolute;
  cursor: pointer;
  pointer-events: auto;
  border-radius: var(--radius-pill);
  background: transparent;
  transition: all 0.2s ease;
}

.banner-hotspot:hover {
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 14px rgba(99, 102, 241, 0.3);
