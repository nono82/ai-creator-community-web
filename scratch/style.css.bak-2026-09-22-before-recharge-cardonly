  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 13px;
  flex-shrink: 0;
}

.doc-format-badge.pdf {
  background: #FEE2E2;
  color: #DC2626;
  border: 1px solid #FECACA;
}

.doc-format-badge.xlsx {
  background: #DCFCE7;
  color: #16A34A;
  border: 1px solid #BBF7D0;
}

.doc-format-badge.docx {
  background: #DBEAFE;
