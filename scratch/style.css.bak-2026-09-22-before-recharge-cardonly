}

.copc-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 6px;
}

.copc-title-group {
  display: flex;
  align-items: center;
  gap: 5px;
  min-width: 0;
}

.copc-icon-badge {
  width: 22px;
