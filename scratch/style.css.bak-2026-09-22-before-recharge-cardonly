  justify-content: space-between;
  align-items: center;
  border-top: 1px dashed #E2E8F0;
  padding-top: 8px;
  margin-top: 4px;
}

.productized-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.productized-price {
  font-size: 17px;
  font-weight: 800;
  color: #EF4444;
}

.productized-sales {
  font-size: 11px;
  color: var(--text-muted);
}

.productized-btn-order {
  background: var(--primary-gradient);
  color: #FFFFFF;
  border: none;
  padding: 5px 14px;
  border-radius: var(--radius-pill);
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s;
}

.productized-btn-order:hover {
  opacity: 0.9;
}

/* 联合舰队大单卡片 */
.consortium-tasks-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.consortium-card {
  background: #FFFFFF;
  border: 1px solid #E0E7FF;
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.consortium-card:hover {
  border-color: #8B5CF6;
  box-shadow: 0 6px 20px rgba(139, 92, 246, 0.12);
}

.consortium-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10px;
}

.consortium-brand {
  font-size: 11px;
  color: #6B7280;
  margin-bottom: 2px;
}

.consortium-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text-primary);
}

.consortium-budget-wrap {
  text-align: right;
}

.consortium-budget-lbl {
  font-size: 11px;
  color: var(--text-muted);
}

.consortium-budget-val {
  font-size: 20px;
  font-weight: 800;
  color: #7C3AED;
}

.consortium-brief {
  font-size: 12px;
  color: #4B5563;
  line-height: 1.5;
  background: #F9FAFB;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.consortium-roles-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.consortium-role-chip {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  border-radius: var(--radius-md);
  padding: 6px 10px;
  font-size: 11.5px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.role-status-open {
  color: #059669;
  font-weight: 600;
}

.role-status-full {
  color: #9CA3AF;
}

.consortium-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid #F3F4F6;
}

.consortium-leader-info {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: #374151;
}

.consortium-leader-avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
}

.consortium-btn-join {
  background: linear-gradient(135deg, #7C3AED 0%, #6366F1 100%);
  color: #fff;
  border: none;
  padding: 6px 16px;
  border-radius: var(--radius-pill);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

/* 4. 商业工作流卡片 (创作工具) */
.workflows-grid-4 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 14px;
}

.workflow-card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: var(--radius-lg);
  padding: 12px 14px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  cursor: pointer;
  transition: all 0.2s ease;
}

.workflow-card:hover {
  border-color: var(--primary);
  box-shadow: 0 4px 16px rgba(99, 102, 241, 0.1);
  transform: translateY(-1px);
}

.wf-icon-box {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.wf-content {
  flex: 1;
  min-width: 0;
}

.wf-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3px;
}

.wf-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.wf-badge {
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 4px;
  background: #EEF2FF;
  color: #4F46E5;
  font-weight: 600;
}

.wf-desc {
  font-size: 11px;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 6px;
}

.wf-meta-row {
  display: flex;
  justify-content: space-between;
  font-size: 10.5px;
  color: #64748B;
  background: #F8FAFC;
  padding: 3px 6px;
  border-radius: 4px;
}

.wf-cost {
  color: #059669;
  font-weight: 600;
}

/* 5. 数据中心 · OPC 商业履约看板 */
.opc-analytics-banner {
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
  border: 1px solid #DDD6FE;
  border-radius: var(--radius-lg);
  padding: 12px 16px;
  margin-bottom: 12px;
}

.opc-analytics-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.opc-analytics-title {
  font-size: 13px;
  font-weight: 700;
  color: #4C1D95;
  display: flex;
  align-items: center;
  gap: 6px;
}

.opc-analytics-grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.opc-metric-item {
  background: #FFFFFF;
  border: 1px solid #E9D5FF;
  border-radius: var(--radius-md);
  padding: 8px 10px;
}

.opc-metric-lbl {
  font-size: 11px;
  color: #6B7280;
  margin-bottom: 2px;
}

.opc-metric-val {
  font-size: 16px;
  font-weight: 800;
  color: #6D28D9;
}

.opc-metric-sub {
  font-size: 10px;
  color: #10B981;
}

/* 6. 我的资产 · OPC 基础设施中枢 */
.opc-infrastructure-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}

.opc-infra-card {
  background: #FFFFFF;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.opc-infra-card:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.opc-infra-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.opc-infra-icon {
  font-size: 16px;
}

.opc-infra-title {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text-primary);
}

.opc-infra-desc {
  font-size: 11px;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 4px;
}

.opc-infra-action {
  font-size: 11px;
  color: var(--primary);
  font-weight: 600;
}

@media (max-width: 1000px) {
  .campus-opc-grid-4,
  .productized-services-grid,
  .workflows-grid-4,
  .opc-analytics-grid-4,
  .opc-infrastructure-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .campus-opc-grid-4,
  .productized-services-grid,
  .workflows-grid-4,
  .opc-analytics-grid-4,
  .opc-infrastructure-grid {
    grid-template-columns: 1fr;
  }
}

/* ===== 接单模式选择（发布页） ===== */
.pt-accept-mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.pt-accept-mode-card {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 14px 16px;
  border: 1.5px solid var(--border-color);
  border-radius: 12px;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
}

.pt-accept-mode-card input {
  margin-top: 3px;
  flex-shrink: 0;
}

.pt-accept-mode-card span {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pt-accept-mode-card strong {
  font-size: 13.5px;
  color: var(--text-primary);
}

.pt-accept-mode-card em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.45;
}

.pt-accept-mode-card:hover {
  border-color: #93C5FD;
}

.pt-accept-mode-card.is-checked {
  border-color: var(--primary);
  background: #F8FAFF;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

@media (max-width: 720px) {
  .pt-accept-mode-grid {
    grid-template-columns: 1fr;
  }
}

/* ===== 任务详情全页 ===== */
.tasks-detail-page[hidden] {
  display: none !important;
}

.tasks-detail-body {
  max-width: 980px;
  margin: 0 auto;
  padding: 20px 24px 48px;
}

.tasks-detail-hero {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 20px;
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
}

.tasks-detail-cover {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  background: #E2E8F0;
}

.tasks-detail-hero-copy {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.tasks-detail-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.tasks-detail-badges .task-mode-chip,
.tasks-detail-badges .task-cover-badge {
  position: static;
}

.task-detail-chip {
  font-size: 11px;
  font-weight: 600;
  color: #334155;
  background: #F1F5F9;
  border-radius: 4px;
  padding: 2px 8px;
}

.tasks-detail-title {
  margin: 0;
  font-size: 22px;
  line-height: 1.35;
  color: var(--text-primary);
}

.tasks-detail-reward-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.tasks-detail-reward-row strong {
  font-size: 24px;
  color: #EF4444;
}

.tasks-detail-reward-row span {
  font-size: 13px;
  color: var(--text-secondary);
}

.tasks-detail-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 4px;
}

.tasks-detail-meta-grid label {
  display: block;
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 2px;
}

.tasks-detail-meta-grid span {
  font-size: 13px;
  color: var(--text-primary);
  font-weight: 600;
}

.tasks-detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}

.tasks-detail-card {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 16px 18px;
}

.tasks-detail-card h3 {
  margin: 0 0 10px;
  font-size: 14px;
  color: var(--text-primary);
}

.tasks-detail-text {
  margin: 0;
  font-size: 13px;
  line-height: 1.65;
  color: var(--text-secondary);
  white-space: pre-wrap;
}

.tasks-detail-text.is-muted {
  color: var(--text-muted);
}

.tasks-detail-attach-list {
  margin: 0;
  padding-left: 18px;
  font-size: 13px;
  color: var(--text-secondary);
}

.tasks-detail-attach-list em {
  font-style: normal;
  color: var(--text-muted);
  margin-left: 6px;
}

.tasks-detail-applicants {
  grid-column: 1 / -1;
  margin-bottom: 12px;
}

.tasks-detail-applicants-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12px;
}

.tasks-detail-applicants-head h3 {
  margin: 0;
}

.tasks-detail-applicants-head span {
  font-size: 12px;
  color: var(--text-muted);
}

.task-applicant-card {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 12px 0;
  border-top: 1px solid #F1F5F9;
}

.task-applicant-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.task-applicant-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.task-applicant-avatar-btn {
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: 50%;
  flex-shrink: 0;
  line-height: 0;
}

.task-applicant-avatar-btn:hover .task-applicant-avatar {
  box-shadow: 0 0 0 2px var(--primary);
}

.task-applicant-name-btn {
  border: none;
  background: none;
  padding: 0;
  font-size: inherit;
  font-weight: 700;
  color: var(--text-primary);
  cursor: pointer;
}

.task-applicant-name-btn:hover {
  color: var(--primary);
}

.task-applicant-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
}

.task-applicant-main {
  flex: 1;
  min-width: 0;
}

.task-applicant-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.task-applicant-sub {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.task-applicant-proposal {
  margin: 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-secondary);
}

.task-applicant-portfolio {
  display: inline-block;
  margin-top: 4px;
  padding: 0;
  border: none;
  background: none;
  font-size: 12px;
  color: var(--primary);
  cursor: pointer;
  text-align: left;
}

.task-applicant-portfolio:hover {
  text-decoration: underline;
}

.task-applicant-status {
  font-size: 11px;
  font-weight: 600;
  padding: 1px 7px;
  border-radius: 999px;
  background: #FEF3C7;
  color: #B45309;
}

.task-applicant-status.accepted {
  background: #D1FAE5;
  color: #047857;
}

.task-applicant-status.rejected {
  background: #F1F5F9;
  color: #64748B;
}

.tasks-detail-cta-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 0 8px;
}

.tasks-detail-cta-hint {
  font-size: 13px;
  color: var(--text-secondary);
}

.tasks-detail-fulfillment {
  margin-top: 4px;
}

.fulfillment-progress-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 12px 0 8px;
}

.fulfillment-bar {
  flex: 1;
  height: 10px;
}

.fulfillment-progress-row strong {
  min-width: 44px;
  text-align: right;
  font-size: 15px;
  color: var(--text-primary);
}

.fulfillment-rule {
  margin: 0 0 12px;
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--text-secondary);
}

.fulfillment-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.fulfillment-summary div {
  background: #F8FAFC;
  border-radius: 10px;
  padding: 10px 12px;
}

.fulfillment-summary label {
  display: block;
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.fulfillment-summary span {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-primary);
}

.fulfillment-form {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 14px;
  background: #FFF;
}

.fulfillment-form-title {
  font-size: 13.5px;
  font-weight: 600;
  margin-bottom: 10px;
}

.fulfillment-form-row {
  margin-bottom: 10px;
}

.fulfillment-form-row label {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.fulfillment-form-row input,
.fulfillment-form-row textarea {
  width: 100%;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 13px;
  font-family: inherit;
  box-sizing: border-box;
}

.fulfillment-timeline-head {
  font-size: 13px;
  font-weight: 600;
  margin: 4px 0 8px;
}

.fulfillment-timeline {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fulfillment-day {
  border-left: 3px solid #22C55E;
  padding: 8px 0 8px 12px;
  background: #F8FAFC;
  border-radius: 0 10px 10px 0;
}

.fulfillment-day.is-missed {
  border-left-color: #F59E0B;
}

.fulfillment-day-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 12.5px;
  margin-bottom: 4px;
}

.fulfillment-day-top span {
  color: var(--text-secondary);
}

.fulfillment-day p {
  margin: 0;
  font-size: 12.5px;
  color: var(--text-secondary);
  line-height: 1.5;
}

@media (max-width: 860px) {
  .fulfillment-summary {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 860px) {
  .tasks-detail-hero {
    grid-template-columns: 1fr;
  }
  .tasks-detail-cover {
    height: 160px;
  }
  .tasks-detail-meta-grid {
    grid-template-columns: 1fr 1fr;
  }
  .tasks-detail-grid {
    grid-template-columns: 1fr;
  }
}

/* ===== 成长学院二级页 ===== */
.academy-sub-page {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64px);
  background: #F4F6FB;
  margin: -14px -16px 0;
}

.academy-sub-page[hidden],
#academy-main-shell[hidden] {
  display: none !important;
}

.academy-sub-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 24px;
  background: #fff;
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 1px 0 rgba(15, 23, 42, 0.03);
}

.academy-sub-back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid var(--border-color);
