  align-items: center;
  gap: 12px;
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  cursor: pointer;
}

.meta-icon {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
}

.meta-item.liked {
  color: #EF4444;
}

.meta-item.liked svg {
  fill: #EF4444;
  stroke: #EF4444;
}

/* 任务精选 4 栏卡片 */
.tasks-grid-4 {
