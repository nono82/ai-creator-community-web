  font-size: 10px;
  font-weight: 600;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}

.work-card-info {
  padding: 8px 2px 4px;
}

.work-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
