.compute-pack-btn {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 12px;
  text-align: left;
  font-family: inherit;
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.18s;
}

.compute-pack-btn:hover {
  border-color: var(--primary);
}

.compute-pack-btn.active {
  background: var(--primary-light);
  border-color: var(--primary);
  box-shadow: var(--shadow-sm);
}

.compute-pack-price {
  font-size: 16px;
  font-weight: 800;
  color: var(--primary);
}

.compute-pack-tokens {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-primary);
}

.compute-pack-origin {
  font-size: 11px;
  color: var(--text-muted);
}

.compute-order-summary {
  padding: 10px 12px;
  margin-bottom: 12px;
  background: var(--bg-page);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.compute-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 4px 0;
  font-size: 12.5px;
  color: var(--text-secondary);
}

.compute-order-row strong {
  color: var(--text-primary);
  font-weight: 700;
}

/* 发票管理弹窗 */
.invoice-summary-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.invoice-summary-cell {
  padding: 12px;
  text-align: center;
  background: var(--primary-light);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.invoice-cell-label {
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.invoice-cell-value {
  font-size: 17px;
  font-weight: 700;
  color: var(--primary);
}

.invoice-record-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 220px;
  overflow-y: auto;
}

.invoice-record-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.18s;
}

.invoice-record-item:hover {
  border-color: var(--primary);
}

.invoice-record-item.active {
  background: var(--primary-light);
  border-color: var(--primary);
}

.invoice-record-item.is-issued {
  cursor: default;
  opacity: 0.72;
}

.invoice-record-main {
  flex: 1;
  min-width: 0;
}

.invoice-record-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.invoice-record-time {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}

.invoice-record-amount {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
}

.invoice-record-status {
  flex-shrink: 0;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
  border-radius: var(--radius-pill);
}

.invoice-record-status.is-pending {
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.12);
}

.invoice-record-status.is-done {
  color: var(--accent-green);
  background: rgba(16, 185, 129, 0.12);
}

.invoice-empty {
  padding: 18px;
  text-align: center;
  font-size: 12px;
  color: var(--text-muted);
  background: var(--bg-page);
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-md);
}

.invoice-type-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 8px;
}

.invoice-type-btn {
  padding: 10px 8px;
  font-size: 12.5px;
  font-family: inherit;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.18s;
}

.invoice-type-btn:hover {
  color: var(--primary);
  border-color: var(--primary);
}

.invoice-type-btn.active {
  color: var(--primary);
  background: var(--primary-light);
  border-color: var(--primary);
}

.invoice-field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 14px;
}

/* Pro 弹窗：订阅方案选择与支付来源（统一账户余额支付） */
.pro-plan-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}

.pro-plan-card {
  padding: 16px;
  text-align: center;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  cursor: pointer;
  transition: all 0.18s;
}

.pro-plan-card:hover {
  border-color: var(--primary);
}

.pro-plan-card.active {
  background: var(--primary-light);
  border: 2px solid var(--primary);
}

.pro-plan-tag {
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
}

.pro-plan-tag.is-muted {
  font-weight: 600;
  color: var(--text-secondary);
}

.pro-plan-price {
  margin: 6px 0;
  font-size: 24px;
  font-weight: 800;
  color: var(--text-primary);
}

.pro-plan-price span {
  font-size: 12px;
  font-weight: 400;
  color: var(--text-muted);
}

.pro-plan-note {
  font-size: 11px;
  color: var(--text-muted);
}

.pro-plan-note.is-green {
  color: var(--accent-green);
}

/* ===== Pro 会员订阅（独立结算通道） ===== */

/* modal-pro 内的会员状态条 */
.pro-subscribe-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 9px 12px;
  margin-bottom: 14px;
  font-size: 12px;
  background: var(--bg-page);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.pro-subscribe-badge {
  flex-shrink: 0;
  padding: 3px 8px;
  font-size: 10.5px;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 0.4px;
  background: linear-gradient(90deg, #F59E0B, #D97706);
  border-radius: 999px;
}

.pro-subscribe-badge.is-muted {
  background: #94A3B8;
}

.pro-subscribe-text {
  font-weight: 600;
  color: var(--text-primary);
}

.pro-subscribe-note {
  margin-left: auto;
  font-size: 11.5px;
  color: var(--text-muted);
}

.pro-expire-date {
  color: #B45309;
  font-weight: 800;
}

/* 侧边栏 Pro 入口卡（Pro 生效中态） */
.pro-widget-badge {
  display: inline-block;
  margin-bottom: 6px;
  padding: 2px 8px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.5px;
  color: #FFFFFF;
  background: linear-gradient(90deg, #F59E0B, #D97706);
  border-radius: 999px;
}

/* 资产页资料条的 Pro 徽章 */
.badge-pro {
  padding: 2px 7px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.5px;
  color: #FFFFFF;
  background: linear-gradient(90deg, #F59E0B, #D97706);
  border-radius: 999px;
}

/* 资料条上的会员信息行（含有效期至） */
.assets-profile-membership {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 5px;
  font-size: 12px;
  color: var(--text-secondary);
}

/* ===== Pro 订阅付款二维码弹窗 ===== */

.pro-qr-order-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.pro-qr-order-cell {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px 12px;
  background: var(--bg-page);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.pro-qr-order-lbl {
  font-size: 11px;
  color: var(--text-muted);
}

.pro-qr-order-val {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-primary);
}

.pro-qr-order-val.is-amount {
  color: #D97706;
}

.pro-qr-order-val.is-mono {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  word-break: break-all;
}

.pro-qr-channel-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.pro-qr-channel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 8px;
  font-size: 13px;
  font-family: inherit;
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  cursor: pointer;
}

.pro-qr-channel-btn:hover {
  border-color: var(--primary);
}

.pro-qr-channel-btn.active {
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-light);
  border-color: var(--primary);
}

.pro-qr-channel-icon {
  font-size: 15px;
}

.pro-qr-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 16px;
  margin-bottom: 14px;
  background: var(--bg-page);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.pro-qr-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  background: #FFFFFF;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
}

.pro-qr-svg {
  display: block;
}

.pro-qr-countdown {
  font-size: 12.5px;
  color: var(--text-secondary);
}

.pro-qr-countdown strong {
  font-size: 14px;
  color: #EF4444;
  letter-spacing: 0.5px;
}

.pro-qr-hint {
  font-size: 12px;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.7;
}

.pro-qr-hint span {
  margin: 0 3px;
  font-weight: 700;
  color: var(--text-primary);
}

.pro-qr-expire-hint {
  padding: 4px 10px;
  font-size: 11.5px;
  font-weight: 600;
  color: #B45309;
  background: #FFFBEB;
  border: 1px solid #FDE68A;
  border-radius: 999px;
}

.pro-qr-tip-row {
  padding: 9px 12px;
  margin-bottom: 16px;
  font-size: 11.5px;
  color: var(--text-secondary);
  background: var(--bg-page);
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-md);
  line-height: 1.7;
}

.pro-qr-tip-row strong {
  color: var(--text-primary);
}

/* 资产流水表格 */
.transactions-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin-top: 6px;
}

.transactions-table th {
  text-align: left;
  color: var(--text-muted);
  font-weight: 500;
  padding: 10px 14px;
  border-bottom: 1px solid #F1F5F9;
  font-size: 12px;
}

.transactions-table td {
  padding: 12px 14px;
  border-bottom: 1px solid #F8FAFC;
  color: var(--text-primary);
}

.transactions-table tr:hover td {
  background: #F8FAFC;
}

.amount-income {
  color: var(--accent-green);
  font-weight: 700;
}

.amount-expense {
  color: #EF4444;
  font-weight: 700;
}

.status-badge-tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
}

.tag-success { background: #D1FAE5; color: #059669; }
.tag-done { background: #F1F5F9; color: var(--text-muted); }

/* 我的数字藏品 (NFT) 5 宫格 */
.nfts-grid-5 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.nft-card {
  background: #FFF;
  border: 1px solid #F1F5F9;
  border-radius: var(--radius-md);
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
}

.nft-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-card);
}

.nft-thumb-wrap {
  width: 100%;
  aspect-ratio: 244 / 146;
  position: relative;
}

.nft-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.nft-info-row {
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.nft-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nft-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.nft-type-label {
  font-size: 10.5px;
  color: var(--text-muted);
  white-space: nowrap;
}

.nft-tag-badge {
  font-size: 10px;
  padding: 1px 5px;
  border-radius: 3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.nft-more-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 700;
}

.tag-rare { background: #DBEAFE; color: #2563EB; }
.tag-epic { background: #FCE7F3; color: #DB2777; }
.tag-common { background: #F1F5F9; color: var(--text-muted); }

/* 资产安全中心 & 常用功能 */
.security-status-bar {
  display: none;
}

.security-level-block {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 10px;
}

.security-level-text {
  font-size: 11.5px;
  color: var(--text-secondary);
}

.security-level-text strong {
  color: var(--primary);
  font-weight: 700;
}

.security-level-bar {
  height: 8px !important;
  border-radius: 999px;
  overflow: hidden;
  background: #EDE9FE;
}

.security-level-bar .progress-bar-fill {
  background: linear-gradient(90deg, #818CF8, #7C3AED);
  border-radius: 999px;
}

.security-items-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  text-align: center;
  gap: 8px;
  margin-bottom: 10px;
}

.security-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.security-icon {
  width: 28px;
  height: 28px;
  border-radius: 0;
  background: transparent;
  color: #3B82F6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.security-icon svg,
.security-icon .icon-3d-img {
  width: 22px;
  height: 22px;
  object-fit: contain;
}

.security-name {
  font-size: 10px;
  color: var(--text-primary);
}

.security-state {
  font-size: 9.5px;
  color: var(--text-muted);
}

.security-settings-section {
  margin-bottom: 18px;
}

.security-settings-section-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

.security-settings-card {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  overflow: hidden;
  background: #FFF;
}

.security-settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 14px;
  border-bottom: 1px solid #F1F5F9;
}

.security-settings-row:last-child {
  border-bottom: none;
}

.security-settings-label {
  font-size: 12px;
  color: var(--text-muted);
  flex-shrink: 0;
  min-width: 72px;
}

.security-settings-value {
  flex: 1;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  text-align: right;
}

.security-settings-action {
  flex-shrink: 0;
  border: none;
  background: transparent;
  color: #6366F1;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  padding: 0 0 0 8px;
}

.security-settings-row.is-focus {
  background: #EEF2FF;
}

.security-settings-action:hover {
  color: #4F46E5;
}

.security-settings-profile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  margin-bottom: 8px;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  background: linear-gradient(135deg, #F8FAFF 0%, #FFF 70%);
}

.security-settings-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.security-settings-profile-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}

.security-settings-profile-sub {
  margin-top: 3px;
  font-size: 12px;
  color: var(--text-muted);
}

.common-functions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  text-align: center;
}

.common-func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  padding: 8px 4px;
  border-radius: var(--radius-md);
  transition: background 0.15s;
}

.common-func-item:hover {
  background: #F1F5F9;
}

.common-func-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #EDE9FE;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
}

.common-func-icon svg,
.common-func-icon .icon-3d-img {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

.benefit-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #EDE9FE;
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 4px;
}

.benefit-icon-wrap svg,
.benefit-icon-wrap .icon-3d-img {
  width: 18px;
  height: 18px;
  object-fit: contain;
}

.common-func-label {
  font-size: 11.5px;
  color: var(--text-primary);
}

/* =========================================================================
   底部全局统计指标条 (Bottom Stats)
   ========================================================================= */
.bottom-stats-bar {
  height: 52px;
  background: transparent;
  border-top: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24px 8px;
  flex-shrink: 0;
  z-index: 40;
}

.bottom-stats-inner {
  width: 100%;
  height: 44px;
  background: #F5F3FF;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  padding: 0 12px;
}

.bottom-stat-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-secondary);
}

.bottom-stat-divider {
  width: 1px;
  height: 20px;
  background: #DDD6FE;
  flex-shrink: 0;
}

.stat-icon-img {
  width: 22px;
  height: 22px;
  object-fit: contain;
  flex-shrink: 0;
}

.stat-icon-bullet {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-val-bold {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

/* =========================================================================
   全局模态弹窗系统 (Modals)
   ========================================================================= */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease-out;
}

.modal-backdrop.active {
  display: flex;
}

.modal-dialog {
  background: #FFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-modal);
  width: 640px;
  max-width: 94vw;
  max-height: 85vh;
  overflow-y: auto;
  padding: 28px;
  position: relative;
  animation: scaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-dialog-wide {
  width: 880px;
  max-width: 96vw;
}

.modal-confirm-backdrop {
  z-index: 1200;
}

.modal-dialog-confirm {
  width: 420px;
  max-width: 92vw;
  padding: 24px 24px 20px;
}

.modal-confirm-message {
  margin: 10px 0 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-secondary);
}

.modal-confirm-actions {
  margin-top: 22px;
  justify-content: flex-end;
  gap: 10px;
}

.modal-publish-task-dialog {
  width: min(760px, 96vw);
}

/* ===== 发布任务全页 ===== */
.tasks-publish-page {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64px);
  background: #F4F6FB;
  margin: -14px -16px 0;
  padding-bottom: 0;
}

.tasks-publish-page[hidden],
#tasks-main-shell[hidden] {
  display: none !important;
}

.tasks-publish-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 24px;
  background: #fff;
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 1px 0 rgba(15, 23, 42, 0.03);
}

.tasks-publish-back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid var(--border-color);
  background: #fff;
  color: var(--text-primary);
  border-radius: var(--radius-pill);
  padding: 7px 12px 7px 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}

.tasks-publish-back:hover {
  border-color: #C7D2FE;
  color: var(--primary);
  background: var(--primary-light);
}

.tasks-publish-crumb {
  flex: 1;
  font-size: 13px;
  color: var(--text-muted);
  font-weight: 500;
}

.tasks-publish-crumb span {
  margin: 0 8px;
  color: #CBD5E1;
}

.tasks-publish-topbar-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.tasks-publish-body {
  width: min(880px, calc(100% - 32px));
  margin: 0 auto;
  padding: 20px 0 32px;
}

.tasks-publish-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
  padding: 18px 20px;
  border-radius: 16px;
  background: linear-gradient(135deg, #EEF2FF 0%, #F8FAFF 48%, #FFFFFF 100%);
  border: 1px solid #E0E7FF;
}

.tasks-publish-hero-title {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.tasks-publish-hero-desc {
  margin: 6px 0 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-secondary);
  max-width: 420px;
}

.tasks-publish-steps {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tasks-publish-steps span {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-muted);
  background: rgba(255,255,255,0.85);
  border: 1px solid #E2E8F0;
  border-radius: var(--radius-pill);
  padding: 5px 10px;
}

.tasks-publish-steps span.is-on {
  color: var(--primary);
  border-color: #C7D2FE;
  background: #fff;
}

.publish-task-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.publish-task-section {
  background: #fff;
  border: 1px solid #E8EDF5;
  border-radius: 16px;
  padding: 18px 18px 16px;
  box-shadow: var(--shadow-card);
}

.publish-task-section-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid #F1F5F9;
}

.publish-task-step {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  background: var(--primary-gradient);
}

.publish-task-section-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.publish-task-section-desc {
  margin-top: 3px;
  font-size: 12px;
  color: var(--text-muted);
}

.tasks-publish-page .form-group {
  margin-bottom: 14px;
}

.tasks-publish-page .form-label {
  font-size: 12.5px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 6px;
}

.tasks-publish-page .form-input,
.tasks-publish-page .form-textarea,
.tasks-publish-page .form-select {
  border-radius: 10px;
  border-color: #E2E8F0;
  background: #fff;
  min-height: 40px;
}

.tasks-publish-page .form-input:focus,
.tasks-publish-page .form-textarea:focus,
.tasks-publish-page .form-select:focus {
  border-color: #A5B4FC;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.publish-task-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.form-required {
  color: #EF4444;
  font-weight: 700;
}

.form-optional {
  margin-left: 8px;
  font-size: 11.5px;
  font-weight: 500;
  color: var(--text-muted);
}

.pt-cover-card {
  position: relative;
  width: min(100%, 360px);
  aspect-ratio: 16 / 9;
  border: 1.5px dashed #CBD5E1;
  border-radius: 14px;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

.pt-cover-card:hover,
.pt-cover-card.is-dragover {
  border-color: var(--primary);
  background: #F5F7FF;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.08);
}

.pt-cover-card.has-image {
  border-style: solid;
  border-color: #E2E8F0;
  background: #0F172A;
  cursor: default;
}

.pt-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
  color: #64748B;
  padding: 16px;
  pointer-events: none;
}

.pt-cover-placeholder[hidden] {
  display: none !important;
}

.pt-cover-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2px;
  background: #fff;
  color: var(--primary);
  border: 1px solid #E2E8F0;
  font-size: 20px;
  font-weight: 500;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.pt-cover-placeholder small {
  font-size: 11.5px;
  font-weight: 500;
  color: #94A3B8;
}

.pt-cover-card > img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pt-cover-card > img[hidden] {
  display: none !important;
}

.pt-cover-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  padding: 10px 12px;
  background: linear-gradient(180deg, transparent 0%, rgba(15, 23, 42, 0.55) 100%);
}

.pt-cover-toolbar[hidden] {
  display: none !important;
}

.pt-cover-tool-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  padding: 0 12px;
  border: none;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.95);
  color: var(--text-primary);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  margin: 0;
}

.pt-cover-tool-btn:hover {
  background: #fff;
}

.pt-field-hint {
  margin-top: 8px;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.5;
}

.pt-attach-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pt-attach-box.is-dragover .pt-attach-trigger {
  border-color: var(--primary);
  background: #F5F7FF;
}

.pt-attach-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pt-attach-list:empty {
  display: none;
}

.pt-attach-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid #E2E8F0;
  background: #fff;
}

.pt-attach-icon {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: #1D4ED8;
  background: #EFF6FF;
  border: 1px solid #DBEAFE;
  flex-shrink: 0;
}

.pt-attach-icon[data-ext="tar"],
.pt-attach-icon[data-ext="tar.gz"],
.pt-attach-icon[data-ext="tgz"] {
  color: #B45309;
  background: #FFFBEB;
  border-color: #FDE68A;
}

.pt-attach-meta {
  min-width: 0;
  flex: 1;
}

.pt-attach-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pt-attach-size {
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--text-muted);
}

.pt-attach-remove {
  width: 28px;
  height: 28px;
  border: none;
  border-radius: 50%;
  background: #F1F5F9;
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 28px;
  cursor: pointer;
  padding: 0;
  flex-shrink: 0;
}

.pt-attach-remove:hover {
  background: #FEE2E2;
  color: #DC2626;
}

.pt-attach-trigger {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1.5px dashed #CBD5E1;
  border-radius: 12px;
  background: #FAFBFC;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.pt-attach-trigger:hover {
  border-color: #A5B4FC;
  background: #F8FAFF;
}

.pt-attach-trigger-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--primary);
  border: 1px solid #E2E8F0;
  font-size: 18px;
  font-weight: 600;
  flex-shrink: 0;
}

.pt-attach-trigger-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.pt-attach-trigger-copy strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.pt-attach-trigger-copy em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.4;
}

.publish-task-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pt-tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  border-radius: var(--radius-pill);
  border: 1px solid #E2E8F0;
  background: #fff;
  font-size: 12.5px;
  color: var(--text-secondary);
  cursor: pointer;
  user-select: none;
  transition: all 0.15s;
}

.pt-tag-chip input {
  accent-color: var(--primary);
}

.pt-tag-chip:has(input:checked),
.pt-tag-chip.is-checked {
  border-color: #A5B4FC;
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.publish-task-check-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  margin-bottom: 10px;
  border: 1px solid #E8EDF5;
  border-radius: 12px;
  background: #FAFBFC;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.publish-task-check-card:hover {
  border-color: #C7D2FE;
  background: #F8FAFF;
}

.publish-task-check-card input {
  margin-top: 3px;
  accent-color: var(--primary);
  flex-shrink: 0;
}

.publish-task-check-card span {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.publish-task-check-card strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.publish-task-check-card em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.45;
}

.publish-task-agree {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 2px 0 0;
  padding: 14px 16px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #E8EDF5;
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--text-secondary);
  cursor: pointer;
}

.publish-task-agree input {
  margin-top: 3px;
  accent-color: var(--primary);
  flex-shrink: 0;
}

@media (max-width: 900px) {
  .tasks-publish-hero {
    flex-direction: column;
    align-items: flex-start;
  }
  .tasks-publish-steps {
    justify-content: flex-start;
  }
  .tasks-publish-topbar {
    flex-wrap: wrap;
  }
  .tasks-publish-topbar-actions {
    width: 100%;
    justify-content: flex-end;
  }
  .publish-task-grid-2 {
    grid-template-columns: 1fr;
  }
  .pt-cover-card {
    width: 100%;
  }
}

.level-perks-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 8px 0 18px;
}

.level-perk-card {
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 14px;
  background: #FFF;
}

.level-perk-card.is-current {
  border-color: var(--primary);
  background: linear-gradient(180deg, #EEF2FF 0%, #FFF 55%);
  box-shadow: 0 0 0 1px rgba(99, 102, 241, 0.15);
}

.level-perk-card.is-locked {
  opacity: 0.72;
}

.level-perk-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}

.level-perk-lv {
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
}

.level-perk-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.level-perk-state {
  margin-left: auto;
  font-size: 11px;
  color: var(--text-muted);
}

.level-perk-card.is-current .level-perk-state {
  color: var(--primary);
  font-weight: 600;
}

.level-perk-list {
  margin: 0;
  padding-left: 16px;
  font-size: 12px;
  line-height: 1.65;
  color: var(--text-secondary);
}

@media (max-width: 760px) {
  .level-perks-grid {
    grid-template-columns: 1fr;
  }
}

@keyframes scaleUp {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.modal-close-btn {
  position: absolute;
  top: 18px;
  right: 18px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  border-radius: 50%;
  transition: all 0.15s;
}

.modal-close-btn:hover {
  background: #F1F5F9;
  color: var(--text-primary);
}

.modal-header-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.modal-header-sub {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.form-input, .form-textarea, .form-select {
  width: 100%;
  padding: 9px 12px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  font-size: 13.5px;
  transition: border-color 0.2s;
}

.form-input:focus, .form-textarea:focus, .form-select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.modal-actions-row {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
}

/* 全局微交互 Toast 提示 */
#global-toast {
  position: fixed;
  top: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(-20px);
  background: rgba(30, 41, 59, 0.9);
  backdrop-filter: blur(8px);
  color: #FFF;
  padding: 10px 24px;
  border-radius: var(--radius-pill);
  font-size: 13.5px;
  font-weight: 500;
  box-shadow: var(--shadow-modal);
  pointer-events: none;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 2000;
  display: flex;
  align-items: center;
  gap: 8px;
}

#global-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* =========================================================================
   全局密度压缩：右侧栏优先，覆盖偏大的标题/内边距
   ========================================================================= */
.col-side .card-section {
  padding: 10px 12px;
}

.col-side .section-header {
  margin-bottom: 8px;
}

.col-side .section-title {
  font-size: var(--fs-title-side);
}

.col-side .section-title span {
  font-size: 10.5px !important;
}

.col-side .link-more {
  font-size: 11px;
}

.col-side .creator-profile-card {
  gap: 14px;
  padding: 16px 14px;
}

.col-side .creator-profile-card .profile-stats-row {
  padding: 12px 0;
}

.col-side .creator-profile-card .progress-bar-bg {
  margin-top: 6px;
}

.col-side .profile-avatar {
  width: 38px;
  height: 38px;
}

.col-side .quick-entry-icon,
.col-side .quick-entry-icon-img {
  width: 34px;
  height: 34px;
}

.col-side .quick-entry-label {
  font-size: 10.5px;
}

.col-side .icon-soft {
  transform: scale(0.92);
  transform-origin: center;
}

.col-main .section-title {
  font-size: var(--fs-title);
}

/* 数据中心 · 矩阵分发回流 */
.analytics-matrix-block {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.analytics-matrix-block[hidden],
#analytics-overview-block[hidden],
.analytics-dim-block[hidden] {
  display: none !important;
}

/* 数据中心 · 内容 / 用户 / 收益 / 创作表现 */
.analytics-dim-block {
  display: block;
}

.analytics-dim-panel {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.analytics-dim-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.analytics-dim-stat {
  background: #FFF;
  border: 1px solid #F1F5F9;
  border-radius: 12px;
  padding: 14px 16px;
  box-shadow: var(--shadow-card);
}

.analytics-dim-stat-label {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.analytics-dim-stat-value {
  font-size: 20px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.analytics-dim-stat-sub {
  margin-top: 4px;
  font-size: 11px;
  color: #10B981;
  font-weight: 600;
}

.analytics-dim-range-hint {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 500;
}

.analytics-dim-bars {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.analytics-dim-bar-row {
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr) minmax(120px, auto);
  gap: 10px;
  align-items: center;
}

.analytics-dim-bar-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.analytics-dim-bar-track {
  height: 8px;
  border-radius: 999px;
  background: #F1F5F9;
  overflow: hidden;
}

.analytics-dim-bar-fill {
  height: 100%;
  border-radius: 999px;
  background: #6366F1;
  min-width: 4px;
}

.analytics-dim-bar-meta {
  font-size: 12px;
  color: var(--text-muted);
  text-align: right;
  white-space: nowrap;
}

.analytics-dim-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.analytics-dim-chip-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.analytics-dim-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #F8FAFC;
}

.analytics-dim-chip span {
  font-size: 13px;
  color: var(--text-primary);
}

.analytics-dim-chip strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.analytics-dim-table-wrap {
  overflow-x: auto;
}

.analytics-dim-table td,
.analytics-dim-table th {
  white-space: nowrap;
}

.analytics-dim-status {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 999px;
  background: #ECFDF5;
  color: #059669;
  font-size: 11px;
  font-weight: 600;
}

.analytics-dim-habit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.analytics-dim-habit {
  padding: 12px 14px;
  border-radius: 10px;
  background: #F8FAFC;
}

.analytics-dim-habit-label {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.analytics-dim-habit-val {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

.matrix-summary-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.matrix-summary-card {
  background: #FFF;
  border: 1px solid #F1F5F9;
  border-radius: 12px;
  padding: 14px 16px;
  box-shadow: var(--shadow-card);
}

.matrix-summary-lbl {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.matrix-summary-val {
  font-size: 20px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.matrix-platform-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.matrix-platform-card {
  background: #FFF;
  border: 1px solid #F1F5F9;
  border-radius: 14px;
  padding: 14px;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
}

.matrix-platform-card:hover {
  border-color: #DDD6FE;
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.08);
  transform: translateY(-1px);
}

.matrix-platform-card.is-highlight {
  border-color: var(--primary);
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.22), 0 8px 20px rgba(99, 102, 241, 0.12);
  transform: translateY(-2px);
}

.matrix-platform-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.matrix-platform-logo {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  object-fit: cover;
  background: #F1F5F9;
}

.matrix-platform-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

.matrix-platform-change {
  font-size: 11px;
  color: #10B981;
  font-weight: 600;
  margin-top: 2px;
}

.matrix-platform-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.matrix-metric {
  background: #F8FAFC;
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.matrix-metric span {
  font-size: 10.5px;
  color: var(--text-muted);
}

.matrix-metric strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.matrix-metric.is-income {
  background: #FFF7ED;
}

.matrix-metric.is-income strong {
  color: #EA580C;
}

.matrix-platform-card.is-native-card {
  border-color: rgba(99, 102, 241, 0.3);
  background: linear-gradient(180deg, #FAF5FF 0%, #FFFFFF 36%);
  box-shadow: 0 4px 16px rgba(99, 102, 241, 0.08);
}

.matrix-platform-logo.is-native-logo {
  background: #EEF2FF;
  padding: 3px;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

.matrix-platform-name-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.matrix-platform-native-tag {
  font-size: 10px;
  font-weight: 700;
  color: #6366F1;
  background: #EEF2FF;
  padding: 1px 6px;
  border-radius: 999px;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

/* 卡片右上角专属能力胶囊与点击浮层 */
.matrix-card-corner-action {
  position: relative;
  margin-left: auto;
  flex-shrink: 0;
}

.btn-native-caps-corner {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(99, 102, 241, 0.08);
  border: 1px solid rgba(99, 102, 241, 0.22);
  border-radius: 999px;
  padding: 3px 8px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.btn-native-caps-corner:hover {
  background: rgba(99, 102, 241, 0.16);
  border-color: var(--primary);
  transform: translateY(-1px);
}

.corner-caps-badge {
  font-size: 11px;
  font-weight: 600;
  color: #4F46E5;
}

.corner-caps-dots {
  font-size: 13px;
  font-weight: 800;
  color: #6366F1;
  line-height: 1;
  letter-spacing: -0.5px;
}

/* 右上角点击展开的气泡浮层 */
.native-caps-popover {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 270px;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  box-shadow: 0 12px 30px -4px rgba(15, 23, 42, 0.15), 0 4px 12px -2px rgba(15, 23, 42, 0.08);
  padding: 12px;
  z-index: 100;
  animation: popoverFadeIn 0.16s ease-out;
}

.native-caps-popover.active {
  display: block;
}

@keyframes popoverFadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

.native-caps-popover-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8px;
  margin-bottom: 8px;
  border-bottom: 1px solid #F1F5F9;
}

.popover-head-title {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-primary);
}

.popover-head-close {
  background: none;
  border: none;
  font-size: 13px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 2px 4px;
  border-radius: 4px;
  line-height: 1;
}

.popover-head-close:hover {
  background: #F1F5F9;
  color: var(--text-primary);
}

.native-caps-popover-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.popover-cap-item {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px;
  border-radius: 8px;
  background: #F8FAFC;
  cursor: pointer;
  transition: background 0.15s, transform 0.12s;
  border: 1px solid transparent;
}

.popover-cap-item:hover {
  background: #EEF2FF;
  border-color: rgba(99, 102, 241, 0.2);
  transform: translateX(2px);
}

.popover-cap-icon {
  font-size: 16px;
  flex-shrink: 0;
}

.popover-cap-texts {
  flex: 1;
  min-width: 0;
}

.popover-cap-name {
  font-size: 12px;
  font-weight: 700;
  color: #1E293B;
  line-height: 1.2;
}

.popover-cap-desc {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
  line-height: 1.3;
}

.popover-cap-desc strong {
  color: #4F46E5;
}

.popover-cap-arrow {
  font-size: 12px;
  color: #94A3B8;
  font-weight: 700;
}

.matrix-work-card {
  margin: 0;
}

.matrix-work-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: #CBD5E1 transparent;
  padding-bottom: 6px;
}

.matrix-work-table-wrap::-webkit-scrollbar {
  height: 6px;
}

.matrix-work-table-wrap::-webkit-scrollbar-track {
  background: #F8FAFC;
  border-radius: 999px;
}

.matrix-work-table-wrap::-webkit-scrollbar-thumb {
  background: #CBD5E1;
  border-radius: 999px;
}

.matrix-work-table-wrap::-webkit-scrollbar-thumb:hover {
  background: #94A3B8;
}

.matrix-work-table {
  width: 100%;
  min-width: 1220px;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 12px;
}

.matrix-work-table th,
.matrix-work-table td {
  white-space: nowrap !important;
  padding: 10px 16px;
  text-align: left;
  min-width: 90px;
}

.matrix-work-table th {
  color: var(--text-muted);
  font-weight: 600;
  border-bottom: 1px solid #F1F5F9;
  background: #FFFFFF;
}

.matrix-work-table td {
  border-bottom: 1px solid #F8FAFC;
  vertical-align: middle;
  background: #FFFFFF;
  transition: background-color 0.15s ease;
}

.matrix-work-table tbody tr:hover td {
  background-color: #F8FAFC;
}

/* 首列“作品”左侧粘性固定，横向滑动时始终保持可见并对齐 */
.matrix-work-table th:first-child,
.matrix-work-table td:first-child {
  position: sticky;
  left: 0;
  background: #FFFFFF;
  z-index: 2;
  width: 220px;
  min-width: 220px;
  max-width: 250px;
  box-shadow: 3px 0 8px -2px rgba(0, 0, 0, 0.08);
  border-right: 1px solid #F1F5F9;
}

.matrix-work-table tbody tr:hover td:first-child {
  background-color: #F8FAFC;
}

.matrix-work-table th:first-child {
  z-index: 3;
}

.matrix-work-table th.th-native {
  color: var(--primary);
  background: #F8FAFC;
  border-bottom: 2px solid var(--primary);
}

.matrix-cell-native-col {
  background: rgba(99, 102, 241, 0.02) !important;
  border-left: 1px dashed #EEF2FF;
  border-right: 1px dashed #EEF2FF;
}

.matrix-work-table tbody tr:hover td.matrix-cell-native-col {
  background: #EEF2FF !important;
}

.work-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-top: 2px;
}

.work-matrix-tag {
  font-size: 9.5px;
  color: #0EA5E9;
  background: #F0F9FF;
  border: 1px solid #BAE6FD;
  padding: 1px 5px;
  border-radius: 4px;
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
}

.work-cover-badge.is-cap-badge {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
}

.matrix-work-cell {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 170px;
  max-width: 210px;
}

.matrix-work-thumb {
  width: 40px;
  height: 28px;
  border-radius: 6px;
  object-fit: cover;
  flex-shrink: 0;
  background: #F1F5F9;
}

.matrix-work-title {
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 150px;
}

.matrix-cell-views {
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap !important;
  line-height: 1.2;
}

.matrix-cell-likes {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
  white-space: nowrap !important;
  line-height: 1.2;
}

.matrix-insight-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.matrix-insight-item {
  --mi-accent: #6366F1;
  display: grid;
  grid-template-columns: 64px 72px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 10px;
  background: #F8FAFC;
  border-left: 3px solid var(--mi-accent);
}

.matrix-insight-tag {
  font-size: 11px;
  font-weight: 600;
  color: var(--mi-accent);
}

.matrix-insight-hl {
  font-size: 13px;
  color: var(--text-primary);
}

.matrix-insight-text {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.45;
}

@media (max-width: 1100px) {
  .matrix-summary-row,
  .matrix-platform-grid,
  .analytics-dim-summary,
  .analytics-dim-two-col,
  .analytics-dim-habit-grid {
    grid-template-columns: 1fr 1fr;
  }

  .matrix-insight-item {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .analytics-dim-bar-row {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .analytics-dim-bar-meta {
    grid-column: 2;
    text-align: left;
  }
}

@media (max-width: 720px) {
  .analytics-dim-summary,
  .analytics-dim-two-col,
  .analytics-dim-habit-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================================
   校园 OPC 超级个体商业孵化与赋能平台 - 核心特色样式
   ========================================================================= */

/* 1. 顶栏 OPC 认证标签 */
.header-opc-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(139, 92, 246, 0.12) 100%);
  border: 1px solid rgba(99, 102, 241, 0.25);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  cursor: pointer;
  margin-right: 6px;
  transition: all 0.2s ease;
}

.header-opc-tag:hover {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.2) 100%);
  border-color: var(--primary);
  transform: translateY(-1px);
}

.opc-tag-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 6px #10B981;
  animation: pulseDot 2s infinite;
}

@keyframes pulseDot {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1.1); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.opc-tag-text {
  font-size: 11.5px;
  font-weight: 600;
  color: #4F46E5;
  letter-spacing: 0.2px;
}

/* 2. 发现页 · 校园 OPC 孵化赋能四大护城河 */
.campus-opc-hero-section {
  background: linear-gradient(135deg, #FAF5FF 0%, #EEF2FF 50%, #F0FDF4 100%);
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: var(--radius-lg);
  padding: 12px 14px;
  margin-bottom: 14px;
}

.campus-opc-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  gap: 12px;
}

.campus-opc-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #FFFFFF;
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  font-size: 11.5px;
  font-weight: 700;
  color: #6366F1;
  border: 1px solid rgba(99, 102, 241, 0.2);
  box-shadow: var(--shadow-sm);
  white-space: nowrap;
  flex-shrink: 0;
}

.campus-opc-slogan {
  font-size: 12px;
  color: #4B5563;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  text-align: center;
}

.campus-opc-grid-4 {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.campus-opc-card {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: var(--radius-md);
  padding: 10px 12px;
