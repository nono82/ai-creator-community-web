  align-items: center;
  gap: 6px;
  margin-top: 8px;
}

.bank-card-act {
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 10.5px;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: inherit;
}

.bank-card-act:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.bank-card-act.is-primary {
  border-color: var(--primary);
  background: var(--primary);
  color: #FFF;
}

.bank-card-act.is-primary:hover {
  background: var(--primary-hover);
  color: #FFF;
}

.bank-card-act.is-danger {
  color: #DC2626;
  border-color: #FECACA;
}

.bank-card-act.is-danger:hover {
  border-color: #DC2626;
  background: #FEF2F2;
}

.bank-card-act-hint {
  font-size: 10px;
  color: var(--text-muted);
  font-style: italic;
}

.bank-card-empty {
  padding: 14px 12px;
  text-align: center;
  font-size: var(--fs-meta);
  color: var(--text-muted);
  line-height: 1.6;
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-md);
  background: var(--bg-page);
}

.bank-card-list-full {
  gap: 0;
}

.bank-card-list-full .bank-card-row {
  border: none;
  border-left: 3px solid var(--primary);
  border-bottom: 1px solid #F1F5F9;
  border-radius: 0;
  background: var(--bg-card);
}

.bank-card-list-full .bank-card-row.is-invalid {
  border-left-color: #F59E0B;
}

.bank-card-list-full .bank-card-row:last-child {
  border-bottom: none;
}

.bank-card-block-add-row {
  padding: 10px 14px;
  border-top: 1px solid #F1F5F9;
}

.bank-card-add-btn {
  width: 100%;
  padding: 8px 12px;
  font-size: 12.5px;
  font-weight: 600;
  border-radius: var(--radius-md);
  cursor: pointer;
}

.bank-card-add-btn.is-disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.withdraw-add-card-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  font-size: var(--fs-meta);
}

.withdraw-add-card-hint {
  color: var(--text-muted);
}

.withdraw-add-card-link {
  color: var(--primary);
  font-weight: 700;
  cursor: pointer;
}

.withdraw-add-card-link:hover {
  color: var(--primary-hover);
  text-decoration: underline;
}

/* 绑卡 / 换绑弹窗 */

.bank-bind-rebind-strip {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  margin-bottom: 14px;
  border-radius: var(--radius-md);
  background: var(--primary-light);
  border: 1px dashed #C7D2FE;
  font-size: var(--fs-meta);
}

.bank-bind-rebind-strip.is-on {
  display: flex;
}

.bank-bind-rebind-label {
  flex-shrink: 0;
  font-weight: 700;
  color: var(--primary);
}

.bank-bind-rebind-card {
  color: var(--text-primary);
  font-weight: 600;
}

.bank-bind-detect {
  margin-top: 6px;
  font-size: var(--fs-meta);
  line-height: 1.6;
  color: var(--text-muted);
}

.bank-bind-detect.is-ok {
  color: #047857;
  font-weight: 600;
}

.bank-bind-detect.is-error {
  color: #DC2626;
  font-weight: 600;
}

.bank-bind-demo {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
}

.bank-bind-demo-label {
  font-size: 10.5px;
  color: var(--text-muted);
}

.bank-bind-demo-chip {
  font-size: 10.5px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: var(--radius-pill);
  background: var(--bg-page);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  cursor: pointer;
}

.bank-bind-demo-chip:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-light);
}

.bank-bind-code-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.bank-bind-code-row .form-input {
  flex: 1;
  min-width: 0;
}

.bank-bind-code-btn {
  flex-shrink: 0;
  padding: 9px 12px;
  font-size: 12px;
  font-weight: 600;
  border-radius: var(--radius-md);
  cursor: pointer;
  white-space: nowrap;
}

.bank-bind-code-btn.is-disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.bank-bind-hint {
  margin-bottom: 12px;
  font-size: var(--fs-meta);
  line-height: 1.6;
  color: var(--text-secondary);
}

.bank-bind-hint.is-error {
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  background: #FEF2F2;
  border: 1px solid #FECACA;
  color: #DC2626;
  font-weight: 600;
}

