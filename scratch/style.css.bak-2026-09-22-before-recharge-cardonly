/* =========================================================================
   商单资金托管库 · 托管进度弹窗 (modal-escrow-progress)
   ========================================================================= */
.escrow-summary-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.escrow-summary-cell {
  padding: 12px;
  text-align: center;
  background: var(--primary-light);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.escrow-cell-label {
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.escrow-cell-value {
  font-size: 17px;
  font-weight: 700;
  color: var(--primary);
}

.escrow-project-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: 300px;
  overflow-y: auto;
  margin-top: 8px;
}

.escrow-project-item {
  padding: 11px 12px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-left: 3px solid var(--secondary);
  border-radius: var(--radius-md);
  transition: all 0.18s;
}

.escrow-project-item:hover {
  border-color: var(--primary);
  border-left-color: var(--secondary);
  box-shadow: var(--shadow-sm);
}

.escrow-project-item.is-settled {
  border-left-color: #CBD5E1;
  background: var(--bg-page);
}

.escrow-project-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.escrow-project-title {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.escrow-status-pill {
  flex-shrink: 0;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-weight: 600;
}

.escrow-status-pill.is-active {
  background: #EDE9FE;
  color: #6D28D9;
}

.escrow-status-pill.is-done {
  background: #F1F5F9;
  color: var(--text-secondary);
}

.escrow-project-meta {
  font-size: 11.5px;
  color: var(--text-muted);
  margin-bottom: 7px;
}

.escrow-project-bar {
  height: 5px;
  border-radius: var(--radius-pill);
  background: #EEF2F7;
  overflow: hidden;
  margin-bottom: 6px;
}

.escrow-project-bar > span {
  display: block;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--primary-gradient);
}

.escrow-project-item.is-settled .escrow-project-bar > span {
  background: #CBD5E1;
}

.escrow-project-stage {
  font-size: 11.5px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.escrow-project-foot {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.escrow-amount-label {
  font-size: 11px;
  color: var(--text-muted);
}

.escrow-amount-value {
  font-size: 15px;
  font-weight: 800;
  color: var(--secondary);
}

.escrow-amount-value.is-done {
  color: var(--text-secondary);
}

.escrow-time {
  margin-left: auto;
  font-size: 11px;
  color: var(--text-muted);
}

.escrow-project-rule {
  margin-top: 5px;
  padding-top: 5px;
  border-top: 1px dashed var(--border-color);
  font-size: 11px;
  color: var(--text-muted);
}

.escrow-empty {
  padding: 22px;
  text-align: center;
  font-size: 12px;
  color: var(--text-muted);
  background: var(--bg-page);
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-md);
}

@media (max-width: 640px) {
  .escrow-summary-strip {
    grid-template-columns: 1fr;
  }
}

