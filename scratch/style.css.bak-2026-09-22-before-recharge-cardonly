}

.academy-sub-crumb span {
  margin: 0 6px;
  color: var(--text-muted);
}

.academy-sub-topbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.academy-sub-body {
  padding: 20px 24px 40px;
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
}

.academy-chip {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: 999px;
  background: var(--primary);
  color: #fff;
  font-size: 12px;
  font-weight: 600;
}

.academy-chip.is-soft {
  background: rgba(99, 102, 241, 0.12);
  color: var(--primary);
}

.academy-course-hero {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 24px;
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
}

.academy-course-cover {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  background: #E2E8F0;
}

.academy-course-badges {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.academy-course-title {
  font-size: 24px;
  line-height: 1.3;
  margin: 0 0 8px;
  color: var(--text-primary);
}

.academy-course-desc {
  margin: 0 0 12px;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.6;
}

.academy-course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 18px;
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 14px;
}

.academy-course-progress-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 16px;
}

.academy-course-cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.academy-panel {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 16px 18px 18px;
  margin-bottom: 16px;
}

.academy-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.academy-panel-head h2 {
  margin: 0;
  font-size: 16px;
  color: var(--text-primary);
}

.academy-panel-head span,
.academy-panel-head .link-more {
  font-size: 13px;
  color: var(--text-muted);
  background: none;
  border: none;
  cursor: pointer;
}

.academy-lesson-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.academy-lesson-row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  text-align: left;
  border: 1px solid var(--border-color);
  background: #fff;
  border-radius: 12px;
  padding: 12px 14px;
  cursor: pointer;
  transition: border-color .15s, background .15s;
}

.academy-lesson-row:hover {
  border-color: rgba(99, 102, 241, 0.45);
}

.academy-lesson-row.is-done {
  background: #F8FAFC;
}

.academy-lesson-row.is-learning {
  border-color: rgba(99, 102, 241, 0.5);
  background: rgba(99, 102, 241, 0.04);
}

.academy-lesson-row.is-locked {
  opacity: 0.55;
  cursor: not-allowed;
}

.academy-lesson-idx {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #EEF2FF;
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}

.academy-lesson-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.academy-lesson-main strong {
  font-size: 14px;
  color: var(--text-primary);
}

.academy-lesson-main em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.academy-lesson-state {
  font-size: 12px;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.academy-lesson-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 16px;
  align-items: start;
}

.academy-player-card {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  overflow: hidden;
}

.academy-player-stage {
  position: relative;
  height: 280px;
  background: #0F172A;
}

.academy-player-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.45;
}

.academy-player-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  text-align: center;
  padding: 20px;
}

.academy-player-play {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.92);
  cursor: pointer;
  position: relative;
  margin-bottom: 14px;
}

.academy-player-play::after {
  content: '';
  position: absolute;
  left: 26px;
  top: 20px;
  border-style: solid;
  border-width: 12px 0 12px 18px;
  border-color: transparent transparent transparent var(--primary);
}

.academy-player-article-badge {
  display: inline-flex;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 12px;
  font-size: 13px;
}

.academy-player-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 6px;
}

.academy-player-sub {
  font-size: 13px;
  opacity: 0.85;
}

.academy-player-body {
  padding: 18px 20px 22px;
}

.academy-player-body h2 {
  margin: 0 0 8px;
  font-size: 15px;
}

.academy-keypoint-list {
  margin: 0 0 16px;
  padding-left: 18px;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.7;
}

.academy-lesson-content {
  margin: 0 0 18px;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.7;
}

.academy-lesson-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.academy-lesson-actions-right {
  display: flex;
  gap: 8px;
}

.academy-lesson-side .academy-panel {
  margin-bottom: 12px;
}

.academy-side-course {
  display: flex;
  gap: 10px;
  width: 100%;
  border: none;
  background: #F8FAFC;
  border-radius: 12px;
  padding: 10px;
  text-align: left;
  cursor: pointer;
}

.academy-side-course img {
  width: 56px;
  height: 40px;
  object-fit: cover;
  border-radius: 8px;
}

.academy-side-course strong {
  display: block;
  font-size: 13px;
  color: var(--text-primary);
}

.academy-side-course em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
}

.academy-mini-outline {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.academy-mini-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  border: 1px solid transparent;
  background: #F8FAFC;
  border-radius: 10px;
  padding: 8px 10px;
  text-align: left;
  cursor: pointer;
  font-size: 12px;
  color: var(--text-primary);
}

.academy-mini-row span {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.academy-mini-row.is-active {
  border-color: rgba(99, 102, 241, 0.45);
  background: rgba(99, 102, 241, 0.06);
}

.academy-mini-row.is-done em {
  color: #16A34A;
}

.academy-mini-row em {
  font-style: normal;
  color: var(--text-muted);
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 600;
}

.academy-exam-card {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 24px;
}

.academy-exam-head h1 {
  margin: 0 0 6px;
  font-size: 22px;
}

.academy-exam-head p {
  margin: 0 0 18px;
  color: var(--text-secondary);
  font-size: 14px;
}

.academy-exam-q {
  margin-bottom: 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid #F1F5F9;
}

.academy-exam-q-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 10px;
}

.academy-exam-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.academy-exam-opt {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
  font-size: 14px;
}

.academy-exam-opt:has(input:checked) {
  border-color: var(--primary);
  background: rgba(99, 102, 241, 0.05);
}

.academy-exam-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
}

/* 课节播放器看视频奖创作积分条 (严格单行防换行) */
.academy-player-reward-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 16px;
  margin: 14px 16px 0;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(14, 165, 233, 0.08) 100%);
  border: 1px solid rgba(79, 70, 229, 0.2);
  color: #4338CA;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
}

.academy-player-reward-tip .reward-tip-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.academy-player-reward-tip .reward-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  background: #4F46E5;
  color: #FFF;
  font-size: 11.5px;
  padding: 4px 12px;
  border-radius: 999px;
  font-weight: 700;
  box-shadow: 0 1px 3px rgba(79, 70, 229, 0.3);
  line-height: 1.4;
}

/* 课程评价与学员讨论专区 */
.academy-reviews-section {
  margin-top: 16px;
  background: #FFF;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 20px;
}

.academy-reviews-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid #F1F5F9;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.academy-reviews-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}

.academy-reviews-stats {
  display: flex;
  align-items: center;
  gap: 16px;
}

.academy-score-box {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.academy-score-num {
  font-size: 22px;
  font-weight: 800;
  color: #D97706;
}

.academy-score-stars {
  color: #F59E0B;
  font-size: 14px;
  letter-spacing: 1px;
}

.academy-reviews-count {
  font-size: 12px;
  color: var(--text-muted);
}

/* 学员评价发表表单 */
.academy-review-form-card {
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 16px;
}

.academy-review-form-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  flex-wrap: wrap;
  gap: 8px;
}

.academy-star-picker {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.star-pick-item {
  cursor: pointer;
  color: #D1D5DB;
  font-size: 18px;
  transition: color 0.15s, transform 0.15s;
  user-select: none;
}

.star-pick-item.active {
  color: #F59E0B;
}

.star-pick-item:hover {
  transform: scale(1.18);
}

.academy-review-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 72px;
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #CBD5E1;
  font-size: 13px;
  line-height: 1.5;
  resize: vertical;
  outline: none;
  font-family: inherit;
  margin-bottom: 10px;
  background: #FFF;
}

.academy-review-textarea:focus {
  border-color: #6366F1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.academy-review-form-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.academy-review-tip {
  font-size: 12px;
  color: #64748B;
}

.academy-review-tip strong {
  color: #4F46E5;
}

/* 学员评价列表 */
.academy-reviews-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.academy-review-card {
  padding: 14px 16px;
  border: 1px solid #F1F5F9;
  background: #FAFAFC;
  border-radius: 12px;
  transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
}

.academy-review-card:hover {
  background: #FFF;
  border-color: #E2E8F0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

.academy-review-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.academy-review-author-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.academy-review-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid #E2E8F0;
}

.academy-review-author-meta strong {
  font-size: 13px;
  color: var(--text-primary);
  display: block;
  margin-bottom: 2px;
}

.academy-review-school {
  font-size: 11px;
  color: #64748B;
}

.academy-review-author-right {
  text-align: right;
}

.academy-review-stars {
  color: #F59E0B;
  font-size: 12px;
  margin-bottom: 2px;
}

.academy-review-date {
  font-size: 11px;
  color: var(--text-muted);
}

.academy-review-content {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin: 0 0 6px;
}

.academy-review-footer {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  color: #94A3B8;
}

.academy-review-progress-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: #EEF2FF;
  color: #4F46E5;
  padding: 1px 6px;
  border-radius: 4px;
  font-weight: 600;
}

.academy-records-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 16px;
}

.academy-stat-card {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 14px 16px;
}

.academy-stat-card em {
  display: block;
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.academy-stat-card strong {
  font-size: 22px;
  color: var(--text-primary);
}

.academy-stat-card strong span {
  font-size: 12px;
  font-weight: 500;
  margin-left: 4px;
  color: var(--text-muted);
}

.academy-records-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 16px;
}

.academy-records-grid .academy-panel:last-child {
  grid-column: 1 / -1;
}

.academy-record-plan,
.academy-log-row,
.academy-cert-mini,
.academy-resource-item {
  display: flex;
  width: 100%;
  border: 1px solid var(--border-color);
  background: #fff;
  border-radius: 12px;
  padding: 10px 12px;
  text-align: left;
  cursor: pointer;
  margin-bottom: 8px;
}

.academy-record-plan {
  gap: 12px;
  align-items: center;
}

.academy-record-plan img {
  width: 72px;
  height: 48px;
  object-fit: cover;
  border-radius: 8px;
}

.academy-record-plan strong,
.academy-log-row strong,
.academy-cert-mini strong,
.academy-resource-item strong {
  display: block;
  font-size: 13px;
  color: var(--text-primary);
}

.academy-record-plan em,
.academy-log-row em,
.academy-cert-mini em {
  font-style: normal;
  font-size: 12px;
  color: var(--text-muted);
}

.academy-record-plan .progress-bar-bg {
  margin-top: 6px;
  width: 160px;
}

.academy-log-row {
  justify-content: space-between;
  align-items: center;
}

.academy-log-row span {
  font-size: 12px;
  color: var(--text-muted);
  flex-shrink: 0;
}

.academy-records-certs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.academy-cert-mini {
  flex-direction: column;
  gap: 6px;
  margin: 0;
}

.academy-cert-mini.claimable {
  border-color: rgba(249, 115, 22, 0.45);
  background: #FFF7ED;
}

.academy-cert-mini.locked {
  opacity: 0.6;
}

.academy-empty {
  padding: 24px;
  text-align: center;
  color: var(--text-muted);
  font-size: 13px;
}

.academy-resource-hero {
  display: flex;
  gap: 16px;
  align-items: center;
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
}

.academy-resource-icon {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: color-mix(in srgb, var(--res-color, #6366F1) 14%, white);
  flex-shrink: 0;
}

.academy-resource-hero h1 {
  margin: 0 0 6px;
  font-size: 22px;
}

.academy-resource-hero p {
  margin: 0;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.6;
}

.academy-resource-item {
  justify-content: space-between;
  align-items: center;
}

.academy-resource-item span {
  color: var(--primary);
  font-size: 13px;
}

.academy-cert-card-lg {
  background: linear-gradient(160deg, #fff 0%, #EEF2FF 100%);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  padding: 36px 32px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.academy-cert-ribbon {
  position: absolute;
  top: 18px;
  left: -28px;
  transform: rotate(-35deg);
  background: var(--primary);
  color: #fff;
  font-size: 12px;
  padding: 4px 36px;
}

.academy-cert-level-lg {
  display: inline-flex;
  padding: 4px 12px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.12);
  color: var(--primary);
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 12px;
}

.academy-cert-card-lg h1 {
  margin: 0 0 10px;
  font-size: 26px;
}

.academy-cert-desc {
  max-width: 520px;
  margin: 0 auto 18px;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.7;
}

.academy-cert-meta-lg {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px 18px;
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 22px;
}

.academy-cert-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

@media (max-width: 960px) {
  .academy-course-hero,
  .academy-lesson-layout,
  .academy-records-grid,
  .academy-records-stats,
  .academy-records-certs {
    grid-template-columns: 1fr;
  }
  .academy-course-cover {
    height: 160px;
  }
  .academy-player-stage {
    height: 200px;
  }
  .academy-sub-body {
    padding: 16px;
  }
  .academy-sub-topbar {
    padding: 10px 14px;
    flex-wrap: wrap;
  }
}

/* ==========================================================================
   任务大厅与作品展厅全生命周期闭环升级样式
   ========================================================================== */

/* 1. 扩展状态角标 */
.task-cover-badge.badge-amber,
.task-cover-badge.badge-revision {
  background: #D97706 !important;
  color: #FFF !important;
}

.task-cover-badge.badge-purple,
.task-cover-badge.badge-dispute {
  background: #8B5CF6 !important;
  color: #FFF !important;
}

.task-cover-badge.badge-evaluate {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%) !important;
  color: #FFF !important;
}

.task-cover-badge.badge-cyan {
  background: #0891B2 !important;
  color: #FFF !important;
}

/* 2. 72小时倒计时提醒条 */
.task-countdown-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  padding: 4px 10px;
  border-radius: 6px;
  margin-top: 6px;
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.25);
  color: #B45309;
}

.task-countdown-bar.is-dispute {
  background: rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.25);
  color: #7C3AED;
}

.task-countdown-bar.is-revision {
  background: rgba(217, 119, 6, 0.08);
  border-color: rgba(217, 119, 6, 0.25);
  color: #B45309;
}

/* 3. 展厅顶部管理按钮与档期展示 */
.gallery-intro-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.gallery-my-booth-btn {
  display: inline-flex;
  align-items: center;
  padding: 5px 12px;
  border-radius: var(--radius-pill, 999px);
  background: var(--bg-card, #FFFFFF);
  border: 1px solid var(--border-color, #E2E8F0);
  color: var(--text-primary, #1E293B);
